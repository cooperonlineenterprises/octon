{
  "schema_version": "octon-mini.source.profile-manifest.v1",
  "document_role": "authoritative_profile_inventory_acceptance_and_generation_manifest",
  "permission_grant": false,
  "profiles": [
    {
      "id": "minimal",
      "rank": 0,
      "layers": [
        "core"
      ],
      "label": "Minimal",
      "selection_basis": "early_or_low_risk_project_requiring_the_complete_domain_neutral_kernel",
      "collaboration_independent": true
    },
    {
      "id": "standard",
      "rank": 1,
      "layers": [
        "core",
        "standard"
      ],
      "label": "Standard",
      "selection_basis": "structured_traceability_review_or_extension_risk",
      "collaboration_independent": true
    },
    {
      "id": "high-assurance",
      "rank": 2,
      "layers": [
        "core",
        "standard",
        "high-assurance"
      ],
      "label": "High Assurance",
      "selection_basis": "sensitive_externally_effective_audit_or_long_lived_agent_operation",
      "collaboration_independent": true
    }
  ],
  "layouts": [
    {
      "id": "compact",
      "default": true,
      "description": "Combine only conceptual artifacts whose authority, owner, lifecycle, review, sensitivity, and retention remain aligned.",
      "omit_paths": [
        "project-dossier/CANONICAL_SOURCE_MAP.md"
      ],
      "template_overrides": [
        {
          "output_path": "project-dossier/AUTHORITY.md",
          "source": "skill:assets/layouts/compact/project-dossier/AUTHORITY.md.tmpl"
        }
      ],
      "registry_combinations": [
        {
          "retained_representation_id": "REP-0002",
          "absorbed_representation_ids": ["REP-0003"],
          "artifact_type_ids": ["DOS-0002", "DOS-0003"],
          "representation_role": "combined_interpretation_and_source_map",
          "authority": "dossier_interpretation_and_source_ownership",
          "applicability_rationale": "Compact layout combines two required conceptual artifacts whose governance boundaries are aligned.",
          "owner_role": "project_governance_owner",
          "review_cadence": "on_authority_or_source_owner_change",
          "update_triggers": ["authority_change", "information_class_change", "artifact_added", "source_direction_change"]
        }
      ]
    },
    {
      "id": "separated",
      "default": false,
      "description": "Keep every Octon Mini representation physically separate; use when ownership or lifecycle boundaries require it.",
      "omit_paths": [],
      "template_overrides": [],
      "registry_combinations": []
    }
  ],
  "project_paths": {
    "kernel_files": [
      ".agent/policy.json",
      ".agent/context.json",
      ".agent/schema.json",
      ".agent/lifecycle.json",
      ".agent/tools.json",
      ".agent/validators.json",
      ".agent/project.json"
    ],
    "origin": {
      "path": ".octon-mini-origin.json",
      "ownership": "generated_snapshot_provenance"
    },
    "project_local_sources": [
      {
        "path": ".agent/state/focus.json",
        "minimum_profile": "minimal",
        "ownership": "project_owned_operator_intent_not_permission"
      },
      {
        "path": ".agent/decisions/governance-register.json",
        "minimum_profile": "minimal",
        "ownership": "project_owned_decision_question_and_review_source_not_accepted_authority"
      },
      {
        "path": ".agent/decisions/reuse-policy.json",
        "minimum_profile": "minimal",
        "ownership": "project_owned_reuse_applicability_bound_to_accepted_decisions_not_operation_authority"
      },
      {
        "path": "project-dossier/machine-readable/artifact-registry.json",
        "minimum_profile": "minimal",
        "ownership": "project_owned_authoritative_source"
      }
    ],
    "derived_outputs": [
      {
        "path": ".agent/state/current.json",
        "minimum_profile": "minimal",
        "writer": "refresh",
        "ownership": "fully_derived_operational_view"
      },
      {
        "path": "project-dossier/ARTIFACT_CATALOG.json",
        "minimum_profile": "minimal",
        "writer": "refresh",
        "ownership": "generated_from_artifact_registry"
      },
      {
        "path": "project-dossier/machine-readable/path-authority.json",
        "minimum_profile": "minimal",
        "writer": "refresh",
        "ownership": "generated_from_artifact_registry"
      },
      {
        "path": "project-dossier/MANIFEST.json",
        "minimum_profile": "minimal",
        "writer": "refresh",
        "ownership": "generated_integrity"
      },
      {
        "path": "project-dossier/CHECKSUMS.sha256",
        "minimum_profile": "high-assurance",
        "writer": "refresh",
        "ownership": "generated_integrity"
      },
      {
        "path": ".agent/generated/manifest.json",
        "minimum_profile": "high-assurance",
        "writer": "refresh",
        "ownership": "generated_integrity"
      },
      {
        "path": ".agent/generated/validation-report.json",
        "minimum_profile": "high-assurance",
        "writer": "refresh",
        "ownership": "generated_validation_evidence"
      }
    ],
    "operational_projection": {
      "include_exact": [
        "AGENTS.md",
        ".octon-mini-origin.json"
      ],
      "include_subtrees": [
        ".agent",
        ".agents"
      ]
    }
  },
