{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/source-schemas/profile-manifest.schema.json",
  "title": "Octon Mini Profile and Inventory Manifest",
  "description": "Authoritative profile, generated inventory, project-path, package, and acceptance-coverage source. It grants no project authority.",
  "$defs": {
    "profile_id": {
      "enum": [
        "minimal",
        "standard",
        "high-assurance"
      ]
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile_id"
      }
    },
    "project_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "layers",
        "label",
        "selection_basis",
        "collaboration_independent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/profile_id"
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "core",
              "standard",
              "high-assurance"
            ]
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "selection_basis": {
          "type": "string",
          "minLength": 1
        },
        "collaboration_independent": {
          "const": true
        }
      }
    },
    "owned_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "minimum_profile",
        "ownership"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/project_path"
        },
        "minimum_profile": {
          "$ref": "#/$defs/profile_id"
        },
        "ownership": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "derived_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "minimum_profile",
        "writer",
        "ownership"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/project_path"
        },
        "minimum_profile": {
          "$ref": "#/$defs/profile_id"
        },
        "writer": {
          "const": "refresh"
        },
        "ownership": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "default", "description", "omit_paths", "template_overrides", "registry_combinations"],
      "properties": {
        "id": {"enum": ["compact", "separated"]},
        "default": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1},
        "omit_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/project_path"}},
        "template_overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["output_path", "source"],
            "properties": {
              "output_path": {"$ref": "#/$defs/project_path"},
              "source": {"type": "string", "pattern": "^(?:skill|octon-mini):[A-Za-z0-9._/-]+$"}
            }
          }
        },
        "registry_combinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["retained_representation_id", "absorbed_representation_ids", "artifact_type_ids", "representation_role", "authority", "applicability_rationale", "owner_role", "review_cadence", "update_triggers"],
            "properties": {
              "retained_representation_id": {"type": "string", "pattern": "^REP-[0-9]{4}$"},
              "absorbed_representation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REP-[0-9]{4}$"}},
              "artifact_type_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4}$"}},
              "representation_role": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "minLength": 1},
              "applicability_rationale": {"type": "string", "minLength": 1},
              "owner_role": {"type": "string", "minLength": 1},
              "review_cadence": {"type": "string", "minLength": 1},
              "update_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "sha256",
        "source",
        "inventory_paths",
        "profiles",
        "installation",
        "trigger",
        "permission_grant"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "scm_portfolio",
            "domain_extension",
            "reference_extension",
            "optional_schema",
            "workflow_capability"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "inventory_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "profiles": {
          "$ref": "#/$defs/profiles"
        },
        "installation": {
          "enum": [
            "trigger_installed_transactionally",
            "locally_bundled_activation_transaction"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "permission_grant": {
          "const": false
        }
      }
    },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "release_coverage"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "release_coverage": {
          "enum": [
            "automated_pass",
            "project_demonstration_required",
            "not_exercised"
          ]
        }
      }
    },
    "documentation_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source": {
          "enum": [
            "profiles",
            "acceptance_criteria"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "strip_suffix"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^(?:\\.|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
        },
        "strip_suffix": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\.[A-Za-z0-9._-]+$"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "const": "recursive_suffix"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "suffix": {
                "type": "string",
                "pattern": "^\\.[A-Za-z0-9._-]+$"
              }
            }
          },
          "else": {
            "properties": {
              "suffix": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "source_only"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "profiles": {
                "maxItems": 0
              },
              "inventory_paths": {
                "type": "null"
              },
              "inventory_count": {
                "type": "null"
              },
              "inventory_paths_sha256": {
                "type": "null"
              },
              "output": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "profiles": {
                "minItems": 1
              },
              "inventory_paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                }
              },
              "inventory_count": {
                "type": "integer",
                "minimum": 1
              },
              "inventory_paths_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output": {
                "$ref": "#/$defs/output"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "profile_optional"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "match": {
                "const": "exact"
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "source",
        "match",
        "suffix",
        "disposition",
        "profiles",
        "inventory_paths",
        "inventory_count",
        "inventory_paths_sha256",
        "output",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source": {
          "type": "string",
          "pattern": "^(?:skill|octon-mini):[A-Za-z0-9._/-]+$"
        },
        "match": {
          "enum": [
            "exact",
            "recursive",
            "recursive_suffix"
          ]
        },
        "suffix": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "enum": [
            "source_only",
            "generated",
            "profile_optional"
          ]
        },
        "profiles": {
          "$ref": "#/$defs/profiles"
        },
        "inventory_paths": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          }
        },
        "inventory_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "inventory_paths_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "output": {
          "type": [
            "object",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forbidden_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "match",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "match": {
          "enum": [
            "exact",
            "subtree"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_role",
    "permission_grant",
    "profiles",
    "layouts",
    "project_paths",
    "packages",
    "acceptance_criteria",
    "documentation_projections",
    "default_disposition",
    "inventory_hash_algorithm",
    "rules",
    "forbidden_outputs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "octon-mini.source.profile-manifest.v1"
    },
    "document_role": {
      "const": "authoritative_profile_inventory_acceptance_and_generation_manifest"
    },
    "permission_grant": {
      "const": false
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "layouts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/layout"}
    },
    "project_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_files",
        "origin",
        "project_local_sources",
        "derived_outputs",
        "operational_projection"
      ],
      "properties": {
        "kernel_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/project_path"
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "ownership"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/project_path"
            },
            "ownership": {
              "const": "generated_snapshot_provenance"
            }
          }
        },
        "project_local_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owned_path"
          }
        },
        "derived_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/derived_path"
          }
        },
        "operational_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "include_exact",
            "include_subtrees"
          ],
          "properties": {
            "include_exact": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/project_path"
              }
            },
            "include_subtrees": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/project_path"
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/acceptance_criterion"
      }
    },
    "documentation_projections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/documentation_projection"
      }
    },
    "default_disposition": {
      "const": "source_only"
    },
    "inventory_hash_algorithm": {
      "const": "sha256_sorted_relative_posix_paths_newline_v1"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "forbidden_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/forbidden_output"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
