{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/source-contracts/autonomous-delivery-benchmark-report.schema.json",
  "title": "Autonomous Delivery Benchmark Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "payload_files", "cold_samples", "warm_samples", "threshold_seconds", "measurements", "storage", "result", "limitations"],
  "properties": {
    "schema_version": {"const": "octon-mini.autonomous-delivery-benchmark-report.v1"},
    "subject": {"const": "generated_project_dormant_autonomous_delivery_read_only_surfaces"},
    "payload_files": {"type": "integer", "minimum": 0},
    "cold_samples": {"type": "integer", "minimum": 1},
    "warm_samples": {"type": "integer", "minimum": 1},
    "threshold_seconds": {"type": "number", "exclusiveMinimum": 0},
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "context", "activation_preview", "resume", "explain"],
      "properties": {
        "status": {"$ref": "#/$defs/measurement"},
        "context": {"$ref": "#/$defs/measurement"},
        "activation_preview": {"$ref": "#/$defs/measurement"},
        "resume": {"$ref": "#/$defs/measurement"},
        "explain": {"$ref": "#/$defs/measurement"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_transition_bytes", "projected_100_transition_bytes", "threshold", "informational"],
      "properties": {
        "sample_transition_bytes": {"type": "integer", "minimum": 1},
        "projected_100_transition_bytes": {"type": "integer", "minimum": 100},
        "threshold": {"const": null},
        "informational": {"const": true}
      }
    },
    "result": {"enum": ["pass", "fail"]},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cold_seconds", "warm_seconds", "warm_p90_seconds", "threshold_pass", "failures"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cold_seconds": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "warm_seconds": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "warm_p90_seconds": {"type": "number", "minimum": 0},
        "threshold_pass": {"type": "boolean"},
        "failures": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
