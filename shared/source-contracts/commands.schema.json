{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/source-contracts/commands.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_role", "permission_grant", "capabilities", "commands", "advanced_primitives", "limitations"],
  "properties": {
    "schema_version": {"const": "harness.command-manifest.v2"},
    "document_role": {"const": "authoritative_workflow_interface_and_capability_catalog"},
    "permission_grant": {"const": false},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "purpose", "availability", "command_entry_points", "implementation_entry_points", "default_behavior", "mutation_behavior", "authorization_boundary", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]+(?:[._][a-z]+)*$"},
          "display_name": {"type": "string", "pattern": "^Octon Mini .+", "minLength": 20},
          "purpose": {"type": "string", "minLength": 20},
          "availability": {"$ref": "#/$defs/availability"},
          "command_entry_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^octon [a-z]+(?:-[a-z]+)*(?: [a-z]+(?:-[a-z]+)*)*$"}},
          "implementation_entry_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "default_behavior": {"enum": ["read_only", "mutating", "mixed"]},
          "mutation_behavior": {"type": "string", "minLength": 3},
          "authorization_boundary": {"type": "string", "minLength": 10},
          "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 10}}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "capability_id", "description", "availability", "default_behavior", "mutation_model", "authorization_boundary"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)*$"},
          "capability_id": {"type": "string", "pattern": "^[a-z]+(?:[._][a-z]+)*$"},
          "description": {"type": "string", "minLength": 10},
          "availability": {"$ref": "#/$defs/availability"},
          "default_behavior": {"enum": ["read_only", "mutating", "mixed"]},
          "mutation_model": {"type": "string", "minLength": 1},
          "authorization_boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "advanced_primitives": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "availability": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["bootstrap_source", "generated_project"]}
    }
  }
}
