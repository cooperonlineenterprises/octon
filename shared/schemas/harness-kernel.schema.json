{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/harness-kernel.schema.json",
  "title": "Project Harness Seven-file Governance Kernel",
  "description": "Per-file strict shapes for the versioned domain-neutral kernel. Semantic invariants are additionally checked by the generated validator.",
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "writes"
      ],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "writes": {
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tool_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "effects",
        "authority_class",
        "normal_workflow",
        "safeguards"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_only_observation",
              "local_reference_mutation",
              "working_tree_or_index_mutation",
              "repository_history_mutation",
              "network_access",
              "external_publication",
              "destructive_recovery"
            ]
          }
        },
        "authority_class": {
          "enum": [
            "allowed",
            "task_scoped",
            "explicit_current_authorization",
            "separate_release_authorization",
            "exceptional_current_authorization",
            "destructive_current_authorization",
            "prohibited"
          ]
        },
        "normal_workflow": {
          "type": "boolean"
        },
        "safeguards": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "operation_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "unknown_operations",
        "operations"
      ],
      "properties": {
        "availability": {
          "enum": [
            "required",
            "optional",
            "unavailable"
          ]
        },
        "unknown_operations": {
          "const": "deny"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tool_operation"
          }
        }
      }
    },
    "collaboration_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_ref",
        "supports",
        "observed_at",
        "fresh_until",
        "limitations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "owner_declaration",
            "hosted_access_snapshot",
            "repository_activity_snapshot",
            "concurrency_declaration",
            "contribution_surface_snapshot",
            "project_owned_observation"
          ]
        },
        "source_ref": {
          "type": "string",
          "pattern": "^(?:(?:DEC|EVD)-[0-9]{4}|(?:authority|external|repo):.+)$"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "declared_write_capable_humans",
              "observed_repository_access",
              "active_contributors",
              "independent_review_capacity",
              "expected_concurrent_repository_writers",
              "external_contribution_mode",
              "solo_integration_preference"
            ]
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "fresh_until": {
          "type": "string",
          "format": "date-time"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "collaboration_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "permission_grant",
        "assessment_status",
        "confidence",
        "declared_write_capable_humans",
        "observed_repository_access",
        "active_contributors",
        "independent_review_capacity",
        "expected_concurrent_repository_writers",
        "external_contribution_mode",
        "solo_integration_preference",
        "evidence",
        "assessed_at",
        "reassess_after",
        "conflicting_signals",
        "limitations",
        "team_band",
        "workflow_selection"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.collaboration-profile.v1"
        },
        "permission_grant": {
          "const": false
        },
        "assessment_status": {
          "enum": [
            "not_assessed",
            "assessed"
          ]
        },
        "confidence": {
          "enum": [
            "confirmed",
            "inferred",
            "conflicted",
            "unknown"
          ]
        },
        "declared_write_capable_humans": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed_repository_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "write_capable_humans",
            "read_only_humans",
            "bots_or_automation"
          ],
          "properties": {
            "write_capable_humans": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "read_only_humans": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "bots_or_automation": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        },
        "active_contributors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_count",
            "bots_or_automation_count",
            "window_days"
          ],
          "properties": {
            "human_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "bots_or_automation_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "window_days": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 365
            }
          }
        },
        "independent_review_capacity": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "expected_concurrent_repository_writers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "humans",
            "agents_or_automation"
          ],
          "properties": {
            "humans": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "agents_or_automation": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        },
        "external_contribution_mode": {
          "enum": [
            "closed",
            "invitation_only",
            "open",
            "unknown"
          ]
        },
        "solo_integration_preference": {
          "enum": [
            "direct",
            "reviewable",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/collaboration_evidence"
          }
        },
        "assessed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "reassess_after": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "conflicting_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "declared_vs_observed_write_capable_humans",
              "review_capacity_evidence_conflict",
              "concurrency_evidence_conflict",
              "external_contribution_evidence_conflict"
            ]
          }
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        },
        "team_band": {
          "enum": [
            "unknown",
            "no_write_capable_human",
            "solo",
            "pair",
            "tiny",
            "unsupported_team_size"
          ]
        },
        "workflow_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "base_workflow",
            "modifiers",
            "review_mode",
            "integration_method",
            "adoption_decision_ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_assessed",
                "blocked_unknown",
                "blocked_stale",
                "blocked_conflicted",
                "blocked_no_writer",
                "recommended",
                "adopted",
                "unsupported_team_size"
              ]
            },
            "base_workflow": {
              "enum": [
                null,
                "solo_direct",
                "solo_hybrid",
                "pair_pr",
                "tiny_pr"
              ]
            },
            "modifiers": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 1,
              "items": {
                "const": "concurrent_work"
              }
            },
            "review_mode": {
              "enum": [
                "not_assessed",
                "none",
                "self_review",
                "one_peer_when_available",
                "block_when_peer_unavailable"
              ]
            },
            "integration_method": {
              "enum": [
                null,
                "not_applicable",
                "merge_commit",
                "squash_merge",
                "rebase_then_fast_forward"
              ]
            },
            "adoption_decision_ref": {
              "type": ["string", "null"],
              "pattern": "^DEC-[0-9]{4}$"
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "permission_grant",
        "project_slug",
        "policy_status",
        "default",
        "declarative_only",
        "non_authorization_rule",
        "local",
        "external",
        "autonomous_delivery",
        "sensitive",
        "repository",
        "invariants",
        "project_specific_adoption"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.policy.v1"
        },
        "permission_grant": {
          "const": false
        },
        "project_slug": {
          "type": "string",
          "minLength": 1
        },
        "policy_status": {
          "enum": [
            "generated_unadopted_baseline",
            "adopted",
            "superseded"
          ]
        },
        "default": {
          "const": "deny"
        },
        "declarative_only": {
          "const": true
        },
        "non_authorization_rule": {
          "type": "string",
          "minLength": 1
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_repository",
            "modify_repository",
            "run_declared_validation",
            "start_services"
          ],
          "properties": {
            "read_repository": {
              "type": "string"
            },
            "modify_repository": {
              "type": "string"
            },
            "run_declared_validation": {
              "type": "string"
            },
            "start_services": {
              "type": "string"
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "publication",
            "deployment",
            "communication",
            "purchase"
          ],
          "properties": {
            "network": {
              "type": "string"
            },
            "publication": {
              "const": "requires_explicit_current_authorization"
            },
            "deployment": {
              "const": "requires_explicit_current_authorization"
            },
            "communication": {
              "const": "requires_explicit_current_authorization"
            },
            "purchase": {
              "const": "requires_explicit_current_authorization"
            }
          }
        },
        "autonomous_delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_activation", "write_activation", "external_effects", "unknown_outcome_retries", "direct_external_spending_usd", "credentials"],
          "properties": {
            "pre_activation": {"const": "read_only_no_hooks_no_repository_or_external_mutation"},
            "write_activation": {"const": "independent_exact_digest_human_confirmation_required"},
            "external_effects": {"const": "current_exact_plan_projection_and_live_revalidation_required"},
            "unknown_outcome_retries": {"const": 0},
            "direct_external_spending_usd": {"const": 0},
            "credentials": {"const": "creation_storage_and_forwarding_prohibited"}
          }
        },
        "sensitive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secret_values_in_repository_or_logs",
            "production_data",
            "destructive_operations",
            "legal_or_compliance_determinations"
          ],
          "properties": {
            "secret_values_in_repository_or_logs": {
              "type": "string"
            },
            "production_data": {
              "type": "string"
            },
            "destructive_operations": {
              "type": "string"
            },
            "legal_or_compliance_determinations": {
              "type": "string"
            }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preserve_unrelated_work",
            "writes_outside_declared_workspace",
            "follow_untrusted_symlink",
            "dossier_instruction_channel",
            "plans_create_permission",
            "generated_outputs_create_permission",
            "current_state_requires_direct_evidence"
          ],
          "properties": {
            "preserve_unrelated_work": {
              "const": true
            },
            "writes_outside_declared_workspace": {
              "const": "denied"
            },
            "follow_untrusted_symlink": {
              "const": "denied"
            },
            "dossier_instruction_channel": {
              "const": false
            },
            "plans_create_permission": {
              "const": false
            },
            "generated_outputs_create_permission": {
              "const": false
            },
            "current_state_requires_direct_evidence": {
              "const": true
            }
          }
        },
        "invariants": {
          "$ref": "#/$defs/strings"
        },
        "project_specific_adoption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "requires"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_assessed",
                "in_progress",
                "adopted",
                "superseded"
              ]
            },
            "requires": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "permission_grant",
        "project_slug",
        "context_status",
        "precedence",
        "path_scope",
        "information_states",
        "conflicts",
        "non_instruction_classes"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.context.v1"
        },
        "permission_grant": {
          "const": false
        },
        "project_slug": {
          "type": "string",
          "minLength": 1
        },
        "context_status": {
          "enum": [
            "generated_unadopted_baseline",
            "adopted",
            "superseded"
          ]
        },
        "precedence": {
          "$ref": "#/$defs/strings"
        },
        "path_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discovery",
            "child_may_add_compatible_constraints",
            "child_may_weaken_ancestor",
            "untrusted_symlinks_as_instruction_paths"
          ],
          "properties": {
            "discovery": {
              "const": "root_to_leaf"
            },
            "child_may_add_compatible_constraints": {
              "const": true
            },
            "child_may_weaken_ancestor": {
              "const": false
            },
            "untrusted_symlinks_as_instruction_paths": {
              "const": "prohibited"
            }
          }
        },
        "information_states": {
          "type": "object"
        },
        "conflicts": {
          "type": "object"
        },
        "non_instruction_classes": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kernel_version",
        "compatibility",
        "record_versions",
        "id_patterns",
        "statuses",
        "evolution"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.schema.v1"
        },
        "kernel_version": {
          "const": "4.2.0"
        },
        "compatibility": {
          "type": "object"
        },
        "record_versions": {
          "type": "object"
        },
        "contract_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["continuation", "plan_summary", "transaction_plan", "transaction_receipt", "transaction_bundle", "decision_reuse", "validation_proof", "autonomous_delivery"],
          "properties": {
            "continuation": {"const": "octon-mini.continuation.v1"},
            "plan_summary": {"const": "harness.plan-summary.v1"},
            "transaction_plan": {"const": "harness.transaction-plan.v3"},
            "transaction_receipt": {"const": "harness.transaction-receipt.v3"},
            "transaction_bundle": {"const": "harness.transaction-bundle.v1"},
            "decision_reuse": {"const": "harness.decision-reuse-registry.v1"},
            "validation_proof": {"const": "harness.validation-proof.v1"},
            "autonomous_delivery": {"const": "harness.autonomous-delivery-standing-authorization.v1"}
          }
        },
        "id_patterns": {
          "type": "object"
        },
        "statuses": {
          "type": "object"
        },
        "evolution": {
          "type": "object"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task",
        "decision",
        "artifact"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.lifecycle.v2"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "terminal",
            "transitions",
            "gates"
          ],
          "properties": {
            "initial": {
              "type": "string"
            },
            "terminal": {
              "$ref": "#/$defs/strings"
            },
            "transitions": {
              "type": "object"
            },
            "gates": {
              "type": "object"
            }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "terminal",
            "transitions",
            "immutable_meaning_after",
            "successor_required_for"
          ],
          "properties": {
            "initial": {
              "type": "string"
            },
            "terminal": {
              "$ref": "#/$defs/strings"
            },
            "transitions": {
              "type": "object"
            },
            "immutable_meaning_after": {
              "type": "string"
            },
            "successor_required_for": {
              "$ref": "#/$defs/strings"
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "terminal",
            "transitions"
          ],
          "properties": {
            "initial": {
              "type": "string"
            },
            "terminal": {
              "$ref": "#/$defs/strings"
            },
            "transitions": {
              "type": "object"
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "permission_grant",
        "declarative_only",
        "real_enforcement_boundary",
        "tools",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.tools.v2"
        },
        "permission_grant": {
          "const": false
        },
        "declarative_only": {
          "const": true
        },
        "real_enforcement_boundary": {
          "$ref": "#/$defs/strings"
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystem",
            "shell",
            "git",
            "hosted_change"
          ],
          "properties": {
            "filesystem": {
              "type": "object",
              "additionalProperties": false,
              "required": ["availability", "allowed", "denied"],
              "properties": {
                "availability": {"const": "required"},
                "allowed": {"$ref": "#/$defs/strings"},
                "denied": {"$ref": "#/$defs/strings"}
              }
            },
            "shell": {
              "type": "object",
              "additionalProperties": false,
              "required": ["availability", "allowed", "denied"],
              "properties": {
                "availability": {"const": "required"},
                "allowed": {"$ref": "#/$defs/strings"},
                "denied": {"$ref": "#/$defs/strings"}
              }
            },
            "git": {
              "$ref": "#/$defs/operation_catalog"
            },
            "hosted_change": {
              "$ref": "#/$defs/operation_catalog"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_material_commands",
            "redact_secret_values",
            "tool_availability_implies_permission"
          ],
          "properties": {
            "record_material_commands": {"const": true},
            "redact_secret_values": {"const": true},
            "tool_availability_implies_permission": {"const": false}
          }
        }
      }
    },
    "validators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "validator_version",
        "runtime",
        "commands",
        "required_core_checks",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "enum": ["harness.validators.v4", "harness.validators.v5"]
        },
        "validator_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "minimum_version",
            "dependencies",
            "bytecode_and_cache_writes"
          ],
          "properties": {
            "executable": {"const": "python"},
            "minimum_version": {"const": "3.11"},
            "dependencies": {"const": "standard_library_only"},
            "bytecode_and_cache_writes": {
              "const": "prohibited_for_check"
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bootstrap",
            "check",
            "collaboration_assessment",
            "ready_frontier",
            "test",
            "project_checks",
            "adoption_verify",
            "refresh",
            "closure"
          ],
          "properties": {
            "bootstrap": {
              "$ref": "#/$defs/command"
            },
            "check": {
              "$ref": "#/$defs/command"
            },
            "collaboration_assessment": {
              "$ref": "#/$defs/command"
            },
            "ready_frontier": {
              "$ref": "#/$defs/command"
            },
            "test": {
              "$ref": "#/$defs/command"
            },
            "test_fast": {
              "$ref": "#/$defs/command"
            },
            "test_integration": {
              "$ref": "#/$defs/command"
            },
            "test_release": {
              "$ref": "#/$defs/command"
            },
            "project_checks": {
              "$ref": "#/$defs/command"
            },
            "project_checks_reuse": {
              "$ref": "#/$defs/command"
            },
            "adoption_verify": {
              "$ref": "#/$defs/command"
            },
            "refresh": {
              "$ref": "#/$defs/command"
            },
            "closure": {
              "$ref": "#/$defs/command"
            }
          }
        },
        "required_core_checks": {
          "$ref": "#/$defs/strings"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "collaboration_profile",
        "paths",
        "commands",
        "project_checks",
        "packages",
        "mutable_work_status"
      ],
      "properties": {
        "schema_version": {
          "enum": ["harness.project.v5", "harness.project.v6", "harness.project.v7", "harness.project.v8"]
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "repository_root",
            "profile",
            "octon_mini_version",
            "adoption_status",
            "adoption_decision_ref"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repository_root": {
              "const": "."
            },
            "profile": {
              "enum": [
                "minimal",
                "standard",
                "high-assurance"
              ]
            },
            "octon_mini_version": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
            },
            "adoption_status": {
              "enum": [
                "not_assessed",
                "in_progress",
                "adopted",
                "superseded"
              ]
            },
            "adoption_decision_ref": {
              "type": ["string", "null"],
              "pattern": "^DEC-[0-9]{4}$"
            }
          }
        },
        "collaboration_profile": {"type": "object"},
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "tests",
            "generated",
            "instruction_roots",
            "fingerprint_exclusions"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/strings"
            },
            "tests": {
              "$ref": "#/$defs/strings"
            },
            "generated": {
              "$ref": "#/$defs/strings"
            },
            "instruction_roots": {
              "$ref": "#/$defs/strings"
            },
            "fingerprint_exclusions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "reason"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_test",
            "project_lint",
            "project_build",
            "project_closure"
          ],
          "properties": {
            "project_test": {"$ref": "#/$defs/project_command"},
            "project_lint": {"$ref": "#/$defs/project_command"},
            "project_build": {"$ref": "#/$defs/project_command"},
            "project_closure": {"$ref": "#/$defs/project_command"},
            "work_completion_plan": {"$ref": "#/$defs/project_command"}
          }
        },
        "project_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_schema",
            "evidence_store",
            "evidence_archive",
            "writer_argv",
            "adoption_verification_argv",
            "execution",
            "shell_interpretation"
          ],
          "properties": {
            "evidence_schema": {
              "enum": [
                ".agent/schemas/harness-project-check-evidence.schema.json",
                ".agent/schemas/harness-project-check-evidence-v3.schema.json"
              ]
            },
            "evidence_store": {
              "const": ".agent/project-checks/evidence.json"
            },
            "evidence_archive": {
              "const": ".agent/project-checks/archive"
            },
            "writer_argv": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "adoption_verification_argv": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "execution": {
              "enum": [
                "explicit_writer_only",
                "explicit_writer_only_with_selective_hooks_and_full_adoption_verification"
              ]
            },
            "shell_interpretation": {
              "const": false
            },
            "proof_reuse": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "input_routing",
                "environment_characteristics",
                "external_or_runtime_authorization_cache_hits",
                "expired_proof_cache_hits",
                "adoption_and_release_gate_reuse"
              ],
              "properties": {
                "status": {"const": "enabled_for_explicit_routine_writer_only"},
                "input_routing": {"const": "declared_source_and_test_roots_with_governance_fallback"},
                "environment_characteristics": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "external_or_runtime_authorization_cache_hits": {"const": false},
                "expired_proof_cache_hits": {"const": false},
                "adoption_and_release_gate_reuse": {"const": false}
              }
            }
          }
        },
        "work_completion": {
          "type": "object"
        },
        "autonomous_delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "status",
            "write_capability",
            "external_effects",
            "delivery_profile",
            "adoption_decision_ref",
            "authorization_record_ref",
            "authorization_record_digest",
            "activation_receipt_ref",
            "limitations"
          ],
          "properties": {
            "schema_version": {"const": "harness.autonomous-delivery-config.v1"},
            "status": {"enum": ["available_not_activated", "active", "disabled", "revoked", "expired"]},
            "write_capability": {"enum": ["locked", "authorized_within_exact_standing_contract"]},
            "external_effects": {"enum": ["locked", "authorized_only_through_current_exact_plan_projections"]},
            "delivery_profile": {"type": ["string", "null"], "enum": [null, "review_first", "balanced_autonomous", "fast_delivery", "custom"]},
            "adoption_decision_ref": {"type": ["string", "null"], "pattern": "^DEC-[0-9]{4}$"},
            "authorization_record_ref": {"type": ["string", "null"]},
            "authorization_record_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "activation_receipt_ref": {"type": ["string", "null"]},
            "limitations": {"$ref": "#/$defs/strings"}
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "trigger_assessments",
            "absence_means_not_applicable"
          ],
          "properties": {
            "registry": {
              "const": ".agent/packages.json"
            },
            "trigger_assessments": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operations_observability", "security_supply_chain", "long_running_work"],
              "properties": {
                "operations_observability": {"enum": ["not_assessed", "not_applicable", "applicable"]},
                "security_supply_chain": {"enum": ["not_assessed", "not_applicable", "applicable"]},
                "long_running_work": {"enum": ["not_assessed", "not_applicable", "applicable"]},
                "autonomous_delivery": {"enum": ["not_assessed", "not_applicable", "applicable"]}
              }
            },
            "absence_means_not_applicable": {
              "const": false
            }
          }
        },
        "mutable_work_status": {
          "const": "prohibited_here"
        }
      }
    },
    "project_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner",
        "rationale",
        "tool_name",
        "argv",
        "version_argv",
        "timeout_seconds",
        "evidence_freshness_days",
        "side_effects"
      ],
      "properties": {
        "status": {
          "enum": ["not_assessed", "configured", "not_applicable"]
        },
        "owner": {
          "type": ["string", "null"]
        },
        "rationale": {
          "type": ["string", "null"]
        },
        "tool_name": {
          "type": ["string", "null"]
        },
        "argv": {
          "type": ["array", "null"],
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "version_argv": {
          "type": ["array", "null"],
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "timeout_seconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 86400
        },
        "evidence_freshness_days": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 365
        },
        "side_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "repository_write_paths",
            "external_effects"
          ],
          "properties": {
            "classification": {
              "enum": [
                "not_assessed",
                "read_only",
                "repository_writes",
                "external_effects_possible",
                "not_applicable"
              ]
            },
            "repository_write_paths": {
              "$ref": "#/$defs/strings"
            },
            "external_effects": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      }
    }
  }
}
