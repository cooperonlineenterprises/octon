{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/extensions/security-supply-chain/records.schema.json",
  "title": "Security and Supply-Chain Project Records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "document_role",
    "permission_grant",
    "authority_effect",
    "control_assessments",
    "records",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "harness.security-supply-chain-records.v1"},
    "extension_id": {"const": "security-supply-chain"},
    "document_role": {
      "enum": [
        "unadopted_authoritative_store_candidate",
        "project_maintained_authoritative_store"
      ]
    },
    "permission_grant": {"const": false},
    "authority_effect": {"const": "restrictions_only"},
    "control_assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets_data_and_trust",
        "threat_modeling",
        "security_controls",
        "security_checks",
        "dependency_and_vendor_inventory",
        "sbom_provenance",
        "vulnerability_management",
        "artifact_provenance_signing_and_verification",
        "license_and_rights"
      ],
      "properties": {
        "assets_data_and_trust": {"$ref": "#/$defs/assessment"},
        "threat_modeling": {"$ref": "#/$defs/assessment"},
        "security_controls": {"$ref": "#/$defs/assessment"},
        "security_checks": {"$ref": "#/$defs/assessment"},
        "dependency_and_vendor_inventory": {"$ref": "#/$defs/assessment"},
        "sbom_provenance": {"$ref": "#/$defs/assessment"},
        "vulnerability_management": {"$ref": "#/$defs/assessment"},
        "artifact_provenance_signing_and_verification": {"$ref": "#/$defs/assessment"},
        "license_and_rights": {"$ref": "#/$defs/assessment"}
      }
    },
    "records": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/record"}
    },
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}
    },
    "internal_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:ASSET|DCLASS|TRUST|THREAT|SECCTRL|SECCHECK|DEPEND|VENDOR|SBOM|VULN|APROV|RIGHTS|SECEXC)-[0-9]{4}$"
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "assessed_on", "rationale", "evidence_refs"],
      "properties": {
        "status": {"enum": ["not_assessed", "applicable", "not_applicable"]},
        "owner": {"type": ["string", "null"], "minLength": 1},
        "assessed_on": {"type": ["string", "null"], "format": "date"},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cadence_days", "last_reviewed_on", "next_review_on"],
      "properties": {
        "status": {"enum": ["not_reviewed", "current", "stale", "not_applicable"]},
        "cadence_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "last_reviewed_on": {"type": ["string", "null"], "format": "date"},
        "next_review_on": {"type": ["string", "null"], "format": "date"}
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "asset_type": {"enum": ["code", "service", "data", "model", "content", "infrastructure", "credential_reference", "other"]},
        "criticality": {"enum": ["low", "moderate", "high", "critical"]},
        "data_class_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^DCLASS-[0-9]{4}$"}
        },
        "trust_boundary_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^TRUST-[0-9]{4}$"}
        },
        "custodian_role": {"type": "string", "minLength": 1},
        "classification": {"enum": ["public", "internal", "confidential", "restricted", "personal", "regulated", "production"]},
        "handling_requirements": {"$ref": "#/$defs/strings"},
        "retention": {"type": "string", "minLength": 1},
        "deletion": {"type": "string", "minLength": 1},
        "minimization": {"type": "string", "minLength": 1},
        "rights_basis": {"type": ["string", "null"], "minLength": 1},
        "from_scope": {"type": "string", "minLength": 1},
        "to_scope": {"type": "string", "minLength": 1},
        "allowed_flows": {"$ref": "#/$defs/strings"},
        "authentication_expectation": {"type": "string", "minLength": 1},
        "enforcement_ref": {"type": ["string", "null"], "pattern": "^(?:external|provider|repo):.+$"},
        "asset_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ASSET-[0-9]{4}$"}
        },
        "boundary_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^TRUST-[0-9]{4}$"}
        },
        "scenario": {"type": "string", "minLength": 1},
        "likelihood": {"enum": ["low", "medium", "high"]},
        "impact": {"enum": ["low", "moderate", "high", "critical"]},
        "control_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SECCTRL-[0-9]{4}$"}
        },
        "residual_risk": {"enum": ["low", "medium", "high", "critical"]},
        "control_type": {"enum": ["preventive", "detective", "corrective", "recovery", "governance"]},
        "requirement": {"type": "string", "minLength": 1},
        "implementation_status": {"enum": ["planned", "implemented", "verified", "not_applicable"]},
        "threat_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^THREAT-[0-9]{4}$"}
        },
        "verification_method": {"type": "string", "minLength": 1},
        "qualified_review_required": {"type": "boolean"},
        "check_type": {"enum": ["sast", "sca", "secret_scanning", "dast", "container_scanning", "iac_scanning", "license_scanning", "artifact_signature", "other"]},
        "tool_ref": {"type": ["string", "null"], "pattern": "^(?:external|provider|repo):.+$"},
        "command_ref": {"type": ["string", "null"], "pattern": "^repo:.+$"},
        "execution_owner": {"type": "string", "minLength": 1},
        "check_scope": {"type": "string", "minLength": 1},
        "frequency": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "last_evidence_ref": {"type": ["string", "null"], "pattern": "^EVD-[0-9]{4}$"},
        "version_or_constraint": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "pattern": "^(?:external|provider|repo):.+$"},
        "directness": {"enum": ["direct", "transitive"]},
        "runtime_scope": {"enum": ["build", "development", "test", "runtime", "optional", "content", "data", "model"]},
        "license_id": {"type": ["string", "null"], "minLength": 1},
        "update_policy": {"type": "string", "minLength": 1},
        "vendor_ref": {"type": ["string", "null"], "pattern": "^VENDOR-[0-9]{4}$"},
        "sbom_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SBOM-[0-9]{4}$"}
        },
        "service_scope": {"type": "string", "minLength": 1},
        "data_access": {"$ref": "#/$defs/strings"},
        "exit_plan": {"type": "string", "minLength": 1},
        "contract_or_terms_ref": {"type": ["string", "null"], "pattern": "^(?:external|provider|repo):.+$"},
        "review_status": {"enum": ["pending", "reviewed", "reviewed_with_limitations", "rejected", "not_applicable"]},
        "format": {"enum": ["spdx", "cyclonedx", "other"]},
        "artifact_path": {"type": "string", "pattern": "^repo:.+$"},
        "subject_revision_or_fingerprint": {"type": "string", "minLength": 1},
        "generated_by": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "source_inventory_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^DEPEND-[0-9]{4}$"}
        },
        "provenance_ref": {"type": "string", "pattern": "^(?:EVD-[0-9]{4}|repo:.+)$"},
        "completeness_scope": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "affected_refs": {"$ref": "#/$defs/internal_refs"},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "vulnerability_status": {"enum": ["open", "mitigated", "accepted_exception", "false_positive", "closed"]},
        "discovered_at": {"type": "string", "format": "date-time"},
        "remediation_due": {"type": ["string", "null"], "format": "date"},
        "exception_ref": {"type": ["string", "null"], "pattern": "^SECEXC-[0-9]{4}$"},
        "handling_owner": {"type": "string", "minLength": 1},
        "disclosure_constraints": {"$ref": "#/$defs/strings"},
        "subject": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "provenance_source": {"type": "string", "pattern": "^(?:external|provider|repo):.+$"},
        "build_environment": {"type": "string", "minLength": 1},
        "signing_status": {"enum": ["not_applicable", "planned", "signed", "verified", "failed"]},
        "signer_identity_ref": {"type": ["string", "null"], "pattern": "^(?:external|provider):.+$"},
        "release_ref": {"type": ["string", "null"], "pattern": "^(?:external|repo):.+$"},
        "subject_refs": {"$ref": "#/$defs/internal_refs"},
        "review_scope": {"type": "string", "minLength": 1},
        "license_or_rights": {"type": "string", "minLength": 1},
        "reviewer_qualification": {"type": "string", "minLength": 1},
        "rights_status": {"enum": ["pending", "accepted", "accepted_with_limitations", "rejected", "not_applicable"]},
        "reviewed_on": {"type": ["string", "null"], "format": "date"},
        "next_review_on": {"type": ["string", "null"], "format": "date"},
        "source_refs": {"$ref": "#/$defs/strings"},
        "applies_to_refs": {"$ref": "#/$defs/internal_refs"},
        "reason": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "accepted_by_role": {"type": "string", "minLength": 1},
        "authority_ref": {"type": "string", "pattern": "^(?:DEC-[0-9]{4}|authority:.+)$"},
        "expires_on": {"type": "string", "format": "date"},
        "exception_status": {"enum": ["proposed", "accepted", "expired", "revoked"]},
        "compensating_controls": {"$ref": "#/$defs/strings"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "owner",
        "scope",
        "review",
        "evidence_refs",
        "exception_refs",
        "limitations",
        "details"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:ASSET|DCLASS|TRUST|THREAT|SECCTRL|SECCHECK|DEPEND|VENDOR|SBOM|VULN|APROV|RIGHTS|SECEXC)-[0-9]{4}$"
        },
        "kind": {
          "enum": [
            "asset",
            "data_class",
            "trust_boundary",
            "threat",
            "control",
            "security_check",
            "dependency",
            "vendor",
            "sbom",
            "vulnerability",
            "artifact_provenance",
            "rights_review",
            "exception"
          ]
        },
        "status": {
          "enum": ["proposed", "active", "implemented", "verified", "mitigated", "accepted", "rejected", "closed", "retired", "failed", "not_applicable"]
        },
        "owner": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "review": {"$ref": "#/$defs/review"},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "exception_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SECEXC-[0-9]{4}$"}
        },
        "limitations": {"$ref": "#/$defs/strings"},
        "details": {"$ref": "#/$defs/details"}
      }
    }
  }
}
