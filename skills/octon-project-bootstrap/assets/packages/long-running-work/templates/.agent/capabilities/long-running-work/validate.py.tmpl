#!/usr/bin/env python3
"""Read-only semantic validator for the long-running-work package."""

from __future__ import annotations

import argparse
import importlib.util
import json
import re
import sys
from pathlib import Path
from typing import Any

sys.dont_write_bytecode = True

PAYLOAD_ROOT = Path(__file__).resolve().parent
ROOT = PAYLOAD_ROOT.parents[2]


def load_runtime():
    path = PAYLOAD_ROOT / "long_work.py"
    spec = importlib.util.spec_from_file_location("octon_long_work_validation_runtime", path)
    if spec is None or spec.loader is None:
        raise RuntimeError("long-running-work entrypoint is unavailable")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def check() -> list[str]:
    findings: list[str] = []
    try:
        runtime = load_runtime()
        core_validator = runtime.load_module(
            "octon_long_work_core_validator",
            ROOT / ".agent/scripts/validate.py",
        )
        run_schema = runtime.load_json(PAYLOAD_ROOT / "run.schema.json")
        checkpoint_schema = runtime.load_json(PAYLOAD_ROOT / "checkpoint.schema.json")
    except Exception as error:
        return [f"cannot load long-running-work runtime: {error}"]
    for name in (
        "README.md", "package.json", "run.schema.json", "context.schema.json",
        "checkpoint.schema.json", "long_work.py", "validate.py",
    ):
        path = PAYLOAD_ROOT / name
        if path.is_symlink() or not path.is_file():
            findings.append(f"package payload is absent or unsafe: {name}")
    try:
        package = runtime.load_json(PAYLOAD_ROOT / "package.json")
        if package.get("package_id") != "long-running-work" or package.get("permission_grant") is not False:
            findings.append("package metadata identity or authority boundary is invalid")
    except Exception as error:
        findings.append(str(error))
    state_root = ROOT / ".agent/work-runs"
    if not state_root.exists():
        return findings
    if state_root.is_symlink() or not state_root.is_dir():
        findings.append("work-run state root is unsafe")
        return findings
    allowed_state_children = {"adoption.json", "active.json", "runs"}
    for path in state_root.iterdir():
        if path.name not in allowed_state_children:
            findings.append(f"unregistered work-run state path: {path.name}")
    adoption_path = state_root / "adoption.json"
    if adoption_path.exists() or adoption_path.is_symlink():
        try:
            adoption = runtime.adoption(require_enabled=False)
            if set(adoption) != {
                "schema_version", "status", "permission_grant", "owner",
                "decision_ref", "decision_sha256", "runtime_authorization", "limitations",
            }:
                findings.append("adoption record has an open or incomplete shape")
            if adoption.get("schema_version") != "harness.long-running-work-adoption.v1":
                findings.append("adoption schema version is invalid")
            if adoption.get("status") not in {"enabled", "disabled"}:
                findings.append("adoption status is invalid")
            if adoption.get("permission_grant") is not False or adoption.get("runtime_authorization") is not False:
                findings.append("adoption record attempts to create authority")
            if re.fullmatch(r"DEC-[0-9]{4}", str(adoption.get("decision_ref", ""))) is None:
                findings.append("adoption decision reference is invalid")
        except Exception as error:
            findings.append(str(error))
    active_path = state_root / "active.json"
    runs_root = state_root / "runs"
    active_id = None
    if active_path.exists() or active_path.is_symlink():
        try:
            active = runtime.active_pointer()
            assert active is not None
            active_id = active.get("run_id")
            if runtime.RUN_ID.fullmatch(str(active_id)) is None:
                findings.append("active run pointer has an invalid identity")
        except Exception as error:
            findings.append(str(error))
    run_dirs = []
    if runs_root.exists():
        if runs_root.is_symlink() or not runs_root.is_dir():
            findings.append("work-run runs root is unsafe")
        else:
            for path in sorted(runs_root.glob("LWR-*")):
                if path.is_symlink() or not path.is_dir():
                    findings.append(f"unsafe run directory: {path.name}")
                else:
                    run_dirs.append(path)
    nonterminal: list[str] = []
    for directory in run_dirs:
        run_id = directory.name
        allowed_run_children = {"run.json", "history.jsonl", "checkpoints", "history"}
        for path in directory.iterdir():
            if path.name not in allowed_run_children:
                findings.append(f"{run_id}: unregistered run-state path: {path.name}")
        try:
            run, _ = runtime.load_run(run_id)
        except Exception as error:
            findings.append(f"{run_id}: {error}")
            continue
        required = {
            "schema_version", "run_id", "permission_grant", "task_ref",
            "task_sha256", "task_contract_digest", "authority_source", "path_narrowing",
            "instruction_fingerprint", "project_fingerprint", "status", "phase",
            "limits", "accounting", "context", "last_result",
            "last_committed_checkpoint", "predecessor_run", "created_at", "updated_at",
            "limitations", "canonical_run_digest",
        }
        if set(run) != required:
            findings.append(f"{run_id}: run record has an open or incomplete shape")
        findings.extend(
            f"{run_id}/run.json: {item}"
            for item in core_validator.validate_schema(run, run_schema)
        )
        if run.get("permission_grant") is not False:
            findings.append(f"{run_id}: run attempts to create authority")
        try:
            runtime.validate_limits(run.get("limits"))
            narrowing = run.get("path_narrowing", {})
            for field in ("allowed_paths", "prohibited_paths"):
                values = narrowing.get(field)
                if not isinstance(values, list) or runtime.normalize_project_paths(values) != values:
                    findings.append(f"{run_id}: {field} is not an exact canonical path set")
        except Exception as error:
            findings.append(f"{run_id}: run limits or path narrowing is invalid: {error}")
        phase_by_status = {
            "planned": {"planned"},
            "active": {"context_required", "step_required", "checkpoint_committed"},
            "safely_paused": {"paused"},
            "blocked": {"blocked"},
            "limit_stopped": {"terminal"},
            "cancelled": {"terminal"},
            "completed_with_current_evidence": {"terminal"},
            "failed_known_outcome": {"terminal"},
            "stopped_partial_or_unknown": {"terminal"},
        }
        if run.get("phase") not in phase_by_status.get(run.get("status"), set()):
            findings.append(f"{run_id}: status and phase are inconsistent")
        if run.get("status") not in runtime.TERMINAL:
            nonterminal.append(run_id)
        if run.get("last_committed_checkpoint"):
            try:
                checkpoint, _marker = runtime.committed_checkpoint(
                    run_id, run["last_committed_checkpoint"]
                )
                findings.extend(
                    f"{run_id}/{run['last_committed_checkpoint']}: {item}"
                    for item in core_validator.validate_schema(
                        checkpoint, checkpoint_schema
                    )
                )
            except Exception as error:
                findings.append(f"{run_id}: {error}")
        try:
            history = runtime.read_history(run_id, allow_missing=True)
            if len(history) > 100:
                findings.append(f"{run_id}: current history exceeds the 100-entry retention bound")
        except Exception as error:
            findings.append(f"{run_id}: {error}")
        checkpoint_root = directory / "checkpoints"
        if checkpoint_root.is_dir():
            for content in checkpoint_root.glob("LWC-*.json"):
                if content.name.endswith(".marker.json"):
                    continue
                marker = content.with_name(content.stem + ".marker.json")
                if not marker.exists():
                    findings.append(f"{run_id}: orphan checkpoint content is not resumable: {content.name}")
                else:
                    try:
                        checkpoint_id = content.stem
                        checkpoint, _marker = runtime.committed_checkpoint(run_id, checkpoint_id)
                        findings.extend(
                            f"{run_id}/{checkpoint_id}: {item}"
                            for item in core_validator.validate_schema(
                                checkpoint, checkpoint_schema
                            )
                        )
                    except Exception as error:
                        findings.append(f"{run_id}: invalid committed checkpoint {content.name}: {error}")
            for marker in checkpoint_root.glob("LWC-*.marker.json"):
                content = marker.with_name(marker.name.removesuffix(".marker.json") + ".json")
                if not content.exists():
                    findings.append(f"{run_id}: orphan checkpoint marker is not resumable: {marker.name}")
            for path in checkpoint_root.iterdir():
                if not re.fullmatch(r"LWC-[0-9]{6}(?:\.marker)?\.json", path.name):
                    findings.append(f"{run_id}: unregistered checkpoint path: {path.name}")
        history_root = directory / "history"
        if history_root.exists():
            if history_root.is_symlink() or not history_root.is_dir():
                findings.append(f"{run_id}: history archive root is unsafe")
            else:
                for path in history_root.rglob("*"):
                    if path.is_symlink():
                        findings.append(f"{run_id}: history archive contains a symlink: {path.name}")
                    elif path.is_file() and not re.fullmatch(r"HIS-[0-9]{6}\.jsonl", path.name):
                        findings.append(f"{run_id}: unregistered history archive path: {path.name}")
    if len(nonterminal) > 1:
        findings.append("more than one nonterminal long-running work run exists")
    if active_id is not None and active_id not in {path.name for path in run_dirs}:
        findings.append("active run pointer does not resolve")
    if nonterminal and active_id != nonterminal[0]:
        findings.append("the nonterminal run is not the active run")
    return findings


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate long-running-work package state read-only")
    parser.add_argument("--check", action="store_true", required=True)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    findings = check()
    if args.json:
        print(json.dumps({
            "schema_version": "harness.long-running-work-validation.v1",
            "read_only": True,
            "permission_grant": False,
            "result": "pass" if not findings else "fail",
            "findings": findings,
        }, indent=2, sort_keys=True))
    else:
        for finding in findings:
            print(f"[FAIL] {finding}", file=sys.stderr)
        if not findings:
            print("[PASS] long-running-work package state")
    return 1 if findings else 0


if __name__ == "__main__":
    raise SystemExit(main())
