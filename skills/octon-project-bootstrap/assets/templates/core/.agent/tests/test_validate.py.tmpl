    @FULL_TREE_ONLY
    def test_validation_proof_reuse_hits_only_exact_current_dependencies(self) -> None:
        temporary, test_root = clone()
        try:
            commands = {
                hook: not_applicable_command()
                for hook in VALIDATOR.PROJECT_COMMAND_HOOKS
            }
            commands["project_test"] = configured_python_command()
            adopt_harness(test_root, commands=commands)
            project_path = test_root / ".agent/project.json"
            project = VALIDATOR.load_json(project_path)
            project["project_checks"]["proof_reuse"][
                "environment_characteristics"
            ].append("REVIEW_ENVIRONMENT")
            write_json(project_path, project)
            writer = [
                sys.executable,
                "-I",
                "-B",
                ".agent/scripts/run_project_checks.py",
                "--write-evidence",
                "--hook",
                "project_test",
            ]

            baseline_environment = {**os.environ, "REVIEW_ENVIRONMENT": "alpha"}

            def run_writer(*extra: str, environment: dict[str, str] | None = None):
                return subprocess.run(
                    [*writer, *extra],
                    cwd=test_root,
                    capture_output=True,
                    text=True,
                    check=False,
                    env=baseline_environment if environment is None else environment,
                )

            first = run_writer()
            self.assertEqual(first.returncode, 0, first.stderr or first.stdout)
            evidence_path = test_root / ".agent/project-checks/evidence.json"
            store = VALIDATOR.load_json(evidence_path)
            self.assertTrue(store["proofs"])
            first_proof = store["proofs"][-1]
            self.assertTrue(first_proof["reusable"])

            hit = run_writer("--reuse-proofs")
            self.assertEqual(hit.returncode, 0, hit.stderr or hit.stdout)
            store = VALIDATOR.load_json(evidence_path)
            hit_record = store["records"][-1]
            self.assertEqual(hit_record["proof_reuse"]["hits"], ["project_test"])
            self.assertEqual(hit_record["checks"][0]["execution"], "reused")
            self.assertEqual(hit_record["reused_proof_ids"], [first_proof["proof_id"]])

            store["proofs"][-1]["fresh_until"] = "2099-01-01T00:00:00Z"
            write_json(evidence_path, store)
            tampered_miss = run_writer("--reuse-proofs")
            self.assertEqual(
                tampered_miss.returncode,
                0,
                tampered_miss.stderr or tampered_miss.stdout,
            )
            store = VALIDATOR.load_json(evidence_path)
            self.assertEqual(store["records"][-1]["proof_reuse"]["hits"], [])
            self.assertEqual(store["records"][-1]["checks"][0]["execution"], "executed")

            (test_root / "synthetic-proof-input.txt").write_text("changed input\n", encoding="utf-8")
            input_miss = run_writer("--reuse-proofs")
            self.assertEqual(input_miss.returncode, 0, input_miss.stderr or input_miss.stdout)
            store = VALIDATOR.load_json(evidence_path)
            self.assertEqual(store["records"][-1]["proof_reuse"]["hits"], [])
            self.assertEqual(store["records"][-1]["checks"][0]["execution"], "executed")

            project = VALIDATOR.load_json(project_path)
            project["commands"]["project_test"]["argv"] = [
                sys.executable,
                "-c",
                "print('changed configuration')",
            ]
            write_json(project_path, project)
            config_miss = run_writer("--reuse-proofs")
            self.assertEqual(config_miss.returncode, 0, config_miss.stderr or config_miss.stdout)
            store = VALIDATOR.load_json(evidence_path)
            self.assertEqual(store["records"][-1]["proof_reuse"]["hits"], [])

            changed_environment = dict(baseline_environment)
            changed_environment["CI"] = "synthetic-proof-environment"
            environment_miss = run_writer(
                "--reuse-proofs",
                environment=changed_environment,
            )
            self.assertEqual(
                environment_miss.returncode,
                0,
                environment_miss.stderr or environment_miss.stdout,
            )
            store = VALIDATOR.load_json(evidence_path)
            self.assertEqual(store["records"][-1]["proof_reuse"]["hits"], [])

            custom_environment = dict(baseline_environment)
            custom_environment["REVIEW_ENVIRONMENT"] = "beta"
            custom_environment_miss = run_writer(
                "--reuse-proofs",
                environment=custom_environment,
            )
            self.assertEqual(
                custom_environment_miss.returncode,
                0,
                custom_environment_miss.stderr or custom_environment_miss.stdout,
            )
            store = VALIDATOR.load_json(evidence_path)
            self.assertEqual(store["records"][-1]["proof_reuse"]["hits"], [])
            self.assertEqual(store["records"][-1]["checks"][0]["execution"], "executed")

            for proof in store["proofs"]:
                proof["fresh_until"] = "2000-01-01T00:00:00Z"
                unsigned = dict(proof)
                unsigned.pop("canonical_proof_digest", None)
                proof["canonical_proof_digest"] = hashlib.sha256(
                    json.dumps(
                        unsigned,
                        ensure_ascii=False,
                        allow_nan=False,
                        sort_keys=True,
                        separators=(",", ":"),
                    ).encode("utf-8")
                ).hexdigest()
            write_json(evidence_path, store)
            freshness_miss = run_writer("--reuse-proofs")
            self.assertEqual(
                freshness_miss.returncode,
                0,
                freshness_miss.stderr or freshness_miss.stdout,
            )
            store = VALIDATOR.load_json(evidence_path)
            self.assertEqual(store["records"][-1]["proof_reuse"]["hits"], [])
            self.assertEqual(store["records"][-1]["checks"][0]["execution"], "executed")
        finally:
            temporary.cleanup()

