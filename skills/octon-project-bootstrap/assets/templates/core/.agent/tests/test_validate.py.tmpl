    @FULL_TREE_ONLY
    def test_work_lifecycle_plan_apply_close_resume_and_rollback(self) -> None:
        temporary, test_root = clone()
        try:
            plan = test_root / ".agent/transactions/plans/work-start.json"
            start = subprocess.run(
                octon_command(
                    test_root, "work", "start",
                    "--title", "Synthetic lifecycle task",
                    "--scope", "Exercise the bounded lifecycle writer",
                    "--authority-basis", "authority:synthetic-lifecycle-owner",
                    "--owner", "test_suite", "--operator", "test_suite",
                    "--acceptance", "The explicit acceptance statement is reviewed",
                    "--validation", "Run the structural check",
                    "--next-action", "Perform the synthetic work",
                    "--output", str(plan),
                ),
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertEqual(start.returncode, 0, start.stderr or start.stdout)
            planned = VALIDATOR.load_json(plan)
            started_task_id = Path(
                next(
                    item["path"]
                    for item in planned["operations"]
                    if item["action"] == "create"
                    and item["path"].startswith(".agent/tasks/TASK-")
                )
            ).stem
            apply = subprocess.run(
                octon_command(
                    test_root,
                    "transaction",
                    "apply",
                    "--plan",
                    str(plan),
                    "--accept-digest",
                    planned["canonical_plan_digest"],
                ),
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertEqual(apply.returncode, 0, apply.stderr or apply.stdout)
            task_path = test_root / ".agent/tasks" / f"{started_task_id}.md"
            task = VALIDATOR.parse_json_header(task_path)
            self.assertEqual(task["status"], "in_progress")
            evidence_numbers = []
            evidence_root = test_root / ".agent/evidence"
            if evidence_root.is_dir():
                for candidate in evidence_root.glob("EVD-*.md"):
                    number = candidate.stem.split("-", 2)[1]
                    if len(number) == 4 and number.isdigit():
                        evidence_numbers.append(int(number))
            next_evidence_number = max(evidence_numbers, default=0) + 1
            self.assertLessEqual(next_evidence_number, 9999)
            evidence_id = f"EVD-{next_evidence_number:04d}"
            evidence = {
                "schema_version": "harness.evidence.v1",
                "id": evidence_id,
                "title": "Synthetic lifecycle closure evidence",
                "task": started_task_id,
                "recorded_at": date.today().isoformat(),
                "authority_source": "authority:synthetic-lifecycle-owner",
                "owner": "test_suite",
                "scope": "Synthetic lifecycle task",
                "method": "Generated mutation integration test",
                "environment": "temporary bounded fixture",
                "subject_revision_or_fingerprint": "synthetic-lifecycle-v1",
                "result": "pass",
                "fresh_until": (date.today() + timedelta(days=30)).isoformat(),
                "supersedes": None,
                "limitations": ["Synthetic evidence proves only lifecycle mechanics."],
            }
            evidence_path = (
                test_root / ".agent/evidence" / f"{evidence_id}-lifecycle.md"
            )
            evidence_path.parent.mkdir(exist_ok=True)
            evidence_path.write_text(
                "---\n"
                + json.dumps(evidence, indent=2, sort_keys=True)
                + "\n---\n\n# Synthetic lifecycle evidence\n",
                encoding="utf-8",
            )

            close_plan = test_root / ".agent/transactions/plans/work-close.json"
            close = subprocess.run(
                octon_command(
                    test_root, "work", "close", started_task_id,
                    "--criteria-met",
                    "--implementation-result", "Synthetic work completed",
                    "--review-evidence", evidence_id,
                    "--closure-evidence", evidence_id,
                    "--external-effects", "none",
                    "--next-action", "Select the next task",
                    "--operator", "test_suite",
                    "--output", str(close_plan),
                ),
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertEqual(close.returncode, 0, close.stderr or close.stdout)
            close_value = VALIDATOR.load_json(close_plan)
            close_apply = subprocess.run(
                octon_command(
                    test_root,
                    "transaction",
                    "apply",
                    "--plan",
                    str(close_plan),
                    "--accept-digest",
                    close_value["canonical_plan_digest"],
                ),
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertEqual(close_apply.returncode, 0, close_apply.stderr or close_apply.stdout)
            task = VALIDATOR.parse_json_header(task_path)
            self.assertEqual(task["status"], "completed")
            resume = subprocess.run(
                octon_command(test_root, "work", "resume"),
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertEqual(resume.returncode, 0, resume.stderr or resume.stdout)
            self.assertIsNone(json.loads(resume.stdout)["focus"]["current_task_id"])
            receipt = next(
                line.split(" ", 1)[1]
                for line in close_apply.stdout.splitlines()
                if line.startswith("[RECEIPT]")
            )
            rollback = subprocess.run(
                octon_command(
                    test_root,
                    "transaction",
                    "rollback",
                    "--receipt",
                    receipt,
                ),
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertEqual(rollback.returncode, 0, rollback.stderr or rollback.stdout)
            task = VALIDATOR.parse_json_header(task_path)
            self.assertEqual(task["status"], "in_progress")
        finally:
            temporary.cleanup()

    def test_workflow_interfaces_share_the_authoritative_command_manifest(self) -> None:
        manifest = VALIDATOR.load_json(ROOT / ".agent/commands.json")
        self.assertEqual(manifest["permission_grant"], False)
        names = [item["name"] for item in manifest["commands"]]
        self.assertEqual(len(names), len(set(names)))
        capabilities = manifest["capabilities"]
        capability_ids = {item["id"] for item in capabilities}
        self.assertEqual(len(capability_ids), len(capabilities))
        self.assertTrue(capability_ids)
        vague_names = {
            "Octon Skill",
            "Octon Engine",
            "Octon Manager",
            "Octon Tool",
            "Octon Service",
        }
        for capability in capabilities:
            self.assertIsInstance(capability["display_name"], str)
            self.assertTrue(capability["display_name"].strip())
            self.assertNotIn(capability["display_name"], vague_names)
            self.assertIsInstance(capability["purpose"], str)
            self.assertTrue(capability["purpose"].strip())
            self.assertTrue(capability["availability"])
            self.assertTrue(capability["command_entry_points"])
            self.assertTrue(capability["implementation_entry_points"])
            self.assertIn(
                capability["default_behavior"],
                {"read_only", "mutating", "mixed"},
            )
            self.assertTrue(capability["mutation_behavior"].strip())
            self.assertTrue(capability["authorization_boundary"].strip())
            self.assertTrue(capability["limitations"])
        self.assertTrue(
            all(
                isinstance(item.get("capability_id"), str)
                and item["capability_id"] in capability_ids
                and isinstance(item.get("description"), str)
                and bool(item["description"].strip())
                for item in manifest["commands"]
            )
        )
        expected_local_roots = {
            item["name"].split(".", 1)[0]
            for item in manifest["commands"]
            if "generated_project"
            in (
                {item["availability"]}
                if isinstance(item["availability"], str)
                else set(item["availability"])
            )
        }
        spec = importlib.util.spec_from_file_location(
            "project_octon_command_manifest_test", ROOT / ".agent/scripts/octon.py"
        )
        self.assertIsNotNone(spec)
        self.assertIsNotNone(spec.loader if spec else None)
        module = importlib.util.module_from_spec(spec)
        assert spec is not None and spec.loader is not None
        scripts = str(ROOT / ".agent/scripts")
        sys.path.insert(0, scripts)
        try:
            spec.loader.exec_module(module)
        finally:
            sys.path.remove(scripts)
        parser = module.parser()
        root_actions = next(
            action for action in parser._actions if isinstance(action, argparse._SubParsersAction)
        )
        self.assertEqual(set(root_actions.choices), expected_local_roots)
        self.assertEqual(
            expected_local_roots,
            {"check", "doctor", "work", "delivery", "maintain", "transaction"},
        )
        self.assertNotIn("--force", parser.format_help())

