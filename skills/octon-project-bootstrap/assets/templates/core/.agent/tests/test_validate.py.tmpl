def progressive_collaboration_value(
    writers: int,
    *,
    concurrent_agents: int = 0,
    review_capacity: bool = True,
    solo_preference: str = "direct",
) -> dict[str, object]:
    now = datetime.now(timezone.utc)
    evidence = {
        "source": "authority:synthetic-collaboration-test",
        "observed_at": rfc3339(now - timedelta(minutes=1)),
        "expires_at": rfc3339(now + timedelta(days=30)),
        "limitations": ["synthetic aggregate fact without identities"],
    }
    band = "solo" if writers == 1 else "pair" if writers == 2 else "tiny" if writers <= 5 else "unsupported"
    if band == "solo":
        base = "solo_hybrid" if solo_preference == "reviewable" or concurrent_agents else "solo_direct"
        review = "self_review" if base == "solo_hybrid" else "none"
        integration = "not_applicable" if base == "solo_direct" else None
        used = ["writer_count", "solo_integration_preference"]
    elif band in {"pair", "tiny"}:
        base = "pair_pr" if band == "pair" else "tiny_pr"
        review = "one_peer_when_available" if review_capacity else "block_when_peer_unavailable"
        integration = "squash_merge"
        used = ["writer_count", "independent_review_capacity"]
    else:
        base = None
        review = "not_assessed"
        integration = None
        used = []
    concurrent = concurrent_agents > 0
    if concurrent:
        used.append("concurrency")
    return {
        "schema_version": "harness.collaboration-profile.v2",
        "permission_grant": False,
        "assessment_status": "assessed",
        "facts": {
            "writer_count": {"value": writers, "evidence": evidence},
            "solo_integration_preference": {"value": solo_preference if band == "solo" else None, "evidence": evidence if band == "solo" else None},
            "independent_review_capacity": {"value": review_capacity if band in {"pair", "tiny"} else None, "evidence": evidence if band in {"pair", "tiny"} else None},
            "concurrency": {"human_writers": 1, "agents_or_automation": concurrent_agents, "evidence": evidence if concurrent else None},
            "external_contribution_mode": {"value": None, "evidence": None},
        },
        "conflicting_signals": [],
        "team_band": band,
        "concurrent_work": concurrent,
        "workflow_selection": {
            "status": "proposed" if base else "withheld",
            "base_workflow": base,
            "modifiers": ["concurrent_work"] if concurrent else [],
            "review_mode": review,
            "integration_method": integration,
            "adoption_decision_ref": None,
            "used_fact_ids": sorted(used),
        },
        "limitations": [],
    }


