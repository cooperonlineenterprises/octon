        temporary, test_root = clone()
        try:
            initialized = subprocess.run(
                ["git", "init", "--quiet"],
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            if initialized.returncode:
                self.skipTest("git is unavailable for ignored-file integration")
            (test_root / ".gitignore").write_text(".synthetic-cache/\n", encoding="utf-8")
            cache = test_root / ".synthetic-cache"
            cache.mkdir()
            (cache / "ignored.txt").write_text("ignored\n", encoding="utf-8")
            before = VALIDATOR.snapshot_files(test_root)
            scope = VALIDATOR.git_scope(test_root)
            after = VALIDATOR.snapshot_files(test_root)
            self.assertIs(scope["available"], True)
            self.assertGreaterEqual(scope["ignored"], 1)
            self.assertEqual(before, after)
        finally:
            temporary.cleanup()

