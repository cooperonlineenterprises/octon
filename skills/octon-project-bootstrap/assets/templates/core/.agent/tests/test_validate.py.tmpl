def rfc3339(value: datetime) -> str:
    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def collaboration_value(
    writers: int,
    *,
    solo_preference: str = "direct",
    review_capacity: int | None = None,
    concurrent_humans: int | None = None,
    concurrent_agents: int = 0,
    active_humans: int | None = None,
    include_declared: bool = True,
    include_observed: bool = True,
) -> dict[str, object]:
    now = datetime.now(timezone.utc)
    review_capacity = (
        (1 if writers >= 2 else 0)
        if review_capacity is None
        else review_capacity
    )
    concurrent_humans = (
        (1 if writers > 0 else 0)
        if concurrent_humans is None
        else concurrent_humans
    )
    active_humans = writers if active_humans is None else active_humans
    unsupported = writers > 5
    if unsupported:
        team_band = "unsupported_team_size"
        selection_status = "unsupported_team_size"
        base = None
        modifiers: list[str] = []
        review_mode = "not_assessed"
        integration = None
    elif writers == 0:
        team_band = "no_write_capable_human"
        selection_status = "blocked_no_writer"
        base = None
        modifiers = []
        review_mode = "not_assessed"
        integration = None
    else:
        team_band = "solo" if writers == 1 else "pair" if writers == 2 else "tiny"
        selection_status = "recommended"
        modifiers = (
            ["concurrent_work"]
            if concurrent_humans + concurrent_agents > 1
            else []
        )
        if writers == 1:
            base = (
                "solo_hybrid"
                if solo_preference == "reviewable" or modifiers
                else "solo_direct"
            )
            review_mode = "self_review" if base == "solo_hybrid" else "none"
        else:
            base = "pair_pr" if writers == 2 else "tiny_pr"
            review_mode = (
                "one_peer_when_available"
                if review_capacity >= 1
                else "block_when_peer_unavailable"
            )
        integration = "not_applicable" if base == "solo_direct" else "squash_merge"
    confidence = "confirmed" if include_declared and include_observed else "inferred"
    return {
        "schema_version": "harness.collaboration-profile.v1",
        "permission_grant": False,
        "assessment_status": "assessed",
        "confidence": confidence,
        "declared_write_capable_humans": writers if include_declared else None,
        "observed_repository_access": {
            "write_capable_humans": writers if include_observed else None,
            "read_only_humans": 7 if include_observed else None,
            "bots_or_automation": 11 if include_observed else None,
        },
        "active_contributors": {
            "human_count": active_humans,
            "bots_or_automation_count": 13,
            "window_days": 90,
        },
        "independent_review_capacity": review_capacity,
        "expected_concurrent_repository_writers": {
            "humans": concurrent_humans,
            "agents_or_automation": concurrent_agents,
        },
        "external_contribution_mode": "closed",
        "solo_integration_preference": solo_preference,
        "evidence": [
            {
                "kind": "project_owned_observation",
                "source_ref": "repo:synthetic-collaboration-observation",
                "supports": sorted(VALIDATOR.COLLABORATION_EVIDENCE_SUPPORTS),
                "observed_at": rfc3339(now - timedelta(minutes=2)),
                "fresh_until": rfc3339(now + timedelta(days=30)),
                "limitations": ["synthetic aggregate fixture; contains no identities"],
            }
        ],
        "assessed_at": rfc3339(now - timedelta(minutes=1)),
        "reassess_after": rfc3339(now + timedelta(days=14)),
        "conflicting_signals": [],
        "limitations": [],
        "team_band": team_band,
        "workflow_selection": {
            "status": selection_status,
            "base_workflow": base,
            "modifiers": modifiers,
            "review_mode": review_mode,
            "integration_method": integration,
            "adoption_decision_ref": None,
        },
    }


