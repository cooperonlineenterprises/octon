def adopt_harness(
    test_root: Path,
    *,
    commands: dict[str, dict[str, object]] | None = None,
) -> None:
    decision = VALIDATOR.parse_json_header(
        test_root / ".agent/templates/decision.md"
    )
    decision.update(
        id="DEC-9097",
        status="accepted",
        previous_status="proposed",
        title="Adopt the synthetic project harness",
        authority_source="authority:synthetic-adoption-test",
        owner="test_suite",
        scope="synthetic project-harness adoption",
    )
    decision_path = test_root / ".agent/decisions/DEC-9097-adopt-harness.md"
    decision_path.write_text(
        "---\n"
        + json.dumps(decision, indent=2, sort_keys=True)
