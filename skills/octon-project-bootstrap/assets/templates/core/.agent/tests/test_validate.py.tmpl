    raise RuntimeError(f"cannot load validator: {VALIDATOR_PATH}")
VALIDATOR = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(VALIDATOR)


def snapshot(base: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    for path in sorted(base.rglob("*")):
        if path.is_file():
            result[path.relative_to(base).as_posix()] = hashlib.sha256(
                path.read_bytes()
            ).hexdigest()
    return result


_BOUNDED_BASELINE_TEMPORARY: tempfile.TemporaryDirectory[str] | None = None
_BOUNDED_BASELINE_ROOT: Path | None = None


def bounded_baseline() -> Path:
    """Build one refreshed governed-only baseline independent of project payload."""
    global _BOUNDED_BASELINE_TEMPORARY, _BOUNDED_BASELINE_ROOT
    if _BOUNDED_BASELINE_ROOT is not None:
        return _BOUNDED_BASELINE_ROOT
    temporary = tempfile.TemporaryDirectory(prefix="harness-bounded-baseline-")
    baseline = Path(temporary.name) / "project"
    baseline.mkdir()
    for relative in (
        "AGENTS.md",
        ".octon-origin.json",
        ".agent",
        ".agents",
        "project-dossier",
        "octon",
    ):
        source = ROOT / relative
        if not source.exists() and not source.is_symlink():
            continue
        destination = baseline / relative
        if source.is_dir() and not source.is_symlink():
            shutil.copytree(
                source,
                destination,
                symlinks=True,
                copy_function=shutil.copy,
            )
        else:
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination, follow_symlinks=False)
    refresh = subprocess.run(
        [sys.executable, "-B", ".agent/scripts/refresh.py", "--refresh"],
        cwd=baseline,
        capture_output=True,
        text=True,
        check=False,
    )
    if refresh.returncode:
        temporary.cleanup()
        raise RuntimeError(
            "cannot create bounded mutation baseline: "
            + (refresh.stderr.strip() or refresh.stdout.strip())
        )
    _BOUNDED_BASELINE_TEMPORARY = temporary
    _BOUNDED_BASELINE_ROOT = baseline
    return baseline


def clone() -> tuple[tempfile.TemporaryDirectory[str], Path]:
    temporary = tempfile.TemporaryDirectory(prefix="harness-mutation-")
    test_root = Path(temporary.name) / "project"
    shutil.copytree(
        bounded_baseline(),
        test_root,
        symlinks=True,
        copy_function=shutil.copy,
    )
    return temporary, test_root


def octon_command(root: Path, *arguments: str) -> list[str]:
    command = [str(root / "octon")]
    if os.name == "nt":
        command = [sys.executable, "-B", *command]
    return [*command, *arguments]


