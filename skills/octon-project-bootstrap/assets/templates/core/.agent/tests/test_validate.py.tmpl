def consume_test_tier() -> str:
    if "--tier" not in sys.argv:
        return "release"
    index = sys.argv.index("--tier")
    if index + 1 >= len(sys.argv):
        raise RuntimeError("--tier requires fast, integration, or release")
    tier = sys.argv[index + 1]
    del sys.argv[index : index + 2]
    if tier not in {"fast", "integration", "release"}:
        raise RuntimeError("--tier requires fast, integration, or release")
    return tier


TEST_TIER = consume_test_tier()
FULL_TREE_ONLY = unittest.skipIf(
