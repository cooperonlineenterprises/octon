def main() -> int:
    args = parser().parse_args()
    if args.command == "check":
        validator = load_validator()
        errors = validator.check(ROOT)
        if args.json:
            print(json.dumps({"schema_version": "harness.check-result.v1", "read_only": True, "permission_grant": False, "structural_conformance": "pass" if not errors else "fail", "findings": errors, "harness_adoption": "not_inferred", "target_project_readiness": "not_inferred"}, indent=2, sort_keys=True))
        else:
            for error in errors:
                print(f"[FAIL] {error}", file=sys.stderr)
            if not errors:
                print("[PASS] structural conformance")
                print("[INFO] harness adoption and target-project readiness remain separate")
        return 1 if errors else 0
    if args.command == "doctor":
        if args.repair_derived:
            if not args.accept_digest:
                raise WorkflowError("derived repair requires --accept-digest")
            return octon_doctor.repair_derived(args.accept_digest)
        report = octon_doctor.build_report()
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True, allow_nan=False))
        elif not report["findings"]:
            print("[PASS] no structural continuation finding")
        else:
            print("\n\n".join(continuation.render_finding(item) for item in report["findings"]))
        return 0
    if args.command == "work":
        if args.work_action == "run":
            return dispatch_long_running_work(args.run_args)
        if args.work_action == "finish":
            if args.finish_action == "plan":
                plan = octon_work_completion.build_plan(ROOT, args.task_id)
                if args.details_json:
                    print(json.dumps(plan, indent=2, sort_keys=True, allow_nan=False))
                else:
                    summary = continuation.plan_summary(plan)
                    print(
                        json.dumps(summary, indent=2, sort_keys=True, allow_nan=False)
                        if args.json
                        else continuation.render_plan_summary(summary)
                    )
                return 0
            if args.finish_action == "apply":
                receipt = octon_work_completion.apply(
                    ROOT,
                    args.accept_digest,
                    project_path(args.authorization_file),
                    args.task_id,
                )
            else:
                receipt = octon_work_completion.resume(
                    ROOT,
                    args.receipt_id,
                    project_path(args.authorization_file) if args.authorization_file else None,
                )
            print(json.dumps(receipt, indent=2, sort_keys=True))
            return 0
        if args.work_action == "resume":
            return resume()
        if args.apply_plan:
            if not args.accept_digest:
                raise WorkflowError("apply requires --accept-digest")
            return apply_workflow_plan(args, "work.")
        if args.work_action == "start":
            plan = work_start_plan(args)
        elif args.work_action in {"block", "close", "reopen"}:
            plan = task_update_plan(args)
        elif args.work_action == "handoff":
            plan = handoff_plan(args)
        else:
            raise WorkflowError("unsupported work action")
        write_plan(plan, args.output, json_output=getattr(args, "json", False))
        return 0
    if args.command == "delivery":
        return dispatch_autonomous_delivery(args.delivery_args)
    if args.command == "maintain":
        if args.maintain_action == "refresh":
            return subprocess.run([sys.executable, "-B", ".agent/scripts/refresh.py", "--refresh"], cwd=ROOT, check=False, shell=False).returncode
        if args.maintain_action == "registry":
            if args.registry_action == "plan":
                value = registry_exact_plan(project_path(args.review_file)) if args.review_file else registry_discovery()
                if args.review_file:
                    write_plan(value, args.output, json_output=args.json)
                else:
                    print(json.dumps(value, indent=2, sort_keys=True))
                return 0
            namespace = argparse.Namespace(apply_plan=args.plan, accept_digest=args.accept_digest)
            return apply_workflow_plan(namespace, "maintain.registry")
        if args.maintain_action == "hooks":
            if args.hooks_action == "plan":
                write_plan(hooks_plan(project_path(args.config)), args.output, json_output=args.json)
                return 0
            namespace = argparse.Namespace(apply_plan=args.plan, accept_digest=args.accept_digest)
            return apply_workflow_plan(namespace, "maintain.hooks")
        if args.maintain_action == "collaboration":
            if args.collaboration_action == "plan":
                write_plan(collaboration_plan(project_path(args.config)), args.output, json_output=args.json)
                return 0
            namespace = argparse.Namespace(apply_plan=args.plan, accept_digest=args.accept_digest)
            return apply_workflow_plan(namespace, "maintain.collaboration")
    if args.command == "transaction":
        if args.transaction_action == "bundle":
            members = []
            for raw in args.member:
                if "=" not in raw:
                    raise WorkflowError("bundle --member must use stable-id=plan-path")
                identifier, raw_path = raw.split("=", 1)
                members.append((identifier, transaction.load_plan(project_path(raw_path))))
            plan = transaction.build_bundle_plan(
                ROOT,
                members,
                authority_sources=args.authority_source,
            )
            write_plan(plan, args.output, json_output=args.json)
            return 0
        if args.transaction_action == "apply":
            namespace = argparse.Namespace(apply_plan=args.plan, accept_digest=args.accept_digest)
            return apply_workflow_plan(namespace, "")
        if args.transaction_action == "rollback":
            receipt = transaction.rollback(ROOT, project_path(args.receipt))
            print(f"[ROLLED BACK] {receipt['receipt_id']}")
            return 0
        if args.transaction_action == "recover":
            pending = transaction.recover_pending(ROOT, project_path(args.pending))
            outcome = "FINALIZED" if pending.get("artifact_kind") == "transaction_receipt" else "RECOVERED"
            print(f"[{outcome}] {pending['receipt_id']}")
            return 0
    raise WorkflowError("unsupported command")


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (WorkflowError, octon_work_completion.FinishError, transaction.TransactionError) as error:
        report = getattr(error, "report", None)
        if not isinstance(report, dict):
            report = continuation.fallback(
                error,
                blocked_operation="generated_project.workflow",
                phase="apply" if "apply" in sys.argv else "plan",
                next_argv=["./octon", "doctor", "--json"],
            )
        print(
            continuation.render_finding(report, json_output="--json" in sys.argv),
            file=sys.stderr,
        )
        raise SystemExit(2)
