#!/usr/bin/env python3
"""Workflow-oriented Octon interface for a generated snapshot."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import re
import stat
import subprocess
import sys
from datetime import date, datetime, timezone
from pathlib import Path, PurePosixPath
from typing import Any

sys.dont_write_bytecode = True

import octon_doctor
import octon_continuation as continuation
import octon_work_completion
import octon_transaction as transaction


ROOT = Path(__file__).resolve().parents[2]
TASK_ID = re.compile(r"^TASK-([0-9]{4})$")
PLAN_ID = re.compile(r"^PLAN-([0-9]{4})$")
ACTIVE_TASK_STATUSES = {"ready", "in_progress", "validating", "review", "blocked", "reopened"}


class WorkflowError(ValueError):
    """A safe workflow could not proceed from the current explicit inputs."""

    def __init__(self, value: str | dict[str, Any]):
        report = value if isinstance(value, dict) else continuation.finding(
            failure_code="OCTON-WORKFLOW-1001",
            blocked_operation="generated_project.workflow",
            phase="plan",
            root_cause=str(value),
            authority_source="project_owned_workflow_configuration_and_current_state",
            repair_class="manual_reconciliation_required",
            next_action=continuation.action(
                "Inspect current coded diagnostics and the exact workflow command inventory.",
                ["./octon", "doctor", "--json"],
                read_only=True,
            ),
            safe_read_only_actions=[
                continuation.action(
                    "Inspect supported generated-project commands.",
                    ["./octon", "--help"],
                    read_only=True,
                )
            ],
        )
        self.report = report
        super().__init__(str(report.get("root_cause", "workflow blocked")))


class ContinuationParser(argparse.ArgumentParser):
    """Render parser refusals through the same non-authorizing continuation contract."""

    def error(self, message: str) -> None:
        report = continuation.finding(
            failure_code="OCTON-CMD-1001",
            blocked_operation="generated_project.dispatch",
            phase="inspect",
            root_cause=message,
            authority_source=".agent/commands.json",
            repair_class="input_required",
            next_action=continuation.action(
                "Inspect the supported generated-project command inventory.",
                ["./octon", "--help"],
                read_only=True,
            ),
        )
        self.exit(
            2,
            continuation.render_finding(
                report, json_output="--json" in sys.argv
            )
            + "\n",
        )


def strict_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise ValueError(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def reject_json_constant(value: str) -> None:
    raise ValueError(f"invalid JSON constant: {value}")


def load_json(path: Path) -> Any:
    try:
        return json.loads(
            path.read_text(encoding="utf-8"),
            object_pairs_hook=strict_pairs,
            parse_constant=reject_json_constant,
        )
    except (OSError, json.JSONDecodeError, ValueError) as error:
        raise WorkflowError(f"cannot load {path.relative_to(ROOT)}: {error}") from error


def json_bytes(value: object) -> bytes:
    return (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n").encode("utf-8")


def project_path(value: str | Path) -> Path:
    path = Path(value)
    return path if path.is_absolute() else ROOT / path


def write_plan(plan: dict[str, Any], output: str | None, *, json_output: bool = False) -> None:
    if output is None:
        summary = continuation.plan_summary(plan)
        print(
            json.dumps(summary, indent=2, sort_keys=True, allow_nan=False)
            if json_output
            else continuation.render_plan_summary(summary)
        )
        return
    path = Path(output)
    if not path.is_absolute():
        path = ROOT / path
    transaction.write_new_json(path, plan)
    summary = continuation.plan_summary(plan)
    print(
        json.dumps(summary, indent=2, sort_keys=True, allow_nan=False)
        if json_output
        else f"[PLAN] {path}\n{continuation.render_plan_summary(summary)}"
    )


def transaction_validation() -> dict[str, Any]:
    """Declare the only staged writes and keep post-apply validation read-only."""
    validators = load_json(ROOT / ".agent/validators.json")
    writes = validators.get("commands", {}).get("refresh", {}).get("writes", [])
    if not isinstance(writes, list) or any(not isinstance(item, str) for item in writes):
        raise WorkflowError("refresh writer paths are not a closed path array")
    return {
        "staged_validation_plan": [
            [sys.executable, "-B", ".agent/scripts/refresh.py", "--refresh"],
            [sys.executable, "-B", ".agent/scripts/validate.py", "--check"],
        ],
        "derived_write_paths": writes,
        "post_apply_validation_plan": [
            [sys.executable, "-B", ".agent/scripts/validate.py", "--check"]
        ],
    }


def dispatch_long_running_work(arguments: list[str]) -> int:
    """Launch the pinned optional capability in one fresh shell-free process."""
    registry = load_json(ROOT / ".agent/packages.json")
    matches = [
        item
        for item in registry.get("packages", [])
        if isinstance(item, dict) and item.get("id") == "long-running-work"
    ] if isinstance(registry, dict) else []
    if len(matches) != 1 or matches[0].get("kind") != "workflow_capability":
        raise WorkflowError(
            continuation.finding(
                failure_code="OCTON-LRW-1000",
                blocked_operation="work.long-running.dispatch",
                phase="inspect",
                root_cause="the optional long-running-work package is not installed",
                authority_source=".agent/packages.json",
                repair_class="project_decision_required",
                next_action=continuation.action(
                    "Inspect current package applicability and structural findings.",
                    ["./octon", "check", "--json"],
                    read_only=True,
                ),
                safe_read_only_actions=[
                    continuation.action(
                        "Inspect installed package state.",
                        ["./octon", "check", "--json"],
                        read_only=True,
                    )
                ],
            )
        )
    package = matches[0]
    installed_paths = package.get("installed_paths", [])
    if not isinstance(installed_paths, list) or any(not isinstance(item, str) for item in installed_paths):
        raise WorkflowError("long-running-work installed inventory is malformed")
    digest = hashlib.sha256()
    for relative in sorted(installed_paths):
        pure = PurePosixPath(relative)
        if (
            pure.is_absolute()
            or any(part in {"", ".", ".."} for part in pure.parts)
            or pure.as_posix() != relative
        ):
            raise WorkflowError(f"long-running-work installed path is unsafe: {relative}")
        candidate = ROOT.joinpath(*pure.parts)
        current = ROOT
        for part in pure.parts[:-1]:
            current = current / part
            if current.is_symlink():
                raise WorkflowError(
                    f"long-running-work installed path has a symlink ancestor: {relative}"
                )
        try:
            candidate.parent.resolve(strict=True).relative_to(ROOT.resolve())
        except (OSError, ValueError) as error:
            raise WorkflowError(
                f"long-running-work installed path escapes the project: {relative}"
            ) from error
        if candidate.is_symlink() or not candidate.is_file():
            raise WorkflowError(f"long-running-work installed path is absent or unsafe: {relative}")
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(candidate.read_bytes())
        digest.update(b"\0")
    if digest.hexdigest() != package.get("installed_paths_sha256"):
        raise WorkflowError("long-running-work installed payload digest is stale")
    entry_relative = ".agent/capabilities/long-running-work/long_work.py"
    if entry_relative not in installed_paths:
        raise WorkflowError("long-running-work entrypoint is outside its installed inventory")
    environment = {
        key: os.environ[key]
        for key in ("PATH", "SYSTEMROOT", "WINDIR", "TEMP", "TMP", "TMPDIR")
        if key in os.environ
    }
    environment.update({
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    })
    return subprocess.run(
        [sys.executable, "-I", "-B", entry_relative, *arguments],
        cwd=ROOT,
        env=environment,
        check=False,
        shell=False,
    ).returncode


def dispatch_autonomous_delivery(arguments: list[str]) -> int:
    """Launch the always-present dormant delivery surface in a fresh process."""
    entry_relative = ".agent/scripts/octon_autonomous_delivery.py"
    entry = ROOT / entry_relative
    if not entry.is_file() or entry.is_symlink():
        raise WorkflowError("autonomous-delivery dormant surface is absent or unsafe")
    environment = {
        key: os.environ[key]
        for key in ("PATH", "HOME", "USERPROFILE", "SYSTEMROOT", "WINDIR", "TEMP", "TMP", "TMPDIR")
        if key in os.environ
    }
    environment.update({
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    })
    return subprocess.run(
        [sys.executable, "-I", "-B", entry_relative, "--target", str(ROOT), *arguments],
        cwd=ROOT,
        env=environment,
        check=False,
        shell=False,
    ).returncode


def load_validator():
    path = ROOT / ".agent/scripts/validate.py"
    spec = importlib.util.spec_from_file_location("octon_runtime_validator", path)
    if spec is None or spec.loader is None:
        raise WorkflowError("project validator is unavailable")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def task_path(task_id: str) -> Path:
    if TASK_ID.fullmatch(task_id) is None:
        raise WorkflowError(f"invalid task ID: {task_id!r}")
    return ROOT / ".agent/tasks" / f"{task_id}.md"


def parse_record(path: Path) -> tuple[dict[str, Any], str]:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise WorkflowError(f"cannot read {path.relative_to(ROOT)}: {error}") from error
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise WorkflowError(f"{path.relative_to(ROOT)} lacks JSON front matter")
    try:
        end = next(index for index, line in enumerate(lines[1:], start=1) if line.strip() == "---")
        record = json.loads("".join(lines[1:end]))
    except (StopIteration, json.JSONDecodeError) as error:
        raise WorkflowError(f"invalid record front matter in {path.relative_to(ROOT)}") from error
    if not isinstance(record, dict):
        raise WorkflowError(f"record front matter must be an object: {path.relative_to(ROOT)}")
    return record, "".join(lines[end + 1 :])


def render_record(record: dict[str, Any], body: str) -> bytes:
    return (
        "---\n"
        + json.dumps(record, indent=2, sort_keys=True, allow_nan=False)
        + "\n---\n"
        + body.lstrip("\n")
    ).encode("utf-8")


def task_body(record: dict[str, Any]) -> str:
    criteria = "\n".join(f"- [ ] {item}" for item in record["acceptance_criteria"])
    validation = "\n".join(f"- {item}" for item in record["validation_plan"])
    return (
        f"\n## Scope\n\n{record['scope']}\n\n"
        f"## Acceptance criteria\n\n{criteria}\n\n"
        f"## Validation plan\n\n{validation}\n\n"
        "## Evidence and closure\n\n"
        "Mechanical lifecycle fields are maintained by `./octon work`; substantive claims remain explicit inputs.\n"
    )


def next_identifier(directory: Path, pattern: re.Pattern[str], prefix: str) -> str:
    values = []
    if directory.is_dir():
        for path in directory.iterdir():
            match = pattern.fullmatch(path.stem)
            if match:
                values.append(int(match.group(1)))
    candidate = max(values, default=0) + 1
    if candidate > 9999:
        raise WorkflowError(f"{prefix} ID space is exhausted")
    return f"{prefix}-{candidate:04d}"


def focus_operation(
    *,
    current_task_id: str | None,
    next_action: str | None,
    handoff_summary: str | None,
    updated_by: str | None,
) -> dict[str, Any]:
    path = ROOT / ".agent/state/focus.json"
    focus = load_json(path)
    if not isinstance(focus, dict):
        raise WorkflowError("focus source must be an object")
    focus.update(
        current_task_id=current_task_id,
        next_action=next_action,
        handoff_summary=handoff_summary,
        updated_at=datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        updated_by=updated_by,
    )
    return transaction.operation(
        "replace",
        ".agent/state/focus.json",
        json_bytes(focus),
        "Update explicit operator focus; this does not grant execution authority.",
    )


def plan_store_update(
    task: dict[str, Any],
    *,
    existing_plan_id: str | None = None,
) -> tuple[dict[str, Any] | None, str | None]:
    path = ROOT / "project-dossier/machine-readable/plan.json"
    if not path.is_file():
        return None, None
    store = load_json(path)
    if not isinstance(store, dict) or not isinstance(store.get("plan_items"), list):
        raise WorkflowError("project plan store is malformed")
    plan_id = existing_plan_id or next_identifier(path.parent, PLAN_ID, "PLAN")
    if existing_plan_id is None:
        used = {
            item.get("id")
            for item in store["plan_items"]
            if isinstance(item, dict)
        }
        number = 1
        while f"PLAN-{number:04d}" in used:
            number += 1
        plan_id = f"PLAN-{number:04d}"
        store["plan_items"].append(
            {
                "id": plan_id,
                "title": task["title"],
                "objective": task["scope"],
                "status": "in_progress",
                "owner_role": task["owner"],
                "depends_on": [],
                "task_refs": [task["id"]],
                "requirement_refs": [],
                "finding_refs": [],
                "gate_refs": task["gate_refs"],
                "blocking_refs": task["blocking_refs"],
                "acceptance_criteria": task["acceptance_criteria"],
                "evidence_expected": task["validation_plan"],
                "evidence_refs": [],
                "blocked_by": task["blocked_by"],
                "limitations": ["Substantive plan priority remains project-owned."],
            }
        )
    else:
        item = next(
            (value for value in store["plan_items"] if isinstance(value, dict) and value.get("id") == plan_id),
            None,
        )
        if item is None:
            raise WorkflowError(f"reciprocal plan item is absent: {plan_id}")
        status_map = {
            "blocked": "blocked",
            "completed": "completed",
            "ready": "planned",
            "in_progress": "in_progress",
            "reopened": "planned",
        }
        item["status"] = status_map.get(task["status"], item["status"])
        item["blocked_by"] = task["blocked_by"]
        item["evidence_refs"] = sorted(set(item.get("evidence_refs", [])) | set(task["closure_evidence"]))
    return transaction.operation(
        "replace",
        "project-dossier/machine-readable/plan.json",
        json_bytes(store),
        "Maintain the reciprocal task/plan link and mechanical lifecycle projection.",
    ), plan_id


def work_start_plan(args: argparse.Namespace) -> dict[str, Any]:
    task_id = next_identifier(ROOT / ".agent/tasks", TASK_ID, "TASK")
    today = date.today().isoformat()
    task = {
        "schema_version": "harness.task.v2",
        "id": task_id,
        "status": "in_progress",
        "previous_status": "ready",
        "title": args.title,
        "authority_basis": args.authority_basis,
        "owner": args.owner,
        "created_at": today,
        "updated_at": today,
        "dependencies": sorted(set(args.depends_on)),
        "plan_item_refs": [],
        "gate_refs": sorted(set(args.gate_ref)),
        "blocking_refs": sorted(set(args.blocking_ref)),
        "scope": args.scope,
        "acceptance_criteria": args.acceptance,
        "validation_plan": args.validation,
        "implementation_result": None,
        "review_evidence": [],
        "blocked_by": [],
        "reopened_by": None,
        "acceptance_criteria_met": False,
        "closure_evidence": [],
        "external_effects": "not_assessed",
        "limitations": [],
    }
    plan_store_operation, plan_id = plan_store_update(task)
    if plan_id is not None:
        task["plan_item_refs"] = [plan_id]
        plan_store_operation, _ = plan_store_update(task)
    relative = f".agent/tasks/{task_id}.md"
    operations = [
        transaction.operation(
            "create",
            relative,
            render_record(task, task_body(task)),
            "Create a task from explicitly supplied semantics and allocate its stable ID.",
        ),
        focus_operation(
            current_task_id=task_id,
            next_action=args.next_action,
            handoff_summary=None,
            updated_by=args.operator,
        ),
    ]
    if plan_store_operation is not None:
        operations.append(plan_store_operation)
    return transaction.build_plan(
        ROOT,
        operation_name="work.start",
        scope=f"Start {task_id}: {args.title}",
        operations=operations,
        evidence=[
            transaction.source_evidence(
                "explicit_operator_input",
                args.authority_basis,
                limitations=["The reference is recorded but not elevated or re-authorized by this plan."],
            )
        ],
        assumptions=[],
        confidence="deterministic",
        limitations=[
            "Purpose, scope, acceptance criteria, validation, owner, and authority basis are explicit inputs.",
            "Starting repository-local work does not authorize external effects.",
        ],
        **transaction_validation(),
    )


def load_task(task_id: str) -> tuple[Path, dict[str, Any], str]:
    path = task_path(task_id)
    record, body = parse_record(path)
    if record.get("id") != task_id or record.get("schema_version") != "harness.task.v2":
        raise WorkflowError(f"{task_id} is not a canonical task record")
    return path, record, body


def task_update_plan(args: argparse.Namespace) -> dict[str, Any]:
    path, task, body = load_task(args.task_id)
    current = task.get("status")
    operation_name = f"work.{args.work_action}"
    evidence: list[dict[str, Any]] = []
    if args.work_action == "block":
        if current not in {"ready", "in_progress", "validating", "review"}:
            raise WorkflowError(f"cannot block {args.task_id} from {current}")
        task.update(
            previous_status=current,
            status="blocked",
            blocked_by=args.reason,
            updated_at=date.today().isoformat(),
        )
    elif args.work_action == "close":
        if current not in {"ready", "in_progress", "validating", "review", "reopened"}:
            raise WorkflowError(f"cannot close {args.task_id} from {current}")
        if not args.criteria_met:
            raise WorkflowError("close requires the explicit --criteria-met acknowledgment")
        task.update(
            previous_status=current,
            status="completed",
            implementation_result=args.implementation_result,
            review_evidence=args.review_evidence,
            acceptance_criteria_met=True,
            closure_evidence=args.closure_evidence,
            external_effects=args.external_effects,
            limitations=args.limitation,
            blocked_by=[],
            updated_at=date.today().isoformat(),
        )
        finish_values = [
            args.finish_path,
            args.finish_commit_message,
            args.finish_pr_title,
            args.finish_pr_body,
            args.finish_self_review_ref,
            args.finish_shared_base_revision,
            args.finish_write_scope,
            args.finish_worktree_owner,
            args.finish_handback_complete,
            args.finish_partial_results_resolved,
            args.finish_coordination_evidence_ref,
        ]
        if any(finish_values):
            if not args.finish_path or not args.finish_commit_message:
                raise WorkflowError(
                    "work-completion preparation requires --finish-path and --finish-commit-message"
                )
            task["work_completion"] = {
                "eligible_staging_paths": sorted(set(args.finish_path)),
                "commit_message": args.finish_commit_message,
                "pull_request_title": args.finish_pr_title,
                "pull_request_body": args.finish_pr_body,
                "self_review_refs": sorted(set(args.finish_self_review_ref)),
                "concurrent_work": {
                    "shared_base_revision": args.finish_shared_base_revision,
                    "declared_write_scope": sorted(set(args.finish_write_scope)),
                    "worktree_owner": args.finish_worktree_owner,
                    "handback_state": "complete" if args.finish_handback_complete else "not_assessed",
                    "partial_result_state": "resolved" if args.finish_partial_results_resolved else "not_assessed",
                    "coordination_evidence_refs": sorted(
                        set(args.finish_coordination_evidence_ref)
                    ),
                },
            }
        evidence.append(
            transaction.source_evidence(
                "explicit_closure_claim",
                ",".join(args.closure_evidence + args.review_evidence),
                limitations=["The writer records supplied references and does not prove their substantive sufficiency."],
            )
        )
    elif args.work_action == "reopen":
        if current not in {"completed", "blocked"}:
            raise WorkflowError(f"cannot reopen {args.task_id} from {current}")
        if current == "completed":
            task.update(
                previous_status="completed",
                status="reopened",
                reopened_by=args.evidence_ref,
                acceptance_criteria_met=False,
                updated_at=date.today().isoformat(),
            )
            task.pop("work_completion", None)
        else:
            task.update(
                previous_status="blocked",
                status="in_progress",
                reopened_by=args.evidence_ref,
                blocked_by=[],
                updated_at=date.today().isoformat(),
            )
        evidence.append(
            transaction.source_evidence("explicit_invalidating_evidence", args.evidence_ref)
        )
    else:
        raise WorkflowError(f"unsupported work action: {args.work_action}")
    operations = [
        transaction.operation(
            "replace",
            path.relative_to(ROOT).as_posix(),
            render_record(task, body),
            f"Apply the legal mechanical {args.work_action} lifecycle transition.",
        )
    ]
    plan_op = None
    if task.get("plan_item_refs"):
        plan_op, _ = plan_store_update(task, existing_plan_id=task["plan_item_refs"][0])
    if plan_op is not None:
        operations.append(plan_op)
    focus = load_json(ROOT / ".agent/state/focus.json")
    current_focus = focus.get("current_task_id") if isinstance(focus, dict) else None
    if args.work_action == "close" and current_focus == args.task_id:
        operations.append(
            focus_operation(
                current_task_id=None,
                next_action=args.next_action,
                handoff_summary=None,
                updated_by=args.operator,
            )
        )
    elif args.work_action == "reopen":
        operations.append(
            focus_operation(
                current_task_id=args.task_id,
                next_action=args.next_action,
                handoff_summary=None,
                updated_by=args.operator,
            )
        )
    return transaction.build_plan(
        ROOT,
        operation_name=operation_name,
        scope=f"{args.work_action} {args.task_id}",
        operations=operations,
        evidence=evidence,
        assumptions=[],
        confidence="deterministic",
        limitations=["The lifecycle writer records explicit claims; it does not invent authority, review, or evidence."],
        **transaction_validation(),
    )


def handoff_plan(args: argparse.Namespace) -> dict[str, Any]:
    if args.task_id is not None:
        _, task, _ = load_task(args.task_id)
        if task.get("status") not in ACTIVE_TASK_STATUSES:
            raise WorkflowError("handoff task must be active")
    return transaction.build_plan(
        ROOT,
        operation_name="work.handoff",
        scope="Update explicit handoff pointers",
        operations=[
            focus_operation(
                current_task_id=args.task_id,
                next_action=args.next_action,
                handoff_summary=args.summary,
                updated_by=args.operator,
            )
        ],
        evidence=[transaction.source_evidence("explicit_operator_handoff", args.operator)],
        assumptions=[],
        confidence="deterministic",
        limitations=["Handoff text is operator-supplied and is not a readiness or authority claim."],
        **transaction_validation(),
    )


def apply_workflow_plan(args: argparse.Namespace, expected_prefix: str) -> int:
    if not args.apply_plan:
        raise WorkflowError("internal apply dispatch requires --apply-plan")
    plan = transaction.load_plan(project_path(args.apply_plan))
    if not str(plan.get("operation", "")).startswith(expected_prefix):
        raise WorkflowError(f"plan operation is not {expected_prefix}")
    receipt, receipt_path = transaction.apply_plan(ROOT, plan, args.accept_digest)
    if getattr(args, "json", False):
        print(json.dumps(receipt, indent=2, sort_keys=True, allow_nan=False))
    else:
        print(f"[APPLIED] {receipt['receipt_id']}")
        print(f"[RECEIPT] {receipt_path.relative_to(ROOT)}")
        print("[TIMING] " + json.dumps(transaction.LAST_PHASE_TIMINGS, sort_keys=True))
    if plan.get("operation") == "work.close":
        completion_plan = octon_work_completion.run_completion_plan_event(ROOT)
        if completion_plan is not None:
            print("[COMPLETION PLAN EVENT]")
            print(json.dumps(completion_plan, indent=2, sort_keys=True))
    return 0


def resume() -> int:
    current = load_json(ROOT / ".agent/state/current.json")
    focus = load_json(ROOT / ".agent/state/focus.json")
    revision = None
    result = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
        env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
    )
    if result.returncode == 0:
        revision = result.stdout.strip() or None
    report = {
        "schema_version": "harness.resume-view.v1",
        "permission_grant": False,
        "read_only": True,
        "exact_revision": revision,
        "focus": focus,
        "current": current,
        "limitations": [
            "This is a derived handoff view, not permission to execute the focused task.",
            "Priority among independent ready tasks remains project-owned.",
        ],
    }
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


def registry_discovery() -> dict[str, Any]:
    registry_path = ROOT / "project-dossier/machine-readable/artifact-registry.json"
    registry = load_json(registry_path)
    manifest_path = ROOT / "project-dossier/MANIFEST.json"
    manifest = load_json(manifest_path) if manifest_path.is_file() else {}
    representations = registry.get("representations", []) if isinstance(registry, dict) else []
    registered = {
        item.get("path"): item
        for item in representations
        if isinstance(item, dict) and isinstance(item.get("path"), str)
    }
    derived = {
        "project-dossier/ARTIFACT_CATALOG.json",
        "project-dossier/MANIFEST.json",
        "project-dossier/CHECKSUMS.sha256",
        "project-dossier/machine-readable/path-authority.json",
    }
    actual = {
        path.relative_to(ROOT).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
        for path in (ROOT / "project-dossier").rglob("*")
        if path.is_file() and not path.is_symlink() and path.relative_to(ROOT).as_posix() not in derived
    }
    previous_hashes = {
        item.get("path"): item.get("sha256")
        for item in manifest.get("files", [])
        if isinstance(item, dict)
    }
    added = sorted(set(actual) - set(registered))
    removed = sorted(set(registered) - set(actual) - derived)
    rename_candidates = []
    for old in removed:
        prior = previous_hashes.get(old)
        if prior is None:
            continue
        for new in added:
            if actual[new] == prior:
                rename_candidates.append({"from": old, "to": new, "sha256": prior})
    proposal = {
        "schema_version": "harness.registry-reconciliation-proposal.v1",
        "permission_grant": False,
        "observed_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "registry_path": "project-dossier/machine-readable/artifact-registry.json",
        "confirmed_collisions": [],
        "added_paths": added,
        "missing_paths": removed,
        "rename_candidates": rename_candidates,
        "review_required": [
            "applicability",
            "ownership",
            "source_direction",
            "representation_role",
            "omission",
            "supersession",
            "stable_id_allocation",
        ],
        "limitations": [
            "Hash-equivalent rename candidates are proposals, not identity decisions.",
            "Refresh remains non-inferential and never edits this registry.",
        ],
    }
    proposal["canonical_proposal_digest"] = transaction.sha256(transaction.canonical_bytes(proposal))
    return proposal


def registry_exact_plan(review_path: Path) -> dict[str, Any]:
    proposal = registry_discovery()
    review = load_json(review_path)
    if not isinstance(review, dict) or review.get("proposal_digest") != proposal["canonical_proposal_digest"]:
        raise WorkflowError("registry review is absent or not bound to the current proposal")
    decisions = review.get("decisions")
    if not isinstance(decisions, list):
        raise WorkflowError("registry review decisions must be an array")
    registry_path = ROOT / "project-dossier/machine-readable/artifact-registry.json"
    registry = load_json(registry_path)
    if not isinstance(registry, dict) or not isinstance(registry.get("representations"), list):
        raise WorkflowError("artifact registry is malformed")
    by_id = {item.get("id"): item for item in registry["representations"] if isinstance(item, dict)}
    for decision in decisions:
        if not isinstance(decision, dict) or decision.get("action") not in {"add", "rename", "remove"}:
            raise WorkflowError("every registry decision requires add, rename, or remove")
        action = decision["action"]
        if action == "add":
            required = {"action", "representation"}
            representation = decision.get("representation")
            if set(decision) != required or not isinstance(representation, dict):
                raise WorkflowError("add requires one exact representation object")
            if representation.get("id") in by_id:
                raise WorkflowError("stable representation ID is already allocated")
            registry["representations"].append(representation)
            by_id[representation.get("id")] = representation
        elif action == "rename":
            if set(decision) != {"action", "representation_id", "from", "to"}:
                raise WorkflowError("rename decision shape is invalid")
            item = by_id.get(decision["representation_id"])
            if item is None or item.get("path") != decision["from"]:
                raise WorkflowError("rename does not match the current stable representation")
            item["path"] = decision["to"]
        else:
            if set(decision) != {"action", "representation_id", "path", "disposition"}:
                raise WorkflowError("remove requires an explicit disposition")
            item = by_id.get(decision["representation_id"])
            if item is None or item.get("path") != decision["path"]:
                raise WorkflowError("remove does not match the current stable representation")
            if decision["disposition"] not in {"explicit_omission", "superseded", "combined"}:
                raise WorkflowError("remove disposition is not explicit")
            registry["representations"].remove(item)
            del by_id[decision["representation_id"]]
    return transaction.build_plan(
        ROOT,
        operation_name="maintain.registry",
        scope="Apply explicitly reviewed artifact-registry reconciliation",
        operations=[
            transaction.operation(
                "replace",
                "project-dossier/machine-readable/artifact-registry.json",
                json_bytes(registry),
                "Apply explicit stable-ID, ownership, applicability, and representation decisions.",
            )
        ],
        evidence=[
            transaction.source_evidence(
                "registry_reconciliation_review",
                review_path.as_posix(),
                content=review_path.read_bytes(),
            )
        ],
        assumptions=[],
        confidence="deterministic",
        limitations=["No artifact identity, ownership, applicability, omission, or supersession was inferred."],
        **transaction_validation(),
    )


def hooks_plan(config_path: Path) -> dict[str, Any]:
    config = load_json(config_path)
    project_path = ROOT / ".agent/project.json"
    project = load_json(project_path)
    if not isinstance(config, dict) or not isinstance(project, dict):
        raise WorkflowError("hook configuration and project must be objects")
    expected_hooks = {"project_test", "project_lint", "project_build", "project_closure"}
    optional_hooks = {"work_completion_plan"}
    if not expected_hooks <= set(config) or not set(config) <= expected_hooks | optional_hooks:
        raise WorkflowError(
            "hook configuration must explicitly assess all four project-check hooks and may assess work_completion_plan"
        )
    replacement = dict(config)
    existing_commands = project.get("commands", {})
    if (
        "work_completion_plan" not in replacement
        and isinstance(existing_commands, dict)
        and "work_completion_plan" in existing_commands
    ):
        replacement["work_completion_plan"] = existing_commands["work_completion_plan"]
    project["commands"] = replacement
    return transaction.build_plan(
        ROOT,
        operation_name="maintain.hooks",
        scope="Replace the explicit project-owned hook assessment",
        operations=[
            transaction.operation(
                "replace",
                ".agent/project.json",
                json_bytes(project),
                "Apply explicit argv, owner, version-probe, timeout, freshness, and side-effect assessments.",
            )
        ],
        evidence=[transaction.source_evidence("explicit_hook_configuration", config_path.as_posix(), content=config_path.read_bytes())],
        assumptions=[],
        confidence="deterministic",
        limitations=["The plan validates hook shape but does not authorize or execute configured hooks."],
        **transaction_validation(),
    )


def collaboration_plan(config_path: Path) -> dict[str, Any]:
    """Install an explicitly reviewed v2 collaboration profile, never an inference."""
    profile = load_json(config_path)
    validator = load_validator()
    schema = validator.load_schema(ROOT, "harness-collaboration-profile.schema.json")
    errors = validator.validate_schema(profile, schema)
    if errors:
        raise WorkflowError("collaboration review file is invalid: " + "; ".join(errors))
    report, report_errors = validator.derive_collaboration_assessment(profile)
    if report_errors:
        raise WorkflowError("collaboration evidence is incomplete or stale: " + "; ".join(report_errors))
    selection = profile.get("workflow_selection", {})
    if profile.get("team_band") != report["team_band"] or profile.get("concurrent_work") != report["concurrent_work"]:
        raise WorkflowError("stored collaboration classification differs from its evidence")
    if report["status"] == "proposed":
        for field in ("base_workflow", "modifiers", "review_mode"):
            if selection.get(field) != report["recommendation"][field]:
                raise WorkflowError(f"workflow_selection.{field} differs from progressive evidence")
        if sorted(selection.get("used_fact_ids", [])) != report["used_fact_ids"]:
            raise WorkflowError("workflow_selection.used_fact_ids differs from progressive evidence")
    project = load_json(ROOT / ".agent/project.json")
    project["collaboration_profile"] = profile
    return transaction.build_plan(
        ROOT,
        operation_name="maintain.collaboration",
        scope="Install an explicitly reviewed progressive collaboration assessment",
        operations=[
            transaction.operation(
                "replace",
                ".agent/project.json",
                json_bytes(project),
                "Record reviewed aggregate collaboration facts without changing assurance profile or granting authority.",
            )
        ],
        evidence=[
            transaction.source_evidence(
                "reviewed_collaboration_profile",
                str(config_path),
                content=config_path.read_bytes(),
                limitations=["The review file is an input record, not a permission channel."],
            )
        ],
        assumptions=[],
        confidence="high",
        limitations=[
            "Collaboration band remains independent of assurance profile.",
            "Concurrent work remains a modifier.",
            "Workflow status `proposed` is non-authorizing; `adopted` requires a resolvable accepted decision.",
        ],
        analysis={
            "observations": [],
            "inferences": [
                {
                    "id": "collaboration.progressive_result",
                    "summary": f"Progressive evidence derives {report['team_band']} with status {report['status']}.",
                    "source_refs": [str(config_path)],
                    "rule": "progressive_collaboration_v2",
                    "confidence": "high",
                    "limitations": report["limitations"],
                }
            ],
            "explicit_decisions": [],
            "authorization_gates": [],
        },
        **transaction_validation(),
    )


