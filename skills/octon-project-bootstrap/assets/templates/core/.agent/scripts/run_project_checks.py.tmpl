def _load_continuation():
    candidates = (
        Path(__file__).with_name("octon_continuation.py"),
        Path(__file__).with_name("octon_continuation.py.tmpl"),
    )
    path = next((item for item in candidates if item.is_file()), None)
    if path is None:
        raise RuntimeError("continuation runtime is unavailable")
    spec = importlib.util.spec_from_file_location("octon_project_check_continuation", path)
    if spec is None or spec.loader is None:
        module = types.ModuleType("octon_project_check_continuation")
        module.__file__ = str(path)
        exec(compile(path.read_text(encoding="utf-8"), str(path), "exec"), module.__dict__)
        return module
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


CONTINUATION = _load_continuation()


def emit_refusal(
    *,
    failure_code: str,
    phase: str,
    root_cause: str,
    next_description: str,
    next_argv: list[str],
    json_output: bool,
    mutation_paths: list[str] | None = None,
    invalidated: list[dict[str, Any]] | None = None,
    preserved: list[dict[str, Any]] | None = None,
    limitations: list[str] | None = None,
) -> int:
    paths = sorted(set(mutation_paths or []))
    report = CONTINUATION.finding(
        failure_code=failure_code,
        blocked_operation="project_checks.write_evidence",
        phase=phase,
        root_cause=root_cause,
        authority_source=".agent/project.json#commands_and_project_checks",
        repair_class="project_action_required",
        next_action=CONTINUATION.action(
            next_description,
            next_argv,
            read_only=True,
        ),
        invalidated=invalidated or [],
        preserved=preserved or [],
        safe_read_only_actions=[
            CONTINUATION.action(
                "Inspect current structural diagnostics.",
                ["./octon", "doctor", "--json"],
                read_only=True,
            )
        ],
        successor_plan=False,
        successor_reason="Project-check evidence can be written only after the reported validation boundary is repaired.",
        mutation_occurred=bool(paths),
        repository_paths=paths,
        limitations=limitations or [],
    )
    if paths:
        report["mutation"]["statement"] = (
            "The evidence operation stopped after the explicitly listed local paths changed; no unlisted external effect is claimed."
        )
    print(CONTINUATION.render_finding(report, json_output=json_output), file=sys.stderr)
    return 2


class DuplicateKeyError(ValueError):
    """Raised when strict JSON contains a repeated object key."""


def strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateKeyError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def reject_json_constant(value: str) -> None:
    raise ValueError(f"non-finite JSON number is prohibited: {value}")


def load_json(path: Path) -> Any:
    return json.loads(
        path.read_text(encoding="utf-8"),
        object_pairs_hook=strict_object,
        parse_constant=reject_json_constant,
    )


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def timestamp(value: datetime) -> str:
    return value.isoformat().replace("+00:00", "Z")


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def file_identity(path: Path) -> bytes:
    if path.is_symlink():
        return b"symlink\0" + os.readlink(path).encode(
            "utf-8", errors="surrogateescape"
        )
    return path.read_bytes()


def safe_relative_path(value: Any) -> str | None:
    if (
        not isinstance(value, str)
        or not value
        or "\x00" in value
        or "\\" in value
        or value.startswith(("/", "./"))
        or any(ord(character) < 32 or ord(character) == 127 for character in value)
        or PurePosixPath(value).as_posix() != value
    ):
        return None
    candidate = PurePosixPath(value)
    if any(part in {"", ".", ".."} for part in candidate.parts):
        return None
    try:
        (ROOT / value).resolve().relative_to(ROOT.resolve())
    except (OSError, ValueError):
        return None
    return value.rstrip("/")


def fingerprint_exclusions(project: dict[str, Any]) -> set[str]:
    exclusions = {
        EVIDENCE_RELATIVE_PATH,
        ".agent/project-checks/archive",
        ".agent/work-runs",
    }
    raw = project.get("paths", {}).get("fingerprint_exclusions", [])
    if not isinstance(raw, list):
        raise ValueError(".agent/project.json fingerprint_exclusions must be an array")
    for index, item in enumerate(raw):
        if not isinstance(item, dict):
            raise ValueError(f"fingerprint exclusion {index} must be an object")
        normalized = safe_relative_path(item.get("path"))
        reason = item.get("reason")
        if normalized is None or not isinstance(reason, str) or not reason.strip():
            raise ValueError(f"fingerprint exclusion {index} is unsafe or unexplained")
        if normalized in {
            ".git",
            ".agent",
            ".agents",
            "project-dossier",
            "AGENTS.md",
            ".octon-origin.json",
        } or normalized.startswith((".git/", ".agent/", ".agents/", "project-dossier/")):
            raise ValueError(f"fingerprint exclusion {index} removes governance source")
        exclusions.add(normalized)
    return exclusions


def project_check_source_fingerprint(
    project: dict[str, Any],
) -> tuple[str, list[str]]:
    exclusions = fingerprint_exclusions(project)
    digest = hashlib.sha256()
    for path in sorted(ROOT.rglob("*")):
        relative = path.relative_to(ROOT)
        value = relative.as_posix()
        if ".git" in relative.parts or "__pycache__" in relative.parts:
            continue
        if path.is_dir() and not path.is_symlink():
            continue
        if (
            value.startswith(".agent/generated/")
            or value.startswith(".agent/transactions/")
            or value.startswith(".agent/work-runs/")
            or value.startswith(".agent/project-checks/archive/")
            or value == EVIDENCE_RELATIVE_PATH
            or value in DERIVED_SOURCE_EXCLUSIONS
            or any(value == item or value.startswith(item + "/") for item in exclusions)
        ):
            continue
        digest.update(value.encode("utf-8", errors="surrogateescape"))
        digest.update(b"\0")
        try:
            digest.update(hashlib.sha256(file_identity(path)).digest())
        except OSError:
            digest.update(hashlib.sha256(b"unreadable").digest())
        digest.update(b"\0")
    reported_exclusions = exclusions | DERIVED_SOURCE_EXCLUSIONS | {
        ".agent/generated",
        ".agent/transactions",
        ".agent/work-runs",
        EVIDENCE_RELATIVE_PATH,
        ".agent/project-checks/archive",
    }
    return digest.hexdigest(), sorted(reported_exclusions)


def repository_snapshot() -> dict[str, str]:
    snapshot: dict[str, str] = {}
    for path in sorted(ROOT.rglob("*")):
        relative = path.relative_to(ROOT)
        if ".git" in relative.parts or "__pycache__" in relative.parts:
            continue
        try:
            metadata = path.lstat()
            if stat.S_ISLNK(metadata.st_mode):
                identity = "symlink:" + sha256_bytes(file_identity(path))
            elif stat.S_ISDIR(metadata.st_mode):
                identity = "directory"
            elif stat.S_ISREG(metadata.st_mode):
                identity = "file:" + sha256_bytes(path.read_bytes())
            else:
                identity = "other"
            snapshot[relative.as_posix()] = (
                f"{identity}:{stat.S_IMODE(metadata.st_mode):o}"
            )
        except OSError:
            snapshot[relative.as_posix()] = "unreadable"
    return snapshot


def changed_paths(before: dict[str, str], after: dict[str, str]) -> list[str]:
    return sorted(
        key
        for key in set(before) | set(after)
        if before.get(key) != after.get(key)
    )


def git_scope() -> dict[str, Any]:
    result: dict[str, Any] = {
        "available": False,
        "revision": None,
        "tracked_modified": [],
        "untracked": [],
        "ignored": [],
    }
    environment = {**os.environ, "GIT_OPTIONAL_LOCKS": "0"}
    try:
        probe = subprocess.run(
            ["git", "rev-parse", "--is-inside-work-tree"],
            cwd=ROOT,
            capture_output=True,
            check=False,
            env=environment,
            shell=False,
        )
    except OSError:
        return result
    if probe.returncode:
        return result
    result["available"] = True
    revision = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=ROOT,
        capture_output=True,
        check=False,
        env=environment,
        shell=False,
    )
    if revision.returncode == 0:
        candidate = revision.stdout.decode("utf-8", errors="replace").strip()
        result["revision"] = candidate or None
    status_result = subprocess.run(
        ["git", "status", "--porcelain=v1", "--ignored", "--untracked-files=all"],
        cwd=ROOT,
        capture_output=True,
        check=False,
        env=environment,
        shell=False,
    )
    if status_result.returncode:
        return result
    for raw_line in status_result.stdout.decode(
        "utf-8", errors="surrogateescape"
    ).splitlines():
        if len(raw_line) < 3:
            continue
        path = raw_line[3:]
        if raw_line.startswith("!!"):
            result["ignored"].append(path)
        elif raw_line.startswith("??"):
            result["untracked"].append(path)
        else:
            result["tracked_modified"].append(path)
    for key in ("tracked_modified", "untracked", "ignored"):
        result[key] = sorted(set(result[key]))
    return result


def source_state(project: dict[str, Any]) -> dict[str, Any]:
    fingerprint, exclusions = project_check_source_fingerprint(project)
    return {
        "fingerprint_algorithm": "sha256",
        "fingerprint": fingerprint,
        "fingerprint_exclusions": exclusions,
        "git": git_scope(),
    }


def proof_input_roots(project: dict[str, Any], hook: str) -> list[str]:
    paths = project.get("paths", {}) if isinstance(project.get("paths"), dict) else {}
    source = [item for item in paths.get("source", []) if isinstance(item, str) and item]
    tests = [item for item in paths.get("tests", []) if isinstance(item, str) and item]
    routed = source + tests if hook in {"project_test", "project_lint", "project_closure"} else source
    return sorted(set(routed))


def proof_input_set(project: dict[str, Any], hook: str) -> list[dict[str, Any]]:
    roots = proof_input_roots(project, hook)
    fixed = [".agent/project.json"] + [
        path.relative_to(ROOT).as_posix()
        for path in sorted(ROOT.rglob("AGENTS.md"))
        if path.is_file() and not path.is_symlink()
    ]
    candidates: set[str] = set(fixed)
    if roots:
        for root_value in roots:
            normalized = safe_relative_path(root_value)
            if normalized is None:
                raise ValueError(f"{hook}: proof input root is unsafe: {root_value!r}")
            root_path = ROOT / normalized
            if root_path.is_file() or root_path.is_symlink():
                candidates.add(normalized)
            elif root_path.is_dir():
                for path in root_path.rglob("*"):
                    if path.is_file() or path.is_symlink():
                        candidates.add(path.relative_to(ROOT).as_posix())
            else:
                candidates.add(normalized)
    else:
        for path in ROOT.rglob("*"):
            if not (path.is_file() or path.is_symlink()):
                continue
            relative = path.relative_to(ROOT)
            value = relative.as_posix()
            if (
                ".git" in relative.parts
                or "__pycache__" in relative.parts
                or value == EVIDENCE_RELATIVE_PATH
                or value.startswith(".agent/project-checks/archive/")
                or value.startswith(".agent/transactions/")
                or value.startswith(".agent/work-runs/")
                or value.startswith(".agent/generated/")
                or value in DERIVED_SOURCE_EXCLUSIONS
            ):
                continue
            candidates.add(value)
    values: list[dict[str, Any]] = []
    for relative in sorted(candidates):
        path = ROOT / relative
        if path.is_symlink():
            values.append(
                {
                    "path": relative,
                    "type": "symlink",
                    "sha256": sha256_bytes(file_identity(path)),
                }
            )
        elif path.is_file():
            values.append(
                {
                    "path": relative,
                    "type": "file",
                    "sha256": sha256_bytes(path.read_bytes()),
                }
            )
        else:
            values.append({"path": relative, "type": "absent", "sha256": None})
    return values


def instruction_digest() -> str:
    values = [
        {
            "path": path.relative_to(ROOT).as_posix(),
            "sha256": sha256_bytes(path.read_bytes()),
        }
        for path in sorted(ROOT.rglob("AGENTS.md"))
        if path.is_file() and not path.is_symlink()
    ]
    return sha256_bytes(canonical_bytes(values))


def environment_proof(project: dict[str, Any]) -> dict[str, Any]:
    proof_config = project.get("project_checks", {}).get("proof_reuse", {})
    names = proof_config.get("environment_characteristics", []) if isinstance(proof_config, dict) else []
    characteristics = {
        str(name): sha256_bytes(os.environ.get(str(name), "<absent>").encode("utf-8"))
        for name in names
        if isinstance(name, str) and name
    }
    return {
        "platform": platform.platform(),
        "python_version": platform.python_version(),
        "working_directory": ".",
        "characteristics_digest": sha256_bytes(canonical_bytes(characteristics)),
    }


def executable_proof(command: dict[str, Any]) -> dict[str, Any] | None:
    executable = resolved_executable(command["argv"][0])
    if executable is None:
        return None
    try:
        executable_hash = sha256_bytes(executable.read_bytes())
        version = subprocess.run(
            command["version_argv"],
            cwd=ROOT,
            capture_output=True,
            check=False,
            timeout=command["timeout_seconds"],
            shell=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if version.returncode:
        return None
    return {
        "resolved_path": str(executable),
        "sha256": executable_hash,
        "version_argv": command["version_argv"],
        "version_output_sha256": sha256_bytes(version.stdout + version.stderr),
    }


def proof_match_fields(proof: dict[str, Any]) -> dict[str, Any]:
    return {
        key: proof.get(key)
        for key in (
            "input_set",
            "input_digest",
            "check_identity",
            "argv",
            "executable",
            "configuration_digest",
            "governing_instruction_digest",
            "environment",
            "side_effects",
            "freshness_days",
        )
    }


def proof_candidate(
    project: dict[str, Any],
    hook: str,
    command: dict[str, Any],
) -> dict[str, Any] | None:
    if command.get("status") != "configured":
        return None
    executable = executable_proof(command)
    if executable is None:
        return None
    inputs = proof_input_set(project, hook)
    return {
        "input_set": inputs,
        "input_digest": sha256_bytes(canonical_bytes(inputs)),
        "check_identity": hook,
        "argv": command["argv"],
        "executable": executable,
        "configuration_digest": sha256_bytes(
            canonical_bytes(
                {
                    "command": command,
                    "paths": project.get("paths", {}),
                    "proof_reuse": project.get("project_checks", {}).get("proof_reuse", {}),
                }
            )
        ),
        "governing_instruction_digest": instruction_digest(),
        "environment": environment_proof(project),
        "side_effects": command["side_effects"],
        "freshness_days": command["evidence_freshness_days"],
    }


def current_reusable_proof(
    store: dict[str, Any],
    candidate: dict[str, Any],
) -> dict[str, Any] | None:
    now = utc_now()
    for proof in reversed(store.get("proofs", [])):
        expected_fields = {
            "schema_version",
            "proof_id",
            "permission_grant",
            "reusable",
            "input_set",
            "input_digest",
            "check_identity",
            "argv",
            "executable",
            "configuration_digest",
            "governing_instruction_digest",
            "environment",
            "side_effects",
            "freshness_days",
            "observed_at",
            "fresh_until",
            "result",
            "limitations",
            "canonical_proof_digest",
        }
        if not isinstance(proof, dict) or set(proof) != expected_fields:
            continue
        unsigned = dict(proof)
        supplied_digest = unsigned.pop("canonical_proof_digest", None)
        identity_body = dict(unsigned)
        supplied_id = identity_body.pop("proof_id", None)
        try:
            observed_at = datetime.fromisoformat(
                str(proof.get("observed_at", "")).replace("Z", "+00:00")
            )
            fresh_until = datetime.fromisoformat(
                str(proof.get("fresh_until", "")).replace("Z", "+00:00")
            )
            freshness_interval_valid = (
                observed_at.tzinfo is not None
                and fresh_until
                == observed_at + timedelta(days=int(proof.get("freshness_days")))
                and observed_at <= now
            )
        except (TypeError, ValueError):
            freshness_interval_valid = False
        valid_integrity = (
            proof.get("schema_version") == "harness.validation-proof.v1"
            and proof.get("permission_grant") is False
            and isinstance(supplied_id, str)
            and re.fullmatch(r"VPR-[a-f0-9]{32}", supplied_id) is not None
            and supplied_id
            == "VPR-" + sha256_bytes(canonical_bytes(identity_body))[:32]
            and supplied_digest == sha256_bytes(canonical_bytes(unsigned))
            and proof.get("input_digest")
            == sha256_bytes(canonical_bytes(proof.get("input_set")))
            and freshness_interval_valid
        )
        if (
            valid_integrity
            and proof.get("reusable") is True
            and proof.get("result") == "pass"
            and proof_match_fields(proof) == candidate
        ):
            try:
                if datetime.fromisoformat(proof["fresh_until"].replace("Z", "+00:00")) > now:
                    return proof
            except (KeyError, AttributeError, ValueError):
                continue
    return None


def build_validation_proof(
    candidate: dict[str, Any],
    result: dict[str, Any],
) -> dict[str, Any] | None:
    if result.get("outcome") != "pass" or result.get("fresh_until") is None:
        return None
    effects = candidate["side_effects"]
    reusable = (
        effects.get("classification") == "read_only"
        and not effects.get("repository_write_paths")
        and not effects.get("external_effects")
    )
    body = {
        "schema_version": "harness.validation-proof.v1",
        "permission_grant": False,
        "reusable": reusable,
        **candidate,
        "observed_at": result["ended_at"],
        "fresh_until": result["fresh_until"],
        "result": "pass",
        "limitations": [
            "This proof is reusable only for the exact bound inputs, tool, configuration, instructions, environment, side-effect class, and freshness window.",
            "A proof hit is not runtime authorization, approval, adoption, release, or readiness evidence.",
        ],
    }
    proof_id = "VPR-" + sha256_bytes(canonical_bytes(body))[:32]
    proof = {"proof_id": proof_id, **body}
    proof["canonical_proof_digest"] = sha256_bytes(canonical_bytes(proof))
    return proof


def reused_result(
    hook: str,
    command: dict[str, Any],
    proof: dict[str, Any],
) -> dict[str, Any]:
    now = utc_now()
    result = empty_result(hook, command, now)
    executable = proof["executable"]
    result.update(
        {
            "resolved_executable": executable["resolved_path"],
            "executable_sha256": executable["sha256"],
            "tool_version": "reused_exact_version_fingerprint",
            "tool_version_output_sha256": executable["version_output_sha256"],
            "tool_version_outcome": "pass",
            "ended_at": timestamp(now),
            "outcome": "pass",
            "exit_code": 0,
            "stdout_sha256": None,
            "stderr_sha256": None,
            "fresh_until": proof["fresh_until"],
            "limitations": list(proof["limitations"])
            + ["The hook was not executed in this evidence record; its exact current proof was reused."],
            "execution": "reused",
            "proof_id": proof["proof_id"],
        }
    )
    return result


def safe_argv(value: Any) -> bool:
    return (
        isinstance(value, list)
        and 1 <= len(value) <= 128
        and all(
            isinstance(item, str)
            and bool(item.strip())
            and not any(ord(character) < 32 or ord(character) == 127 for character in item)
            for item in value
        )
    )


def uses_inline_shell(argv: list[str]) -> bool:
    executable = Path(argv[0]).name.lower()
    return executable in SHELL_EXECUTABLES and any(
        item.lower() in INLINE_SHELL_FLAGS for item in argv[1:]
    )


def validate_side_effects(value: Any, hook: str, status: str) -> list[str]:
    if not isinstance(value, dict) or set(value) != {
        "classification",
        "repository_write_paths",
        "external_effects",
    }:
        return [f"{hook}: side_effects must use the closed contract"]
    classification = value.get("classification")
    writes = value.get("repository_write_paths")
    external = value.get("external_effects")
    errors: list[str] = []
    if not isinstance(writes, list) or not isinstance(external, list):
        return [f"{hook}: side-effect paths/effects must be arrays"]
    if any(not isinstance(item, str) or not item.strip() for item in external):
        errors.append(f"{hook}: external-effect declarations must be nonempty strings")
    normalized_writes: list[str] = []
    for item in writes:
        normalized = safe_relative_path(item)
        if normalized is None:
            errors.append(f"{hook}: declared repository write path is unsafe")
            continue
        if normalized in {
            ".git",
            ".agent",
            ".agents",
            "project-dossier",
            "AGENTS.md",
            ".octon-origin.json",
        } or normalized.startswith((".git/", ".agent/", ".agents/", "project-dossier/")):
            errors.append(f"{hook}: project checks may not declare governance writes")
        normalized_writes.append(normalized)
    if len(normalized_writes) != len(set(normalized_writes)) or len(external) != len(set(external)):
        errors.append(f"{hook}: side-effect declarations must be unique")
    if status == "not_assessed" and (
        classification != "not_assessed" or writes or external
    ):
        errors.append(f"{hook}: not_assessed side effects are incoherent")
    elif status == "not_applicable" and (
        classification != "not_applicable" or writes or external
    ):
        errors.append(f"{hook}: not_applicable side effects are incoherent")
    elif status == "configured":
        if classification == "read_only" and (writes or external):
            errors.append(f"{hook}: read_only checks cannot declare writes/effects")
        elif classification == "repository_writes" and (not writes or external):
            errors.append(f"{hook}: repository_writes requires paths and no external effects")
        elif classification == "external_effects_possible" and not external:
            errors.append(f"{hook}: external_effects_possible requires declarations")
        elif classification not in {
            "read_only",
            "repository_writes",
            "external_effects_possible",
        }:
            errors.append(f"{hook}: configured side-effect classification is invalid")
    return errors


def validate_command(hook: str, value: Any) -> list[str]:
    required = {
        "status",
        "owner",
        "rationale",
        "tool_name",
        "argv",
        "version_argv",
        "timeout_seconds",
        "evidence_freshness_days",
        "side_effects",
    }
    if not isinstance(value, dict) or set(value) != required:
        return [f"{hook}: command assessment must use the closed contract"]
    status = value.get("status")
    errors = validate_side_effects(value.get("side_effects"), hook, str(status))
    if status == "configured":
        if not isinstance(value.get("owner"), str) or not value["owner"].strip():
            errors.append(f"{hook}: configured command requires an owner")
        if not isinstance(value.get("tool_name"), str) or not value["tool_name"].strip():
            errors.append(f"{hook}: configured command requires a tool name")
        for field in ("argv", "version_argv"):
            if not safe_argv(value.get(field)):
                errors.append(f"{hook}: configured {field} must be a nonempty argv array")
            elif uses_inline_shell(value[field]):
                errors.append(f"{hook}: inline shell interpretation is prohibited")
        if (
            safe_argv(value.get("argv"))
            and safe_argv(value.get("version_argv"))
            and value["argv"][0] != value["version_argv"][0]
        ):
            errors.append(
                f"{hook}: version probe must use the configured executable"
            )
        if (
            not isinstance(value.get("timeout_seconds"), int)
            or isinstance(value.get("timeout_seconds"), bool)
            or not 1 <= value["timeout_seconds"] <= 86400
        ):
            errors.append(f"{hook}: configured command requires a bounded timeout")
        if (
            not isinstance(value.get("evidence_freshness_days"), int)
            or isinstance(value.get("evidence_freshness_days"), bool)
            or not 1 <= value["evidence_freshness_days"] <= 365
        ):
            errors.append(f"{hook}: configured command requires bounded evidence freshness")
        if value.get("rationale") is not None and (
            not isinstance(value["rationale"], str) or not value["rationale"].strip()
        ):
            errors.append(f"{hook}: configured rationale must be null or nonempty")
    elif status == "not_applicable":
        if not isinstance(value.get("owner"), str) or not value["owner"].strip():
            errors.append(f"{hook}: not_applicable requires an owner")
        if not isinstance(value.get("rationale"), str) or not value["rationale"].strip():
            errors.append(f"{hook}: not_applicable requires a rationale")
        for field in (
            "tool_name",
            "argv",
            "version_argv",
            "timeout_seconds",
            "evidence_freshness_days",
        ):
            if value.get(field) is not None:
                errors.append(f"{hook}: not_applicable requires {field}=null")
    elif status == "not_assessed":
        for field in (
            "owner",
            "rationale",
            "tool_name",
            "argv",
            "version_argv",
            "timeout_seconds",
            "evidence_freshness_days",
        ):
            if value.get(field) is not None:
                errors.append(f"{hook}: not_assessed requires {field}=null")
    else:
        errors.append(f"{hook}: unknown assessment status")
    return errors


def validate_proof_reuse_config(
    project: dict[str, Any], *, required: bool
) -> list[str]:
    value = project.get("project_checks", {}).get("proof_reuse")
    if value is None and not required:
        return []
    fixed = {
        "status": "enabled_for_explicit_routine_writer_only",
        "input_routing": "declared_source_and_test_roots_with_governance_fallback",
        "external_or_runtime_authorization_cache_hits": False,
        "expired_proof_cache_hits": False,
        "adoption_and_release_gate_reuse": False,
    }
    names = value.get("environment_characteristics") if isinstance(value, dict) else None
    if (
        not isinstance(value, dict)
        or set(value) != set(fixed) | {"environment_characteristics"}
        or any(value.get(key) != expected for key, expected in fixed.items())
        or not isinstance(names, list)
        or not 1 <= len(names) <= 64
        or len(names) != len(set(item for item in names if isinstance(item, str)))
        or not BASELINE_PROOF_ENVIRONMENT <= set(
            item for item in names if isinstance(item, str)
        )
        or any(
            not isinstance(item, str) or ENVIRONMENT_NAME.fullmatch(item) is None
            for item in names
        )
    ):
        return [
            "proof_reuse: environment characteristics must be a unique bounded project-owned allowlist containing CI, PATH, PYTHONPATH, and VIRTUAL_ENV"
        ]
    return []


def declared_write_allows(path: str, roots: list[str]) -> bool:
    return any(path == root or path.startswith(root.rstrip("/") + "/") for root in roots)


def resolved_executable(argv0: str) -> Path | None:
    if Path(argv0).is_absolute():
        candidate = Path(argv0)
    elif "/" in argv0 or "\\" in argv0:
        candidate = ROOT / argv0
    else:
        found = shutil.which(argv0)
        candidate = Path(found) if found else Path()
    try:
        resolved = candidate.resolve(strict=True)
    except (OSError, ValueError):
        return None
    return resolved if resolved.is_file() else None


def safe_version(value: bytes) -> str | None:
    text = value.decode("utf-8", errors="replace")
    line = next((item.strip() for item in text.splitlines() if item.strip()), "")
    if not line:
        return None
    line = "".join(
        character if ord(character) >= 32 and ord(character) != 127 else "?"
        for character in line
    )[:512]
    if SECRET_LIKE.search(line):
        return "redacted_sensitive_version_output"
    return line


def empty_result(hook: str, command: dict[str, Any], now: datetime) -> dict[str, Any]:
    return {
        "hook": hook,
        "assessment_status": command["status"],
        "owner": command["owner"],
        "rationale": command["rationale"],
        "tool_name": command["tool_name"],
        "argv": command["argv"],
        "version_argv": command["version_argv"],
        "resolved_executable": None,
        "executable_sha256": None,
        "tool_version": None,
        "tool_version_output_sha256": None,
        "tool_version_outcome": "not_run",
        "started_at": timestamp(now),
        "ended_at": timestamp(now),
        "outcome": command["status"],
        "exit_code": None,
        "stdout_sha256": None,
        "stderr_sha256": None,
        "output_capture": "hashes_only_secret_values_not_persisted",
        "declared_side_effects": command["side_effects"],
        "repository_mutation": {
            "detection_only": True,
            "changed_paths": [],
            "outside_declared_write_scope": [],
        },
        "fresh_until": None,
        "execution": "executed",
        "proof_id": None,
        "limitations": [],
    }


def execute_hook(
    hook: str,
    command: dict[str, Any],
    acknowledge_side_effects: bool,
) -> tuple[dict[str, Any], dict[str, Any] | None]:
    started = utc_now()
    result = empty_result(hook, command, started)
    status = command["status"]
    if status == "not_assessed":
        result["limitations"] = ["Hook has not been assessed and was not executed."]
        return result, {
            "hook": hook,
            "status": "not_assessed",
            "owner": None,
            "reason": "Project adoption has not assessed this hook.",
        }
    if status == "not_applicable":
        result["limitations"] = ["Project owner marked this hook not applicable."]
        return result, {
            "hook": hook,
            "status": "not_applicable",
            "owner": command["owner"],
            "reason": command["rationale"],
        }
    classification = command["side_effects"]["classification"]
    if classification != "read_only" and not acknowledge_side_effects:
        result["outcome"] = "unavailable"
        result["limitations"] = [
            "Execution withheld because declared side effects were not explicitly acknowledged."
        ]
        return result, {
            "hook": hook,
            "status": "unavailable",
            "owner": command["owner"],
            "reason": "Pass --acknowledge-side-effects after confirming current authority.",
        }

    before = repository_snapshot()
    executable = resolved_executable(command["argv"][0])
    if executable is None:
        result["outcome"] = "unavailable"
        result["limitations"] = ["Configured executable is unavailable."]
        result["ended_at"] = timestamp(utc_now())
        return result, {
            "hook": hook,
            "status": "unavailable",
            "owner": command["owner"],
            "reason": "Configured executable is unavailable.",
        }
    result["resolved_executable"] = str(executable)
    try:
        result["executable_sha256"] = hashlib.sha256(executable.read_bytes()).hexdigest()
    except OSError:
        result["outcome"] = "unavailable"
        result["limitations"] = ["Configured executable could not be fingerprinted."]
        result["ended_at"] = timestamp(utc_now())
        return result, {
            "hook": hook,
            "status": "unavailable",
            "owner": command["owner"],
            "reason": "Configured executable could not be fingerprinted.",
        }

    timeout_seconds = command["timeout_seconds"]
    try:
        version = subprocess.run(
            command["version_argv"],
            cwd=ROOT,
            capture_output=True,
            check=False,
            timeout=timeout_seconds,
            shell=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        version = None
    if version is None or version.returncode:
        result["tool_version_outcome"] = "unavailable"
        result["outcome"] = "unavailable"
        result["limitations"] = [
            "Tool-version probe was unavailable or failed; the project check was not executed."
        ]
    else:
        version_output = version.stdout + version.stderr
        result["tool_version"] = safe_version(version_output)
        result["tool_version_output_sha256"] = sha256_bytes(version_output)
        if result["tool_version"] is None:
            result["tool_version_outcome"] = "unavailable"
            result["outcome"] = "unavailable"
            result["limitations"] = [
                "Tool-version probe produced no usable version text; the project check was not executed."
            ]
        else:
            result["tool_version_outcome"] = "pass"
            try:
                execution = subprocess.run(
                    command["argv"],
                    cwd=ROOT,
                    capture_output=True,
                    check=False,
                    timeout=timeout_seconds,
                    shell=False,
                )
            except OSError:
                execution = None
                result["outcome"] = "unavailable"
                result["limitations"] = ["Configured check could not be started."]
            except subprocess.TimeoutExpired as error:
                execution = None
                result["outcome"] = "fail"
                result["stdout_sha256"] = sha256_bytes(error.stdout or b"")
                result["stderr_sha256"] = sha256_bytes(error.stderr or b"")
                result["limitations"] = ["Configured check exceeded its declared timeout."]
            if execution is not None:
                result["exit_code"] = execution.returncode
                result["stdout_sha256"] = sha256_bytes(execution.stdout)
                result["stderr_sha256"] = sha256_bytes(execution.stderr)
                result["outcome"] = "pass" if execution.returncode == 0 else "fail"

    after = repository_snapshot()
    changed = changed_paths(before, after)
    declared = command["side_effects"]["repository_write_paths"]
    outside = [item for item in changed if not declared_write_allows(item, declared)]
    result["repository_mutation"] = {
        "detection_only": True,
        "changed_paths": changed,
        "outside_declared_write_scope": outside,
    }
    if outside:
        result["outcome"] = "fail"
        result["limitations"].append(
            "Repository paths changed outside the declared write scope; detection did not prevent the writes."
        )
    ended = utc_now()
    result["ended_at"] = timestamp(ended)
    if result["outcome"] == "pass":
        result["fresh_until"] = timestamp(
            ended + timedelta(days=command["evidence_freshness_days"])
        )
    if not result["limitations"]:
        result["limitations"] = [
            "Repository mutation detection is not sandbox isolation; external effects were not observed."
        ]
    skipped = None
    if result["outcome"] == "unavailable":
        skipped = {
            "hook": hook,
            "status": "unavailable",
            "owner": command["owner"],
            "reason": result["limitations"][0],
        }
    return result, skipped


def append_evidence(
    store: dict[str, Any],
    record: dict[str, Any],
    new_proofs: list[dict[str, Any]],
) -> None:
    expected = {
        "schema_version": "harness.project-check-evidence-store.v3",
        "document_role": "bounded_current_index_and_content_addressed_proofs_of_project_owned_execution_evidence",
        "permission_grant": False,
        "archive_root": ".agent/project-checks/archive",
        "current_record_limit": CURRENT_RECORD_LIMIT,
    }
    if not isinstance(store, dict) or any(store.get(key) != value for key, value in expected.items()):
        raise ValueError("project-check evidence store header is invalid")
    if (
        set(store) != set(expected) | {"records", "proofs", "successor_relationships"}
        or not isinstance(store.get("records"), list)
        or not isinstance(store.get("proofs"), list)
        or not isinstance(store.get("successor_relationships"), list)
    ):
        raise ValueError("project-check evidence store shape is invalid")
    predecessors = [
        item
        for item in store["records"]
        if isinstance(item, dict)
        and [value.get("hook") for value in item.get("checks", [])]
        == [value.get("hook") for value in record.get("checks", [])]
    ]
    if predecessors:
        store["successor_relationships"].append(
            {
                "predecessor": predecessors[-1]["id"],
                "successor": record["id"],
                "recorded_at": record["ended_at"],
            }
        )
    store["records"].append(record)
    store["records"] = store["records"][-CURRENT_RECORD_LIMIT:]
    proofs_by_id = {
        item["proof_id"]: item
        for item in store["proofs"]
        if isinstance(item, dict) and isinstance(item.get("proof_id"), str)
    }
    for proof in new_proofs:
        previous = proofs_by_id.get(proof["proof_id"])
        if previous is not None and previous != proof:
            raise ValueError(f"validation proof identity collision: {proof['proof_id']}")
        proofs_by_id[proof["proof_id"]] = proof
    store["proofs"] = list(proofs_by_id.values())[-100:]
    archive_time = datetime.fromisoformat(record["ended_at"].replace("Z", "+00:00"))
    archive_path = (
        ARCHIVE_ROOT
        / f"{archive_time.year:04d}"
        / f"{archive_time.month:02d}"
        / f"{record['id']}.json"
    )
    archive_path.parent.mkdir(parents=True, exist_ok=True)
    archive_payload = (
        json.dumps(record, indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")
    try:
        archive_descriptor = os.open(
            archive_path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
    except FileExistsError as error:
        raise ValueError(f"immutable evidence archive already exists: {archive_path}") from error
    with os.fdopen(archive_descriptor, "wb") as archive_handle:
        archive_handle.write(archive_payload)
        archive_handle.flush()
        os.fsync(archive_handle.fileno())
    rendered = (json.dumps(store, indent=2, sort_keys=True) + "\n").encode("utf-8")
    mode = stat.S_IMODE(EVIDENCE_PATH.stat().st_mode)
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb",
            prefix=".project-check-evidence-",
            dir=EVIDENCE_PATH.parent,
            delete=False,
        ) as handle:
            temporary_path = Path(handle.name)
            handle.write(rendered)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, EVIDENCE_PATH)
        temporary_path = None
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except OSError:
                pass


def run_verify_adoption() -> int:
    refresh = subprocess.run(
        [sys.executable, "-B", ".agent/scripts/refresh.py", "--refresh"],
        cwd=ROOT,
        check=False,
        shell=False,
    )
    if refresh.returncode:
        return refresh.returncode
    validation = subprocess.run(
        [sys.executable, "-B", ".agent/scripts/validate.py", "--check"],
        cwd=ROOT,
        check=False,
        shell=False,
    )
    return validation.returncode


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Explicitly execute assessed project hooks and append scoped evidence. "
            "This command may have the side effects declared by project hooks."
        )
    )
    output_mode = parser.add_mutually_exclusive_group(required=True)
    output_mode.add_argument("--write-evidence", action="store_true")
    output_mode.add_argument(
        "--observe-only",
        action="store_true",
        help="run only configured read-only hooks and emit ephemeral JSON without writing evidence",
    )
    parser.add_argument("--verify-adoption", action="store_true")
    parser.add_argument("--hook", action="append", choices=HOOKS)
    parser.add_argument("--changed-scope", action="store_true")
    parser.add_argument(
        "--reuse-proofs",
        action="store_true",
        help="reuse only exact current content-addressed passing proofs during routine explicit evidence writing",
    )
    parser.add_argument("--acknowledge-side-effects", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.observe_only and args.verify_adoption:
        parser.error("observe-only execution cannot refresh or verify adoption")
    if args.reuse_proofs and (not args.write_evidence or args.verify_adoption):
        parser.error("proof reuse is limited to routine --write-evidence and is prohibited at adoption verification")
    if args.verify_adoption and (args.hook or args.changed_scope):
        parser.error("adoption verification always executes the full assessed hook set")
    if args.hook and args.changed_scope:
        parser.error("use either explicit --hook selection or --changed-scope routing")

    if args.write_evidence and (EVIDENCE_PATH.is_symlink() or not EVIDENCE_PATH.is_file()):
        return emit_refusal(
            failure_code="OCTON-CHECK-5001",
            phase="inspect",
            root_cause="The project-check evidence destination is absent or unsafe.",
            next_description="Inspect the evidence-store path and restore it only from project-owned governance.",
            next_argv=["./octon", "doctor", "--json"],
            json_output=args.json,
            invalidated=[
                CONTINUATION.proof_state(
                    "evidence",
                    EVIDENCE_RELATIVE_PATH,
                    "The configured evidence-writing boundary does not resolve to a regular file.",
                    ["source_fingerprint_bound"],
                )
            ],
        )
    try:
        project = load_json(ROOT / ".agent/project.json")
        store = load_json(EVIDENCE_PATH) if args.write_evidence else None
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return emit_refusal(
            failure_code="OCTON-CHECK-5002",
            phase="inspect",
            root_cause=f"Unable to load the project-check contracts: {error}",
            next_description="Inspect the project-owned command and evidence contracts.",
            next_argv=["./octon", "doctor", "--json"],
            json_output=args.json,
        )
    if not isinstance(project, dict) or not isinstance(project.get("commands"), dict):
        return emit_refusal(
            failure_code="OCTON-CHECK-5002",
            phase="inspect",
            root_cause="The project command contract is absent.",
            next_description="Inspect the project-owned command configuration.",
            next_argv=["./octon", "doctor", "--json"],
            json_output=args.json,
        )
    commands = project["commands"]
    errors: list[str] = []
    errors.extend(
        validate_proof_reuse_config(
            project,
            required=(
                args.reuse_proofs
                or project.get("schema_version") in {"harness.project.v6", "harness.project.v7"}
            ),
        )
    )
    allowed_hooks = set(HOOKS) | {"work_completion_plan"}
    if not set(HOOKS) <= set(commands) or not set(commands) <= allowed_hooks:
        errors.append("project command hook set differs from the closed contract")
    selected_hooks = list(HOOKS)
    if args.hook:
        selected_hooks = list(dict.fromkeys(args.hook))
    elif args.changed_scope:
        scope = git_scope()
        if scope["available"]:
            changed = set(
                scope["tracked_modified"] + scope["untracked"]
            )
            project_paths = project.get("paths", {})
            source_roots = project_paths.get("source", []) if isinstance(project_paths, dict) else []
            test_roots = project_paths.get("tests", []) if isinstance(project_paths, dict) else []
            def touches(roots: list[str]) -> bool:
                return any(
                    path == root or path.startswith(root.rstrip("/") + "/")
                    for path in changed
                    for root in roots
                    if isinstance(root, str) and root
                )
            selected_hooks = (
                ["project_test", "project_lint", "project_build"]
                if touches(source_roots)
                else ["project_test", "project_lint"]
                if touches(test_roots)
                else ["project_lint"]
            )
        else:
            selected_hooks = list(HOOKS)
    for hook in selected_hooks:
        errors.extend(validate_command(hook, commands.get(hook)))
        command = commands.get(hook)
        if (
            args.observe_only
            and isinstance(command, dict)
            and command.get("status") == "configured"
            and command.get("side_effects", {}).get("classification") != "read_only"
        ):
            errors.append(f"{hook}: observe-only execution requires a configured read_only hook")
    if errors:
        return emit_refusal(
            failure_code="OCTON-CHECK-5003",
            phase="inspect",
            root_cause="Project-check configuration is invalid: " + "; ".join(errors[:20]),
            next_description="Correct the project-owned hook or proof-reuse configuration, then rerun the explicit writer.",
            next_argv=["./octon", "doctor", "--json"],
            json_output=args.json,
            invalidated=[
                CONTINUATION.proof_state(
                    "configuration",
                    ".agent/project.json#commands_and_project_checks",
                    "The closed project-check configuration contract did not validate.",
                    ["source_fingerprint_bound"],
                )
            ],
        )

    store_before = (
        hashlib.sha256(EVIDENCE_PATH.read_bytes()).hexdigest()
        if args.write_evidence
        else None
    )
    started = utc_now()
    source_before = source_state(project)
    checks: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []
    new_proofs: list[dict[str, Any]] = []
    reused_proof_ids: list[str] = []
    proof_hits: list[str] = []
    proof_misses: list[dict[str, str]] = []
    declared_external_effects: set[str] = set()
    for hook in selected_hooks:
        command = commands[hook]
        declared_external_effects.update(command["side_effects"]["external_effects"])
        proof_boundary_before = repository_snapshot()
        candidate = proof_candidate(project, hook, command)
        proof = (
            current_reusable_proof(store, candidate)
            if args.reuse_proofs and store is not None and candidate is not None
            else None
        )
        if proof is not None:
            result = reused_result(hook, command, proof)
            skipped_result = None
        else:
            result, skipped_result = execute_hook(
                hook,
                command,
                args.acknowledge_side_effects,
            )
        proof_boundary_after = repository_snapshot()
        boundary_changed = changed_paths(
            proof_boundary_before, proof_boundary_after
        )
        prior_changed = result.get("repository_mutation", {}).get(
            "changed_paths", []
        )
        combined_changed = sorted(set(boundary_changed) | set(prior_changed))
        declared_writes = command["side_effects"]["repository_write_paths"]
        outside = [
            item
            for item in combined_changed
            if not declared_write_allows(item, declared_writes)
        ]
        result["repository_mutation"] = {
            "detection_only": True,
            "changed_paths": combined_changed,
            "outside_declared_write_scope": outside,
        }
        if outside:
            result["outcome"] = "fail"
            result["execution"] = "executed"
            result["proof_id"] = None
            result["limitations"].append(
                "The executable/version observation or hook changed repository paths outside the declared scope; no proof was reused or created."
            )
        if proof is not None and not outside:
            reused_proof_ids.append(proof["proof_id"])
            proof_hits.append(hook)
        else:
            if args.reuse_proofs:
                proof_misses.append(
                    {
                        "hook": hook,
                        "reason": (
                            "Executable/version observation or hook mutation escaped the declared write scope."
                            if outside
                            else "No exact unexpired reusable proof matched current inputs, tool, configuration, instructions, environment, and effects."
                            if candidate is not None
                            else "The hook is unconfigured or its executable/version identity is unavailable."
                        ),
                    }
                )
            generated_proof = (
                build_validation_proof(candidate, result)
                if candidate is not None and not outside
                else None
            )
            if generated_proof is not None:
                result["proof_id"] = generated_proof["proof_id"]
                new_proofs.append(generated_proof)
        checks.append(result)
        if skipped_result is not None:
            skipped.append(skipped_result)
    source_after = source_state(project)
    outcomes = {item["outcome"] for item in checks}
    overall = (
        "fail"
        if "fail" in outcomes
        else "unavailable"
        if outcomes & {"unavailable", "not_assessed"}
        else "pass"
    )
    ended = utc_now()
    writer_argv = [str(item) for item in getattr(sys, "orig_argv", sys.argv)]
    record = {
        "schema_version": "harness.project-check-evidence.v2",
        "id": "PCE-" + uuid.uuid4().hex,
        "permission_grant": False,
        "readiness_claim": False,
        "writer_argv": writer_argv,
        "started_at": timestamp(started),
        "ended_at": timestamp(ended),
        "source_before": source_before,
        "source_after": source_after,
        "environment": {
            "platform": platform.platform(),
            "python_version": platform.python_version(),
            "python_executable": sys.executable,
            "working_directory": ".",
            "environment_variable_names": sorted(os.environ),
        },
        "checks": checks,
        "reused_proof_ids": sorted(set(reused_proof_ids)),
        "proof_reuse": {
            "requested": args.reuse_proofs,
            "hits": sorted(proof_hits),
            "misses": proof_misses,
            "adoption_or_release_gate_complete_execution": args.verify_adoption,
        },
        "skipped_checks": skipped,
        "overall_outcome": overall,
        "external_effects": {
            "declared_possible": sorted(declared_external_effects),
            "observed": "not_assessed",
        },
        "limitations": [
            "Structural and project-check success does not establish production readiness or permission.",
            "Repository mutation comparison detects writes after execution and does not provide sandbox isolation.",
            "External effects and environment effects outside the repository were not observed.",
            "Command output is represented only by hashes; secret-bearing output is not persisted.",
        ],
    }
    if args.observe_only:
        record["limitations"].append(
            "Observe-only mode did not append the ephemeral result to the project evidence store."
        )
        print(json.dumps(record, indent=2, sort_keys=True))
        return 0 if overall == "pass" else 1
    assert store is not None and store_before is not None
    if hashlib.sha256(EVIDENCE_PATH.read_bytes()).hexdigest() != store_before:
        return emit_refusal(
            failure_code="OCTON-CHECK-5004",
            phase="revalidate",
            root_cause="A project check changed the reserved evidence store; the writer refused to overwrite it.",
            next_description="Inspect the changed evidence store and the recorded hook mutation before any retry.",
            next_argv=["./octon", "doctor", "--json"],
            json_output=args.json,
            mutation_paths=[EVIDENCE_RELATIVE_PATH],
            invalidated=[
                CONTINUATION.proof_state(
                    "evidence",
                    EVIDENCE_RELATIVE_PATH,
                    "The evidence-store preimage changed during hook execution.",
                    ["source_fingerprint_bound"],
                )
            ],
        )
    archive_time = datetime.fromisoformat(record["ended_at"].replace("Z", "+00:00"))
    archive_relative = (
        Path(".agent/project-checks/archive")
        / f"{archive_time.year:04d}"
        / f"{archive_time.month:02d}"
        / f"{record['id']}.json"
    ).as_posix()
    try:
        append_evidence(store, record, new_proofs)
    except (OSError, ValueError) as error:
        surviving = [
            path
            for path in (archive_relative,)
            if (ROOT / path).is_file() and not (ROOT / path).is_symlink()
        ]
        return emit_refusal(
            failure_code="OCTON-CHECK-5005",
            phase="receipt",
            root_cause=f"Unable to append project-check evidence atomically: {error}",
            next_description="Inspect the evidence archive and current store before retrying the explicit writer.",
            next_argv=["./octon", "doctor", "--json"],
            json_output=args.json,
            mutation_paths=surviving,
            invalidated=[
                CONTINUATION.proof_state(
                    "evidence",
                    EVIDENCE_RELATIVE_PATH,
                    "The current evidence index was not confirmed as containing this record.",
                    ["source_fingerprint_bound"],
                )
            ],
            preserved=(
                [
                    CONTINUATION.proof_state(
                        "evidence",
                        archive_relative,
                        "The immutable archive record was persisted before the current-index failure.",
                        ["source_fingerprint_bound"],
                    )
                ]
                if surviving
                else []
            ),
        )

    verification_result = 0
    verification_changed: list[str] = []
    if args.verify_adoption:
        verification_before = repository_snapshot()
        verification_result = run_verify_adoption()
        verification_changed = changed_paths(
            verification_before,
            repository_snapshot(),
        )
    if overall != "pass" or verification_result != 0:
        check_changed = sorted(
            {
                path
                for item in checks
                for path in item.get("repository_mutation", {}).get("changed_paths", [])
            }
        )
        emit_refusal(
            failure_code="OCTON-CHECK-5006",
            phase="validate",
            root_cause=(
                f"Project-check evidence recorded outcome {overall!r}"
                + (
                    f" and final adoption verification exited {verification_result}"
                    if verification_result
                    else ""
                )
                + "."
            ),
            next_description="Inspect the preserved failed evidence and repair only the owning hook, inputs, or governing configuration.",
            next_argv=["./octon", "doctor", "--json"],
            json_output=args.json,
            mutation_paths=sorted(
                set(check_changed)
                | set(verification_changed)
                | {EVIDENCE_RELATIVE_PATH, archive_relative}
            ),
            invalidated=[
                CONTINUATION.proof_state(
                    "validation_proof",
                    ",".join(selected_hooks),
                    "No passing current conclusion exists for every selected hook.",
                    ["source_fingerprint_bound", "expiry_bound"],
                )
            ],
            preserved=[
                CONTINUATION.proof_state(
                    "evidence",
                    archive_relative,
                    "The exact failed or unavailable observation remains immutable evidence.",
                    ["source_fingerprint_bound"],
                )
            ],
            limitations=[
                "Declared possible external effects were not observed and are not asserted as completed by this finding."
            ],
        )
        return 1
    if args.json:
        print(json.dumps(record, indent=2, sort_keys=True, allow_nan=False))
    else:
        print(f"[INFO] appended project-check evidence {record['id']} ({overall})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
