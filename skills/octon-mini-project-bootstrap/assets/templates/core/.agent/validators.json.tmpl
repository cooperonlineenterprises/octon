{
  "schema_version": "harness.validators.v5",
  "validator_version": "4.2.0",
  "runtime": {
    "executable": "python",
    "minimum_version": "3.11",
    "dependencies": "standard_library_only",
    "bytecode_and_cache_writes": "prohibited_for_check"
  },
  "commands": {
    "bootstrap": {"run": "python --version", "writes": []},
    "check": {"run": "python -B .agent/scripts/validate.py --check", "writes": []},
    "ready_frontier": {"run": "python -B .agent/scripts/validate.py --ready-frontier", "writes": []},
    "collaboration_assessment": {"run": "python -B .agent/scripts/validate.py --assess-collaboration", "writes": []},
    "test": {"run": "python -B .agent/tests/test_validate.py --tier integration", "writes": []},
    "test_fast": {"run": "python -B .agent/tests/test_validate.py --tier fast", "writes": []},
    "test_integration": {"run": "python -B .agent/tests/test_validate.py --tier integration", "writes": []},
    "test_release": {"run": "python -B .agent/tests/test_validate.py --tier release", "writes": []},
    "project_checks": {
      "run": "python -B .agent/scripts/run_project_checks.py --write-evidence",
      "writes": [".agent/project-checks/archive", ".agent/project-checks/evidence.json"]
    },
    "project_checks_reuse": {
      "run": "python -B .agent/scripts/run_project_checks.py --write-evidence --changed-scope --reuse-proofs",
      "writes": [".agent/project-checks/archive", ".agent/project-checks/evidence.json"]
    },
    "adoption_verify": {
      "run": "python -B .agent/scripts/run_project_checks.py --write-evidence --verify-adoption",
      "writes": "project_check_evidence_and_profile_refresh_outputs"
    },
    "refresh": {"run": "{{HARNESS_REFRESH_COMMAND}}", "writes": {{HARNESS_REFRESH_WRITES}}},
    "closure": {"run": "configure_during_project_adoption", "writes": "not_assessed"}
  },
  "required_core_checks": [
    "python_runtime_floor",
    "strict_json_and_duplicate_keys",
    "schemas_and_versions",
    "authority_and_nested_instruction_invariants",
    "identifiers_references_and_lifecycles",
    "dependency_readiness_and_ready_frontier",
    "decision_governance_and_authority_reconciliation",
    "collaboration_topology_and_workflow_selection",
    "small_team_git_workflow_and_operation_contract",
    "project_command_assessment_and_current_evidence",
    "content_addressed_validation_proof_reuse",
    "typed_continuation_and_safe_transaction_bundles",
    "autonomous_delivery_dormant_activation_authority_limits_and_monotonic_effects",
    "dossier_catalog_path_authority_and_traceability",
    "extension_compatibility_confinement_and_validator_protocol",
    "unresolved_generation_placeholders",
    "redacted_secret_detection",
    "repository_symlinks_and_host_metadata",
    "generated_integrity_freshness_when_present"
  ],
  "limitations": [
    "structural_checks_do_not_prove_project_readiness",
    "repository_policy_is_not_runtime_sandbox_enforcement"
  ]
}
