class DeliveryError(RuntimeError):
    """Fail-closed autonomous-delivery error."""


def duplicate_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise ValueError(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def load_json(path: Path) -> Any:
    try:
        return json.loads(
            path.read_text(encoding="utf-8"),
            object_pairs_hook=duplicate_pairs,
            parse_constant=lambda raw: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON value: {raw}")
            ),
        )
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise DeliveryError(f"cannot load strict JSON {path}: {error}") from error


def canonical_bytes(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8")


def digest(value: Any) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def digest_without(value: dict[str, Any], field: str) -> str:
    candidate = dict(value)
    candidate.pop(field, None)
    return digest(candidate)


def file_sha256(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            value.update(block)
    return value.hexdigest()


def timestamp(value: str, label: str) -> datetime:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError) as error:
        raise DeliveryError(f"{label} must be an ISO-8601 timestamp") from error
    if parsed.tzinfo is None:
        raise DeliveryError(f"{label} requires a timezone")
    return parsed


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def utc_text(value: datetime | None = None) -> str:
    return (value or utc_now()).astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def root_path(raw: str | None) -> Path:
    root = Path(raw or ".").resolve()
    if not root.is_dir() or (root / ".agent").is_symlink():
        raise DeliveryError("target project root is absent or unsafe")
    return root


def confined(root: Path, raw: str, *, require_file: bool = False) -> Path:
    relative = PurePosixPath(raw)
    if relative.is_absolute() or any(part in {"", ".", ".."} for part in relative.parts):
        raise DeliveryError(f"unsafe project path: {raw}")
    candidate = root.joinpath(*relative.parts)
    current = root
    for part in relative.parts[:-1]:
        current = current / part
        if current.is_symlink():
            raise DeliveryError(f"project path has a symlink ancestor: {raw}")
    try:
        candidate.resolve(strict=False).relative_to(root)
    except (OSError, ValueError) as error:
        raise DeliveryError(f"project path escapes target: {raw}") from error
    if require_file and (not candidate.is_file() or candidate.is_symlink()):
        raise DeliveryError(f"required project file is absent or unsafe: {raw}")
    return candidate


def external_path(root: Path, raw: str, *, require_file: bool = False) -> Path:
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute():
        raise DeliveryError("operator-controlled paths must be absolute")
    candidate = candidate.resolve(strict=False)
    try:
        candidate.relative_to(root)
    except ValueError:
        pass
    else:
        raise DeliveryError("operator-controlled paths must remain outside the repository")
    current = Path(candidate.anchor)
    for part in candidate.parts[1:-1]:
        current = current / part
        if current.is_symlink():
            raise DeliveryError("operator-controlled path has a symlink ancestor")
    if require_file and (not candidate.is_file() or candidate.is_symlink()):
        raise DeliveryError(f"required external record is absent or unsafe: {candidate}")
    return candidate


def write_external_new(root: Path, raw: str, value: Any) -> Path:
    path = external_path(root, raw)
    if not path.parent.is_dir() or path.parent.is_symlink():
        raise DeliveryError("external output parent must already exist and be nonsymlinked")
    try:
        with path.open("xb") as handle:
            handle.write(canonical_bytes(value))
            handle.flush()
            os.fsync(handle.fileno())
    except FileExistsError as error:
        raise DeliveryError(f"external output already exists and will not be overwritten: {path}") from error
    return path


def emit(value: Any, output: str | None, root: Path) -> None:
    if output:
        write_external_new(root, output, value)
    else:
        sys.stdout.buffer.write(canonical_bytes(value))


def project(root: Path) -> dict[str, Any]:
    value = load_json(confined(root, ".agent/project.json", require_file=True))
    if not isinstance(value, dict):
        raise DeliveryError("project contract must be an object")
    return value


def delivery_config(root: Path) -> dict[str, Any]:
    if not (root / ".agent/project.json").exists() and (root / "octon-mini.json").is_file() and (root / "VERSION").is_file():
        return {
            "schema_version": "harness.autonomous-delivery-config.v2",
            "status": STATUS_AVAILABLE,
            "write_capability": "locked",
            "external_effects": "locked",
            "delivery_profile": None,
            "compute_mode": None,
            "adoption_decision_ref": None,
            "authorization_record_ref": None,
            "authorization_record_digest": None,
            "activation_receipt_ref": None,
            "limitations": ["Octon Mini source delivery remains locally implemented but externally locked pending an exact current SAC confirmation and matching compute evidence."],
        }
    value = project(root).get("autonomous_delivery")
    if value is None:
        return {
            "schema_version": "harness.autonomous-delivery-config.v2",
            "status": STATUS_AVAILABLE,
            "write_capability": "locked",
            "external_effects": "locked",
            "delivery_profile": None,
            "compute_mode": None,
            "adoption_decision_ref": None,
            "authorization_record_ref": None,
            "authorization_record_digest": None,
            "activation_receipt_ref": None,
            "limitations": ["Older snapshot or unprojected configuration; upgrade assessment is required."],
        }
    if not isinstance(value, dict):
        raise DeliveryError("autonomous-delivery project configuration is malformed")
    return value


def profile_preset(profile: str) -> dict[str, Any]:
    if profile not in ALLOWED_PROFILES:
        raise DeliveryError(f"unsupported delivery profile: {profile}")
    if profile == "review_first":
        actions = REVIEW_FIRST_ACTIONS
        releases: list[str] = []
        limits = {**FAST_LIMITS, "covered_releases": 0}
    elif profile == "balanced_autonomous":
        actions = BALANCED_ACTIONS
        releases = ["patch"]
        limits = dict(FAST_LIMITS)
    elif profile == "fast_delivery":
        actions = FAST_ACTIONS
        releases = ["patch", "minor"]
        limits = dict(FAST_LIMITS)
    else:
        actions = []
        releases = []
        limits = dict(FAST_LIMITS)
    return {
        "profile": profile,
        "recommended_for_most_solo_developers": profile == "fast_delivery",
        "silently_selected": False,
        "supported_compute_modes": sorted(COMPUTE_MODES),
        "compute_mode_silently_selected": False,
        "permitted_actions": actions,
        "release_types": releases,
        "limits": limits,
        "hard_safety_rules_are_overridable": False,
    }


def read_only_status(
    root: Path,
    authorization_record: str | None = None,
    confirmation_artifact: str | None = None,
    cost_enforcement_artifact: str | None = None,
    activation_receipt: str | None = None,
) -> dict[str, Any]:
    config = delivery_config(root)
    source_active = False
    supplied = [authorization_record, confirmation_artifact, cost_enforcement_artifact, activation_receipt]
    if any(supplied):
        if not all(supplied):
            raise DeliveryError("active source status requires authorization, confirmation, compute, and activation-receipt artifacts together")
        confirmation = load_json(external_path(root, str(confirmation_artifact), require_file=True))
        record = validate_record(load_json(external_path(root, str(authorization_record), require_file=True)), confirmation)
        active_controls(root, record["contract"])
        validate_cost_evidence(load_json(external_path(root, str(cost_enforcement_artifact), require_file=True)), record["contract"])
        receipt = load_json(external_path(root, str(activation_receipt), require_file=True))
        if not isinstance(receipt, dict) or receipt.get("schema_version") != "harness.autonomous-delivery-activation-receipt.v1" or receipt.get("status") != "active" or receipt.get("authorization_record_digest") != record["accepted_record_digest"]:
            raise DeliveryError("source activation receipt is absent, malformed, or bound to another standing record")
        source_active = True
    return {
        "schema_version": "harness.autonomous-delivery-status.v1",
        "artifact_kind": "derived_read_only_delivery_status",
        "permission_grant": False,
        "read_only": True,
        "status": "active" if source_active else config.get("status", STATUS_AVAILABLE),
        "write_capability": "authorized_within_exact_standing_contract" if source_active else config.get("write_capability", "locked"),
        "external_effects": "authorized_only_through_current_exact_plan_projections" if source_active else config.get("external_effects", "locked"),
        "delivery_profile": record["contract"]["delivery_profile"] if source_active else config.get("delivery_profile"),
        "compute_mode": compute_mode(record["contract"]) if source_active else config.get("compute_mode"),
        "pre_activation_capabilities": [
            "research",
            "context_building",
            "applicability_assessment",
            "planning",
            "status",
            "explanation",
            "activation_preview",
        ],
        "project_hooks_executed": False,
        "repository_mutated": False,
        "external_state_mutated": False,
        "authority_created": False,
        "limitations": config.get("limitations", []),
    }


def context_manifest(root: Path, max_bytes: int, task_ref: str | None) -> dict[str, Any]:
    candidates = ["AGENTS.md", ".agent/project.json", ".agent/state/focus.json"]
    if task_ref:
        candidates.extend(
            path.relative_to(root).as_posix()
            for path in sorted((root / ".agent/tasks").glob(f"{task_ref}*.md"))
            if path.is_file() and not path.is_symlink()
        )
    included: list[dict[str, Any]] = []
    omitted: list[dict[str, Any]] = []
    consumed = 0
    for relative in candidates:
        path = confined(root, relative)
        if not path.is_file() or path.is_symlink():
            omitted.append({"path": relative, "reason": "absent"})
            continue
        size = path.stat().st_size
        item = {"path": relative, "sha256": file_sha256(path), "bytes": size}
        if consumed + size > max_bytes:
            omitted.append({**item, "reason": "byte_budget_exhausted"})
            continue
        included.append({**item, "reason": "deterministic_governing_source"})
        consumed += size
    value = {
        "schema_version": "harness.autonomous-delivery-context.v1",
        "artifact_kind": "derived_read_only_context_manifest",
        "permission_grant": False,
        "read_only": True,
        "task_ref": task_ref,
        "max_bytes": max_bytes,
        "measured_bytes": consumed,
        "included": included,
        "omitted": omitted,
        "project_hooks_executed": False,
        "repository_mutated": False,
        "external_state_mutated": False,
        "limitations": ["Content is referenced by digest and is not copied into this manifest."],
    }
    value["manifest_digest"] = digest(value)
    return value


