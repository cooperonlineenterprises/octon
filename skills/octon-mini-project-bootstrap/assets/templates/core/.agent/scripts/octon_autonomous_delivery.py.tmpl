class DeliveryError(RuntimeError):
    """Fail-closed autonomous-delivery error."""


def duplicate_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise ValueError(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def load_json(path: Path) -> Any:
    try:
        return json.loads(
            path.read_text(encoding="utf-8"),
            object_pairs_hook=duplicate_pairs,
            parse_constant=lambda raw: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON value: {raw}")
            ),
        )
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise DeliveryError(f"cannot load strict JSON {path}: {error}") from error


def canonical_bytes(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8")


def digest(value: Any) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def digest_without(value: dict[str, Any], field: str) -> str:
    candidate = dict(value)
    candidate.pop(field, None)
    return digest(candidate)


def file_sha256(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            value.update(block)
    return value.hexdigest()


def timestamp(value: str, label: str) -> datetime:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError) as error:
        raise DeliveryError(f"{label} must be an ISO-8601 timestamp") from error
    if parsed.tzinfo is None:
        raise DeliveryError(f"{label} requires a timezone")
    return parsed


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def utc_text(value: datetime | None = None) -> str:
    return (value or utc_now()).astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def root_path(raw: str | None) -> Path:
    root = Path(raw or ".").resolve()
    if not root.is_dir() or (root / ".agent").is_symlink():
        raise DeliveryError("target project root is absent or unsafe")
    return root


def confined(root: Path, raw: str, *, require_file: bool = False) -> Path:
    relative = PurePosixPath(raw)
    if relative.is_absolute() or any(part in {"", ".", ".."} for part in relative.parts):
        raise DeliveryError(f"unsafe project path: {raw}")
    candidate = root.joinpath(*relative.parts)
    current = root
    for part in relative.parts[:-1]:
        current = current / part
        if current.is_symlink():
            raise DeliveryError(f"project path has a symlink ancestor: {raw}")
    try:
        candidate.resolve(strict=False).relative_to(root)
    except (OSError, ValueError) as error:
        raise DeliveryError(f"project path escapes target: {raw}") from error
    if require_file and (not candidate.is_file() or candidate.is_symlink()):
        raise DeliveryError(f"required project file is absent or unsafe: {raw}")
    return candidate


def external_path(root: Path, raw: str, *, require_file: bool = False) -> Path:
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute():
        raise DeliveryError("operator-controlled paths must be absolute")
    candidate = candidate.resolve(strict=False)
    try:
        candidate.relative_to(root)
    except ValueError:
        pass
    else:
        raise DeliveryError("operator-controlled paths must remain outside the repository")
    current = Path(candidate.anchor)
    for part in candidate.parts[1:-1]:
        current = current / part
        if current.is_symlink():
            raise DeliveryError("operator-controlled path has a symlink ancestor")
    if require_file and (not candidate.is_file() or candidate.is_symlink()):
        raise DeliveryError(f"required external record is absent or unsafe: {candidate}")
    return candidate


def write_external_new(root: Path, raw: str, value: Any) -> Path:
    path = external_path(root, raw)
    if not path.parent.is_dir() or path.parent.is_symlink():
        raise DeliveryError("external output parent must already exist and be nonsymlinked")
    try:
        with path.open("xb") as handle:
            handle.write(canonical_bytes(value))
            handle.flush()
            os.fsync(handle.fileno())
    except FileExistsError as error:
        raise DeliveryError(f"external output already exists and will not be overwritten: {path}") from error
    return path


def emit(value: Any, output: str | None, root: Path) -> None:
    if output:
        write_external_new(root, output, value)
    else:
        sys.stdout.buffer.write(canonical_bytes(value))


def project(root: Path) -> dict[str, Any]:
    value = load_json(confined(root, ".agent/project.json", require_file=True))
    if not isinstance(value, dict):
        raise DeliveryError("project contract must be an object")
    return value


