    if value is None:
        return {
            "schema_version": "harness.autonomous-delivery-config.v1",
            "status": STATUS_AVAILABLE,
            "write_capability": "locked",
            "external_effects": "locked",
            "delivery_profile": None,
            "adoption_decision_ref": None,
            "authorization_record_ref": None,
            "authorization_record_digest": None,
            "activation_receipt_ref": None,
            "limitations": ["Older snapshot or unprojected configuration; upgrade assessment is required."],
        }
    if not isinstance(value, dict):
        raise DeliveryError("autonomous-delivery project configuration is malformed")
    return value


def profile_preset(profile: str) -> dict[str, Any]:
    if profile not in ALLOWED_PROFILES:
        raise DeliveryError(f"unsupported delivery profile: {profile}")
    if profile == "review_first":
        actions = REVIEW_FIRST_ACTIONS
        releases: list[str] = []
        limits = {**FAST_LIMITS, "covered_releases": 0}
    elif profile == "balanced_autonomous":
        actions = BALANCED_ACTIONS
        releases = ["patch"]
        limits = dict(FAST_LIMITS)
    elif profile == "fast_delivery":
        actions = FAST_ACTIONS
        releases = ["patch", "minor"]
        limits = dict(FAST_LIMITS)
    else:
        actions = []
        releases = []
        limits = dict(FAST_LIMITS)
    return {
        "profile": profile,
        "recommended_for_most_solo_developers": profile == "fast_delivery",
        "silently_selected": False,
        "permitted_actions": actions,
        "release_types": releases,
        "limits": limits,
        "hard_safety_rules_are_overridable": False,
    }


def read_only_status(
    root: Path,
    authorization_record: str | None = None,
    confirmation_artifact: str | None = None,
    cost_enforcement_artifact: str | None = None,
    activation_receipt: str | None = None,
) -> dict[str, Any]:
    config = delivery_config(root)
    source_active = False
    supplied = [authorization_record, confirmation_artifact, cost_enforcement_artifact, activation_receipt]
    if any(supplied):
        if not all(supplied):
            raise DeliveryError("active source status requires authorization, confirmation, cost, and activation-receipt artifacts together")
        confirmation = load_json(external_path(root, str(confirmation_artifact), require_file=True))
        record = validate_record(load_json(external_path(root, str(authorization_record), require_file=True)), confirmation)
        active_controls(root, record["contract"])
        validate_cost_evidence(load_json(external_path(root, str(cost_enforcement_artifact), require_file=True)), record["contract"])
        receipt = load_json(external_path(root, str(activation_receipt), require_file=True))
        if not isinstance(receipt, dict) or receipt.get("schema_version") != "harness.autonomous-delivery-activation-receipt.v1" or receipt.get("status") != "active" or receipt.get("authorization_record_digest") != record["accepted_record_digest"]:
            raise DeliveryError("source activation receipt is absent, malformed, or bound to another standing record")
        source_active = True
    return {
        "schema_version": "harness.autonomous-delivery-status.v1",
        "artifact_kind": "derived_read_only_delivery_status",
        "permission_grant": False,
        "read_only": True,
        "status": "active" if source_active else config.get("status", STATUS_AVAILABLE),
        "write_capability": "authorized_within_exact_standing_contract" if source_active else config.get("write_capability", "locked"),
        "external_effects": "authorized_only_through_current_exact_plan_projections" if source_active else config.get("external_effects", "locked"),
        "delivery_profile": record["contract"]["delivery_profile"] if source_active else config.get("delivery_profile"),
        "pre_activation_capabilities": [
            "research",
            "context_building",
            "applicability_assessment",
            "planning",
            "status",
            "explanation",
            "activation_preview",
        ],
        "project_hooks_executed": False,
        "repository_mutated": False,
        "external_state_mutated": False,
        "authority_created": False,
        "limitations": config.get("limitations", []),
    }


def context_manifest(root: Path, max_bytes: int, task_ref: str | None) -> dict[str, Any]:
    candidates = ["AGENTS.md", ".agent/project.json", ".agent/state/focus.json"]
    if task_ref:
        candidates.extend(
            path.relative_to(root).as_posix()
            for path in sorted((root / ".agent/tasks").glob(f"{task_ref}*.md"))
            if path.is_file() and not path.is_symlink()
        )
    included: list[dict[str, Any]] = []
    omitted: list[dict[str, Any]] = []
    consumed = 0
    for relative in candidates:
        path = confined(root, relative)
        if not path.is_file() or path.is_symlink():
            omitted.append({"path": relative, "reason": "absent"})
            continue
        size = path.stat().st_size
        item = {"path": relative, "sha256": file_sha256(path), "bytes": size}
        if consumed + size > max_bytes:
            omitted.append({**item, "reason": "byte_budget_exhausted"})
            continue
        included.append({**item, "reason": "deterministic_governing_source"})
        consumed += size
    value = {
        "schema_version": "harness.autonomous-delivery-context.v1",
        "artifact_kind": "derived_read_only_context_manifest",
        "permission_grant": False,
        "read_only": True,
        "task_ref": task_ref,
        "max_bytes": max_bytes,
        "measured_bytes": consumed,
        "included": included,
        "omitted": omitted,
        "project_hooks_executed": False,
        "repository_mutated": False,
        "external_state_mutated": False,
        "limitations": ["Content is referenced by digest and is not copied into this manifest."],
    }
    value["manifest_digest"] = digest(value)
    return value


