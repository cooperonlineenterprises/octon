def generated_string_list(raw: str) -> list[str]:
    """Decode a rendered manifest projection; source templates use an empty view."""
    if raw.startswith("{{"):
        return []
    value = json.loads(raw)
    if (
        not isinstance(value, list)
        or any(not isinstance(item, str) or not item for item in value)
        or len(value) != len(set(value))
    ):
        raise ValueError("generated manifest projection must be a unique string array")
    return value


