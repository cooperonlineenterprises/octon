class DuplicateKeyError(ValueError):
    """Raised when strict JSON encounters a repeated object key."""


def relative(path: Path, root: Path = ROOT) -> str:
    return path.relative_to(root).as_posix()


def safe_diagnostic(value: Any) -> str:
    """Escape control characters before a finding reaches logs or callers."""
    text = str(value)
    escaped: list[str] = []
    for character in text:
        codepoint = ord(character)
        if codepoint < 32 or codepoint == 127:
            escaped.append(
                {
                    "\n": r"\n",
                    "\r": r"\r",
                    "\t": r"\t",
                }.get(character, f"\\x{codepoint:02x}")
            )
        else:
            escaped.append(character)
    return "".join(escaped)


def strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateKeyError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def reject_json_constant(value: str) -> None:
    raise ValueError(f"non-finite JSON number is prohibited: {value}")


def loads_json(text: str) -> Any:
    return json.loads(
        text,
        object_pairs_hook=strict_object,
        parse_constant=reject_json_constant,
    )


def load_json(path: Path) -> Any:
    return loads_json(path.read_text(encoding="utf-8"))


def freshness_deadline(value: Any) -> datetime | None:
    """Parse a date or timezone-aware date-time as an inclusive deadline."""
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if "T" in value or " " in value:
            return parsed if parsed.tzinfo is not None else None
    except ValueError:
        pass
    try:
        return datetime.combine(
            date.fromisoformat(value),
            datetime.max.time(),
        ).astimezone()
    except ValueError:
        return None


def _collaboration_baseline_errors(profile: dict[str, Any]) -> list[str]:
    """Require an unassessed profile to remain fact-free and non-selecting."""
    errors: list[str] = []
    if profile.get("schema_version") == "harness.collaboration-profile.v2":
        facts = profile.get("facts", {})
        if not isinstance(facts, dict) or set(facts) != {
            "writer_count",
            "solo_integration_preference",
            "independent_review_capacity",
            "concurrency",
            "external_contribution_mode",
        }:
            return ["collaboration_profile facts must use the closed v2 contract"]
        for fact_id, fact in facts.items():
            if not isinstance(fact, dict):
                errors.append(f"collaboration_profile facts.{fact_id} must be an object")
                continue
            values = [value for key, value in fact.items() if key != "evidence"]
            if any(value is not None for value in values) or fact.get("evidence") is not None:
                errors.append(f"collaboration_profile facts.{fact_id} must remain unknown before assessment")
        if profile.get("team_band") != "unknown" or profile.get("concurrent_work") is not False:
            errors.append("collaboration_profile unassessed v2 result must remain unknown and nonconcurrent")
        if profile.get("conflicting_signals") != []:
            errors.append("collaboration_profile conflicting_signals must be empty before assessment")
        if profile.get("workflow_selection") != {
            "status": "not_assessed",
            "base_workflow": None,
            "modifiers": [],
            "review_mode": "not_assessed",
            "integration_method": None,
            "adoption_decision_ref": None,
            "used_fact_ids": [],
        }:
            errors.append("collaboration_profile unassessed v2 baseline must not select a workflow")
        if "generated_unassessed_baseline" not in profile.get("limitations", []):
            errors.append("collaboration_profile v2 baseline must disclose its generated limitation")
        return errors
    expected_nulls = {
        "declared_write_capable_humans": None,
        "independent_review_capacity": None,
        "assessed_at": None,
        "reassess_after": None,
    }
    for field, expected in expected_nulls.items():
        if profile.get(field) is not expected:
            errors.append(f"collaboration_profile.{field} must remain null before assessment")
    if profile.get("confidence") != "unknown":
        errors.append("collaboration_profile confidence must be unknown before assessment")
    if profile.get("team_band") != "unknown":
        errors.append("collaboration_profile team_band must be unknown before assessment")
    if profile.get("external_contribution_mode") != "unknown":
        errors.append(
            "collaboration_profile external_contribution_mode must be unknown before assessment"
        )
    if profile.get("solo_integration_preference") != "unknown":
        errors.append(
            "collaboration_profile solo_integration_preference must be unknown before assessment"
        )
    for field, keys in (
        (
            "observed_repository_access",
            ("write_capable_humans", "read_only_humans", "bots_or_automation"),
        ),
        (
            "active_contributors",
            ("human_count", "bots_or_automation_count", "window_days"),
        ),
        (
            "expected_concurrent_repository_writers",
            ("humans", "agents_or_automation"),
        ),
    ):
        value = profile.get(field, {})
        if not isinstance(value, dict) or any(value.get(key) is not None for key in keys):
            errors.append(f"collaboration_profile.{field} must remain unknown before assessment")
    if profile.get("evidence") != []:
        errors.append("collaboration_profile evidence must be empty before assessment")
    if profile.get("conflicting_signals") != []:
        errors.append(
            "collaboration_profile conflicting_signals must be empty before assessment"
        )
    limitations = profile.get("limitations", [])
    if "generated_unassessed_baseline" not in limitations:
        errors.append(
            "collaboration_profile unassessed baseline must disclose its generated limitation"
        )
    selection = profile.get("workflow_selection", {})
    if selection != {
        "status": "not_assessed",
        "base_workflow": None,
        "modifiers": [],
        "review_mode": "not_assessed",
        "integration_method": None,
        "adoption_decision_ref": None,
    }:
        errors.append(
            "collaboration_profile unassessed baseline must not select or adopt a workflow"
        )
    return errors


def derive_collaboration_assessment(
    profile: dict[str, Any],
    *,
    now: datetime | None = None,
) -> tuple[dict[str, Any], list[str]]:
    """Derive a non-authorizing small-team classification from aggregate facts."""
    if profile.get("schema_version") == "harness.collaboration-profile.v2":
        now = now or datetime.now().astimezone()
        errors: list[str] = []
        facts = profile.get("facts", {})
        writer = facts.get("writer_count", {}) if isinstance(facts, dict) else {}
        writer_count = writer.get("value") if isinstance(writer, dict) else None
        band = (
            "solo" if writer_count == 1
            else "pair" if writer_count == 2
            else "tiny" if isinstance(writer_count, int) and 3 <= writer_count <= 5
            else "unsupported" if isinstance(writer_count, int) and writer_count > 5
            else "unknown"
        )
        concurrency = facts.get("concurrency", {}) if isinstance(facts, dict) else {}
        concurrent = bool(
            isinstance(concurrency, dict)
            and isinstance(concurrency.get("human_writers"), int)
            and isinstance(concurrency.get("agents_or_automation"), int)
            and concurrency["human_writers"] + concurrency["agents_or_automation"] > 1
        )
        used = ["writer_count"]
        selection = {
            "base_workflow": None,
            "modifiers": ["concurrent_work"] if concurrent else [],
            "review_mode": "not_assessed",
            "integration_method": None,
        }
        status = "withheld"
        required_ids: list[str] = []
        if profile.get("assessment_status") == "not_assessed":
            status = "not_assessed"
        elif profile.get("conflicting_signals"):
            status = "withheld"
        elif band == "solo":
            required_ids = ["writer_count", "solo_integration_preference"]
            preference = facts.get("solo_integration_preference", {}).get("value")
            used.append("solo_integration_preference")
            if preference in {"direct", "reviewable"}:
                selection["base_workflow"] = "solo_hybrid" if preference == "reviewable" or concurrent else "solo_direct"
                selection["review_mode"] = "self_review" if selection["base_workflow"] == "solo_hybrid" else "none"
                selection["integration_method"] = "not_applicable" if selection["base_workflow"] == "solo_direct" else None
                status = "proposed"
        elif band in {"pair", "tiny"}:
            required_ids = ["writer_count", "independent_review_capacity"]
            capacity = facts.get("independent_review_capacity", {}).get("value")
            used.append("independent_review_capacity")
            if isinstance(capacity, bool):
                selection["base_workflow"] = "pair_pr" if band == "pair" else "tiny_pr"
                selection["review_mode"] = "one_peer_when_available" if capacity else "block_when_peer_unavailable"
                status = "proposed"
        if concurrent:
            required_ids.append("concurrency")
            used.append("concurrency")
        stored_used = profile.get("workflow_selection", {}).get("used_fact_ids", [])
        if "external_contribution_mode" in stored_used:
            required_ids.append("external_contribution_mode")
            used.append("external_contribution_mode")
        stale = False
        for fact_id in set(required_ids):
            fact = facts.get(fact_id, {}) if isinstance(facts, dict) else {}
            evidence = fact.get("evidence") if isinstance(fact, dict) else None
            if not isinstance(evidence, dict):
                errors.append(f"collaboration_profile facts.{fact_id} lacks evidence used by the result")
                status = "withheld"
                continue
            observed = freshness_deadline(evidence.get("observed_at"))
            expires = freshness_deadline(evidence.get("expires_at"))
            if observed is None or expires is None or expires <= observed:
                errors.append(f"collaboration_profile facts.{fact_id} evidence time bounds are invalid")
                status = "withheld"
            if expires is not None and expires < now:
                stale = True
                status = "withheld"
        if stale:
            errors.append("collaboration_profile evidence used by the result is stale")
        return {
            "schema_version": "harness.collaboration-assessment.v2",
            "permission_grant": False,
            "assessment_status": profile.get("assessment_status"),
            "team_band": band,
            "concurrent_work": concurrent,
            "status": status,
            "recommendation": selection,
            "used_fact_ids": sorted(set(used if status == "proposed" else [])),
            "limitations": ["Only facts used by the result require current evidence."],
            "non_authorization": "This proposal adopts no workflow and grants no permission.",
        }, errors
    now = now or datetime.now().astimezone()
    errors: list[str] = []
    limitations: list[str] = []
    assessment_status = profile.get("assessment_status")
    declared = profile.get("declared_write_capable_humans")
    access = profile.get("observed_repository_access", {})
    observed = access.get("write_capable_humans") if isinstance(access, dict) else None
    active = profile.get("active_contributors", {})
    concurrency = profile.get("expected_concurrent_repository_writers", {})
    review_capacity = profile.get("independent_review_capacity")
    external_mode = profile.get("external_contribution_mode")
    solo_preference = profile.get("solo_integration_preference")
    conflicts = profile.get("conflicting_signals", [])
    evidence = profile.get("evidence", [])

    report: dict[str, Any] = {
        "schema_version": "harness.collaboration-assessment.v1",
        "permission_grant": False,
        "assessment_status": assessment_status,
        "confidence": "unknown",
        "counts": {
            "declared_write_capable_humans": declared,
            "observed_write_capable_humans": observed,
            "observed_read_only_humans_excluded": (
                access.get("read_only_humans") if isinstance(access, dict) else None
            ),
            "observed_bots_or_automation_excluded": (
                access.get("bots_or_automation") if isinstance(access, dict) else None
            ),
            "active_human_contributors": (
                active.get("human_count") if isinstance(active, dict) else None
            ),
            "active_bots_or_automation_excluded": (
                active.get("bots_or_automation_count")
                if isinstance(active, dict)
                else None
            ),
            "active_contributor_window_days": (
                active.get("window_days") if isinstance(active, dict) else None
            ),
            "independent_review_capacity": review_capacity,
            "expected_concurrent_humans": (
                concurrency.get("humans") if isinstance(concurrency, dict) else None
            ),
            "expected_concurrent_agents_or_automation": (
                concurrency.get("agents_or_automation")
                if isinstance(concurrency, dict)
                else None
            ),
        },
        "team_band": "unknown",
        "status": "not_assessed",
        "recommendation": {
            "base_workflow": None,
            "modifiers": [],
            "review_mode": "not_assessed",
            "integration_method": None,
        },
        "limitations": limitations,
        "non_authorization": (
            "This assessment classifies aggregate observations only; it grants no "
            "permission and never adopts or publishes a workflow."
        ),
    }
    if assessment_status != "assessed":
        limitations.append("collaboration_profile_not_assessed")
        return report, errors

    if not isinstance(declared, (int, type(None))) or isinstance(declared, bool):
        errors.append("collaboration_profile declared writer count is invalid")
        declared = None
    if not isinstance(observed, (int, type(None))) or isinstance(observed, bool):
        errors.append("collaboration_profile observed writer count is invalid")
        observed = None
    writer_signals = [value for value in (declared, observed) if isinstance(value, int)]
    declared_conflict = (
        isinstance(declared, int)
        and isinstance(observed, int)
        and declared != observed
    )
    listed_declared_conflict = (
        "declared_vs_observed_write_capable_humans" in conflicts
        if isinstance(conflicts, list)
        else False
    )
    if declared_conflict != listed_declared_conflict:
        errors.append(
            "collaboration_profile declared/observed disagreement must be recorded exactly"
        )
    has_conflict = declared_conflict or bool(conflicts)
    if has_conflict:
        expected_confidence = "conflicted"
    elif len(writer_signals) == 2:
        expected_confidence = "confirmed"
    elif len(writer_signals) == 1:
        expected_confidence = "inferred"
    else:
        expected_confidence = "unknown"
    report["confidence"] = expected_confidence
    if profile.get("confidence") != expected_confidence:
        errors.append(
            "collaboration_profile confidence is inconsistent with declared and observed signals"
        )

    missing_signals: list[str] = []
    if not writer_signals:
        missing_signals.append("write_capable_human_signal")
    if isinstance(observed, int) and isinstance(access, dict):
        for key in ("read_only_humans", "bots_or_automation"):
            if not isinstance(access.get(key), int):
                missing_signals.append(f"observed_repository_access.{key}")
    if not isinstance(active, dict) or any(
        not isinstance(active.get(key), int)
        for key in ("human_count", "bots_or_automation_count", "window_days")
    ):
        missing_signals.append("active_contributors")
    if not isinstance(review_capacity, int) or isinstance(review_capacity, bool):
        missing_signals.append("independent_review_capacity")
    concurrent_humans = concurrency.get("humans") if isinstance(concurrency, dict) else None
    concurrent_agents = (
        concurrency.get("agents_or_automation") if isinstance(concurrency, dict) else None
    )
    if (
        not isinstance(concurrent_humans, int)
        or isinstance(concurrent_humans, bool)
        or not isinstance(concurrent_agents, int)
        or isinstance(concurrent_agents, bool)
    ):
        missing_signals.append("expected_concurrent_repository_writers")
    if external_mode in {None, "unknown"}:
        missing_signals.append("external_contribution_mode")

    assessed_at = freshness_deadline(profile.get("assessed_at"))
    reassess_after = freshness_deadline(profile.get("reassess_after"))
    if assessed_at is None:
        missing_signals.append("assessed_at")
    if reassess_after is None:
        missing_signals.append("reassess_after")
    if assessed_at is not None and assessed_at > now:
        errors.append("collaboration_profile assessed_at may not be in the future")
    if (
        assessed_at is not None
        and reassess_after is not None
        and reassess_after <= assessed_at
    ):
        errors.append("collaboration_profile reassess_after must follow assessed_at")

    required_supports: set[str] = {
        "active_contributors",
        "independent_review_capacity",
        "expected_concurrent_repository_writers",
        "external_contribution_mode",
    }
    if isinstance(declared, int):
        required_supports.add("declared_write_capable_humans")
    if isinstance(observed, int):
        required_supports.add("observed_repository_access")

    stale = reassess_after is not None and reassess_after < now
    supported_by_fresh_evidence: set[str] = set()
    if not isinstance(evidence, list) or not evidence:
        missing_signals.append("evidence")
    else:
        for index, item in enumerate(evidence):
            if not isinstance(item, dict):
                continue
            observed_at = freshness_deadline(item.get("observed_at"))
            fresh_until = freshness_deadline(item.get("fresh_until"))
            if observed_at is None or fresh_until is None:
                continue
            if fresh_until <= observed_at:
                errors.append(
                    f"collaboration_profile.evidence[{index}] fresh_until must follow observed_at"
                )
            if assessed_at is not None and observed_at > assessed_at:
                errors.append(
                    f"collaboration_profile.evidence[{index}] was observed after assessed_at"
                )
            if fresh_until < now:
                stale = True
            else:
                supports = item.get("supports", [])
                if isinstance(supports, list):
                    supported_by_fresh_evidence.update(
                        value
                        for value in supports
                        if value in COLLABORATION_EVIDENCE_SUPPORTS
                    )
    missing_evidence = sorted(required_supports - supported_by_fresh_evidence)
    if missing_evidence:
        limitations.extend(f"missing_fresh_evidence:{item}" for item in missing_evidence)

    unsupported = any(
        value > MAXIMUM_SUPPORTED_WRITE_CAPABLE_HUMANS
        for value in writer_signals
    )
    writer_count: int | None
    if unsupported:
        writer_count = max(writer_signals)
    elif has_conflict or not writer_signals:
        writer_count = None
    else:
        writer_count = writer_signals[0]

    if unsupported:
        band = "unsupported_team_size"
    elif writer_count == 0:
        band = "no_write_capable_human"
    elif writer_count == 1:
        band = "solo"
    elif writer_count == 2:
        band = "pair"
    elif isinstance(writer_count, int) and 3 <= writer_count <= 5:
        band = "tiny"
    else:
        band = "unknown"
    report["team_band"] = band

    if band == "solo":
        required_supports.add("solo_integration_preference")
        if solo_preference not in {"direct", "reviewable"}:
            missing_signals.append("solo_integration_preference")
        if "solo_integration_preference" not in supported_by_fresh_evidence:
            missing_evidence = sorted(
                set(missing_evidence) | {"solo_integration_preference"}
            )
            marker = "missing_fresh_evidence:solo_integration_preference"
            if marker not in limitations:
                limitations.append(marker)

    if isinstance(concurrent_humans, int) and isinstance(writer_count, int):
        if concurrent_humans > writer_count:
            errors.append(
                "collaboration_profile concurrent human writers exceed write-capable humans"
            )

    is_unknown = bool(missing_signals or missing_evidence) or expected_confidence == "unknown"
    if unsupported:
        status = "unsupported_team_size"
        limitations.append("teams_larger_than_five_are_outside_supported_scope")
    elif stale:
        status = "blocked_stale"
        limitations.append("collaboration_evidence_or_reassessment_is_stale")
    elif has_conflict:
        status = "blocked_conflicted"
        limitations.append("collaboration_signals_conflict")
    elif is_unknown:
        status = "blocked_unknown"
        limitations.extend(f"missing_signal:{item}" for item in sorted(set(missing_signals)))
    elif band == "no_write_capable_human":
        status = "blocked_no_writer"
        limitations.append("no_write_capable_human_is_established")
    else:
        status = "recommended"

    recommendation = report["recommendation"]
    if status == "recommended":
        total_concurrency = int(concurrent_humans) + int(concurrent_agents)
        modifiers = ["concurrent_work"] if total_concurrency > 1 else []
        if band == "solo":
            base = (
                "solo_hybrid"
                if solo_preference == "reviewable" or modifiers
                else "solo_direct"
            )
            review_mode = "self_review" if base == "solo_hybrid" else "none"
        elif band == "pair":
            base = "pair_pr"
            review_mode = (
                "one_peer_when_available"
                if int(review_capacity) >= 1
                else "block_when_peer_unavailable"
            )
        else:
            base = "tiny_pr"
            review_mode = (
                "one_peer_when_available"
                if int(review_capacity) >= 1
                else "block_when_peer_unavailable"
            )
        stored_integration = profile.get("workflow_selection", {}).get(
            "integration_method"
        )
        if base == "solo_direct":
            integration = "not_applicable"
        elif stored_integration in {
            "merge_commit",
            "squash_merge",
            "rebase_then_fast_forward",
        }:
            integration = stored_integration
        else:
            integration = None
            limitations.append("integration_method_requires_project_choice")
        recommendation.update(
            base_workflow=base,
            modifiers=modifiers,
            review_mode=review_mode,
            integration_method=integration,
        )
    report["status"] = status
    report["limitations"] = list(dict.fromkeys(limitations))
    return report, errors


def check_collaboration_profile(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    """Check stored assessment coherence and project-owned workflow adoption."""
    try:
        project = load_json(root / ".agent/project.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/project.json: {error}"]
    if not isinstance(project, dict):
        return [".agent/project.json: expected object"]
    profile = project.get("collaboration_profile")
    if not isinstance(profile, dict):
        return [".agent/project.json: collaboration_profile must be an object"]
    if profile.get("permission_grant") is not False:
        return [".agent/project.json: collaboration_profile cannot grant permission"]
    if profile.get("assessment_status") == "not_assessed":
        return [f".agent/project.json: {item}" for item in _collaboration_baseline_errors(profile)]

    if profile.get("schema_version") == "harness.collaboration-profile.v2":
        try:
            schema = load_schema(root, "harness-collaboration-profile.schema.json")
        except (OSError, ValueError, json.JSONDecodeError) as error:
            return [f".agent/project.json: {error}"]
        result = [
            f".agent/project.json: collaboration_profile {item}"
            for item in validate_schema(profile, schema)
        ]
        report, report_errors = derive_collaboration_assessment(profile)
        result.extend(f".agent/project.json: {item}" for item in report_errors)
        if profile.get("team_band") != report["team_band"]:
            result.append(".agent/project.json: stored team_band differs from progressive collaboration evidence")
        if profile.get("concurrent_work") != report["concurrent_work"]:
            result.append(".agent/project.json: concurrent_work modifier differs from used concurrency fact")
        selection = profile.get("workflow_selection", {})
        expected_status = report["status"]
        if expected_status == "proposed" and selection.get("status") not in {"proposed", "adopted"}:
            result.append(".agent/project.json: supported collaboration result must remain proposed or explicitly adopted")
        if expected_status != "proposed" and selection.get("status") not in {expected_status, "not_assessed"}:
            result.append(".agent/project.json: incomplete collaboration evidence must select no workflow")
        if expected_status == "proposed":
            for field in ("base_workflow", "modifiers", "review_mode"):
                if selection.get(field) != report["recommendation"][field]:
                    result.append(f".agent/project.json: workflow_selection.{field} differs from progressive evidence result")
            if sorted(selection.get("used_fact_ids", [])) != report["used_fact_ids"]:
                result.append(".agent/project.json: workflow_selection.used_fact_ids is incomplete")
        elif any((selection.get("base_workflow") is not None, selection.get("modifiers") != [], selection.get("used_fact_ids") != [])):
            result.append(".agent/project.json: withheld collaboration result must not select a workflow")
        if selection.get("status") == "adopted":
            decision_ref = selection.get("adoption_decision_ref")
            record = records.get(decision_ref) if isinstance(decision_ref, str) else None
            if record is None or record[0].get("status") != "accepted" or not str(record[0].get("authority_source", "")).startswith(("authority:", "external:")):
                result.append(".agent/project.json: adopted workflow lacks accepted project-owned authority")
        return list(dict.fromkeys(result))

    report, errors = derive_collaboration_assessment(profile)
    result = [f".agent/project.json: {item}" for item in errors]
    if profile.get("team_band") != report["team_band"]:
        result.append(
            ".agent/project.json: stored team_band differs from aggregate collaboration signals"
        )
    selection = profile.get("workflow_selection", {})
    derived_status = report["status"]
    stored_status = selection.get("status") if isinstance(selection, dict) else None
    if derived_status == "recommended":
        if stored_status not in {"recommended", "adopted"}:
            result.append(
                ".agent/project.json: fresh supported topology must be recommended or deliberately adopted"
            )
        recommendation = report["recommendation"]
        for field in ("base_workflow", "modifiers", "review_mode"):
            if selection.get(field) != recommendation[field]:
                result.append(
                    f".agent/project.json: workflow_selection.{field} differs from topology-derived workflow"
                )
        integration = selection.get("integration_method")
        if recommendation["base_workflow"] == "solo_direct":
            if integration != "not_applicable":
                result.append(
                    ".agent/project.json: solo_direct integration_method must be not_applicable"
                )
        elif integration not in {
            "merge_commit",
            "squash_merge",
            "rebase_then_fast_forward",
        }:
            result.append(
                ".agent/project.json: reviewable workflow requires one documented integration method"
            )
    else:
        if stored_status != derived_status:
            result.append(
                ".agent/project.json: workflow_selection status does not fail closed for the assessment"
            )
        if any(
            (
                selection.get("base_workflow") is not None,
                selection.get("modifiers") != [],
                selection.get("review_mode") != "not_assessed",
                selection.get("integration_method") is not None,
                selection.get("adoption_decision_ref") is not None,
            )
        ):
            result.append(
                ".agent/project.json: blocked or unsupported assessment must not select a workflow"
            )

    decision_ref = selection.get("adoption_decision_ref")
    if stored_status == "adopted":
        record = records.get(decision_ref) if isinstance(decision_ref, str) else None
        if (
            record is None
            or not str(decision_ref).startswith("DEC-")
            or record[0].get("status") != "accepted"
            or not str(record[0].get("authority_source", "")).startswith(
                ("authority:", "external:")
            )
        ):
            result.append(
                ".agent/project.json: adopted workflow lacks a resolving accepted project-owned decision"
            )
    elif decision_ref is not None:
        result.append(
            ".agent/project.json: workflow adoption decision is set before workflow adoption"
        )

    for index, evidence in enumerate(profile.get("evidence", [])):
        if not isinstance(evidence, dict):
            continue
        source_ref = evidence.get("source_ref")
        if isinstance(source_ref, str) and source_ref.startswith(("DEC-", "EVD-")):
            record = records.get(source_ref)
            if record is None:
                result.append(
                    f".agent/project.json: unresolved collaboration evidence source {source_ref}"
                )
            elif source_ref.startswith("DEC-") and (
                record[0].get("status") != "accepted"
                or not str(record[0].get("authority_source", "")).startswith(
                    ("authority:", "external:")
                )
            ):
                result.append(
                    f".agent/project.json: collaboration decision source {source_ref} is not accepted authority"
                )
    return list(dict.fromkeys(result))


def _contract_digest(value: Any) -> str:
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def check_tool_operation_contract(tools: dict[str, Any]) -> list[str]:
    """Enforce the exact closed Git and hosted-change operation vocabulary."""
    errors: list[str] = []
    catalogs = tools.get("tools", {}) if isinstance(tools, dict) else {}
    git = catalogs.get("git", {}) if isinstance(catalogs, dict) else {}
    hosted = catalogs.get("hosted_change", {}) if isinstance(catalogs, dict) else {}
    for name, catalog, expected_ids, expected_digest in (
        ("git", git, GIT_OPERATION_IDS, EXPECTED_GIT_CATALOG_SHA256),
        (
            "hosted_change",
            hosted,
            HOSTED_CHANGE_OPERATION_IDS,
            EXPECTED_HOSTED_CHANGE_CATALOG_SHA256,
        ),
    ):
        if not isinstance(catalog, dict):
            errors.append(f".agent/tools.json: {name} operation catalog must be an object")
            continue
        if catalog.get("availability") != "optional":
            errors.append(f".agent/tools.json: {name} availability must remain optional")
        if catalog.get("unknown_operations") != "deny":
            errors.append(f".agent/tools.json: {name} unknown operations must fail closed")
        operations = catalog.get("operations", [])
        if not isinstance(operations, list):
            errors.append(f".agent/tools.json: {name}.operations must be an array")
            continue
        ids = [item.get("id") for item in operations if isinstance(item, dict)]
        if ids != list(expected_ids):
            errors.append(
                f".agent/tools.json: {name} operation vocabulary or ordering differs from the kernel"
            )
        if len(ids) != len(set(ids)):
            errors.append(f".agent/tools.json: {name} operation IDs must be unique")
        for index, operation in enumerate(operations):
            if not isinstance(operation, dict):
                continue
            effects = operation.get("effects", [])
            authority = operation.get("authority_class")
            if (
                not isinstance(effects, list)
                or not effects
                or len(effects) != len(set(effects))
                or any(effect not in GIT_EFFECTS for effect in effects)
            ):
                errors.append(
                    f".agent/tools.json: {name}.operations[{index}] has invalid effects"
                )
            if authority not in GIT_AUTHORITY_CLASSES:
                errors.append(
                    f".agent/tools.json: {name}.operations[{index}] has invalid authority_class"
                )
        if _contract_digest(catalog) != expected_digest:
            errors.append(
                f".agent/tools.json: {name} effects, authority, workflow status, or safeguards differ from the versioned contract"
            )

    by_id = {
        item.get("id"): item
        for item in git.get("operations", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    } if isinstance(git, dict) else {}
    for legacy in ("branch", "remote_mutation"):
        if legacy in by_id:
            errors.append(f".agent/tools.json: vague legacy Git operation {legacy} is prohibited")
    for prohibited in ("pull", "force_push"):
        operation = by_id.get(prohibited, {})
        if (
            operation.get("authority_class") != "prohibited"
            or operation.get("normal_workflow") is not False
        ):
            errors.append(
                f".agent/tools.json: {prohibited} must remain explicitly prohibited"
            )
    fetch = by_id.get("fetch_remote", {})
    if (
        fetch.get("effects") != ["local_reference_mutation", "network_access"]
        or fetch.get("authority_class") != "explicit_current_authorization"
        or "perform_no_implicit_integration_or_prune" not in fetch.get("safeguards", [])
    ):
        errors.append(
            ".agent/tools.json: fetch_remote must be authorized network/local-ref observation without implicit integration"
        )
    force_with_lease = by_id.get("force_push_with_lease", {})
    if (
        force_with_lease.get("authority_class")
        != "exceptional_current_authorization"
        or force_with_lease.get("normal_workflow") is not False
        or not {
            "require_exact_current_history_replacement_authority",
            "require_a_non_default_short_lived_branch",
            "require_the_expected_remote_object_lease",
            "name_the_exact_repository_remote_and_ref",
            "default_branch_history_replacement_is_forbidden",
        }.issubset(set(force_with_lease.get("safeguards", [])))
    ):
        errors.append(
            ".agent/tools.json: force_push_with_lease lacks exact non-default branch authority and lease safeguards"
        )
    for tag_operation in ("create_annotated_tag", "push_tag"):
        operation = by_id.get(tag_operation, {})
        if (
            operation.get("authority_class") != "separate_release_authorization"
            or operation.get("normal_workflow") is not False
        ):
            errors.append(
                f".agent/tools.json: {tag_operation} requires separate release authority"
            )
    for safe_cleanup in ("remove_clean_worktree", "delete_merged_branch"):
        operation = by_id.get(safe_cleanup, {})
        if (
            operation.get("authority_class") != "task_scoped"
            or operation.get("normal_workflow") is not True
        ):
            errors.append(
                f".agent/tools.json: {safe_cleanup} must remain the bounded normal cleanup path"
            )
    for destructive in (
        "reset_hard",
        "clean_untracked",
        "discard_worktree_changes",
        "delete_unmerged_branch",
        "remove_dirty_worktree",
        "delete_or_move_tag",
    ):
        operation = by_id.get(destructive, {})
        if (
            operation.get("authority_class") != "destructive_current_authorization"
            or operation.get("normal_workflow") is not False
            or "destructive_recovery" not in operation.get("effects", [])
        ):
            errors.append(
                f".agent/tools.json: {destructive} must remain exceptional destructive recovery"
            )
    return list(dict.fromkeys(errors))


def check_git_workflows(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]] | None = None,
) -> list[str]:
    """Validate the complete provider-neutral one-to-five-person workflow portfolio."""
    scm_path = root / ".agent/scm.json"
    try:
        scm = load_json(scm_path)
        scm_schema = load_schema(root, "harness-scm.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/scm.json: {error}"]
    errors = [
        f".agent/scm.json: {item}" for item in validate_schema(scm, scm_schema)
    ]
    if not isinstance(scm, dict):
        return errors
    selection = scm.get("selection")
    decision_ref = scm.get("selection_decision_ref")
    if selection == "not_assessed":
        if decision_ref is not None:
            errors.append(".agent/scm.json: unassessed SCM cannot cite a selection decision")
    else:
        record = records.get(decision_ref) if records is not None and isinstance(decision_ref, str) else None
        if (
            record is None
            or record[0].get("status") != "accepted"
            or not str(record[0].get("authority_source", "")).startswith(("authority:", "external:"))
        ):
            errors.append(".agent/scm.json: assessed SCM selection lacks an accepted project-owned decision")
    portfolio = scm.get("portfolio", {})
    if isinstance(portfolio, dict):
        if portfolio.get("version") != EXPECTED_GIT_PORTFOLIO_VERSION:
            errors.append(".agent/scm.json: portfolio version differs from the versioned package")
        if portfolio.get("sha256") != EXPECTED_GIT_PORTFOLIO_SHA256:
            errors.append(".agent/scm.json: portfolio digest differs from the versioned package")
    workflow_root = root / ".agent/workflows"
    if scm.get("selection") != "git":
        if isinstance(portfolio, dict) and portfolio.get("status") != "not_installed":
            errors.append(".agent/scm.json: non-Git selection cannot install the Git portfolio")
        if workflow_root.exists():
            errors.append(".agent/workflows: Git portfolio is installed without Git selection")
        return errors
    if not isinstance(portfolio, dict) or portfolio.get("status") != "installed":
        errors.append(".agent/scm.json: Git selection requires the vendored portfolio")
        return errors
    path = root / ".agent/workflows/small-team-git.json"
    try:
        value = load_json(path)
        schema = load_schema(root, "harness-git-workflows.schema.json")
        tools = load_json(root / ".agent/tools.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/workflows/small-team-git.json: {error}"]
    errors.extend(
        f".agent/workflows/small-team-git.json: {item}"
        for item in validate_schema(value, schema)
    )
    if not isinstance(value, dict) or not isinstance(tools, dict):
        return errors
    if _contract_digest(value) != EXPECTED_GIT_WORKFLOW_SHA256:
        errors.append(
            ".agent/workflows/small-team-git.json: workflow portfolio differs from the versioned contract"
        )
    if value.get("supported_base_workflows") != list(SUPPORTED_BASE_WORKFLOWS):
        errors.append(
            ".agent/workflows/small-team-git.json: supported workflow vocabulary/order mismatch"
        )
    if value.get("supported_modifiers") != list(SUPPORTED_WORKFLOW_MODIFIERS):
        errors.append(
            ".agent/workflows/small-team-git.json: concurrent modifier contract mismatch"
        )
    if value.get("maximum_supported_write_capable_humans") != 5:
        errors.append(
            ".agent/workflows/small-team-git.json: maximum supported team size must remain five"
        )
    if value.get("excluded_enterprise_workflows") != list(
        EXCLUDED_ENTERPRISE_WORKFLOW_IDS
    ):
        errors.append(
            ".agent/workflows/small-team-git.json: enterprise workflow exclusions mismatch"
        )
    unsupported = value.get("unsupported_state", {})
    if unsupported != {
        "result": "unsupported_team_size",
        "threshold": 5,
        "enterprise_fallback": False,
    }:
        errors.append(
            ".agent/workflows/small-team-git.json: unsupported team size must not select an enterprise fallback"
        )

    tool_root = tools.get("tools", {})
    git_operations = {
        item.get("id"): item
        for item in tool_root.get("git", {}).get("operations", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    } if isinstance(tool_root, dict) else {}
    hosted_operations = {
        item.get("id"): item
        for item in tool_root.get("hosted_change", {}).get("operations", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    } if isinstance(tool_root, dict) else {}
    operation_catalog = {**git_operations, **hosted_operations}
    workflows = value.get("workflows", {})
    referenced: list[tuple[str, str]] = []
    if isinstance(workflows, dict):
        for workflow_id, workflow in workflows.items():
            if workflow_id not in SUPPORTED_BASE_WORKFLOWS:
                errors.append(
                    f".agent/workflows/small-team-git.json: unknown workflow {workflow_id}"
                )
            if not isinstance(workflow, dict):
                continue
            review = workflow.get("review", {})
            if isinstance(review, dict) and review.get(
                "maximum_required_peer_approvals", 0
            ) > 1:
                errors.append(
                    f".agent/workflows/small-team-git.json: {workflow_id} requires more than one peer approval"
                )
            for step in workflow.get("steps", []):
                if not isinstance(step, dict):
                    continue
                for operation_id in step.get("operations", []):
                    referenced.append((f"{workflow_id}.{step.get('id')}", operation_id))
            for operation_id in workflow.get("cleanup_operations", []):
                referenced.append((f"{workflow_id}.cleanup", operation_id))
    modifier = value.get("modifiers", {}).get("concurrent_work", {})
    if isinstance(modifier, dict):
        for operation_id in modifier.get("operations", []):
            referenced.append(("concurrent_work", operation_id))
    for location, operation_id in referenced:
        operation = operation_catalog.get(operation_id)
        if operation is None:
            errors.append(
                f".agent/workflows/small-team-git.json: {location} references unknown operation {operation_id}"
            )
            continue
        if (
            operation.get("authority_class") in {
                "prohibited",
                "destructive_current_authorization",
            }
            or operation.get("normal_workflow") is not True
        ):
            errors.append(
                f".agent/workflows/small-team-git.json: {location} uses non-normal operation {operation_id}"
            )
    if any(
        operation_id in {"pull", "force_push"}
        for _, operation_id in referenced
    ):
        errors.append(
            ".agent/workflows/small-team-git.json: composite pull and raw force-push are prohibited workflow steps"
        )
    return list(dict.fromkeys(errors))


def hash_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def hash_path_identity(path: Path) -> str:
    if path.is_symlink():
        target = os.readlink(path)
        return hashlib.sha256(
            b"symlink\0" + target.encode("utf-8", errors="surrogateescape")
        ).hexdigest()
    return hash_file(path)


def safe_relative_path(
    root: Path,
    value: Any,
    *,
    allowed_prefixes: tuple[str, ...] = (),
    must_exist: bool = False,
) -> tuple[Path | None, str | None]:
    if (
        not isinstance(value, str)
        or not value
        or "\x00" in value
        or "\\" in value
        or value.startswith(("/", "./"))
        or any(ord(character) < 32 or ord(character) == 127 for character in value)
        or PurePosixPath(value).as_posix() != value
    ):
        return None, "path must be a normalized repository-relative POSIX path"
    candidate = Path(value)
    if candidate.is_absolute() or any(part in {"", ".", ".."} for part in candidate.parts):
        return None, "path contains an unsafe or non-normalized segment"
    if allowed_prefixes and not any(
        value == prefix or value.startswith(prefix + "/")
        for prefix in allowed_prefixes
    ):
        return None, "path is outside its allowed repository scope"
    resolved_root = root.resolve()
    try:
        resolved = (root / candidate).resolve(strict=must_exist)
        resolved.relative_to(resolved_root)
    except (FileNotFoundError, OSError, ValueError):
        return None, "path escapes the repository, is broken, or is absent"
    return candidate, None


def json_secret_path(value: Any, path: str = "$"):
    if isinstance(value, dict):
        for key, child in value.items():
            child_path = f"{path}.{key}"
            if (
                SENSITIVE_JSON_KEY.fullmatch(key)
                and isinstance(child, str)
                and len(child) >= 8
                and not SAFE_SECRET_SENTINEL.fullmatch(child.strip())
            ):
                yield child_path
            yield from json_secret_path(child, child_path)
    elif isinstance(value, list):
        for index, child in enumerate(value):
            yield from json_secret_path(child, f"{path}[{index}]")
    elif isinstance(value, str) and SECRET_VALUE.search(value.strip()):
        yield path


def snapshot_files(root: Path) -> dict[str, str]:
    def identity(path: Path) -> str:
        metadata = path.lstat()
        kind = (
            "symlink"
            if stat.S_ISLNK(metadata.st_mode)
            else "directory"
            if stat.S_ISDIR(metadata.st_mode)
            else "file"
        )
        if kind == "directory":
            payload = ""
        else:
            try:
                payload = hash_path_identity(path)
            except OSError:
                payload = "unreadable"
        return (
            f"{kind}:{stat.S_IMODE(metadata.st_mode):o}:"
            f"{metadata.st_size}:{metadata.st_mtime_ns}:{payload}"
        )

    def add_git_directory(git_dir: Path, prefix: str) -> None:
        critical = [
            git_dir / "HEAD",
            git_dir / "index",
            git_dir / "config",
            git_dir / "packed-refs",
        ]
        for directory in (git_dir / "refs", git_dir / "hooks"):
            if directory.is_dir():
                critical.extend(
                    path
                    for path in directory.rglob("*")
                    if path.is_file() or path.is_symlink()
                )
        for path in critical:
            if path.is_file() or path.is_symlink():
                try:
                    rel = path.relative_to(git_dir).as_posix()
                    snapshot[f"{prefix}/{rel}"] = identity(path)
                except (OSError, ValueError):
                    continue

    snapshot: dict[str, str] = {}
    for path in sorted(root.rglob("*")):
        rel_path = path.relative_to(root)
        if ".git" in rel_path.parts or "__pycache__" in rel_path.parts:
            continue
        snapshot[rel_path.as_posix()] = identity(path)
    git_path = root / ".git"
    if git_path.is_file() or git_path.is_symlink():
        snapshot[".git"] = identity(git_path)
        if git_path.is_file() and not git_path.is_symlink():
            try:
                pointer = git_path.read_text(encoding="utf-8").strip()
                if (
                    pointer.startswith("gitdir: ")
                    and "\n" not in pointer
                    and "\r" not in pointer
                    and "\x00" not in pointer
                ):
                    raw_git_dir = Path(pointer[8:])
                    git_dir = (
                        raw_git_dir
                        if raw_git_dir.is_absolute()
                        else (root / raw_git_dir)
                    ).resolve(strict=True)
                    if git_dir.is_dir():
                        add_git_directory(git_dir, ".git::worktree")
                        common_file = git_dir / "commondir"
                        if common_file.is_file() and not common_file.is_symlink():
                            common_value = common_file.read_text(
                                encoding="utf-8"
                            ).strip()
                            if (
                                common_value
                                and "\n" not in common_value
                                and "\r" not in common_value
                                and "\x00" not in common_value
                            ):
                                raw_common = Path(common_value)
                                common_dir = (
                                    raw_common
                                    if raw_common.is_absolute()
                                    else git_dir / raw_common
                                ).resolve(strict=True)
                                if common_dir.is_dir():
                                    add_git_directory(
                                        common_dir,
                                        ".git::common",
                                    )
            except (OSError, UnicodeDecodeError, ValueError):
                pass
    elif git_path.is_dir():
        add_git_directory(git_path, ".git")
    return snapshot


def fingerprint_exclusions(root: Path) -> tuple[set[str], list[str]]:
    errors: list[str] = []
    exclusions: set[str] = set()
    project_path = root / ".agent" / "project.json"
    if not project_path.is_file():
        return exclusions, errors
    try:
        project = load_json(project_path)
    except (OSError, ValueError, json.JSONDecodeError):
        return exclusions, errors
    if not isinstance(project, dict):
        return exclusions, [".agent/project.json: top-level value must be an object"]
    paths = project.get("paths")
    if not isinstance(paths, dict):
        return exclusions, [".agent/project.json: paths must be an object"]
    raw = paths.get("fingerprint_exclusions", [])
    if not isinstance(raw, list):
        return exclusions, [".agent/project.json: fingerprint_exclusions must be an array"]
    for index, item in enumerate(raw):
        if not isinstance(item, dict):
            errors.append(
                f".agent/project.json: fingerprint_exclusions[{index}] must be an object"
            )
            continue
        path = item.get("path")
        reason = item.get("reason")
        if (
            not isinstance(path, str)
            or not path
            or "*" in path
        ):
            errors.append(
                f".agent/project.json: unsafe fingerprint exclusion at index {index}"
            )
            continue
        normalized, path_error = safe_relative_path(root, path)
        if (
            path_error
            or normalized is None
            or normalized.parts[0]
            in {".git", ".agent", ".agents", "project-dossier"}
            or path in {
                ".",
                ".git",
                "AGENTS.md",
                ".octon-mini-origin.json",
            }
            or path in DERIVED_EXCLUSIONS
        ):
            errors.append(
                f".agent/project.json: unsafe fingerprint exclusion at index {index}"
            )
            continue
        if not isinstance(reason, str) or not reason.strip():
            errors.append(
                f".agent/project.json: exclusion {path!r} requires a reason"
            )
            continue
        exclusions.add(path.rstrip("/"))
    return exclusions, errors


def repository_files(
    root: Path = ROOT,
    *,
    source_only: bool = False,
) -> list[Path]:
    exclusions, _ = fingerprint_exclusions(root)
    files: list[Path] = []

    def omitted(rel_path: Path) -> bool:
        rel = rel_path.as_posix()
        if ".git" in rel_path.parts or "__pycache__" in rel_path.parts:
            return True
        if source_only and (
            rel == ".agent/generated"
            or rel.startswith(".agent/generated/")
            or rel == ".agent/transactions"
            or rel.startswith(".agent/transactions/")
            or rel == ".agent/work-runs"
            or rel.startswith(".agent/work-runs/")
            or rel in DERIVED_EXCLUSIONS
            or any(rel == item or rel.startswith(item + "/") for item in exclusions)
        ):
            return True
        return False

    def visit(directory: Path, relative_directory: Path) -> None:
        with os.scandir(directory) as iterator:
            entries = sorted(iterator, key=lambda entry: entry.name)
        for entry in entries:
            rel_path = relative_directory / entry.name
            if omitted(rel_path):
                continue
            path = directory / entry.name
            if entry.is_symlink():
                files.append(path)
            elif entry.is_dir(follow_symlinks=False):
                visit(path, rel_path)
            else:
                files.append(path)

    visit(root, Path())
    files.sort()
    return files


def source_inventory(root: Path = ROOT) -> tuple[dict[str, str], str]:
    """Hash the source inventory once for both manifest and fingerprint checks."""
    digest = hashlib.sha256()
    files: dict[str, str] = {}
    for path in repository_files(root, source_only=True):
        rel = relative(path, root)
        if path.name == ".DS_Store":
            continue
        digest.update(rel.encode("utf-8", errors="surrogateescape"))
        digest.update(b"\0")
        try:
            identity_hex = hash_path_identity(path)
            identity = bytes.fromhex(identity_hex)
        except OSError:
            identity_hex = hashlib.sha256(b"unreadable").hexdigest()
            identity = bytes.fromhex(identity_hex)
        files[rel] = identity_hex
        digest.update(identity)
        digest.update(b"\0")
    return files, digest.hexdigest()


def source_fingerprint(root: Path = ROOT) -> str:
    return source_inventory(root)[1]


def project_check_source_fingerprint(root: Path = ROOT) -> str:
    """Fingerprint project-check subject source without self-staling evidence."""
    digest = hashlib.sha256()
    for path in repository_files(root, source_only=True):
        rel = relative(path, root)
        if (
            rel == PROJECT_CHECK_EVIDENCE_PATH
            or rel.startswith(".agent/project-checks/archive/")
            or path.name == ".DS_Store"
        ):
            continue
        digest.update(rel.encode("utf-8", errors="surrogateescape"))
        digest.update(b"\0")
        try:
            identity = bytes.fromhex(hash_path_identity(path))
        except OSError:
            identity = hashlib.sha256(b"unreadable").digest()
        digest.update(identity)
        digest.update(b"\0")
    return digest.hexdigest()


def schema_type_matches(value: Any, expected: str) -> bool:
    if expected == "object":
        return isinstance(value, dict)
    if expected == "array":
        return isinstance(value, list)
    if expected == "string":
        return isinstance(value, str)
    if expected == "boolean":
        return isinstance(value, bool)
    if expected == "null":
        return value is None
    if expected == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if expected == "number":
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    return False


def resolve_ref(root_schema: dict[str, Any], reference: str) -> dict[str, Any]:
    if not reference.startswith("#/"):
        raise ValueError(f"unsupported non-local schema reference: {reference}")
    current: Any = root_schema
    for part in reference[2:].split("/"):
        key = part.replace("~1", "/").replace("~0", "~")
        if not isinstance(current, dict) or key not in current:
            raise ValueError(f"unresolved schema reference: {reference}")
        current = current[key]
    if not isinstance(current, dict):
        raise ValueError(f"schema reference does not resolve to an object: {reference}")
    return current


def validate_schema(
    value: Any,
    schema: dict[str, Any],
    path: str = "$",
    *,
    root_schema: dict[str, Any] | None = None,
) -> list[str]:
    root_schema = root_schema or schema
    if "$ref" in schema:
        try:
            resolved = resolve_ref(root_schema, schema["$ref"])
        except ValueError as error:
            return [f"{path}: {error}"]
        return validate_schema(value, resolved, path, root_schema=root_schema)

    errors: list[str] = []
    if "const" in schema and value != schema["const"]:
        errors.append(f"{path}: must equal {schema['const']!r}")
    if "enum" in schema and value not in schema["enum"]:
        errors.append(f"{path}: value is outside the allowed vocabulary")

    expected = schema.get("type")
    if expected is not None:
        types = expected if isinstance(expected, list) else [expected]
        if not any(schema_type_matches(value, item) for item in types):
            return [f"{path}: expected type {expected!r}"]

    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            errors.append(f"{path}: string is too short")
        pattern = schema.get("pattern")
        if pattern and not re.fullmatch(pattern, value):
            errors.append(f"{path}: string does not match required pattern")
        if schema.get("format") == "date":
            try:
                date.fromisoformat(value)
            except ValueError:
                errors.append(f"{path}: expected ISO date")
        if schema.get("format") == "date-time":
            try:
                parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
                if parsed.tzinfo is None:
                    raise ValueError("timezone required")
            except ValueError:
                errors.append(f"{path}: expected timezone-aware ISO date-time")
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "minimum" in schema and value < schema["minimum"]:
            errors.append(f"{path}: number is below minimum")
        if "maximum" in schema and value > schema["maximum"]:
            errors.append(f"{path}: number is above maximum")

    if isinstance(value, list):
        if len(value) < schema.get("minItems", 0):
            errors.append(f"{path}: array has too few items")
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            errors.append(f"{path}: array has too many items")
        if schema.get("uniqueItems"):
            encoded = [json.dumps(item, sort_keys=True) for item in value]
            if len(encoded) != len(set(encoded)):
                errors.append(f"{path}: array items must be unique")
        item_schema = schema.get("items")
        if isinstance(item_schema, dict):
            for index, item in enumerate(value):
                errors.extend(
                    validate_schema(
                        item,
                        item_schema,
                        f"{path}[{index}]",
                        root_schema=root_schema,
                    )
                )

    if isinstance(value, dict):
        if len(value) < schema.get("minProperties", 0):
            errors.append(f"{path}: object has too few properties")
        for required in schema.get("required", []):
            if required not in value:
                errors.append(f"{path}: missing required property {required!r}")
        properties = schema.get("properties", {})
        if isinstance(properties, dict):
            for key, child in properties.items():
                if key in value and isinstance(child, dict):
                    errors.extend(
                        validate_schema(
                            value[key],
                            child,
                            f"{path}.{key}",
                            root_schema=root_schema,
                        )
                    )
            if schema.get("additionalProperties") is False:
                for key in value:
                    if key not in properties:
                        errors.append(f"{path}: unknown property {key!r}")
    return errors


def lint_schema_contract(schema: dict[str, Any]) -> list[str]:
    allowed = {
        "$schema",
        "$id",
        "$ref",
        "$defs",
        "title",
        "description",
        "type",
        "additionalProperties",
        "required",
        "properties",
        "const",
        "enum",
        "pattern",
        "minLength",
        "items",
        "uniqueItems",
        "minItems",
        "maxItems",
        "minProperties",
        "format",
        "minimum",
        "maximum",
    }
    errors: list[str] = []

    def visit(value: Any, location: str) -> None:
        if not isinstance(value, dict):
            return
        for key in value:
            if key not in allowed:
                errors.append(f"{location}: unsupported schema keyword {key!r}")
        reference = value.get("$ref")
        if isinstance(reference, str):
            match = re.fullmatch(r"#/\$defs/([^/]+)", reference)
            if not match or match.group(1) not in schema.get("$defs", {}):
                errors.append(f"{location}: unresolved or nonlocal schema reference")
        for map_key in ("properties", "$defs"):
            children = value.get(map_key, {})
            if isinstance(children, dict):
                for child_name, child in children.items():
                    visit(child, f"{location}.{map_key}.{child_name}")
        if isinstance(value.get("items"), dict):
            visit(value["items"], f"{location}.items")

    visit(schema, "$")
    return errors


def load_schema(root: Path, name: str) -> dict[str, Any]:
    value = load_json(root / ".agent" / "schemas" / name)
    if not isinstance(value, dict):
        raise ValueError(f"schema {name} must be an object")
    schema_errors = lint_schema_contract(value)
    if schema_errors:
        raise ValueError("; ".join(schema_errors))
    return value


def parse_json_header(path: Path) -> dict[str, Any]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        raise ValueError("missing JSON metadata header")
    end = text.find("\n---\n", 4)
    if end < 0:
        raise ValueError("unterminated JSON metadata header")
    value = loads_json(text[4:end])
    if not isinstance(value, dict):
        raise ValueError("metadata header must be a JSON object")
    return value


def check_runtime() -> list[str]:
    if sys.version_info < (3, 11):
        return [f"Python 3.11+ required; found {sys.version.split()[0]}"]
    return []


def check_files_and_json(
    root: Path,
    *,
    include_derived: bool = True,
) -> list[str]:
    errors: list[str] = []
    _, exclusion_errors = fingerprint_exclusions(root)
    errors.extend(exclusion_errors)
    for path in repository_files(root):
        rel = relative(path, root)
        if any(ord(character) < 32 or ord(character) == 127 for character in rel):
            errors.append(f"{rel!r}: repository path contains control characters")
            continue
        if not include_derived and (
            rel in DERIVED_EXCLUSIONS or rel.startswith(".agent/generated/")
        ):
            continue
        if path.name == ".DS_Store":
            errors.append(f"{rel}: prohibited host metadata")
        if path.is_symlink():
            errors.append(f"{rel}: managed repository symlinks are prohibited")
            try:
                path.resolve(strict=True).relative_to(root.resolve())
            except (FileNotFoundError, ValueError):
                errors.append(f"{rel}: symlink escapes repository or is broken")
            continue
        if rel.startswith(".agent/tests/fixtures/invalid/"):
            continue
        try:
            size = path.stat().st_size
        except OSError as error:
            errors.append(f"{rel}: cannot inspect file: {error}")
            continue
        if size > 4 * 1024 * 1024:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        except OSError as error:
            errors.append(f"{rel}: cannot read file: {error}")
            continue
        if PLACEHOLDER.search(text):
            errors.append(f"{rel}: unresolved generation placeholder")
        secret_detected = bool(SECRET_ASSIGNMENT.search(text) or SECRET_VALUE.search(text))
        parsed_json: Any = None
        if path.suffix == ".json":
            try:
                parsed_json = loads_json(text)
            except (DuplicateKeyError, json.JSONDecodeError, ValueError):
                parsed_json = None
            if parsed_json is not None and any(json_secret_path(parsed_json)):
                secret_detected = True
        if secret_detected:
            errors.append(f"{rel}: possible embedded secret assignment (value redacted)")
        if (
            path.name == "AGENTS.md"
            and rel != "AGENTS.md"
            and (
                AUTHORITY_EXPANSION.search(text)
                or NATURAL_LANGUAGE_WEAKENING.search(text)
            )
        ):
            errors.append(
                f"{rel}: nested instruction may expand authority or weaken ancestor constraints"
            )
        governed_instruction_prose = (
            (rel.startswith(".agents/") and path.suffix == ".md")
            or (
                rel.startswith(".agent/")
                and path.suffix == ".md"
                and not rel.startswith(
                    (
                        ".agent/evidence/",
                        ".agent/reviews/",
                        ".agent/checkpoints/",
                        ".agent/events/",
                        ".agent/templates/",
                        ".agent/tests/",
                        ".agent/generated/",
                        ".agent/artifacts/",
                    )
                )
            )
        )
        if governed_instruction_prose and NATURAL_LANGUAGE_WEAKENING.search(text):
            errors.append(
                f"{rel}: governed instructional prose may weaken authority"
            )
        if (
            rel.startswith((".agent/", ".agents/"))
            and not rel.startswith(
                (
                    ".agent/tests/",
                    ".agent/templates/",
                    ".agent/schemas/",
                    ".agent/generated/",
                )
            )
            and AUTHORITY_EXPANSION.search(text)
        ):
            errors.append(f"{rel}: harness component may expand authority")
        if path.suffix == ".json":
            try:
                value = parsed_json if parsed_json is not None else loads_json(text)
            except DuplicateKeyError:
                errors.append(f"{rel}: duplicate JSON key")
                continue
            except json.JSONDecodeError as error:
                errors.append(f"{rel}: invalid JSON at line {error.lineno}")
                continue
            except ValueError:
                errors.append(
                    f"{rel}: invalid strict JSON numeric constant (value redacted)"
                )
                continue
            controlled = (
                rel.startswith((".agent/", ".agents/", "project-dossier/"))
                or rel == ".octon-mini-origin.json"
            )
            is_schema = rel.startswith(".agent/schemas/") or (
                rel.startswith(".agent/extensions/")
                and path.name.endswith(".schema.json")
            )
            if controlled and not is_schema:
                if not isinstance(value, dict):
                    errors.append(f"{rel}: controlled JSON must be a top-level object")
                elif "schema_version" not in value:
                    errors.append(f"{rel}: missing top-level schema_version")
    return errors


def check_jsonl(path: Path, root: Path) -> list[str]:
    errors: list[str] = []
    seen: set[str] = set()
    seen_sequences: set[int] = set()
    previous_sequence: int | None = None
    previous_time: datetime | None = None
    try:
        schema = load_schema(root, "harness-record.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f"{relative(path, root)}: event schema unavailable: {error}"]
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as error:
        return [f"{relative(path, root)}: cannot read event log: {error}"]
    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            continue
        try:
            value = loads_json(raw)
        except (ValueError, json.JSONDecodeError):
            errors.append(f"{relative(path, root)}:{number}: invalid strict JSON")
            continue
        location = f"{relative(path, root)}:{number}"
        errors.extend(
            f"{location}: {item}"
            for item in validate_schema(
                value,
                {"$ref": "#/$defs/event"},
                root_schema=schema,
            )
        )
        event_id = value.get("id") if isinstance(value, dict) else None
        if not isinstance(event_id, str):
            continue
        if event_id in seen:
            errors.append(f"{relative(path, root)}:{number}: duplicate event ID")
        else:
            seen.add(event_id)
        sequence = value.get("sequence") if isinstance(value, dict) else None
        if isinstance(sequence, int) and not isinstance(sequence, bool):
            if sequence in seen_sequences:
                errors.append(f"{location}: duplicate event sequence")
            if previous_sequence is not None and sequence <= previous_sequence:
                errors.append(f"{location}: event sequence is not strictly monotonic")
            seen_sequences.add(sequence)
            previous_sequence = sequence
        occurred_at = value.get("occurred_at") if isinstance(value, dict) else None
        if isinstance(occurred_at, str):
            try:
                current_time = datetime.fromisoformat(
                    occurred_at.replace("Z", "+00:00")
                )
                if current_time.tzinfo is None:
                    raise ValueError("timezone required")
                if previous_time is not None and current_time < previous_time:
                    errors.append(f"{location}: events are not chronological")
                previous_time = current_time
            except ValueError:
                pass
    return errors


def project_argv_is_safe(value: Any) -> bool:
    return (
        isinstance(value, list)
        and 1 <= len(value) <= 128
        and all(
            isinstance(item, str)
            and bool(item.strip())
            and not any(
                ord(character) < 32 or ord(character) == 127
                for character in item
            )
            for item in value
        )
    )


def project_argv_uses_inline_shell(value: list[str]) -> bool:
    executable = Path(value[0]).name.lower()
    return executable in SHELL_EXECUTABLES and any(
        item.lower() in INLINE_SHELL_FLAGS for item in value[1:]
    )


def check_project_command_contract(
    root: Path,
    project: dict[str, Any],
) -> list[str]:
    errors: list[str] = []
    commands = project.get("commands")
    allowed_hook_sets = {
        frozenset(PROJECT_COMMAND_HOOKS),
        frozenset((*PROJECT_COMMAND_HOOKS, *OPTIONAL_PROJECT_COMMAND_HOOKS)),
    }
    if not isinstance(commands, dict) or frozenset(commands) not in allowed_hook_sets:
        return [".agent/project.json: project command hook set differs from contract"]
    required_fields = {
        "status",
        "owner",
        "rationale",
        "tool_name",
        "argv",
        "version_argv",
        "timeout_seconds",
        "evidence_freshness_days",
        "side_effects",
    }
    for hook in commands:
        command = commands.get(hook)
        location = f".agent/project.json: commands.{hook}"
        if not isinstance(command, dict) or set(command) != required_fields:
            errors.append(f"{location} must use the closed assessment contract")
            continue
        status = command.get("status")
        side_effects = command.get("side_effects")
        if not isinstance(side_effects, dict) or set(side_effects) != {
            "classification",
            "repository_write_paths",
            "external_effects",
        }:
            errors.append(f"{location}.side_effects must use the closed contract")
            continue
        classification = side_effects.get("classification")
        writes = side_effects.get("repository_write_paths")
        external = side_effects.get("external_effects")
        if not isinstance(writes, list) or not isinstance(external, list):
            errors.append(f"{location}: side-effect declarations must be arrays")
            continue
        if len(writes) != len(set(item for item in writes if isinstance(item, str))):
            errors.append(f"{location}: repository write declarations must be unique")
        if len(external) != len(set(item for item in external if isinstance(item, str))):
            errors.append(f"{location}: external-effect declarations must be unique")
        if any(not isinstance(item, str) or not item.strip() for item in external):
            errors.append(f"{location}: external-effect declarations must be nonempty")
        for index, item in enumerate(writes):
            normalized, path_error = safe_relative_path(root, item)
            if path_error or normalized is None:
                errors.append(f"{location}: unsafe repository write path at index {index}")
                continue
            value = normalized.as_posix()
            if value in {
                ".git",
                ".agent",
                ".agents",
                "project-dossier",
                "AGENTS.md",
                ".octon-mini-origin.json",
            } or value.startswith((".git/", ".agent/", ".agents/", "project-dossier/")):
                errors.append(f"{location}: project checks may not declare governance writes")
        if status == "configured":
            if not isinstance(command.get("owner"), str) or not command["owner"].strip():
                errors.append(f"{location}: configured hook requires an owner")
            if not isinstance(command.get("tool_name"), str) or not command["tool_name"].strip():
                errors.append(f"{location}: configured hook requires a tool name")
            for field in ("argv", "version_argv"):
                argv = command.get(field)
                if not project_argv_is_safe(argv):
                    errors.append(f"{location}: configured {field} must be a safe argv array")
                elif project_argv_uses_inline_shell(argv):
                    errors.append(f"{location}: inline shell interpretation is prohibited")
            if (
                project_argv_is_safe(command.get("argv"))
                and project_argv_is_safe(command.get("version_argv"))
                and command["argv"][0] != command["version_argv"][0]
            ):
                errors.append(
                    f"{location}: version probe must use the configured executable"
                )
            timeout = command.get("timeout_seconds")
            if (
                not isinstance(timeout, int)
                or isinstance(timeout, bool)
                or not 1 <= timeout <= 86400
            ):
                errors.append(f"{location}: configured hook requires a bounded timeout")
            freshness = command.get("evidence_freshness_days")
            if (
                not isinstance(freshness, int)
                or isinstance(freshness, bool)
                or not 1 <= freshness <= 365
            ):
                errors.append(
                    f"{location}: configured hook requires bounded evidence freshness"
                )
            if command.get("rationale") is not None and (
                not isinstance(command["rationale"], str)
                or not command["rationale"].strip()
            ):
                errors.append(f"{location}: configured rationale must be null or nonempty")
            if classification == "read_only" and (writes or external):
                errors.append(f"{location}: read_only hook cannot declare writes/effects")
            elif classification == "repository_writes" and (not writes or external):
                errors.append(
                    f"{location}: repository_writes requires paths and no external effects"
                )
            elif classification == "external_effects_possible" and not external:
                errors.append(
                    f"{location}: external_effects_possible requires declarations"
                )
            elif classification not in {
                "read_only",
                "repository_writes",
                "external_effects_possible",
            }:
                errors.append(f"{location}: configured side-effect class is invalid")
        elif status == "not_applicable":
            if not isinstance(command.get("owner"), str) or not command["owner"].strip():
                errors.append(f"{location}: not_applicable requires an owner")
            if not isinstance(command.get("rationale"), str) or not command["rationale"].strip():
                errors.append(f"{location}: not_applicable requires a rationale")
            for field in (
                "tool_name",
                "argv",
                "version_argv",
                "timeout_seconds",
                "evidence_freshness_days",
            ):
                if command.get(field) is not None:
                    errors.append(f"{location}: not_applicable requires {field}=null")
            if classification != "not_applicable" or writes or external:
                errors.append(f"{location}: not_applicable side effects are incoherent")
        elif status == "not_assessed":
            for field in (
                "owner",
                "rationale",
                "tool_name",
                "argv",
                "version_argv",
                "timeout_seconds",
                "evidence_freshness_days",
            ):
                if command.get(field) is not None:
                    errors.append(f"{location}: not_assessed requires {field}=null")
            if classification != "not_assessed" or writes or external:
                errors.append(f"{location}: not_assessed side effects are incoherent")
        else:
            errors.append(f"{location}: unknown assessment status")

    expected_project_checks = {
        "evidence_schema": ".agent/schemas/harness-project-check-evidence-v3.schema.json",
        "evidence_store": PROJECT_CHECK_EVIDENCE_PATH,
        "evidence_archive": ".agent/project-checks/archive",
        "writer_argv": [
            "python",
            "-B",
            ".agent/scripts/run_project_checks.py",
            "--write-evidence",
        ],
        "adoption_verification_argv": [
            "python",
            "-B",
            ".agent/scripts/run_project_checks.py",
            "--write-evidence",
            "--verify-adoption",
        ],
        "execution": "explicit_writer_only_with_selective_hooks_and_full_adoption_verification",
        "shell_interpretation": False,
    }
    legacy_project_checks = {
        **{key: value for key, value in expected_project_checks.items() if key != "proof_reuse"},
        "evidence_schema": ".agent/schemas/harness-project-check-evidence.schema.json",
    }
    project_checks = project.get("project_checks")
    if project.get("schema_version") in {"harness.project.v6", "harness.project.v7", "harness.project.v8"}:
        if (
            not isinstance(project_checks, dict)
            or set(project_checks) != set(expected_project_checks) | {"proof_reuse"}
            or any(project_checks.get(key) != value for key, value in expected_project_checks.items())
        ):
            errors.append(".agent/project.json: project-check writer contract differs from kernel")
        else:
            proof = project_checks.get("proof_reuse")
            fixed_proof = {
                "status": "enabled_for_explicit_routine_writer_only",
                "input_routing": "declared_source_and_test_roots_with_governance_fallback",
                "external_or_runtime_authorization_cache_hits": False,
                "expired_proof_cache_hits": False,
                "adoption_and_release_gate_reuse": False,
            }
            names = proof.get("environment_characteristics") if isinstance(proof, dict) else None
            baseline = {"CI", "PATH", "PYTHONPATH", "VIRTUAL_ENV"}
            if (
                not isinstance(proof, dict)
                or set(proof) != set(fixed_proof) | {"environment_characteristics"}
                or any(proof.get(key) != value for key, value in fixed_proof.items())
                or not isinstance(names, list)
                or not 1 <= len(names) <= 64
                or len(names) != len(set(item for item in names if isinstance(item, str)))
                or not baseline <= set(item for item in names if isinstance(item, str))
                or any(
                    not isinstance(item, str)
                    or re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", item) is None
                    for item in names
                )
            ):
                errors.append(
                    ".agent/project.json: proof reuse requires a unique, bounded project-owned environment allowlist containing the kernel baseline"
                )
    elif project_checks != legacy_project_checks:
        errors.append(".agent/project.json: project-check writer contract differs from kernel")
    return errors


def check_work_completion_config(root: Path, project: dict[str, Any]) -> list[str]:
    """Validate the optional, disabled-by-default completion adoption contract."""
    if "work_completion" not in project:
        return []
    value = project.get("work_completion")
    try:
        schema = load_schema(root, "harness-work-completion.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/project.json: work-completion schema unavailable: {error}"]
    fragment = {
        "$schema": schema.get("$schema"),
        "$defs": schema.get("$defs", {}),
        **schema.get("$defs", {}).get("completion_config", {}),
    }
    errors = [
        f".agent/project.json: work_completion {item}"
        for item in validate_schema(value, fragment)
    ]
    if errors or not isinstance(value, dict):
        return errors
    hook = value.get("completion_hook", {})
    commands = project.get("commands", {})
    command_hook = (
        commands.get("work_completion_plan")
        if isinstance(commands, dict)
        else None
    )
    repository = value.get("repository", {})
    provider = value.get("provider", {})
    checks = value.get("required_hosted_checks", {})
    cleanup = value.get("cleanup", {})
    if value.get("status") == "disabled":
        expected = {
            "hook": "disabled",
            "repository": {"identity": None, "remote": None, "default_branch": None},
            "git_hooks": "not_assessed",
            "provider_adapter": "not_assessed",
            "hosted_repository": None,
            "eligible_peer_reviewers": [],
            "solo_hybrid_pull_request": "not_assessed",
            "checks": {"status": "not_assessed", "names": []},
            "validation_hooks": [],
            "cleanup": {"remote_task_branch": "not_assessed", "local_task_branch": "not_assessed"},
        }
        observed = {
            "hook": hook.get("mode"),
            "repository": repository,
            "git_hooks": value.get("git_hooks"),
            "provider_adapter": provider.get("adapter"),
            "hosted_repository": provider.get("hosted_repository"),
            "eligible_peer_reviewers": value.get("eligible_peer_reviewers"),
            "solo_hybrid_pull_request": value.get("solo_hybrid_pull_request"),
            "checks": checks,
            "validation_hooks": value.get("validation_hooks"),
            "cleanup": cleanup,
        }
        if observed != expected:
            errors.append(
                ".agent/project.json: disabled work completion must retain the non-authorizing unassessed baseline"
            )
        if command_hook is not None and command_hook.get("status") != "not_assessed":
            errors.append(
                ".agent/project.json: disabled work completion cannot configure its completion-event command hook"
            )
        return errors
    if hook.get("mode") not in {"disabled", "plan_only_on_completion_event"}:
        errors.append(
            ".agent/project.json: enabled completion hook must remain disabled or plan-only"
        )
    expected_plan_argv = [
        "python", "-B", ".agent/scripts/octon.py", "work", "finish", "plan"
    ]
    if (
        not isinstance(command_hook, dict)
        or command_hook.get("status") != "configured"
        or command_hook.get("argv") != expected_plan_argv
        or command_hook.get("side_effects") != {
            "classification": "read_only",
            "repository_write_paths": [],
            "external_effects": [],
        }
    ):
        errors.append(
            ".agent/project.json: enabled work completion requires the exact configured read-only work_completion_plan command hook"
        )
    if any(not isinstance(repository.get(field), str) or not repository[field] for field in ("identity", "remote", "default_branch")):
        errors.append(
            ".agent/project.json: enabled work completion requires explicit repository identity, remote, and default branch"
        )
    if value.get("git_hooks") != "require_none":
        errors.append(
            ".agent/project.json: enabled work completion requires an explicit no-active-Git-hooks policy"
        )
    selection = project.get("collaboration_profile", {}).get("workflow_selection", {})
    workflow = selection.get("base_workflow")
    if selection.get("status") != "adopted" or workflow not in SUPPORTED_BASE_WORKFLOWS:
        errors.append(
            ".agent/project.json: work completion requires an adopted small-team workflow authority"
        )
    if checks.get("status") != "configured":
        errors.append(
            ".agent/project.json: enabled work completion must explicitly assess required hosted checks"
        )
    if provider.get("adapter") not in {"none", "github_cli"}:
        errors.append(
            ".agent/project.json: enabled work completion must explicitly assess provider handling"
        )
    if provider.get("adapter") == "none" and checks.get("names"):
        errors.append(
            ".agent/project.json: named hosted checks require an assessed hosted provider adapter"
        )
    if checks.get("names") and (
        provider.get("adapter") != "github_cli"
        or not isinstance(provider.get("hosted_repository"), str)
        or not provider["hosted_repository"]
    ):
        errors.append(
            ".agent/project.json: named hosted checks require an explicit hosted repository"
        )
    if provider.get("adapter") == "none" and provider.get("hosted_repository") is not None:
        errors.append(
            ".agent/project.json: provider adapter none requires hosted_repository=null"
        )
    hooks = value.get("validation_hooks", [])
    if not hooks:
        errors.append(
            ".agent/project.json: enabled work completion requires at least one validation hook"
        )
    for hook_name in hooks:
        command = commands.get(hook_name, {}) if isinstance(commands, dict) else {}
        if command.get("status") != "configured" or command.get("side_effects", {}).get("classification") != "read_only":
            errors.append(
                f".agent/project.json: work-completion hook {hook_name} must be configured read_only"
            )
    pr_required = workflow in {"pair_pr", "tiny_pr"} or (
        workflow == "solo_hybrid" and value.get("solo_hybrid_pull_request") == "enabled"
    )
    if workflow == "solo_hybrid" and value.get("solo_hybrid_pull_request") == "not_assessed":
        errors.append(
            ".agent/project.json: solo_hybrid self-PR handling must be explicitly assessed"
        )
    if pr_required and (
        provider.get("adapter") != "github_cli"
        or not isinstance(provider.get("hosted_repository"), str)
        or not provider["hosted_repository"]
    ):
        errors.append(
            ".agent/project.json: the adopted pull-request path requires an assessed provider adapter"
        )
    eligible_reviewers = value.get("eligible_peer_reviewers", [])
    if workflow in {"pair_pr", "tiny_pr"} and not eligible_reviewers:
        errors.append(
            ".agent/project.json: peer-review workflows require explicit eligible provider reviewer identities"
        )
    if workflow not in {"pair_pr", "tiny_pr"} and eligible_reviewers:
        errors.append(
            ".agent/project.json: eligible peer reviewers are only applicable to peer-review workflows"
        )
    if workflow == "solo_direct" and cleanup != {
        "remote_task_branch": "disabled",
        "local_task_branch": "disabled",
    }:
        errors.append(
            ".agent/project.json: solo_direct must not introduce task-branch cleanup"
        )
    if workflow != "solo_direct" and cleanup != {
        "remote_task_branch": "required",
        "local_task_branch": "required",
    }:
        errors.append(
            ".agent/project.json: branch-based completion must reconcile both remote and local task-branch cleanup"
        )
    return list(dict.fromkeys(errors))


def check_autonomous_delivery_config(root: Path, project: dict[str, Any]) -> list[str]:
    """Validate the dormant or explicitly activated autonomous-delivery boundary."""
    value = project.get("autonomous_delivery")
    if value is None and project.get("schema_version") != "harness.project.v8":
        return []
    if not isinstance(value, dict):
        return [".agent/project.json: autonomous_delivery must be an object"]
    required = {
        "schema_version", "status", "write_capability", "external_effects",
        "delivery_profile", "adoption_decision_ref", "authorization_record_ref",
        "authorization_record_digest", "activation_receipt_ref", "limitations",
    }
    if set(value) != required or value.get("schema_version") != "harness.autonomous-delivery-config.v1":
        return [".agent/project.json: autonomous_delivery contract is malformed"]
    errors: list[str] = []
    status = value.get("status")
    if status == "available_not_activated":
        expected = {
            "write_capability": "locked",
            "external_effects": "locked",
            "delivery_profile": None,
            "adoption_decision_ref": None,
            "authorization_record_ref": None,
            "authorization_record_digest": None,
            "activation_receipt_ref": None,
        }
        observed = {key: value.get(key) for key in expected}
        if observed != expected:
            errors.append(".agent/project.json: available autonomous delivery must remain externally locked and unbound")
    elif status == "active":
        if value.get("write_capability") != "authorized_within_exact_standing_contract" or value.get("external_effects") != "authorized_only_through_current_exact_plan_projections":
            errors.append(".agent/project.json: active autonomous delivery has invalid effect locks")
        if value.get("delivery_profile") not in {"review_first", "balanced_autonomous", "fast_delivery", "custom"}:
            errors.append(".agent/project.json: active autonomous delivery lacks an exact delivery profile")
        if not isinstance(value.get("adoption_decision_ref"), str) or re.fullmatch(r"DEC-[0-9]{4}", value["adoption_decision_ref"]) is None:
            errors.append(".agent/project.json: active autonomous delivery lacks an accepted project adoption decision reference")
        if not isinstance(value.get("authorization_record_ref"), str) or not Path(value["authorization_record_ref"]).is_absolute():
            errors.append(".agent/project.json: active autonomous delivery requires an external absolute authorization reference")
        if not isinstance(value.get("authorization_record_digest"), str) or re.fullmatch(r"[a-f0-9]{64}", value["authorization_record_digest"]) is None:
            errors.append(".agent/project.json: active autonomous delivery requires an exact authorization-record digest")
    elif status in {"disabled", "revoked", "expired"}:
        if value.get("write_capability") != "locked" or value.get("external_effects") != "locked":
            errors.append(".agent/project.json: inactive autonomous delivery must lock writes and external effects")
    else:
        errors.append(".agent/project.json: autonomous-delivery status is invalid")
    surface = root / ".agent/scripts/octon_autonomous_delivery.py"
    if not surface.is_file() or surface.is_symlink():
        errors.append(".agent/scripts/octon_autonomous_delivery.py: dormant delivery surface is absent or unsafe")
    payload = root / ".agent/available-packages/autonomous-delivery/payload"
    if not payload.is_dir() or payload.is_symlink():
        errors.append(".agent/available-packages/autonomous-delivery/payload: offline activation payload is absent or unsafe")
    dependency_payload = root / ".agent/available-packages/long-running-work/payload"
    if not dependency_payload.is_dir() or dependency_payload.is_symlink():
        errors.append(".agent/available-packages/long-running-work/payload: offline activation dependency is absent or unsafe")
    catalog_path = root / ".agent/available-packages/catalog.json"
    try:
        catalog = load_json(catalog_path)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        errors.append(f".agent/available-packages/catalog.json: {error}")
    else:
        packages = {
            item.get("id"): item
            for item in catalog.get("packages", [])
            if isinstance(item, dict) and isinstance(item.get("id"), str)
        } if isinstance(catalog, dict) else {}
        if (
            not isinstance(catalog, dict)
            or catalog.get("schema_version") != "harness.available-package-catalog.v1"
            or catalog.get("permission_grant") is not False
            or set(packages) != {"autonomous-delivery", "long-running-work"}
            or any(
                item.get("kind") != "workflow_capability"
                or item.get("status") != "available_not_installed"
                or item.get("payload_root") != f".agent/available-packages/{package_id}/payload"
                or re.fullmatch(r"[a-f0-9]{64}", str(item.get("source_sha256", ""))) is None
                or re.fullmatch(r"[a-f0-9]{64}", str(item.get("installed_paths_sha256", ""))) is None
                for package_id, item in packages.items()
            )
        ):
            errors.append(".agent/available-packages/catalog.json: offline package projection is malformed")
        else:
            for package_id, item in packages.items():
                payload_root = root / item["payload_root"]
                value = hashlib.sha256()
                for path in sorted(payload_root.rglob("*")):
                    if path.is_file() and not path.is_symlink():
                        relative_path = path.relative_to(payload_root).as_posix()
                        value.update(relative_path.encode("utf-8"))
                        value.update(b"\0")
                        value.update(path.read_bytes())
                        value.update(b"\0")
                if value.hexdigest() != item["installed_paths_sha256"]:
                    errors.append(f".agent/available-packages/catalog.json: {package_id} offline payload digest is stale")
    return errors


def load_project_check_evidence(
    root: Path,
) -> tuple[dict[str, Any] | None, list[str]]:
    path = root / PROJECT_CHECK_EVIDENCE_PATH
    errors: list[str] = []
    try:
        store = load_json(path)
        schema_name = (
            "harness-project-check-evidence-v3.schema.json"
            if isinstance(store, dict)
            and store.get("schema_version") == "harness.project-check-evidence-store.v3"
            else "harness-project-check-evidence.schema.json"
        )
        schema = load_schema(root, schema_name)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return None, [f"{PROJECT_CHECK_EVIDENCE_PATH}: {error}"]
    errors.extend(
        f"{PROJECT_CHECK_EVIDENCE_PATH}: {item}"
        for item in validate_schema(store, schema)
    )
    if not isinstance(store, dict):
        return None, errors
    proof_ids: set[str] = set()
    proofs = store.get("proofs", [])
    if store.get("schema_version") == "harness.project-check-evidence-store.v3":
        if not isinstance(proofs, list):
            errors.append(f"{PROJECT_CHECK_EVIDENCE_PATH}: proofs must be an array")
            proofs = []
        for proof_index, proof in enumerate(proofs):
            location = f"{PROJECT_CHECK_EVIDENCE_PATH}: proofs[{proof_index}]"
            if not isinstance(proof, dict):
                continue
            proof_id = proof.get("proof_id")
            if not isinstance(proof_id, str) or proof_id in proof_ids:
                errors.append(f"{location}: validation proof ID is malformed or duplicated")
            else:
                proof_ids.add(proof_id)
            unsigned = dict(proof)
            supplied = unsigned.pop("canonical_proof_digest", None)
            expected = hashlib.sha256(
                json.dumps(
                    unsigned,
                    ensure_ascii=False,
                    allow_nan=False,
                    sort_keys=True,
                    separators=(",", ":"),
                ).encode("utf-8")
            ).hexdigest()
            if supplied != expected:
                errors.append(f"{location}: canonical validation-proof digest is invalid")
            effects = proof.get("side_effects", {})
            if proof.get("reusable") is True and (
                not isinstance(effects, dict)
                or effects.get("external_effects")
                or effects.get("classification") == "external_effects_possible"
            ):
                errors.append(f"{location}: externally volatile proof cannot be reusable")
    records = store.get("records")
    if not isinstance(records, list):
        return store, errors
    seen_ids: set[str] = set()
    for record_index, record in enumerate(records):
        location = f"{PROJECT_CHECK_EVIDENCE_PATH}: records[{record_index}]"
        if not isinstance(record, dict):
            continue
        record_id = record.get("id")
        if isinstance(record_id, str):
            if record_id in seen_ids:
                errors.append(f"{location}: duplicate project-check evidence ID")
            seen_ids.add(record_id)
        source_after = record.get("source_after")
        if isinstance(source_after, dict) and PROJECT_CHECK_EVIDENCE_PATH not in source_after.get(
            "fingerprint_exclusions", []
        ):
            errors.append(
                f"{location}: evidence store must be excluded from its subject fingerprint"
            )
        writer_argv = record.get("writer_argv")
        if (
            not project_argv_is_safe(writer_argv)
            or not any(
                item == ".agent/scripts/run_project_checks.py"
                or item.replace("\\", "/").endswith(
                    "/.agent/scripts/run_project_checks.py"
                )
                for item in writer_argv
            )
            or "--write-evidence" not in writer_argv
        ):
            errors.append(f"{location}: record lacks the explicit writer invocation")
        checks = record.get("checks")
        if not isinstance(checks, list):
            continue
        hooks = [
            item.get("hook")
            for item in checks
            if isinstance(item, dict)
        ]
        if not hooks or len(hooks) != len(set(hooks)) or not set(hooks) <= set(
            PROJECT_COMMAND_HOOKS
        ):
            errors.append(f"{location}: check results must cover a unique nonempty hook subset")
        if "--verify-adoption" in writer_argv and set(hooks) != set(PROJECT_COMMAND_HOOKS):
            errors.append(f"{location}: adoption verification must cover every hook")
        reused_proof_ids = record.get("reused_proof_ids", [])
        if reused_proof_ids:
            if "--verify-adoption" in writer_argv:
                errors.append(f"{location}: adoption verification cannot reuse prior proofs")
            if not isinstance(reused_proof_ids, list) or any(
                item not in proof_ids for item in reused_proof_ids
            ):
                errors.append(f"{location}: reused validation proof does not resolve")
        for check_index, result in enumerate(checks):
            if not isinstance(result, dict):
                continue
            result_location = f"{location}.checks[{check_index}]"
            assessment = result.get("assessment_status")
            outcome = result.get("outcome")
            if assessment == "not_assessed" and outcome != "not_assessed":
                errors.append(f"{result_location}: not_assessed outcome is incoherent")
            if assessment == "not_applicable" and outcome != "not_applicable":
                errors.append(f"{result_location}: not_applicable outcome is incoherent")
            if assessment == "configured":
                if outcome not in {"pass", "fail", "unavailable"}:
                    errors.append(f"{result_location}: configured outcome is invalid")
                for field in ("argv", "version_argv"):
                    argv = result.get(field)
                    if not project_argv_is_safe(argv) or project_argv_uses_inline_shell(argv):
                        errors.append(
                            f"{result_location}: recorded {field} is not argv-safe"
                        )
                if outcome == "pass":
                    deadline = freshness_deadline(result.get("fresh_until"))
                    if (
                        result.get("exit_code") != 0
                        or result.get("tool_version_outcome") != "pass"
                        or not isinstance(result.get("tool_version"), str)
                        or not result.get("tool_version", "").strip()
                        or not isinstance(result.get("tool_version_output_sha256"), str)
                        or deadline is None
                    ):
                        errors.append(
                            f"{result_location}: passing result lacks execution/version/freshness evidence"
                        )
                elif result.get("fresh_until") is not None:
                    errors.append(
                        f"{result_location}: non-passing result cannot claim freshness"
                    )
            mutation = result.get("repository_mutation")
            if (
                outcome == "pass"
                and isinstance(mutation, dict)
                and mutation.get("outside_declared_write_scope")
            ):
                errors.append(
                    f"{result_location}: passing result changed paths outside declared scope"
                )
        outcomes = {
            item.get("outcome")
            for item in checks
            if isinstance(item, dict)
        }
        expected_overall = (
            "fail"
            if "fail" in outcomes
            else "unavailable"
            if outcomes & {"unavailable", "not_assessed"}
            else "pass"
        )
        if record.get("overall_outcome") != expected_overall:
            errors.append(f"{location}: overall outcome is inconsistent with checks")
    return store, errors


def check_project_check_evidence(root: Path) -> list[str]:
    return load_project_check_evidence(root)[1]


def fresh_project_evidence_record(
    root: Path,
    project: dict[str, Any],
) -> tuple[dict[str, Any] | None, list[str]]:
    store, errors = load_project_check_evidence(root)
    if store is None or not isinstance(store.get("records"), list):
        return None, errors
    current_fingerprint = project_check_source_fingerprint(root)
    candidates = [
        record
        for record in store["records"]
        if isinstance(record, dict)
        and isinstance(record.get("source_after"), dict)
        and record["source_after"].get("fingerprint") == current_fingerprint
    ]
    candidates.sort(key=lambda item: str(item.get("ended_at", "")))
    return (candidates[-1] if candidates else None), errors


def check_high_assurance_trigger_adoption(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    registry, errors = load_dossier_registry(root)
    if registry is None:
        return errors
    artifact_types = _sorted_by_id(registry.get("artifact_types"))
    representations = _sorted_by_id(registry.get("representations"))
    now = datetime.now().astimezone()
    for artifact_type in artifact_types:
        if artifact_type.get("classification") not in {"conditional", "optional"}:
            continue
        artifact_type_id = artifact_type.get("id")
        applicability = artifact_type.get("applicability", {})
        status = applicability.get("status") if isinstance(applicability, dict) else None
        if status == "not_assessed":
            errors.append(
                f"artifact type {artifact_type_id}: adopted High Assurance project "
                "retains an unresolved conditional/optional trigger"
            )
            continue
        if status != "applicable":
            continue
        active_representations = [
            representation
            for representation in representations
            if artifact_type_id in representation.get("artifact_type_ids", [])
            and representation.get("applicability", {}).get("status")
            in {"required", "applicable", "combined"}
            and representation.get("superseded_by") is None
        ]
        if not active_representations:
            errors.append(
                f"artifact type {artifact_type_id}: applicable High Assurance control "
                "lacks an active assessed representation"
            )
        elif any(
            not isinstance(item.get("owner_role"), str)
            or not item.get("owner_role", "").strip()
            for item in active_representations
        ):
            errors.append(
                f"artifact type {artifact_type_id}: applicable High Assurance control "
                "lacks a representation owner"
            )
        if not any(
            isinstance(item.get("review"), dict)
            and item["review"].get("status") == "reviewed"
            and isinstance(item["review"].get("last_reviewed_on"), str)
            and bool(item["review"]["last_reviewed_on"].strip())
            for item in active_representations
        ):
            errors.append(
                f"artifact type {artifact_type_id}: applicable High Assurance control "
                "lacks an active reviewed representation"
            )
        evidence_refs = applicability.get("evidence_refs", [])
        if not isinstance(evidence_refs, list) or not evidence_refs:
            errors.append(
                f"artifact type {artifact_type_id}: applicable High Assurance control "
                "requires assessment evidence references"
            )
            continue
        for evidence_ref in evidence_refs:
            evidence = records.get(evidence_ref)
            if evidence is None or not str(evidence_ref).startswith("EVD-"):
                errors.append(
                    f"artifact type {artifact_type_id}: unresolved assessment "
                    f"evidence {evidence_ref}"
                )
                continue
            value = evidence[0]
            deadline = freshness_deadline(value.get("fresh_until"))
            if value.get("result") == "not_assessed" or deadline is None or deadline < now:
                errors.append(
                    f"artifact type {artifact_type_id}: assessment evidence "
                    f"{evidence_ref} is unassessed, undated, or stale"
                )
    return errors


def check_adopted_project_conformance(
    root: Path,
    project: dict[str, Any],
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    errors: list[str] = []
    commands = project.get("commands", {})
    for hook in PROJECT_COMMAND_HOOKS:
        command = commands.get(hook, {}) if isinstance(commands, dict) else {}
        if command.get("status") == "not_assessed":
            errors.append(
                f".agent/project.json: adopted project retains unassessed hook {hook}"
            )
    evidence_record, evidence_errors = fresh_project_evidence_record(root, project)
    errors.extend(evidence_errors)
    configured = [
        hook
        for hook in PROJECT_COMMAND_HOOKS
        if isinstance(commands.get(hook), dict)
        and commands[hook].get("status") == "configured"
    ] if isinstance(commands, dict) else []
    if configured:
        if evidence_record is None:
            errors.append(
                ".agent/project-checks/evidence.json: adopted project lacks "
                "project-check evidence for the current source fingerprint"
            )
        else:
            by_hook = {
                item.get("hook"): item
                for item in evidence_record.get("checks", [])
                if isinstance(item, dict)
            }
            if evidence_record.get("overall_outcome") != "pass":
                errors.append(
                    ".agent/project-checks/evidence.json: latest current project-check "
                    "record is not a complete pass"
                )
            now = datetime.now().astimezone()
            for hook in configured:
                command = commands[hook]
                result = by_hook.get(hook, {})
                deadline = freshness_deadline(result.get("fresh_until"))
                if (
                    result.get("assessment_status") != "configured"
                    or result.get("outcome") != "pass"
                    or result.get("argv") != command.get("argv")
                    or result.get("version_argv") != command.get("version_argv")
                    or result.get("tool_name") != command.get("tool_name")
                    or result.get("exit_code") != 0
                    or result.get("tool_version_outcome") != "pass"
                    or deadline is None
                    or deadline < now
                ):
                    errors.append(
                        f".agent/project-checks/evidence.json: {hook} lacks current "
                        "passing evidence matching its configured argv/tool contract"
                    )
    if project.get("project", {}).get("profile") == "high-assurance":
        errors.extend(check_high_assurance_trigger_adoption(root, records))
    return errors


def check_kernel(root: Path) -> list[str]:
    errors: list[str] = []
    allowed_agent_entries = {
        "START_HERE.md",
        "approvals",
        "artifacts",
        "available-packages",
        "capabilities",
        "checklists",
        "checkpoints",
        "commands.json",
        "context.json",
        "coordination",
        "decisions",
        "diagnostics",
        "evaluations",
        "events",
        "evidence",
        "extensions",
        "generated",
        "lifecycle.json",
        "metrics",
        "packages.json",
        "policy.json",
        "project.json",
        "project-checks",
        "reviews",
        "schema.json",
        "scm.json",
        "schemas",
        "scripts",
        "state",
        "tasks",
        "templates",
        "tests",
        "tools.json",
        "transactions",
        "validators.json",
        "workflows",
        "work-runs",
    }
    agent_root = root / ".agent"
    if agent_root.is_dir():
        for path in sorted(agent_root.iterdir()):
            if path.name not in allowed_agent_entries:
                errors.append(
                    f"{relative(path, root)}: unknown live-governance path"
                )
    values: dict[str, dict[str, Any]] = {}
    try:
        kernel_schema = load_schema(root, "harness-kernel.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/schemas/harness-kernel.schema.json: {error}"]
    for relative_path in KERNEL_FILES:
        path = root / relative_path
        if not path.is_file():
            errors.append(f"missing required kernel file: {relative_path}")
            continue
        try:
            value = load_json(path)
        except (ValueError, json.JSONDecodeError) as error:
            errors.append(f"{relative_path}: {error}")
            continue
        if not isinstance(value, dict):
            errors.append(f"{relative_path}: expected object")
            continue
        values[relative_path] = value
        definition = KERNEL_SCHEMA_DEFS[relative_path]
        errors.extend(
            f"{relative_path}: {item}"
            for item in validate_schema(
                value,
                {"$ref": f"#/$defs/{definition}"},
                root_schema=kernel_schema,
            )
        )

    policy = values.get(".agent/policy.json", {})
    if not (
        policy.get("permission_grant") is False
        and policy.get("default") == "deny"
        and policy.get("declarative_only") is True
        and policy.get("external", {}).get("publication")
        == "requires_explicit_current_authorization"
        and policy.get("external", {}).get("deployment")
        == "requires_explicit_current_authorization"
        and policy.get("repository", {}).get("dossier_instruction_channel") is False
        and "lower_level_files_cannot_expand_authority"
        in policy.get("invariants", [])
    ):
        errors.append(".agent/policy.json: critical non-authorizing invariants missing")

    context = values.get(".agent/context.json", {})
    if not (
        context.get("permission_grant") is False
        and "applicable_AGENTS_md_root_to_leaf" in context.get("precedence", [])
        and context.get("path_scope", {}).get("child_may_weaken_ancestor") is False
        and context.get("conflicts", {}).get("ambiguous_high_impact_action")
        == "stop_and_request_authority"
    ):
        errors.append(".agent/context.json: precedence or path-scope contract invalid")
    expected_context_contract = {
        "precedence": [
            "platform_system_sandbox_and_tool_constraints",
            "current_operator_instruction",
            "applicable_AGENTS_md_root_to_leaf",
            "live_policy_within_higher_authority",
            "accepted_in_scope_decisions",
            "direct_observation_and_fresh_evidence",
            "canonical_dossier_target",
            "active_task_and_implementation_plan",
            "maintained_explanatory_documentation",
            "drafts_generated_imported_and_historical",
        ],
        "information_states": {
            "permission": "authorized_channel_only",
            "intended_state": "canonical_target_and_accepted_decisions",
            "current_state": "dated_direct_observation",
            "planning": "dependency_partial_order_for_future_work_not_permission",
            "evidence": "bounded_support_for_a_claim",
            "provenance": "source_origin_and_limitations",
            "generated": "point_in_time_non_authoritative_view",
            "historical": "retained_noncurrent_context",
        },
        "conflicts": {
            "permission": "higher_and_safer_compatible_rule",
            "current_state": "newest_direct_evidence",
            "intended_state": "accepted_decision_then_canonical_target",
            "ambiguous_high_impact_action": "stop_and_request_authority",
            "reversible_local_analysis": "continue_with_stated_assumptions",
        },
        "non_instruction_classes": [
            "dossier_and_documentation",
            "plans_and_templates",
            "generated_reports_and_model_output",
            "imported_and_web_content",
            "tool_output_and_untrusted_data",
        ],
    }
    if any(
        context.get(field) != expected
        for field, expected in expected_context_contract.items()
    ):
        errors.append(".agent/context.json: safety contract differs from kernel")

    expected_policy_contract = {
        "non_authorization_rule": (
            "This harness cannot create permission. Every action remains bounded "
            "by current user instructions, platform policy, applicable AGENTS.md "
            "files, tool permissions, the host sandbox, contracts, and law."
        ),
        "local": {
            "read_repository": "allowed_when_relevant",
            "modify_repository": "requires_implementation_request",
            "run_declared_validation": "allowed",
            "start_services": "denied_unless_declared_loopback_and_disposable",
        },
        "external": {
            "network": "denied_unless_tool_and_task_scoped",
            "publication": "requires_explicit_current_authorization",
            "deployment": "requires_explicit_current_authorization",
            "communication": "requires_explicit_current_authorization",
            "purchase": "requires_explicit_current_authorization",
        },
        "autonomous_delivery": {
            "pre_activation": "read_only_no_hooks_no_repository_or_external_mutation",
            "write_activation": "independent_exact_digest_human_confirmation_required",
            "external_effects": "current_exact_plan_projection_and_live_revalidation_required",
            "unknown_outcome_retries": 0,
            "direct_external_spending_usd": 0,
            "credentials": "creation_storage_and_forwarding_prohibited",
        },
        "sensitive": {
            "secret_values_in_repository_or_logs": "prohibited",
            "production_data": "prohibited_unless_explicitly_authorized_and_isolated",
            "destructive_operations": "require_exact_target_and_explicit_authorization",
            "legal_or_compliance_determinations": "require_qualified_human_authority",
        },
        "invariants": [
            "lower_level_files_cannot_expand_authority",
            "installed_tools_do_not_imply_permission",
            "capabilities_inherit_and_cannot_expand_task_authority",
            "generated_outputs_are_non_authoritative_and_point_in_time",
        ],
    }
    if any(
        policy.get(field) != expected
        for field, expected in expected_policy_contract.items()
    ) or policy.get("project_specific_adoption", {}).get("requires") != [
        "inspected_project_scope_and_threat_model",
        "explicit_authority_source",
        "project_specific_decision_record",
        "successful_read_only_check_and_mutation_tests",
    ]:
        errors.append(".agent/policy.json: safety contract differs from kernel")

    schema = values.get(".agent/schema.json", {})
    lifecycle = values.get(".agent/lifecycle.json", {})
    if schema.get("kernel_version") != KERNEL_VERSION:
        errors.append(".agent/schema.json: unsupported kernel version")
    if schema.get("record_versions") != EXPECTED_RECORD_VERSIONS:
        errors.append(".agent/schema.json: record-version contract mismatch")
    if schema.get("id_patterns") != EXPECTED_ID_PATTERNS:
        errors.append(".agent/schema.json: record ID contract mismatch")
    if schema.get("compatibility") != {
        "extension_api": "harness.extension.v1",
        "unknown_safety_values": "reject",
    } or schema.get("evolution") != {
        "breaking_change_requires_major_version": True,
        "migration_must_be_idempotent_and_fixture_tested": True,
        "accepted_decision_changes_require_successor": True,
    }:
        errors.append(".agent/schema.json: compatibility/evolution contract mismatch")
    actual_statuses = schema.get("statuses", {})
    if (
        set(actual_statuses) != set(EXPECTED_LIFECYCLES)
        or any(
            set(actual_statuses.get(kind, []))
            != set(contract["transitions"])
            or len(actual_statuses.get(kind, [])) != len(contract["transitions"])
            for kind, contract in EXPECTED_LIFECYCLES.items()
        )
    ):
        errors.append(".agent/schema.json: controlled status vocabularies mismatch")
    for kind, expected in EXPECTED_LIFECYCLES.items():
        if lifecycle.get(kind) != expected:
            errors.append(
                f".agent/lifecycle.json: {kind} lifecycle differs from versioned contract"
            )

    validators = values.get(".agent/validators.json", {})
    commands = validators.get("commands", {})
    project = values.get(".agent/project.json", {})
    profile = project.get("project", {}).get("profile")
    refresh_writes = [
        ".agent/state/current.json",
        "project-dossier/ARTIFACT_CATALOG.json",
        "project-dossier/MANIFEST.json",
        "project-dossier/machine-readable/path-authority.json",
    ]
    if profile == "high-assurance":
        refresh_writes = sorted(
            refresh_writes
            + [
                ".agent/generated/manifest.json",
                ".agent/generated/validation-report.json",
                "project-dossier/CHECKSUMS.sha256",
            ]
        )
    expected_commands = {
        "bootstrap": {"run": "python --version", "writes": []},
        "check": {
            "run": "python -B .agent/scripts/validate.py --check",
            "writes": [],
        },
        "ready_frontier": {
            "run": "python -B .agent/scripts/validate.py --ready-frontier",
            "writes": [],
        },
        "collaboration_assessment": {
            "run": "python -B .agent/scripts/validate.py --assess-collaboration",
            "writes": [],
        },
        "test": {
            "run": "python -B .agent/tests/test_validate.py --tier integration",
            "writes": [],
        },
        "test_fast": {
            "run": "python -B .agent/tests/test_validate.py --tier fast",
            "writes": [],
        },
        "test_integration": {
            "run": "python -B .agent/tests/test_validate.py --tier integration",
            "writes": [],
        },
        "test_release": {
            "run": "python -B .agent/tests/test_validate.py --tier release",
            "writes": [],
        },
        "project_checks": {
            "run": (
                "python -B .agent/scripts/run_project_checks.py --write-evidence"
            ),
            "writes": [".agent/project-checks/archive", PROJECT_CHECK_EVIDENCE_PATH],
        },
        "project_checks_reuse": {
            "run": (
                "python -B .agent/scripts/run_project_checks.py --write-evidence "
                "--changed-scope --reuse-proofs"
            ),
            "writes": [".agent/project-checks/archive", PROJECT_CHECK_EVIDENCE_PATH],
        },
        "adoption_verify": {
            "run": (
                "python -B .agent/scripts/run_project_checks.py --write-evidence "
                "--verify-adoption"
            ),
            "writes": "project_check_evidence_and_profile_refresh_outputs",
        },
        "refresh": {
            "run": "python -B .agent/scripts/refresh.py --refresh",
            "writes": refresh_writes,
        },
        "closure": {
            "run": "configure_during_project_adoption",
            "writes": "not_assessed",
        },
    }
    expected_for_version = dict(expected_commands)
    expected_checks = list(EXPECTED_REQUIRED_CORE_CHECKS)
    if validators.get("schema_version") == "harness.validators.v4":
        expected_for_version.pop("project_checks_reuse", None)
        expected_checks = [
            item
            for item in expected_checks
            if item not in {
                "content_addressed_validation_proof_reuse",
                "typed_continuation_and_safe_transaction_bundles",
            }
        ]
    if (
        validators.get("validator_version") != KERNEL_VERSION
        or commands != expected_for_version
        or validators.get("required_core_checks") != expected_checks
    ):
        errors.append(".agent/validators.json: core command contract mismatch")
    tools = values.get(".agent/tools.json", {})
    if not (
        tools.get("permission_grant") is False
        and tools.get("declarative_only") is True
        and tools.get("evidence", {}).get("tool_availability_implies_permission")
        is False
    ):
        errors.append(".agent/tools.json: availability/authority boundary invalid")
    tool_catalogs = tools.get("tools", {})
    if (
        not isinstance(tool_catalogs, dict)
        or tool_catalogs.get("filesystem")
        != {
            "availability": "required",
            "allowed": ["read_relevant", "write_requested_repository_paths"],
            "denied": [
                "write_outside_declared_workspace",
                "follow_untrusted_symlink",
            ],
        }
        or tool_catalogs.get("shell")
        != {
            "availability": "required",
            "allowed": ["declared_validation", "scoped_local_commands"],
            "denied": ["undeclared_external_effect", "secret_in_command"],
        }
        or tools.get("evidence") != {
        "record_material_commands": True,
        "redact_secret_values": True,
        "tool_availability_implies_permission": False,
        }
        or tools.get("real_enforcement_boundary")
        != [
            "platform_and_sandbox_permissions",
            "operating_system_and_workspace_access",
            "credential_scope",
            "protected_remote_controls",
        ]
    ):
        errors.append(".agent/tools.json: safety vocabulary differs from kernel")
    errors.extend(check_tool_operation_contract(tools))
    project_id = project.get("project", {}).get("id")
    if (
        not isinstance(project_id, str)
        or policy.get("project_slug") != project_id
        or context.get("project_slug") != project_id
    ):
        errors.append(".agent: governance kernel project identity mismatch")
    errors.extend(check_project_command_contract(root, project))
    errors.extend(check_work_completion_config(root, project))
    errors.extend(check_autonomous_delivery_config(root, project))
    for group in ("source", "tests", "generated", "instruction_roots"):
        for index, item in enumerate(project.get("paths", {}).get(group, [])):
            _, path_error = safe_relative_path(root, item)
            if path_error:
                errors.append(
                    f".agent/project.json: paths.{group}[{index}] {path_error}"
                )
    return errors


def check_origin(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]] | None = None,
) -> list[str]:
    path = root / ".octon-mini-origin.json"
    try:
        origin = load_json(path)
        schema = load_schema(root, "octon-mini-project-origin.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".octon-mini-origin.json: {error}"]
    errors = [
        f".octon-mini-origin.json: {item}"
        for item in validate_schema(origin, schema)
    ]
    if isinstance(origin, dict):
        generated_paths = origin.get("generated_paths", [])
        generated_path_set = {
            item for item in generated_paths if isinstance(item, str)
        }
        for index, item in enumerate(origin.get("generated_paths", [])):
            _, path_error = safe_relative_path(root, item)
            if path_error:
                errors.append(
                    f".octon-mini-origin.json: generated_paths[{index}] "
                    f"{path_error}"
                )
        profile = origin.get("profile")
        required_operational = PROFILE_OPERATIONAL_FILES
        for required_path in sorted(required_operational):
            if required_path not in generated_path_set:
                errors.append(
                    ".octon-mini-origin.json: profile-required operational "
                    f"path absent from inventory: {required_path}"
                )
            candidate = root / required_path
            if (
                required_path not in DERIVED_OPERATIONAL_FILES
                and (not candidate.is_file() or candidate.is_symlink())
            ):
                errors.append(
                    f"{required_path}: profile-required operational file missing"
                )
        try:
            project = load_json(root / ".agent/project.json")
            registry = load_json(
                root / "project-dossier/machine-readable/artifact-registry.json"
            )
            if (
                not isinstance(project, dict)
                or not isinstance(project.get("project"), dict)
                or
                project.get("project", {}).get("id") != origin.get("project_slug")
                or project.get("project", {}).get("profile") != origin.get("profile")
            ):
                errors.append(
                    ".octon-mini-origin.json: project identity/profile mismatch"
                )
            if (
                not isinstance(registry, dict)
                or registry.get("layout") != origin.get("layout")
            ):
                errors.append(
                    ".octon-mini-origin.json: physical layout differs from the artifact registry"
                )
            if (
                isinstance(project, dict)
                and isinstance(project.get("project"), dict)
                and project["project"].get("octon_mini_version")
                != origin.get("octon_mini_version")
            ):
                errors.append(
                    ".octon-mini-origin.json: project Octon Mini version mismatch"
                )
        except (OSError, ValueError, json.JSONDecodeError):
            pass
        try:
            harness_schema = load_json(root / ".agent/schema.json")
            if (
                not isinstance(harness_schema, dict)
                or origin.get("harness_kernel_version") != KERNEL_VERSION
                or harness_schema.get("kernel_version") != KERNEL_VERSION
            ):
                errors.append(
                    ".octon-mini-origin.json: harness kernel version mismatch"
                )
        except (OSError, ValueError, json.JSONDecodeError):
            pass
        initial = origin.get("initial_generation")
        history = origin.get("migration_history")
        if initial is not None or history is not None:
            if not isinstance(initial, dict) or not isinstance(history, list):
                errors.append(
                    ".octon-mini-origin.json: upgrade provenance is incomplete"
                )
            else:
                migration_ids: set[str] = set()
                expected_product = initial.get("product")
                expected_from = initial.get("version")
                expected_profile = initial.get("profile")
                expected_layout = initial.get("layout")
                previous_date = initial.get("generated_on")
                for index, migration in enumerate(history):
                    if not isinstance(migration, dict):
                        continue
                    migration_id = migration.get("id")
                    if migration_id in migration_ids:
                        errors.append(
                            ".octon-mini-origin.json: duplicate migration ID"
                        )
                    if isinstance(migration_id, str):
                        migration_ids.add(migration_id)
                    if migration.get("from_product") != expected_product:
                        errors.append(
                            ".octon-mini-origin.json: migration product chain "
                            f"breaks at index {index}"
                        )
                    if migration.get("from_version") != expected_from:
                        errors.append(
                            ".octon-mini-origin.json: migration version chain "
                            f"breaks at index {index}"
                        )
                    if migration.get("from_profile") != expected_profile:
                        errors.append(
                            ".octon-mini-origin.json: migration profile chain "
                            f"breaks at index {index}"
                        )
                    if migration.get("from_layout") != expected_layout:
                        errors.append(
                            ".octon-mini-origin.json: migration layout chain "
                            f"breaks at index {index}"
                        )
                    if not str(migration.get("authority_source", "")).startswith(
                        ("authority:", "external:")
                    ):
                        errors.append(
                            ".octon-mini-origin.json: migration authority "
                            f"is invalid at index {index}"
                        )
                    evidence_refs = migration.get("evidence_refs", [])
                    if not evidence_refs:
                        errors.append(
                            ".octon-mini-origin.json: migration evidence "
                            f"is missing at index {index}"
                        )
                    elif records is not None:
                        for reference in evidence_refs:
                            if (
                                reference not in records
                                or not str(reference).startswith("EVD-")
                            ):
                                errors.append(
                                    ".octon-mini-origin.json: unresolved "
                                    f"migration evidence {reference}"
                                )
                    migrated_on = migration.get("migrated_on")
                    if (
                        isinstance(previous_date, str)
                        and isinstance(migrated_on, str)
                        and migrated_on < previous_date
                    ):
                        errors.append(
                            ".octon-mini-origin.json: migration dates are "
                            "not chronological"
                        )
                    expected_product = migration.get("to_product")
                    expected_from = migration.get("to_version")
                    expected_profile = migration.get("to_profile")
                    expected_layout = migration.get("to_layout")
                    previous_date = migrated_on
                if expected_product != origin.get("product"):
                    errors.append(
                        ".octon-mini-origin.json: migration history does not "
                        "reach the current product identity"
                    )
                if expected_from != origin.get("octon_mini_version"):
                    errors.append(
                        ".octon-mini-origin.json: migration history does not "
                        "reach current Octon Mini version"
                    )
                if expected_profile != origin.get("profile"):
                    errors.append(
                        ".octon-mini-origin.json: migration history does not "
                        "reach current profile"
                    )
                if expected_layout != origin.get("layout"):
                    errors.append(
                        ".octon-mini-origin.json: migration history does not "
                        "reach current layout"
                    )
                if history and history[-1].get("generator_version") != origin.get(
                    "generator_version"
                ):
                    errors.append(
                        ".octon-mini-origin.json: latest migration generator "
                        "does not match current provenance"
                    )
                if not history:
                    initial_to_origin = {
                        "product": "product",
                        "version": "octon_mini_version",
                        "generator_version": "generator_version",
                        "generation_id": "generation_id",
                        "generated_on": "generated_on",
                        "profile": "profile",
                        "layout": "layout",
                    }
                    for initial_field, origin_field in initial_to_origin.items():
                        if initial.get(initial_field) != origin.get(origin_field):
                            errors.append(
                                ".octon-mini-origin.json: initial generation "
                                f"{initial_field} differs without migration history"
                            )
        inventory = origin.get("installed_inventory")
        if isinstance(inventory, dict):
            inventory_paths = inventory.get("paths", [])
            path_values = [
                item.get("path")
                for item in inventory_paths
                if isinstance(item, dict)
            ]
            if len(path_values) != len(set(path_values)):
                errors.append(
                    ".octon-mini-origin.json: installed inventory paths must be unique"
                )
            if set(path_values) != generated_path_set:
                errors.append(
                    ".octon-mini-origin.json: installed inventory differs from generated_paths"
                )
            for item in inventory_paths:
                if not isinstance(item, dict):
                    continue
                role = item.get("role")
                digest = item.get("sha256")
                mode = item.get("mode")
                if role in {"derived", "provenance"}:
                    if digest is not None or mode is not None:
                        errors.append(
                            ".octon-mini-origin.json: derived/provenance inventory entries must not claim a pristine hash"
                        )
                elif digest is None or mode is None:
                    errors.append(
                        ".octon-mini-origin.json: static installed inventory entry lacks hash or mode"
                    )
    return errors


def record_files(root: Path) -> list[tuple[Path, str]]:
    result: list[tuple[Path, str]] = []
    specifications = (
        (".agent/tasks", "TASK-*.md", "task"),
        (".agent/decisions", "DEC-*.md", "decision"),
        (".agent/evidence", "EVD-*.md", "evidence"),
        (".agent/reviews", "REV-*.md", "review"),
        (".agent/checkpoints", "CHK-*.md", "checkpoint"),
    )
    for directory, pattern, kind in specifications:
        base = root / directory
        if base.is_dir():
            result.extend((path, kind) for path in sorted(base.glob(pattern)))
    return result


def check_record_store_filenames(root: Path) -> list[str]:
    errors: list[str] = []
    specifications = (
        (".agent/tasks", r"TASK-[0-9]{4}(?:-[a-z0-9-]+)?\.md"),
        (".agent/decisions", r"DEC-[0-9]{4}(?:-[a-z0-9-]+)?\.md"),
        (".agent/evidence", r"EVD-[0-9]{4}(?:-[a-z0-9-]+)?\.md"),
        (".agent/reviews", r"REV-[0-9]{4}(?:-[a-z0-9-]+)?\.md"),
        (".agent/checkpoints", r"CHK-[0-9]{4}(?:-[a-z0-9-]+)?\.md"),
    )
    for directory, pattern in specifications:
        base = root / directory
        if not base.is_dir():
            continue
        for path in sorted(base.iterdir()):
            if path.name == "README.md" or (
                directory == ".agent/decisions"
                and path.name in {"governance-register.json", "reuse-policy.json"}
            ):
                continue
            if path.is_dir() or not re.fullmatch(pattern, path.name):
                errors.append(
                    f"{relative(path, root)}: unexpected governed record-store path"
                )
    events = root / ".agent/events"
    if events.is_dir():
        for path in sorted(events.iterdir()):
            if path.name == "README.md":
                continue
            if path.is_dir() or path.suffix != ".jsonl":
                errors.append(
                    f"{relative(path, root)}: unexpected event-store path"
                )
    return errors


def collect_records(
    root: Path,
) -> tuple[dict[str, tuple[dict[str, Any], str]], list[str]]:
    records: dict[str, tuple[dict[str, Any], str]] = {}
    errors: list[str] = check_record_store_filenames(root)
    try:
        record_schema = load_schema(root, "harness-record.schema.json")
        dossier_schema = load_schema(root, "dossier-records.schema.json")
        artifact_schema = load_schema(root, "harness-artifact-registry.schema.json")
        assurance_schema = load_schema(root, "harness-assurance-records.schema.json")
        harness_schema = load_json(root / ".agent/schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return records, [f"schema loading failed: {error}"]

    for path, kind in record_files(root):
        rel = relative(path, root)
        try:
            record = parse_json_header(path)
        except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError) as error:
            errors.append(f"{rel}: {error}")
            continue
        errors.extend(
            f"{rel}: {item}"
            for item in validate_schema(
                record,
                {"$ref": f"#/$defs/{kind}"},
                root_schema=record_schema,
            )
        )
        record_id = record.get("id")
        expected_version = harness_schema.get("record_versions", {}).get(kind)
        expected_pattern = harness_schema.get("id_patterns", {}).get(kind)
        if record.get("schema_version") != expected_version:
            errors.append(f"{rel}: schema version does not match {kind} record kind")
        if (
            not isinstance(record_id, str)
            or not isinstance(expected_pattern, str)
            or not re.fullmatch(expected_pattern, record_id)
        ):
            errors.append(f"{rel}: invalid {kind} ID")
            continue
        if not path.name.startswith(record_id):
            errors.append(f"{rel}: filename/ID mismatch")
        if record_id in records:
            errors.append(f"{rel}: duplicate global record ID {record_id}")
        else:
            records[record_id] = (record, rel)

    for store_path, (array_name, definition, store_definition) in DOSSIER_STORES.items():
        path = root / store_path
        if not path.is_file():
            continue
        try:
            store = load_json(path)
        except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError) as error:
            errors.append(f"{store_path}: {error}")
            continue
        errors.extend(
            f"{store_path}: {item}"
            for item in validate_schema(
                store,
                {"$ref": f"#/$defs/{store_definition}"},
                root_schema=dossier_schema,
            )
        )
        entries = store.get(array_name) if isinstance(store, dict) else None
        if not isinstance(entries, list):
            errors.append(f"{store_path}: {array_name} must be an array")
            continue
        item_schema = {"$ref": f"#/$defs/{definition}"}
        for index, record in enumerate(entries):
            item_path = f"{store_path}:{array_name}[{index}]"
            errors.extend(
                f"{item_path}: {item}"
                for item in validate_schema(
                    record, item_schema, root_schema=dossier_schema
                )
            )
            record_id = record.get("id") if isinstance(record, dict) else None
            if isinstance(record_id, str):
                if record_id in records:
                    errors.append(f"{item_path}: duplicate global record ID {record_id}")
                else:
                    records[record_id] = (record, item_path)

    gates_path = root / "project-dossier" / "validation" / "QUALITY_GATES.json"
    if gates_path.is_file():
        try:
            gates_value = load_json(gates_path)
            errors.extend(
                f"project-dossier/validation/QUALITY_GATES.json: {item}"
                for item in validate_schema(
                    gates_value,
                    {"$ref": "#/$defs/quality_gates_store"},
                    root_schema=dossier_schema,
                )
            )
            if not isinstance(gates_value, dict):
                raise ValueError("top-level value must be an object")
            gates = gates_value.get("gates", [])
            if not isinstance(gates, list):
                raise ValueError("gates must be an array")
            for index, gate in enumerate(gates):
                gate_id = gate.get("id") if isinstance(gate, dict) else None
                location = f"project-dossier/validation/QUALITY_GATES.json:gates[{index}]"
                if not isinstance(gate_id, str) or not re.fullmatch(
                    r"GATE-[0-9]{4}", gate_id
                ):
                    errors.append(f"{location}: invalid gate ID")
                elif gate_id in records:
                    errors.append(f"{location}: duplicate global record ID {gate_id}")
                else:
                    records[gate_id] = (gate, location)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            errors.append(f"project-dossier/validation/QUALITY_GATES.json: {error}")

    supersession_path = root / "project-dossier" / "SUPERSESSION.json"
    if supersession_path.is_file():
        try:
            supersession = load_json(supersession_path)
            errors.extend(
                f"project-dossier/SUPERSESSION.json: {item}"
                for item in validate_schema(
                    supersession,
                    {"$ref": "#/$defs/supersession_store"},
                    root_schema=dossier_schema,
                )
            )
            if not isinstance(supersession, dict):
                raise ValueError("top-level value must be an object")
            for index, record in enumerate(supersession.get("records", [])):
                location = f"project-dossier/SUPERSESSION.json:records[{index}]"
                record_id = record.get("id") if isinstance(record, dict) else None
                if isinstance(record_id, str):
                    if record_id in records:
                        errors.append(f"{location}: duplicate global record ID {record_id}")
                    else:
                        records[record_id] = (record, location)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            errors.append(f"project-dossier/SUPERSESSION.json: {error}")

    artifact_registry_path = root / ".agent" / "artifacts" / "registry.json"
    if artifact_registry_path.is_file():
        try:
            registry = load_json(artifact_registry_path)
            errors.extend(
                f".agent/artifacts/registry.json: {item}"
                for item in validate_schema(registry, artifact_schema)
            )
            if not isinstance(registry, dict):
                raise ValueError("top-level value must be an object")
            for index, record in enumerate(registry.get("artifacts", [])):
                location = f".agent/artifacts/registry.json:artifacts[{index}]"
                record_id = record.get("id") if isinstance(record, dict) else None
                if isinstance(record_id, str):
                    if record_id in records:
                        errors.append(f"{location}: duplicate global record ID {record_id}")
                    else:
                        records[record_id] = (record, location)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            errors.append(f".agent/artifacts/registry.json: {error}")

    for store_path, (array_name, definition, store_definition) in ASSURANCE_STORES.items():
        path = root / store_path
        if not path.is_file():
            continue
        try:
            store = load_json(path)
            errors.extend(
                f"{store_path}: {item}"
                for item in validate_schema(
                    store,
                    {"$ref": f"#/$defs/{store_definition}"},
                    root_schema=assurance_schema,
                )
            )
            if not isinstance(store, dict):
                raise ValueError("top-level value must be an object")
            for index, record in enumerate(store.get(array_name, [])):
                location = f"{store_path}:{array_name}[{index}]"
                record_errors = validate_schema(
                    record,
                    {"$ref": f"#/$defs/{definition}"},
                    root_schema=assurance_schema,
                )
                errors.extend(f"{location}: {item}" for item in record_errors)
                record_id = record.get("id") if isinstance(record, dict) else None
                if isinstance(record_id, str):
                    if record_id in records:
                        errors.append(f"{location}: duplicate global record ID {record_id}")
                    else:
                        records[record_id] = (record, location)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            errors.append(f"{store_path}: {error}")

    events_root = root / ".agent" / "events"
    if events_root.is_dir():
        for path in sorted(events_root.glob("*.jsonl")):
            errors.extend(check_jsonl(path, root))
            try:
                lines = path.read_text(encoding="utf-8").splitlines()
            except (OSError, UnicodeDecodeError):
                continue
            for number, raw in enumerate(lines, 1):
                if not raw.strip():
                    continue
                try:
                    record = loads_json(raw)
                except (ValueError, json.JSONDecodeError):
                    continue
                if not isinstance(record, dict):
                    continue
                record_id = record.get("id")
                location = f"{relative(path, root)}:{number}"
                if isinstance(record_id, str):
                    if record_id in records:
                        errors.append(f"{location}: duplicate global record ID {record_id}")
                    else:
                        records[record_id] = (record, location)
    return records, errors


def _decision_graph_errors(
    node_ids: set[str],
    dependencies: dict[str, list[str]],
    declared_order: Any,
    label: str,
) -> list[str]:
    errors: list[str] = []
    for node_id, refs in dependencies.items():
        for reference in refs:
            if reference not in node_ids:
                errors.append(f"{label}: {node_id} references unknown dependency {reference}")
            if reference == node_id:
                errors.append(f"{label}: {node_id} depends on itself")

    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(node_id: str, trail: list[str]) -> None:
        if node_id in visiting:
            cycle_start = trail.index(node_id) if node_id in trail else 0
            cycle = trail[cycle_start:] + [node_id]
            errors.append(f"{label}: dependency cycle {' -> '.join(cycle)}")
            return
        if node_id in visited:
            return
        visiting.add(node_id)
        for reference in dependencies.get(node_id, []):
            if reference in node_ids:
                visit(reference, trail + [node_id])
        visiting.remove(node_id)
        visited.add(node_id)

    for node_id in sorted(node_ids):
        visit(node_id, [])

    if not isinstance(declared_order, list):
        errors.append(f"{label}: dependency_order must be an array")
        return errors
    order_ids = [item for item in declared_order if isinstance(item, str)]
    if len(order_ids) != len(declared_order):
        errors.append(f"{label}: dependency_order contains a non-string value")
    if len(order_ids) != len(set(order_ids)):
        errors.append(f"{label}: dependency_order contains duplicate IDs")
    if set(order_ids) != node_ids:
        errors.append(f"{label}: dependency_order must reconcile every ID exactly once")
        return errors
    positions = {item: index for index, item in enumerate(order_ids)}
    for node_id, refs in dependencies.items():
        for reference in refs:
            if reference in positions and positions[reference] >= positions[node_id]:
                errors.append(
                    f"{label}: dependency_order places {node_id} before dependency {reference}"
                )
    return errors


def _accepted_decision_authority(
    reference: Any,
    records: dict[str, tuple[dict[str, Any], str]],
    *,
    allow_superseded: bool = False,
) -> bool:
    if not isinstance(reference, str) or not re.fullmatch(r"DEC-[0-9]{4}", reference):
        return False
    entry = records.get(reference)
    if entry is None:
        return False
    record = entry[0]
    allowed_statuses = {"accepted", "superseded"} if allow_superseded else {"accepted"}
    return bool(
        record.get("status") in allowed_statuses
        and isinstance(record.get("authority_source"), str)
        and record["authority_source"].startswith(("authority:", "external:"))
    )


def _governance_reference_errors(
    value: Any,
    records: dict[str, tuple[dict[str, Any], str]],
    decisions: dict[str, dict[str, Any]],
    closure_items: dict[str, dict[str, Any]],
) -> list[str]:
    reference_fields = {
        "accepted_authority_constraints_inspected",
        "authoritative_references",
        "completion_evidence_refs",
        "decision_refs",
        "dependent_decision_refs",
        "evidence_refs",
        "gate_refs",
        "plan_refs",
        "references",
        "requirement_refs",
        "risk_refs",
        "supporting_evidence_refs",
    }
    errors: list[str] = []

    def visit(node: Any, location: str, field: str | None = None) -> None:
        if isinstance(node, dict):
            for key, child in node.items():
                visit(child, f"{location}.{key}", key)
            return
        if isinstance(node, list):
            if field in reference_fields:
                for index, reference in enumerate(node):
                    if not isinstance(reference, str):
                        continue
                    if reference.startswith(EXTERNAL_REFERENCE_PREFIXES):
                        continue
                    if reference.startswith("DREG-"):
                        resolved = reference in decisions
                    elif reference.startswith("CLOSE-"):
                        resolved = reference in closure_items
                    else:
                        resolved = reference in records
                    if not resolved:
                        errors.append(
                            f"{location}[{index}]: unresolved governance reference {reference}"
                        )
                return
            for index, child in enumerate(node):
                visit(child, f"{location}[{index}]", field)

    visit(value, ".agent/decisions/governance-register.json")
    return errors


def _handoff_claim_errors(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
    register_decisions: dict[str, dict[str, Any]],
) -> list[str]:
    path = root / "project-dossier/handoff/START_HERE.md"
    if not path.is_file():
        return []
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        return [f"project-dossier/handoff/START_HERE.md: {error}"]
    required_review_terms = (
        "## Authority reconciliation before reliance",
        "authoritative gate record",
        "accepted decision references",
        "version and ownership statements",
        "recommendations and owner selections",
        "implementation and readiness claims",
    )
    for term in required_review_terms:
        if term not in text:
            return [
                "project-dossier/handoff/START_HERE.md: mandatory authority reconciliation checklist is incomplete"
            ]

    errors: list[str] = []
    marker = re.compile(r"<!--\s*octon-handoff-claim\s+(\{.*?\})\s*-->")
    if "<!-- octon-handoff-claim" in text and not marker.search(text):
        errors.append(
            "project-dossier/handoff/START_HERE.md: malformed octon-handoff-claim marker"
        )
    quality: Any = None
    quality_path = root / "project-dossier/validation/QUALITY_GATES.json"
    if quality_path.is_file():
        try:
            quality = load_json(quality_path)
        except (OSError, ValueError, json.JSONDecodeError):
            quality = None
    for match in marker.finditer(text):
        try:
            claim = loads_json(match.group(1))
        except (ValueError, json.JSONDecodeError) as error:
            errors.append(
                f"project-dossier/handoff/START_HERE.md: invalid handoff claim JSON: {error}"
            )
            continue
        if not isinstance(claim, dict) or set(claim) != {"kind", "ref", "status"}:
            errors.append(
                "project-dossier/handoff/START_HERE.md: handoff claim requires exactly kind, ref, and status"
            )
            continue
        kind = claim.get("kind")
        reference = claim.get("ref")
        claimed_status = claim.get("status")
        actual_status: Any = None
        if kind == "gate" and isinstance(reference, str):
            actual_status = records.get(reference, ({}, ""))[0].get("status")
        elif kind == "decision" and isinstance(reference, str):
            actual_status = records.get(reference, ({}, ""))[0].get("status")
        elif kind == "decision register" and isinstance(reference, str):
            actual_status = register_decisions.get(reference, {}).get("lifecycle_state")
        elif (
            kind == "readiness"
            and reference == "project-dossier/validation/QUALITY_GATES.json"
            and isinstance(quality, dict)
        ):
            actual_status = quality.get("readiness")
        else:
            errors.append(
                "project-dossier/handoff/START_HERE.md: handoff claim has an unknown kind or unresolved reference"
            )
            continue
        if actual_status != claimed_status:
            errors.append(
                "project-dossier/handoff/START_HERE.md: subordinate handoff claim "
                f"{reference}={claimed_status!r} conflicts with authoritative status {actual_status!r}"
            )
    return errors


def check_decision_governance(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    path = root / ".agent/decisions/governance-register.json"
    location = ".agent/decisions/governance-register.json"
    if not path.is_file():
        return [f"{location}: required decision-governance register is missing"]
    try:
        value = load_json(path)
        schema = load_schema(root, "harness-decision-governance.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f"{location}: malformed decision-governance source: {error}"]
    errors = [
        f"{location}: {item}" for item in validate_schema(value, schema)
    ]
    if not isinstance(value, dict):
        return errors + [f"{location}: top-level value must be an object"]

    decisions_raw = value.get("decisions", [])
    dashboard_raw = value.get("dashboard", [])
    reviews_raw = value.get("trade_off_reviews", [])
    if not isinstance(decisions_raw, list):
        decisions_raw = []
    if not isinstance(dashboard_raw, list):
        dashboard_raw = []
    if not isinstance(reviews_raw, list):
        reviews_raw = []

    decisions: dict[str, dict[str, Any]] = {}
    for index, item in enumerate(decisions_raw):
        item_location = f"{location}:decisions[{index}]"
        if not isinstance(item, dict):
            continue
        decision_id = item.get("id")
        if not isinstance(decision_id, str):
            continue
        if decision_id in decisions:
            errors.append(f"{item_location}: duplicate stable decision-register ID {decision_id}")
        else:
            decisions[decision_id] = item

    dashboard: dict[str, dict[str, Any]] = {}
    for index, item in enumerate(dashboard_raw):
        item_location = f"{location}:dashboard[{index}]"
        if not isinstance(item, dict):
            continue
        decision_id = item.get("id")
        if not isinstance(decision_id, str):
            continue
        if decision_id in dashboard:
            errors.append(f"{item_location}: duplicate dashboard ID {decision_id}")
        else:
            dashboard[decision_id] = item
    if set(dashboard) != set(decisions):
        errors.append(
            f"{location}: dashboard and decision-sheet inventories do not reconcile exactly"
        )
    dashboard_fields = (
        "title",
        "decision_type",
        "timing",
        "lifecycle_state",
        "blocking",
        "accountable_owner_role",
    )
    for decision_id in sorted(set(dashboard) & set(decisions)):
        for field in dashboard_fields:
            if dashboard[decision_id].get(field) != decisions[decision_id].get(field):
                errors.append(
                    f"{location}: dashboard {decision_id} field {field} is stale or contradictory"
                )

    summary = value.get("executive_summary", {})
    if isinstance(summary, dict):
        expected_counts = {
            state: sum(
                1 for item in decisions.values() if item.get("lifecycle_state") == state
            )
            for state in DECISION_REGISTER_LIFECYCLES
        }
        expected_summary = {
            "total_registered": len(decisions),
            "unresolved": sum(
                1
                for item in decisions.values()
                if item.get("lifecycle_state") in DECISION_UNRESOLVED_LIFECYCLES
            ),
            "blocking": sum(1 for item in decisions.values() if item.get("blocking") is True),
            "evidence_first": sum(
                1 for item in decisions.values() if item.get("timing") == "evidence-first"
            ),
        }
        for field, expected in expected_summary.items():
            if summary.get(field) != expected:
                errors.append(f"{location}: executive summary {field} does not reconcile")
        if summary.get("counts_by_lifecycle") != expected_counts:
            errors.append(f"{location}: lifecycle counts do not reconcile")

    dependencies: dict[str, list[str]] = {}
    for decision_id, decision in decisions.items():
        refs = decision.get("depends_on", [])
        dependencies[decision_id] = [item for item in refs if isinstance(item, str)] if isinstance(refs, list) else []
    errors.extend(
        _decision_graph_errors(
            set(decisions), dependencies, value.get("dependency_order"), location
        )
    )
    for decision_id, decision in decisions.items():
        linked = decision.get("links", {})
        downstream = linked.get("dependent_decision_refs", []) if isinstance(linked, dict) else []
        if not isinstance(downstream, list):
            continue
        for target in downstream:
            if target not in decisions:
                errors.append(f"{location}: {decision_id} names unknown dependent decision {target}")
            elif decision_id not in dependencies.get(target, []):
                errors.append(
                    f"{location}: {decision_id} and dependent {target} are not reciprocal"
                )
    for decision_id, refs in dependencies.items():
        for source in refs:
            if source in decisions:
                linked = decisions[source].get("links", {})
                downstream = linked.get("dependent_decision_refs", []) if isinstance(linked, dict) else []
                if decision_id not in downstream:
                    errors.append(
                        f"{location}: dependency {source} and dependent {decision_id} are not reciprocal"
                    )

    for decision_id, decision in decisions.items():
        item_location = f"{location}:{decision_id}"
        lifecycle = decision.get("lifecycle_state")
        timing = decision.get("timing")
        links = decision.get("links", {})
        if isinstance(links, dict):
            typed_link_prefixes = {
                "requirement_refs": "REQ-",
                "risk_refs": "RISK-",
                "plan_refs": "PLAN-",
                "gate_refs": "GATE-",
            }
            for field, prefix in typed_link_prefixes.items():
                raw_references = links.get(field, [])
                if not isinstance(raw_references, list):
                    raw_references = []
                for reference in raw_references:
                    if not isinstance(reference, str) or not reference.startswith(prefix):
                        errors.append(
                            f"{item_location}: {field} contains a misclassified reference"
                        )
        options = decision.get("options", [])
        option_ids = [
            option.get("id")
            for option in options
            if isinstance(option, dict) and isinstance(option.get("id"), str)
        ] if isinstance(options, list) else []
        if len(option_ids) != len(set(option_ids)):
            errors.append(f"{item_location}: option IDs must be unique")
        recommendation = decision.get("recommendation", {})
        recommended = recommendation.get("option_id") if isinstance(recommendation, dict) else None
        if recommended is not None and recommended not in option_ids:
            errors.append(f"{item_location}: recommendation references an unknown option")
        selection = decision.get("owner_selection", {})
        selection_values = (
            [selection.get(field) for field in ("option_id", "selected_by_role", "selected_on", "selection_rationale")]
            if isinstance(selection, dict)
            else []
        )
        selection_present = bool(selection_values and all(item is not None for item in selection_values))
        selection_partial = bool(selection_values and any(item is not None for item in selection_values) and not selection_present)
        if selection_partial:
            errors.append(f"{item_location}: owner selection is partial")
        selected = selection.get("option_id") if isinstance(selection, dict) else None
        if selected is not None and selected not in option_ids:
            errors.append(f"{item_location}: owner selection references an unknown option")
        if lifecycle in {
            "owner selected — ADR or approval pending",
            "accepted — authority linked",
        } and not selection_present:
            errors.append(f"{item_location}: lifecycle requires a complete owner selection")
        if lifecycle in {"open", "evidence in progress", "deferred"} and selected is not None:
            errors.append(
                f"{item_location}: owner selection must not be represented in lifecycle {lifecycle!r}"
            )

        authority_ref = decision.get("authority_ref")
        if lifecycle == "accepted — authority linked":
            if not _accepted_decision_authority(authority_ref, records):
                errors.append(
                    f"{item_location}: accepted entry requires a resolving accepted DEC-#### authority reference"
                )
            else:
                reverse_refs = records[authority_ref][0].get(
                    "governance_register_refs", []
                )
                if not isinstance(reverse_refs, list):
                    reverse_refs = []
                if decision_id not in reverse_refs:
                    errors.append(
                        f"{item_location}: resolving accepted decision {authority_ref} does not link back to {decision_id}"
                    )
        elif lifecycle == "superseded":
            if authority_ref is not None and not _accepted_decision_authority(
                authority_ref, records, allow_superseded=True
            ):
                errors.append(
                    f"{item_location}: superseded entry authority reference is missing or invalid"
                )
        elif authority_ref is not None:
            errors.append(
                f"{item_location}: non-accepted entry cannot be represented as accepted authority"
            )

        if decision.get("blocking") is True:
            for field in (
                "accepted_constraints",
                "explicit_exclusions",
                "work_blocked",
                "reversal_or_successor_conditions",
            ):
                if not isinstance(decision.get(field), list) or not decision[field]:
                    errors.append(f"{item_location}: blocking decision requires {field}")
        if timing == "evidence-first" or lifecycle == "evidence in progress":
            plan = decision.get("evidence_plan", {})
            if not isinstance(plan, dict):
                errors.append(f"{item_location}: evidence-first decision lacks an evidence plan")
            else:
                for field in (
                    "evidence_owner_role",
                    "evidence_producing_step",
                    "stop_condition",
                ):
                    if not isinstance(plan.get(field), str) or not plan[field].strip():
                        errors.append(f"{item_location}: evidence-first decision requires {field}")
                if not isinstance(plan.get("expected_evidence"), list) or not plan["expected_evidence"]:
                    errors.append(
                        f"{item_location}: evidence-first decision requires expected_evidence"
                    )

    settled = value.get("already_settled", [])
    if isinstance(settled, list):
        settled_refs: set[str] = set()
        for index, item in enumerate(settled):
            reference = item.get("authority_ref") if isinstance(item, dict) else None
            if isinstance(reference, str) and reference in settled_refs:
                errors.append(f"{location}:already_settled[{index}]: duplicate authority reference")
            if isinstance(reference, str):
                settled_refs.add(reference)
            if not _accepted_decision_authority(reference, records):
                errors.append(
                    f"{location}:already_settled[{index}]: reference is missing or no longer accepted"
                )
            constrained = (
                item.get("constrains_decision_refs", [])
                if isinstance(item, dict)
                else []
            )
            if not isinstance(constrained, list):
                constrained = []
            for decision_ref in constrained:
                if decision_ref not in decisions:
                    errors.append(
                        f"{location}:already_settled[{index}]: unknown constrained decision {decision_ref}"
                    )

    reviews: dict[str, dict[str, Any]] = {}
    for index, review in enumerate(reviews_raw):
        review_location = f"{location}:trade_off_reviews[{index}]"
        if not isinstance(review, dict):
            continue
        decision_id = review.get("decision_id")
        if not isinstance(decision_id, str):
            continue
        if decision_id in reviews:
            errors.append(f"{review_location}: duplicate decision review {decision_id}")
        else:
            reviews[decision_id] = review
    if set(reviews) != set(decisions):
        errors.append(f"{location}: every registered decision must be reviewed exactly once")

    if isinstance(settled, list):
        for index, item in enumerate(settled):
            if not isinstance(item, dict):
                continue
            reference = item.get("authority_ref")
            constrained = item.get("constrains_decision_refs", [])
            if not isinstance(constrained, list):
                continue
            for decision_ref in constrained:
                review = reviews.get(decision_ref, {})
                inspected = review.get(
                    "accepted_authority_constraints_inspected", []
                )
                if not isinstance(inspected, list) or reference not in inspected:
                    errors.append(
                        f"{location}:already_settled[{index}]: {decision_ref} review did not inspect constraining authority {reference}"
                    )

    for decision_id in sorted(set(reviews) & set(decisions)):
        review = reviews[decision_id]
        decision = decisions[decision_id]
        review_location = f"{location}:review:{decision_id}"
        if review.get("reviewed_lifecycle_state") != decision.get("lifecycle_state"):
            errors.append(f"{review_location}: reviewed lifecycle state is stale")
        inspected = review.get("accepted_authority_constraints_inspected", [])
        if isinstance(inspected, list):
            for reference in inspected:
                if isinstance(reference, str) and reference.startswith("DEC-") and not _accepted_decision_authority(reference, records):
                    errors.append(
                        f"{review_location}: accepted authority constraint {reference} is missing or no longer accepted"
                    )
        option_reviews_raw = review.get("option_reviews", [])
        option_reviews: dict[str, dict[str, Any]] = {}
        if isinstance(option_reviews_raw, list):
            for item in option_reviews_raw:
                if not isinstance(item, dict) or not isinstance(item.get("option_id"), str):
                    continue
                option_id = item["option_id"]
                if option_id in option_reviews:
                    errors.append(f"{review_location}: duplicate option review {option_id}")
                else:
                    option_reviews[option_id] = item
        review_options = decision.get("options", [])
        if not isinstance(review_options, list):
            review_options = []
        option_ids = {
            option.get("id")
            for option in review_options
            if isinstance(option, dict) and isinstance(option.get("id"), str)
        }
        if set(option_reviews) != option_ids:
            errors.append(f"{review_location}: option reviews do not reconcile exactly")

        for option_id, option_review in option_reviews.items():
            option_location = f"{review_location}:{option_id}"
            gates_raw = option_review.get("gate_results", [])
            gates: dict[str, dict[str, Any]] = {}
            if isinstance(gates_raw, list):
                for gate in gates_raw:
                    if not isinstance(gate, dict) or not isinstance(gate.get("gate"), str):
                        continue
                    gate_name = gate["gate"]
                    if gate_name in gates:
                        errors.append(f"{option_location}: duplicate non-negotiable gate {gate_name}")
                    else:
                        gates[gate_name] = gate
            if set(gates) != set(DECISION_NONNEGOTIABLE_GATES):
                errors.append(f"{option_location}: non-negotiable gates must reconcile exactly")
            has_failure = any(gate.get("result") == "fail" for gate in gates.values())
            has_material_unknown = any(
                gate.get("result") == "unknown" and gate.get("material") is True
                for gate in gates.values()
            )
            expected_eligibility = (
                "disqualified"
                if has_failure
                else "evidence-first"
                if has_material_unknown
                else "eligible"
            )
            if option_review.get("eligibility") != expected_eligibility:
                errors.append(
                    f"{option_location}: eligibility hides a gate failure or material unknown"
                )

            attributes_raw = option_review.get("balanced_attributes", [])
            attributes: dict[str, dict[str, Any]] = {}
            if isinstance(attributes_raw, list):
                for attribute in attributes_raw:
                    if not isinstance(attribute, dict) or not isinstance(attribute.get("attribute"), str):
                        continue
                    attribute_name = attribute["attribute"]
                    if attribute_name in attributes:
                        errors.append(f"{option_location}: balanced attribute counted twice: {attribute_name}")
                    else:
                        attributes[attribute_name] = attribute
            if expected_eligibility == "eligible":
                if set(attributes) != set(DECISION_BALANCED_ATTRIBUTES):
                    errors.append(f"{option_location}: eligible option requires every balanced attribute exactly once")
                if any(item.get("score") == "X" for item in attributes.values()):
                    errors.append(
                        f"{option_location}: gate-eligible option cannot carry an X gate-failure sentinel"
                    )
            elif attributes:
                permitted_sentinels = (
                    {"X", "N/A"}
                    if expected_eligibility == "disqualified"
                    else {"?", "N/A"}
                )
                if any(
                    not isinstance(item.get("score"), str)
                    or item.get("score") not in permitted_sentinels
                    for item in attributes.values()
                ):
                    errors.append(
                        f"{option_location}: gate-ineligible option may record only visible X, ?, or N/A sentinels, not numeric balanced scoring"
                    )
            total = option_review.get("weighted_total")
            scores = [item.get("score") for item in attributes.values()]
            if expected_eligibility != "eligible" and total is not None:
                errors.append(f"{option_location}: total conceals a gate failure or evidence gap")
            if any(
                isinstance(score, str) and score in {"X", "?"}
                for score in scores
            ) and total is not None:
                errors.append(f"{option_location}: total conceals X or ? scores")
            numeric_total = 0.0
            total_is_calculable = bool(attributes)
            for item in attributes.values():
                score = item.get("score")
                weight = item.get("weight")
                if score == "N/A":
                    continue
                if (
                    not isinstance(score, (int, float))
                    or isinstance(score, bool)
                    or not isinstance(weight, (int, float))
                    or isinstance(weight, bool)
                ):
                    total_is_calculable = False
                    continue
                numeric_total += float(score) * float(weight)
            if (
                isinstance(total, (int, float))
                and not isinstance(total, bool)
                and total_is_calculable
                and abs(float(total) - numeric_total) > 1e-9
            ):
                errors.append(f"{option_location}: weighted total does not match visible scores")

        option_eligibilities = {
            item.get("eligibility")
            for item in option_reviews.values()
            if isinstance(item, dict)
        }
        if (
            decision.get("lifecycle_state")
            in {
                "open",
                "evidence in progress",
                "owner selected — ADR or approval pending",
            }
            and "eligible" not in option_eligibilities
            and "evidence-first" in option_eligibilities
            and decision.get("timing") != "evidence-first"
        ):
            errors.append(
                f"{review_location}: material unknowns leave no eligible option; the unresolved decision must remain evidence-first"
            )

        if review.get("weighting_mode") == "default":
            for option_review in option_reviews.values():
                raw_attributes = option_review.get("balanced_attributes", [])
                if not isinstance(raw_attributes, list):
                    raw_attributes = []
                for item in raw_attributes:
                    if isinstance(item, dict) and item.get("weight") != 1:
                        errors.append(f"{review_location}: default weighting requires weight 1 for every attribute")
                        break
        elif review.get("weighting_mode") == "non-default":
            weights = [
                item.get("weight")
                for option_review in option_reviews.values()
                for item in (
                    option_review.get("balanced_attributes", [])
                    if isinstance(option_review.get("balanced_attributes", []), list)
                    else []
                )
                if isinstance(item, dict)
            ]
            if weights and all(weight == 1 for weight in weights):
                errors.append(
                    f"{review_location}: non-default weighting must expose at least one non-default weight"
                )
        permitted = review.get("best_option_permitted_by_current_authority")
        evidenced = review.get("best_option_supported_by_current_evidence")
        for label, option_id in (("best permitted", permitted), ("best evidenced", evidenced)):
            if option_id is not None and option_reviews.get(option_id, {}).get("eligibility") != "eligible":
                errors.append(f"{review_location}: {label} option is not gate-eligible")
        recommended = decision.get("recommendation", {}).get("option_id") if isinstance(decision.get("recommendation"), dict) else None
        if recommended is not None and option_reviews.get(recommended, {}).get("eligibility") == "disqualified":
            errors.append(f"{review_location}: recommendation selects a gate-disqualified option")
        selected = decision.get("owner_selection", {}).get("option_id") if isinstance(decision.get("owner_selection"), dict) else None
        if (
            selected is not None
            and decision.get("lifecycle_state") == "owner selected — ADR or approval pending"
            and option_reviews.get(selected, {}).get("eligibility") == "disqualified"
            and review.get("disposition") != "challenge owner selection"
        ):
            errors.append(f"{review_location}: gate-disqualified owner selection must be challenged")
        compatibility = review.get("compatibility")
        issues = review.get("compatibility_issues", [])
        if compatibility == "compatible" and issues:
            errors.append(f"{review_location}: compatible review must not hide compatibility issues")
        if compatibility in {"tension", "conflict", "unknown"} and not issues:
            errors.append(f"{review_location}: {compatibility} requires a complete compatibility issue")

    closure = value.get("minimum_closure_set", {})
    closure_items_raw = closure.get("items", []) if isinstance(closure, dict) else []
    closure_items: dict[str, dict[str, Any]] = {}
    if isinstance(closure_items_raw, list):
        for index, item in enumerate(closure_items_raw):
            if not isinstance(item, dict) or not isinstance(item.get("id"), str):
                continue
            closure_id = item["id"]
            if closure_id in closure_items:
                errors.append(f"{location}:minimum_closure_set: duplicate closure ID {closure_id}")
            else:
                closure_items[closure_id] = item
            item_decision_refs = item.get("decision_refs", [])
            if not isinstance(item_decision_refs, list):
                item_decision_refs = []
            for decision_ref in item_decision_refs:
                if decision_ref not in decisions:
                    errors.append(
                        f"{location}:minimum_closure_set:{closure_id}: unknown decision {decision_ref}"
                    )
            if item.get("status") == "complete":
                evidence_refs = item.get("completion_evidence_refs", [])
                if not isinstance(evidence_refs, list) or not evidence_refs:
                    errors.append(
                        f"{location}:minimum_closure_set:{closure_id}: complete item requires resolvable completion evidence references"
                    )
                    evidence_refs = []
                kind = item.get("kind")
                if kind == "ADR or approval" and not any(
                    (
                        isinstance(reference, str)
                        and reference.startswith(("authority:", "external:"))
                    )
                    or _accepted_decision_authority(reference, records)
                    for reference in evidence_refs
                ):
                    errors.append(
                        f"{location}:minimum_closure_set:{closure_id}: completed ADR or approval lacks accepted authority"
                    )
                if kind == "owner decision":
                    for decision_ref in item_decision_refs:
                        decision = decisions.get(decision_ref, {})
                        selection = decision.get("owner_selection", {})
                        if not isinstance(selection, dict) or any(
                            selection.get(field) is None
                            for field in (
                                "option_id",
                                "selected_by_role",
                                "selected_on",
                                "selection_rationale",
                            )
                        ):
                            errors.append(
                                f"{location}:minimum_closure_set:{closure_id}: completed owner decision lacks a recorded owner selection for {decision_ref}"
                            )
                if kind in {"evidence-first spike", "gate evidence"} and not any(
                    isinstance(reference, str)
                    and reference.startswith("EVD-")
                    and reference in records
                    and records[reference][0].get("result") == "pass"
                    for reference in evidence_refs
                ):
                    errors.append(
                        f"{location}:minimum_closure_set:{closure_id}: completed {kind} requires resolving pass evidence"
                    )
                if kind == "specialist review" and not any(
                    (
                        isinstance(reference, str)
                        and reference.startswith(("authority:", "external:"))
                    )
                    or (
                        isinstance(reference, str)
                        and reference.startswith("EVD-")
                        and reference in records
                        and records[reference][0].get("result") == "pass"
                    )
                    for reference in evidence_refs
                ):
                    errors.append(
                        f"{location}:minimum_closure_set:{closure_id}: completed specialist review lacks approval or pass evidence"
                    )
    closure_dependencies: dict[str, list[str]] = {}
    for closure_id, record in closure_items.items():
        raw_dependencies = record.get("depends_on", [])
        if not isinstance(raw_dependencies, list):
            raw_dependencies = []
        closure_dependencies[closure_id] = [
            item for item in raw_dependencies if isinstance(item, str)
        ]
    errors.extend(
        _decision_graph_errors(
            set(closure_items),
            closure_dependencies,
            closure.get("dependency_order") if isinstance(closure, dict) else None,
            f"{location}:minimum_closure_set",
        )
    )
    if isinstance(closure, dict):
        seen_parallel: set[str] = set()
        raw_parallel_groups = closure.get("parallel_groups", [])
        if not isinstance(raw_parallel_groups, list):
            raw_parallel_groups = []
        for group in raw_parallel_groups:
            if not isinstance(group, list):
                continue
            for closure_id in group:
                if closure_id not in closure_items:
                    errors.append(
                        f"{location}:minimum_closure_set: parallel group references unknown {closure_id}"
                    )
                if closure_id in seen_parallel:
                    errors.append(
                        f"{location}:minimum_closure_set: {closure_id} appears in more than one parallel group"
                    )
                seen_parallel.add(closure_id)
            group_ids = [item for item in group if isinstance(item, str)]

            def reaches(source: str, target: str, visited: set[str]) -> bool:
                if source in visited:
                    return False
                visited.add(source)
                for dependency in closure_dependencies.get(source, []):
                    if dependency == target or reaches(dependency, target, visited):
                        return True
                return False

            for index, left in enumerate(group_ids):
                for right in group_ids[index + 1 :]:
                    if reaches(left, right, set()) or reaches(right, left, set()):
                        errors.append(
                            f"{location}:minimum_closure_set: parallel group contains dependency-related items {left} and {right}"
                        )

    errors.extend(
        _governance_reference_errors(value, records, decisions, closure_items)
    )
    errors.extend(_handoff_claim_errors(root, records, decisions))
    return list(dict.fromkeys(errors))


def check_maturity_assessments(
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    errors: list[str] = []
    for record_id, (record, location) in records.items():
        if not record_id.startswith(("REQ-", "GATE-")):
            continue
        assessment = record.get("maturity_assessment")
        if assessment is None:
            continue
        if not isinstance(assessment, dict):
            errors.append(f"{location}: maturity assessment must be an object")
            continue
        level = assessment.get("level")
        basis_kind = assessment.get("basis_kind")
        raw_evidence_refs = assessment.get("evidence_refs", [])
        evidence_refs = (
            raw_evidence_refs if isinstance(raw_evidence_refs, list) else []
        )
        if level is None:
            if (
                basis_kind is not None
                or
                assessment.get("assessed_on") is not None
                or assessment.get("assessor_role") is not None
                or evidence_refs
            ):
                errors.append(
                    f"{location}: unassessed maturity cannot carry a basis, assessor, or evidence claim"
                )
            continue
        expected_basis = {
            "1. Architecturally specified": "architecture specification",
            "2. Evidence planned": "evidence plan",
            "3. Structurally validated": "structural validation",
            "4. Demonstrated by executable implementation": "executable implementation",
            "5. Specialist-approved": "specialist approval",
            "6. Release-ready": "release gate",
            "7. Production-proven": "production observation",
        }.get(level)
        if basis_kind != expected_basis:
            errors.append(
                f"{location}: maturity level requires basis kind {expected_basis!r}"
            )
        if not isinstance(assessment.get("assessed_on"), str) or not isinstance(
            assessment.get("assessor_role"), str
        ):
            errors.append(f"{location}: assessed maturity requires date and assessor role")
        if not isinstance(raw_evidence_refs, list) or not evidence_refs:
            errors.append(f"{location}: assessed maturity requires explicit evidence references")
        if isinstance(level, str) and level.startswith(("3.", "4.", "5.", "6.", "7.")):
            if not any(
                isinstance(reference, str)
                and reference.startswith("EVD-")
                and reference in records
                and records[reference][0].get("result") == "pass"
                for reference in evidence_refs
            ):
                errors.append(
                    f"{location}: structural or higher maturity requires resolving pass EVD evidence"
                )
    return errors


def iter_references(value: Any, key: str | None = None):
    if isinstance(value, dict):
        for child_key, child in value.items():
            yield from iter_references(child, child_key)
    elif isinstance(value, list):
        if key in REFERENCE_KEYS:
            for child in value:
                if isinstance(child, str):
                    yield key, child
        else:
            for child in value:
                yield from iter_references(child, key)
    elif isinstance(value, str) and key in REFERENCE_KEYS:
        yield key, value


def task_authority_is_valid(
    record: dict[str, Any],
    records: dict[str, tuple[dict[str, Any], str]],
) -> bool:
    authority_basis = record.get("authority_basis")
    if isinstance(authority_basis, str) and authority_basis.startswith(
        ("authority:", "external:")
    ):
        return True
    return bool(
        isinstance(authority_basis, str)
        and re.fullmatch(r"DEC-[0-9]{4}", authority_basis)
        and authority_basis in records
        and records[authority_basis][0].get("status") == "accepted"
    )


def blocking_reference_is_resolved(
    reference: str,
    records: dict[str, tuple[dict[str, Any], str]],
) -> bool:
    entry = records.get(reference)
    if entry is None:
        return False
    status = entry[0].get("status")
    if reference.startswith(("TASK-", "PLAN-")):
        return status == "completed"
    if reference.startswith("GATE-"):
        return status in SATISFIED_GATE_STATUSES
    if reference.startswith("DEC-"):
        return status == "accepted"
    if reference.startswith(("RISK-", "ASM-", "ISSUE-", "DEP-", "OQ-")):
        return status in SATISFIED_RAIDQ_STATUSES
    return False


def unresolved_structured_blockers(
    record: dict[str, Any],
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    values = record.get("blocking_refs", [])
    if not isinstance(values, list):
        return ["blocking_refs_invalid"]
    return [
        reference
        for reference in values
        if isinstance(reference, str)
        and not blocking_reference_is_resolved(reference, records)
    ]


def unsatisfied_gate_refs(
    record: dict[str, Any],
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    values = record.get("gate_refs", [])
    if not isinstance(values, list):
        return ["gate_refs_invalid"]
    return [
        reference
        for reference in values
        if isinstance(reference, str)
        and (
            reference not in records
            or records[reference][0].get("status") not in SATISFIED_GATE_STATUSES
        )
    ]


def unsatisfied_hard_dependencies(
    record: dict[str, Any],
    records: dict[str, tuple[dict[str, Any], str]],
    field: str,
) -> list[str]:
    values = record.get(field, [])
    if not isinstance(values, list):
        return [f"{field}_invalid"]
    return [
        reference
        for reference in values
        if isinstance(reference, str)
        and (
            reference not in records
            or records[reference][0].get("status") != "completed"
        )
    ]


def plan_prerequisite_blockers(
    record: dict[str, Any],
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    blockers = [
        f"dependency:{reference}"
        for reference in unsatisfied_hard_dependencies(record, records, "depends_on")
    ]
    blockers.extend(
        f"gate:{reference}" for reference in unsatisfied_gate_refs(record, records)
    )
    blockers.extend(
        f"blocker:{reference}"
        for reference in unresolved_structured_blockers(record, records)
    )
    return blockers


def task_prerequisite_blockers(
    record: dict[str, Any],
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    blockers = [
        f"dependency:{reference}"
        for reference in unsatisfied_hard_dependencies(record, records, "dependencies")
    ]
    blockers.extend(
        f"gate:{reference}" for reference in unsatisfied_gate_refs(record, records)
    )
    blockers.extend(
        f"blocker:{reference}"
        for reference in unresolved_structured_blockers(record, records)
    )
    plan_refs = record.get("plan_item_refs", [])
    if not isinstance(plan_refs, list):
        return blockers + ["plan_item_refs_invalid"]
    for reference in plan_refs:
        if not isinstance(reference, str) or reference not in records:
            blockers.append(f"plan:{reference}")
            continue
        plan = records[reference][0]
        task_status = record.get("status")
        if task_status == "completed":
            allowed_statuses = {"in_progress", "completed"}
        elif task_status in {"in_progress", "validating", "review"}:
            allowed_statuses = {"in_progress"}
        else:
            allowed_statuses = {"planned", "in_progress"}
        if plan.get("status") not in allowed_statuses:
            blockers.append(f"plan_status:{reference}")
        blockers.extend(
            f"plan:{reference}:{item}"
            for item in plan_prerequisite_blockers(plan, records)
        )
    return blockers


def check_references_and_lifecycle(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    errors: list[str] = []
    lifecycle = load_json(root / ".agent" / "lifecycle.json")
    for record_id, (record, location) in records.items():
        for key, reference in iter_references(record):
            if reference.startswith(EXTERNAL_REFERENCE_PREFIXES):
                continue
            if not ID4.fullmatch(reference):
                errors.append(f"{location}: {key} contains invalid reference")
            elif reference not in records:
                errors.append(f"{location}: unresolved reference {reference}")

        kind = (
            "task"
            if record_id.startswith("TASK-")
            else "decision"
            if record_id.startswith("DEC-")
            else "artifact"
            if record_id.startswith("ART-")
            else None
        )
        if kind is None:
            continue
        expected_version = EXPECTED_RECORD_VERSIONS[kind]
        if record.get("schema_version") != expected_version:
            errors.append(f"{location}: schema version/kind mismatch")
        status = record.get("status")
        previous = record.get("previous_status")
        graph = lifecycle.get(kind, {}).get("transitions", {})
        initial = lifecycle.get(kind, {}).get("initial")
        if status not in graph:
            errors.append(f"{location}: unknown {kind} status")
        elif previous is None:
            if status != initial:
                errors.append(
                    f"{location}: noninitial status requires previous_status"
                )
        elif previous not in graph or status not in graph.get(previous, []):
            errors.append(
                f"{location}: illegal {kind} transition {previous!r} -> {status!r}"
            )
        if kind == "task":
            ready_or_later = {
                "ready",
                "in_progress",
                "validating",
                "review",
                "completed",
                "reopened",
            }
            if status in ready_or_later:
                for field in (
                    "scope",
                    "authority_basis",
                    "acceptance_criteria",
                    "validation_plan",
                ):
                    if not record.get(field):
                        errors.append(f"{location}: {status} task lacks {field}")
                if not task_authority_is_valid(record, records):
                    errors.append(
                        f"{location}: {status} task requires an external authority "
                        "reference or accepted decision basis"
                    )
            if status in DEPENDENCY_GATED_TASK_STATUSES:
                blockers = task_prerequisite_blockers(record, records)
                if blockers:
                    errors.append(
                        f"{location}: {status} task has unsatisfied readiness "
                        "conditions: " + ", ".join(blockers)
                    )
            if status in {
                "in_progress",
                "validating",
                "review",
                "completed",
                "blocked",
                "reopened",
            } and record.get("owner") in {None, "", "unassigned"}:
                errors.append(f"{location}: {status} task requires an assigned owner")
            if status in {"validating", "review", "completed"} and not record.get(
                "implementation_result"
            ):
                errors.append(
                    f"{location}: {status} task lacks implementation_result"
                )
            if status == "review" and not (
                record.get("review_evidence") or record.get("limitations")
            ):
                errors.append(
                    f"{location}: review task requires evidence or an explicit limitation"
                )
            if status == "completed":
                if record.get("acceptance_criteria_met") is not True:
                    errors.append(
                        f"{location}: completed task lacks satisfied acceptance criteria"
                    )
                if not record.get("closure_evidence"):
                    errors.append(f"{location}: completed task lacks closure evidence")
                resolved_closure_evidence = 0
                for evidence_ref in record.get("closure_evidence", []):
                    if not str(evidence_ref).startswith("EVD-"):
                        continue
                    resolved_closure_evidence += 1
                    evidence_entry = records.get(evidence_ref)
                    if evidence_entry is None:
                        errors.append(
                            f"{location}: completed task closure evidence "
                            f"{evidence_ref} is unresolved"
                        )
                        continue
                    evidence = evidence_entry[0]
                    subject = evidence.get(
                        "subject_revision_or_fingerprint",
                        evidence.get("subject_version"),
                    )
                    if (
                        not isinstance(subject, str)
                        or not subject.strip()
                        or subject in {"not_recorded", "not_assessed"}
                        or subject.startswith("replace_")
                    ):
                        errors.append(
                            f"{location}: completed task closure evidence "
                            f"{evidence_ref} has an unbound subject"
                        )
                    task_refs = evidence.get("task_refs", [])
                    explicitly_binds_task = (
                        evidence.get("task") == record_id
                        or (
                            isinstance(task_refs, list)
                            and record_id in task_refs
                        )
                    )
                    if not explicitly_binds_task:
                        errors.append(
                            f"{location}: completed task closure evidence "
                            f"{evidence_ref} does not bind the task"
                        )
                    if evidence.get("result") != "pass":
                        errors.append(
                            f"{location}: completed task closure evidence "
                            f"{evidence_ref} does not have a pass result"
                        )
                    deadline = freshness_deadline(evidence.get("fresh_until"))
                    if deadline is None:
                        errors.append(
                            f"{location}: completed task closure evidence "
                            f"{evidence_ref} lacks an explicit freshness deadline"
                        )
                    elif deadline < datetime.now().astimezone():
                        errors.append(
                            f"{location}: completed task closure evidence "
                            f"{evidence_ref} is expired"
                        )
                if record.get("closure_evidence") and not resolved_closure_evidence:
                    errors.append(
                        f"{location}: completed task requires at least one EVD "
                        "closure record"
                    )
                if record.get("external_effects") in {None, "not_assessed"}:
                    errors.append(
                        f"{location}: completed task external effects unassessed"
                    )
                if "limitations" not in record:
                    errors.append(f"{location}: completed task lacks limitations field")
            if status == "blocked":
                if not record.get("blocked_by"):
                    errors.append(f"{location}: blocked task lacks blocking condition")
                if not task_prerequisite_blockers(record, records):
                    errors.append(
                        f"{location}: blocked task lacks an unresolved structured cause"
                    )
            if status == "reopened" and not record.get("reopened_by"):
                errors.append(f"{location}: reopened task lacks invalidating evidence")
        if kind == "decision":
            if status in {"accepted", "superseded"} and not str(
                record.get("authority_source", "")
            ).startswith(("authority:", "external:")):
                errors.append(
                    f"{location}: {status} decision requires an explicit external "
                    "authority source"
                )
            if status == "superseded" and not record.get("successor"):
                errors.append(f"{location}: superseded decision requires successor")
        if kind == "artifact":
            if status in {"approved", "final"} and record.get(
                "required_approver"
            ) in {None, "", "not_assessed"}:
                errors.append(
                    f"{location}: {status} artifact lacks required approver"
                )
            if status in {"reviewed", "approved", "final"} and not record.get(
                "review"
            ):
                errors.append(f"{location}: {status} artifact lacks review evidence")
            if status == "final":
                validation_refs = record.get("validation", [])
                if not validation_refs:
                    errors.append(f"{location}: final artifact lacks validation evidence")
                fingerprint = record.get("content_fingerprint")
                if fingerprint in {
                    None,
                    "",
                    "not_recorded",
                }:
                    errors.append(f"{location}: final artifact lacks content fingerprint")
                valid_bound_evidence = 0
                for evidence_ref in (
                    validation_refs if isinstance(validation_refs, list) else []
                ):
                    if not isinstance(evidence_ref, str) or not evidence_ref.startswith(
                        "EVD-"
                    ):
                        continue
                    evidence_entry = records.get(evidence_ref)
                    if evidence_entry is None:
                        continue
                    evidence = evidence_entry[0]
                    subject = evidence.get(
                        "subject_revision_or_fingerprint",
                        evidence.get("subject_version"),
                    )
                    deadline = freshness_deadline(evidence.get("fresh_until"))
                    if (
                        evidence.get("result") == "pass"
                        and isinstance(fingerprint, str)
                        and subject == fingerprint
                        and deadline is not None
                        and deadline >= datetime.now().astimezone()
                    ):
                        valid_bound_evidence += 1
                if validation_refs and not valid_bound_evidence:
                    errors.append(
                        f"{location}: final artifact requires fresh passing EVD "
                        "validation bound to its content fingerprint"
                    )

    for record_id, (record, location) in records.items():
        if not record_id.startswith(("DEC-", "ART-")):
            continue
        successor = record.get("successor")
        supersedes = record.get("supersedes")
        if successor in records and records[successor][0].get("supersedes") != record_id:
            errors.append(f"{location}: successor {successor} lacks reciprocal supersedes")
        if supersedes in records and records[supersedes][0].get("successor") != record_id:
            errors.append(f"{location}: superseded record {supersedes} lacks reciprocal successor")
        if successor == record_id or supersedes == record_id:
            errors.append(f"{location}: record cannot supersede itself")
    return errors


def check_plan_and_traceability(
    records: dict[str, tuple[dict[str, Any], str]]
) -> list[str]:
    errors: list[str] = []
    plans = {
        record_id: record
        for record_id, (record, _) in records.items()
        if record_id.startswith("PLAN-")
    }
    tasks = {
        record_id: record
        for record_id, (record, _) in records.items()
        if record_id.startswith("TASK-")
    }

    def check_cycles(
        nodes: dict[str, dict[str, Any]], field: str, label: str
    ) -> None:
        visiting: set[str] = set()
        visited: set[str] = set()
        stack: list[str] = []
        emitted: set[tuple[str, ...]] = set()

        def visit(node: str) -> None:
            if node in visiting:
                start = stack.index(node)
                cycle = tuple(stack[start:] + [node])
                if cycle not in emitted:
                    errors.append(
                        f"{label} dependency cycle: " + " -> ".join(cycle)
                    )
                    emitted.add(cycle)
                return
            if node in visited:
                return
            visiting.add(node)
            stack.append(node)
            dependencies = nodes[node].get(field, [])
            if isinstance(dependencies, list):
                for dependency in dependencies:
                    if dependency in nodes:
                        visit(dependency)
            stack.pop()
            visiting.remove(node)
            visited.add(node)

        for node in sorted(nodes):
            visit(node)

    check_cycles(plans, "depends_on", "plan")
    check_cycles(tasks, "dependencies", "task")

    linked_requirements: set[str] = set()
    for record_id, (record, location) in records.items():
        for key in ("requirement_refs",):
            values = record.get(key, [])
            if isinstance(values, list):
                linked_requirements.update(
                    item for item in values if isinstance(item, str)
                )
        if record_id.startswith("FIND-") and record.get("status") not in {
            "not_assessed",
            "not_applicable",
        } and not record.get("inspected_evidence"):
            errors.append(f"{location}: assessed finding lacks inspected evidence")

    for plan_id, plan in plans.items():
        location = records[plan_id][1]
        status = plan.get("status")
        prerequisite_blockers = plan_prerequisite_blockers(plan, records)
        if status in {"in_progress", "completed"} and prerequisite_blockers:
            errors.append(
                f"{location}: {status} plan item has unsatisfied readiness "
                "conditions: " + ", ".join(prerequisite_blockers)
            )
        if status in {"in_progress", "completed"}:
            for field in ("acceptance_criteria", "evidence_expected"):
                if not plan.get(field):
                    errors.append(f"{location}: {status} plan item lacks {field}")
            if plan.get("owner_role") in {None, "", "unassigned"}:
                errors.append(f"{location}: {status} plan item requires an owner")
        if status == "blocked":
            if not plan.get("blocked_by"):
                errors.append(f"{location}: blocked plan item lacks explanation")
            if not prerequisite_blockers:
                errors.append(
                    f"{location}: blocked plan item lacks an unresolved structured cause"
                )

        task_refs = plan.get("task_refs", [])
        if not isinstance(task_refs, list):
            task_refs = []
        for task_ref in task_refs:
            task = tasks.get(task_ref)
            if task is not None and plan_id not in task.get("plan_item_refs", []):
                errors.append(
                    f"{location}: task link {task_ref} lacks reciprocal plan_item_refs"
                )
        if status in {"in_progress", "completed"} and not task_refs:
            errors.append(f"{location}: {status} plan item lacks task_refs")
        if status == "in_progress" and task_refs:
            progressed = {
                "in_progress",
                "validating",
                "review",
                "blocked",
                "completed",
                "reopened",
            }
            if not any(
                task_ref in tasks and tasks[task_ref].get("status") in progressed
                for task_ref in task_refs
            ):
                errors.append(
                    f"{location}: in_progress plan item has no progressed task"
                )
        if status == "completed":
            evidence = plan.get("evidence_refs")
            if not isinstance(evidence, list) or not evidence:
                errors.append(f"{location}: completed plan item lacks evidence_refs")
            incomplete_tasks = [
                task_ref
                for task_ref in task_refs
                if task_ref not in tasks
                or tasks[task_ref].get("status") != "completed"
            ]
            if incomplete_tasks:
                errors.append(
                    f"{location}: completed plan item has incomplete tasks: "
                    + ", ".join(incomplete_tasks)
                )

    for task_id, task in tasks.items():
        location = records[task_id][1]
        plan_refs = task.get("plan_item_refs", [])
        if not isinstance(plan_refs, list):
            continue
        for plan_ref in plan_refs:
            plan = plans.get(plan_ref)
            if plan is not None and task_id not in plan.get("task_refs", []):
                errors.append(
                    f"{location}: plan link {plan_ref} lacks reciprocal task_refs"
                )

    for record_id, (record, location) in records.items():
        if record_id.startswith("REQ-") and record.get("status") == "active":
            for field in ("owner_role", "basis", "validation"):
                if not record.get(field):
                    errors.append(f"{location}: active requirement lacks {field}")
            if record_id not in linked_requirements:
                errors.append(
                    f"{location}: active requirement has no finding, plan, or evidence link"
                )
    return errors


def ready_frontier(
    records: dict[str, tuple[dict[str, Any], str]],
) -> dict[str, Any]:
    plans = {
        record_id: record
        for record_id, (record, _) in records.items()
        if record_id.startswith("PLAN-")
    }
    tasks = {
        record_id: record
        for record_id, (record, _) in records.items()
        if record_id.startswith("TASK-")
    }
    ready_plans = []
    for plan_id, plan in sorted(plans.items()):
        if plan.get("status") != "planned":
            continue
        if plan_prerequisite_blockers(plan, records):
            continue
        if not plan.get("acceptance_criteria") or not plan.get("evidence_expected"):
            continue
        if plan.get("owner_role") in {None, "", "unassigned"}:
            continue
        ready_plans.append(plan_id)

    ready_tasks = []
    for task_id, task in sorted(tasks.items()):
        if task.get("status") not in {"proposed", "ready"}:
            continue
        if task_prerequisite_blockers(task, records):
            continue
        if any(
            not task.get(field)
            for field in (
                "scope",
                "authority_basis",
                "acceptance_criteria",
                "validation_plan",
            )
        ):
            continue
        if not task_authority_is_valid(task, records):
            continue
        ready_tasks.append(task_id)

    return {
        "schema_version": "harness.ready-frontier.v1",
        "permission_grant": False,
        "priority_ordered": False,
        "plan_items": ready_plans,
        "tasks": ready_tasks,
        "display_order": "stable identifier order only; never priority",
        "selection_rule": (
            "Hard dependencies, gates, blockers, and reciprocal plan/task links "
            "determine eligibility. Current operator direction or an accepted "
            "priority/value/risk decision selects among independent ready items."
        ),
        "timeline_fields_determine_readiness": False,
        "limitations": [
            "Eligibility does not grant authority to execute work.",
            "Array order is deterministic display order, not priority.",
            "External deadlines remain constraints but do not satisfy prerequisites.",
        ],
    }


def check_current_state(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    path = root / ".agent/state/current.json"
    errors: list[str] = []
    try:
        current = load_json(path)
        schema = load_schema(root, "harness-current-state.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/state/current.json: {error}"]
    errors.extend(
        f".agent/state/current.json: {item}"
        for item in validate_schema(current, schema)
    )
    if not isinstance(current, dict):
        return errors + [".agent/state/current.json: expected object"]
    focus_path = root / ".agent/state/focus.json"
    try:
        focus = load_json(focus_path)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return errors + [f".agent/state/focus.json: {error}"]
    if not isinstance(focus, dict):
        return errors + [".agent/state/focus.json: expected object"]
    if current.get("next_action") != focus.get("next_action"):
        errors.append(
            ".agent/state/current.json: next_action differs from authoritative focus source"
        )
    try:
        project = load_json(root / ".agent/project.json")
        project_slug = (
            project.get("project", {}).get("id")
            if isinstance(project, dict)
            else None
        )
        if current.get("project_slug") != project_slug:
            errors.append(".agent/state/current.json: project slug mismatch")
    except (OSError, ValueError, json.JSONDecodeError):
        pass

    active_statuses = {
        "ready",
        "in_progress",
        "validating",
        "review",
        "blocked",
        "reopened",
    }
    for field, prefix, statuses in (
        ("active_tasks", "TASK-", active_statuses),
        ("accepted_decisions", "DEC-", {"accepted"}),
    ):
        values = current.get(field, [])
        if not isinstance(values, list):
            continue
        for reference in values:
            record = records.get(reference)
            if record is None:
                errors.append(
                    f".agent/state/current.json: unresolved reference {reference}"
                )
            elif not str(reference).startswith(prefix):
                errors.append(
                    f".agent/state/current.json: {field} contains wrong record kind"
                )
            elif record[0].get("status") not in statuses:
                errors.append(
                    f".agent/state/current.json: {reference} status is inconsistent "
                    f"with {field}"
                )

    evidence_values = current.get("fresh_evidence", [])
    if isinstance(evidence_values, list):
        for reference in evidence_values:
            record = records.get(reference)
            if record is None:
                errors.append(
                    f".agent/state/current.json: unresolved reference {reference}"
                )
                continue
            value = record[0]
            if (
                not str(reference).startswith("EVD-")
                or value.get("result") in {"not_run", "not_assessed"}
            ):
                errors.append(
                    f".agent/state/current.json: {reference} is not fresh evidence"
                )
            deadline = freshness_deadline(value.get("fresh_until"))
            if deadline is None:
                errors.append(
                    f".agent/state/current.json: {reference} lacks an explicit "
                    "parseable freshness deadline"
                )
            elif deadline < datetime.now().astimezone():
                errors.append(
                    f".agent/state/current.json: {reference} evidence is expired"
                )

    authority_refs = current.get("external_effects_authority_refs", [])
    if isinstance(authority_refs, list):
        for reference in authority_refs:
            if isinstance(reference, str) and reference.startswith(
                ("authority:", "external:")
            ):
                continue
            record = records.get(reference)
            if (
                record is None
                or not str(reference).startswith("DEC-")
                or record[0].get("status") != "accepted"
            ):
                errors.append(
                    ".agent/state/current.json: external-effects authority "
                    f"reference {reference} is not an accepted decision or external source"
                )
    try:
        project = load_json(root / ".agent/project.json")
        policy = load_json(root / ".agent/policy.json")
        context = load_json(root / ".agent/context.json")
    except (OSError, ValueError, json.JSONDecodeError):
        return errors
    project_data = project.get("project", {}) if isinstance(project, dict) else {}
    policy_adoption = (
        policy.get("project_specific_adoption", {})
        if isinstance(policy, dict)
        else {}
    )
    adoption_statuses = (
        project_data.get("adoption_status"),
        policy_adoption.get("status"),
        current.get("adoption_status"),
    )
    context_status = (
        context.get("context_status") if isinstance(context, dict) else None
    )
    policy_status = (
        policy.get("policy_status") if isinstance(policy, dict) else None
    )
    if len(set(adoption_statuses)) != 1:
        errors.append(
            ".agent/state/current.json: project, policy, and current-state "
            "adoption statuses are incoherent"
        )
    adoption_status = adoption_statuses[0]
    expected_context_status = {
        "not_assessed": "generated_unadopted_baseline",
        "in_progress": "generated_unadopted_baseline",
        "adopted": "adopted",
        "superseded": "superseded",
    }.get(adoption_status)
    if (
        expected_context_status is None
        or context_status != expected_context_status
        or policy_status != expected_context_status
    ):
        errors.append(
            ".agent/state/current.json: context/policy status is incoherent "
            "with the adoption lifecycle"
        )
    if adoption_status in {"adopted", "superseded"}:
        decision_ref = project_data.get("adoption_decision_ref")
        if (
            decision_ref not in records
            or not str(decision_ref).startswith("DEC-")
            or records[decision_ref][0].get("status") != "accepted"
            or not str(
                records.get(decision_ref, ({}, ""))[0].get(
                    "authority_source", ""
                )
            ).startswith(("authority:", "external:"))
            or (
                adoption_status == "adopted"
                and decision_ref not in current.get("accepted_decisions", [])
            )
        ):
            errors.append(
                f".agent/state/current.json: {adoption_status} project lacks a "
                "traceable accepted adoption decision with external authority"
            )
    elif project_data.get("adoption_decision_ref") is not None:
        errors.append(
            ".agent/state/current.json: adoption decision is set before adoption"
        )
    if adoption_status == "superseded":
        project_commands = project.get("commands", {})
        for hook in PROJECT_COMMAND_HOOKS:
            if (
                isinstance(project_commands, dict)
                and isinstance(project_commands.get(hook), dict)
                and project_commands[hook].get("status") == "not_assessed"
            ):
                errors.append(
                    f".agent/project.json: superseded project retains unassessed hook {hook}"
                )
    if adoption_status == "adopted":
        errors.extend(check_adopted_project_conformance(root, project, records))
    expected_active = sorted(
        record_id
        for record_id, (record, _) in records.items()
        if record_id.startswith("TASK-")
        and record.get("status")
        in {"ready", "in_progress", "validating", "review", "blocked", "reopened"}
    )
    expected_decisions = sorted(
        record_id
        for record_id, (record, _) in records.items()
        if record_id.startswith("DEC-") and record.get("status") == "accepted"
    )
    if current.get("active_tasks") != expected_active:
        errors.append(".agent/state/current.json: active_tasks projection is stale")
    if current.get("accepted_decisions") != expected_decisions:
        errors.append(".agent/state/current.json: accepted_decisions projection is stale")
    if focus.get("current_task_id") is not None and focus.get("current_task_id") not in expected_active:
        errors.append(".agent/state/focus.json: current_task_id is not active")
    return errors


def check_focus(root: Path = ROOT) -> list[str]:
    path = root / ".agent/state/focus.json"
    try:
        focus = load_json(path)
        schema = load_schema(root, "harness-focus.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/state/focus.json: {error}"]
    errors = [
        f".agent/state/focus.json: {item}"
        for item in validate_schema(focus, schema)
    ]
    if isinstance(focus, dict) and focus.get("permission_grant") is not False:
        errors.append(".agent/state/focus.json: focus must not grant permission")
    return errors


def check_governance_semantics(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    errors: list[str] = []
    now = datetime.now().astimezone()

    def parsed_time(value: Any) -> datetime | None:
        if not isinstance(value, str):
            return None
        try:
            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
            return parsed if parsed.tzinfo is not None else None
        except ValueError:
            return None

    gates = {
        record_id: (record, location)
        for record_id, (record, location) in records.items()
        if record_id.startswith("GATE-")
    }
    for gate_id, (gate, location) in gates.items():
        status = gate.get("status")
        if status == "passed":
            if not gate.get("pass_criteria") or not gate.get("required_evidence"):
                errors.append(
                    f"{location}: passed gate requires criteria and evidence"
                )
            if gate.get("owner_role") in {None, "", "unassigned"}:
                errors.append(f"{location}: passed gate requires an assigned owner")
            gate_requirements = set(gate.get("requirement_refs", []))
            for evidence_ref in gate.get("required_evidence", []):
                evidence_entry = records.get(evidence_ref)
                if (
                    evidence_entry is None
                    or not str(evidence_ref).startswith("EVD-")
                ):
                    errors.append(
                        f"{location}: passed gate evidence {evidence_ref} "
                        "does not resolve to an evidence record"
                    )
                    continue
                evidence = evidence_entry[0]
                subject = evidence.get(
                    "subject_revision_or_fingerprint",
                    evidence.get("subject_version"),
                )
                scope = evidence.get("scope")
                if (
                    not isinstance(subject, str)
                    or not subject.strip()
                    or subject in {"not_recorded", "not_assessed"}
                    or subject.startswith("replace_")
                    or not isinstance(scope, str)
                    or not scope.strip()
                    or scope in {"not_recorded", "not_assessed"}
                    or scope.startswith("replace_")
                ):
                    errors.append(
                        f"{location}: passed gate evidence {evidence_ref} "
                        "has an unbound subject or scope"
                    )
                if evidence.get("result") != "pass":
                    errors.append(
                        f"{location}: passed gate evidence {evidence_ref} "
                        "does not have a pass result"
                    )
                deadline = freshness_deadline(evidence.get("fresh_until"))
                if deadline is None:
                    errors.append(
                        f"{location}: passed gate evidence {evidence_ref} "
                        "lacks an explicit freshness deadline"
                    )
                elif deadline < now:
                    errors.append(
                        f"{location}: passed gate evidence {evidence_ref} is expired"
                    )
                evidence_requirements = evidence.get("requirement_refs")
                if (
                    gate_requirements
                    and isinstance(evidence_requirements, list)
                    and not gate_requirements.issubset(set(evidence_requirements))
                ):
                    errors.append(
                        f"{location}: passed gate evidence {evidence_ref} "
                        "does not cover its requirement scope"
                    )
            expires_on = gate.get("expires_on")
            if isinstance(expires_on, str):
                try:
                    if date.fromisoformat(expires_on) < date.today():
                        errors.append(f"{location}: passed gate is expired")
                except ValueError:
                    pass
        if status == "waived":
            if gate.get("owner_role") in {None, "", "unassigned"}:
                errors.append(f"{location}: waived gate requires an assigned owner")
            if gate.get("approval_required") is not True:
                errors.append(
                    f"{location}: waived gate requires approval_required=true"
                )
            if not gate.get("limitations"):
                errors.append(f"{location}: waived gate requires limitations")
        if gate.get("approval_required") and status in {"passed", "waived"}:
            approval_source = gate.get("approval_source")
            if not approval_source:
                errors.append(
                    f"{location}: {status} gate requires external approval evidence"
                )
            elif isinstance(approval_source, str) and approval_source.startswith(
                "APR-"
            ):
                approval_entry = records.get(approval_source)
                if (
                    approval_entry is None
                    or approval_entry[0].get("status") != "observed"
                ):
                    errors.append(
                        f"{location}: approval source {approval_source} is not "
                        "a current observed attestation"
                    )
                else:
                    approval = approval_entry[0]
                    valid_from = parsed_time(approval.get("valid_from"))
                    valid_until = parsed_time(approval.get("valid_until"))
                    revoked_at = parsed_time(approval.get("revoked_at"))
                    if (
                        (valid_from is not None and valid_from > now)
                        or (valid_until is not None and valid_until <= now)
                        or revoked_at is not None
                    ):
                        errors.append(
                            f"{location}: approval source {approval_source} is "
                            "expired, revoked, or not yet valid"
                        )
                    if gate_id not in str(approval.get("resource_scope", "")):
                        errors.append(
                            f"{location}: approval source {approval_source} "
                            "does not bind the gate scope"
                        )
            elif not str(approval_source).startswith(
                ("authority:", "external:")
            ):
                errors.append(
                    f"{location}: approval source must be APR, authority, or external reference"
                )
    quality_path = root / "project-dossier/validation/QUALITY_GATES.json"
    if quality_path.is_file():
        try:
            quality = load_json(quality_path)
            if isinstance(quality, dict) and quality.get("readiness") == "ready" and (
                not gates
                or any(
                    gate.get("status") not in {"passed", "waived"}
                    for gate, _ in gates.values()
                )
            ):
                errors.append(
                    "project-dossier/validation/QUALITY_GATES.json: readiness "
                    "cannot be ready while gates are unresolved"
                )
        except (ValueError, json.JSONDecodeError):
            pass

    for record_id, (record, location) in records.items():
        if record_id.startswith("REQ-") and record.get("status") == "superseded":
            if not record.get("superseded_by"):
                errors.append(
                    f"{location}: superseded requirement requires a successor"
                )
        if record_id.startswith("ART-"):
            candidate, path_error = safe_relative_path(
                root,
                record.get("path"),
                must_exist=record.get("status") != "scratch",
            )
            if path_error and record.get("path") != "replace_with_repository_path":
                errors.append(f"{location}: artifact {path_error}")
            if candidate is not None and candidate.parts[0] == ".git":
                errors.append(f"{location}: artifact path may not target .git")
        if record_id.startswith("APR-"):
            status = record.get("status")
            observed_at = parsed_time(record.get("observed_at"))
            valid_from = parsed_time(record.get("valid_from"))
            valid_until = parsed_time(record.get("valid_until"))
            revoked_at = parsed_time(record.get("revoked_at"))
            if valid_from and valid_until and valid_until <= valid_from:
                errors.append(
                    f"{location}: approval validity window is not increasing"
                )
            if observed_at and valid_until and observed_at > valid_until:
                errors.append(
                    f"{location}: approval was observed after its validity ended"
                )
            if status == "observed":
                if (
                    not record.get("evidence_refs")
                    or not re.fullmatch(
                        r"[a-f0-9]{64}",
                        str(record.get("evidence_fingerprint", "")),
                    )
                ):
                    errors.append(
                        f"{location}: observed approval lacks evidence fingerprint"
                    )
                if not record.get("principal_or_role"):
                    errors.append(
                        f"{location}: observed approval lacks principal or role"
                    )
                if not str(record.get("authority_source", "")).startswith(
                    ("authority:", "external:")
                ):
                    errors.append(
                        f"{location}: approval attestation must cite external authority"
                    )
                if revoked_at is not None:
                    errors.append(
                        f"{location}: observed approval cannot also be revoked"
                    )
                if valid_from and valid_from > now:
                    errors.append(f"{location}: observed approval is not yet valid")
                if valid_until and valid_until <= now:
                    errors.append(f"{location}: observed approval is expired")
            if status == "expired" and (
                valid_until is None or valid_until > now
            ):
                errors.append(
                    f"{location}: expired approval lacks an elapsed valid_until"
                )
            if status == "revoked" and (
                revoked_at is None or revoked_at > now
            ):
                errors.append(
                    f"{location}: revoked approval lacks a valid revocation time"
                )
            if status == "superseded":
                successor = record.get("superseded_by")
                if successor not in records or not str(successor).startswith("APR-"):
                    errors.append(
                        f"{location}: superseded approval lacks a valid successor"
                    )
        if record_id.startswith("EVA-") and record.get("status") == "completed":
            if not record.get("result") or not record.get("evidence_refs"):
                errors.append(
                    f"{location}: completed evaluation lacks result or evidence"
                )

    active_leases: list[tuple[str, set[str], str]] = []
    for record_id, (record, location) in records.items():
        if not record_id.startswith("LEASE-") or record.get("status") != "active":
            continue
        paths: set[str] = set()
        for index, item in enumerate(record.get("write_ownership", [])):
            candidate, path_error = safe_relative_path(root, item)
            if path_error or candidate is None or candidate.parts[0] == ".git":
                errors.append(
                    f"{location}: write_ownership[{index}] is unsafe"
                )
            else:
                paths.add(candidate.as_posix())
        acquired = parsed_time(record.get("acquired_at"))
        expires = parsed_time(record.get("expires_at"))
        if acquired is None or expires is None or expires <= acquired:
            errors.append(f"{location}: active lease has invalid expiry window")
        elif expires <= now:
            errors.append(f"{location}: active lease is expired")
        active_leases.append((record_id, paths, location))
    for index, (lease_id, paths, location) in enumerate(active_leases):
        for other_id, other_paths, _ in active_leases[index + 1 :]:
            for path in paths:
                for other in other_paths:
                    if (
                        path == other
                        or path.startswith(other + "/")
                        or other.startswith(path + "/")
                    ):
                        errors.append(
                            f"{location}: active lease {lease_id} overlaps "
                            f"{other_id} at {path!r}/{other!r}"
                        )

    try:
        registry = load_json(
            root / "project-dossier/machine-readable/artifact-registry.json"
        )
        if not isinstance(registry, dict):
            return errors + ["artifact registry: top-level value must be an object"]
        representations = {
            item.get("id"): item
            for item in registry.get("representations", [])
            if isinstance(item, dict)
        }
        supersession = load_json(root / "project-dossier/SUPERSESSION.json")
        if not isinstance(supersession, dict):
            return errors + ["supersession ledger: top-level value must be an object"]
        seen_superseded: set[str] = set()
        for index, item in enumerate(supersession.get("records", [])):
            if not isinstance(item, dict):
                continue
            location = f"project-dossier/SUPERSESSION.json:records[{index}]"
            old = item.get("superseded_representation_id")
            new = item.get("successor_representation_id")
            if old == new:
                errors.append(f"{location}: successor must differ from superseded")
            if old not in representations or new not in representations:
                errors.append(f"{location}: unresolved representation supersession")
            elif representations[old].get("superseded_by") != new:
                errors.append(
                    f"{location}: registry successor does not match ledger"
                )
            if old in seen_superseded:
                errors.append(f"{location}: representation superseded more than once")
            if isinstance(old, str):
                seen_superseded.add(old)
            retained, path_error = safe_relative_path(
                root,
                item.get("retained_history_path"),
                allowed_prefixes=("project-dossier/history",),
                must_exist=True,
            )
            if path_error or retained is None:
                errors.append(f"{location}: retained history path is invalid")
    except (OSError, ValueError, json.JSONDecodeError):
        pass
    return errors


def _sorted_by_id(values: Any) -> list[dict[str, Any]]:
    if not isinstance(values, list):
        return []
    return sorted(
        (item for item in values if isinstance(item, dict)),
        key=lambda item: str(item.get("id", "")),
    )


def load_dossier_registry(
    root: Path,
) -> tuple[dict[str, Any] | None, list[str]]:
    path = root / "project-dossier/machine-readable/artifact-registry.json"
    errors: list[str] = []
    try:
        registry = load_json(path)
        schema = load_schema(root, "dossier-artifact-registry.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return None, [f"project-dossier/machine-readable/artifact-registry.json: {error}"]
    errors.extend(
        f"project-dossier/machine-readable/artifact-registry.json: {item}"
        for item in validate_schema(registry, schema)
    )
    if not isinstance(registry, dict):
        return None, errors

    try:
        project = load_json(root / ".agent/project.json")
        if (
            registry.get("project_slug") != project.get("project", {}).get("id")
            or registry.get("profile") != project.get("project", {}).get("profile")
        ):
            errors.append("artifact registry: project identity/profile mismatch")
    except (OSError, ValueError, json.JSONDecodeError):
        pass

    artifact_types = _sorted_by_id(registry.get("artifact_types"))
    representations = _sorted_by_id(registry.get("representations"))
    type_ids = [item.get("id") for item in artifact_types]
    representation_ids = [item.get("id") for item in representations]
    representation_paths = [item.get("path") for item in representations]
    if len(type_ids) != len(set(type_ids)):
        errors.append("artifact registry: duplicate artifact type ID")
    if len(representation_ids) != len(set(representation_ids)):
        errors.append("artifact registry: duplicate representation ID")
    if len(representation_paths) != len(set(representation_paths)):
        errors.append("artifact registry: duplicate representation path")
    known_types = {item for item in type_ids if isinstance(item, str)}
    known_representations = {
        item for item in representation_ids if isinstance(item, str)
    }
    by_type = {
        str(item.get("id")): item
        for item in artifact_types
        if isinstance(item.get("id"), str)
    }
    by_representation = {
        str(item.get("id")): item
        for item in representations
        if isinstance(item.get("id"), str)
    }

    for artifact_type in artifact_types:
        artifact_type_id = artifact_type.get("id")
        classification = artifact_type.get("classification")
        applicability = artifact_type.get("applicability", {})
        status = (
            applicability.get("status") if isinstance(applicability, dict) else None
        )
        if classification == "core" and status != "required":
            errors.append(
                f"artifact type {artifact_type_id}: core type must be required"
            )
        if classification in {"conditional", "optional"} and status not in {
            "not_assessed",
            "applicable",
            "not_applicable",
        }:
            errors.append(
                f"artifact type {artifact_type_id}: invalid applicability for "
                f"{classification} type"
            )
        if status in {"applicable", "not_applicable"} and (
            not applicability.get("assessed_on")
            or not isinstance(applicability.get("assessed_by"), str)
            or not applicability.get("assessed_by", "").strip()
            or not isinstance(applicability.get("rationale"), str)
            or not applicability.get("rationale", "").strip()
        ):
            errors.append(
                f"artifact type {artifact_type_id}: assessed applicability requires "
                "date, assessor, and rationale"
            )
        if status in {"required", "not_assessed"} and (
            applicability.get("assessed_on") is not None
            or applicability.get("assessed_by") is not None
        ):
            errors.append(
                f"artifact type {artifact_type_id}: unassessed/generated applicability "
                "must not claim an assessor or date"
            )
        for dependency in artifact_type.get("dependencies", []):
            if dependency not in known_types:
                errors.append(
                    f"artifact type {artifact_type_id}: unresolved dependency {dependency}"
                )

    nonderived_dossier_paths: set[str] = set()
    represented_type_ids: set[str] = set()
    for representation in representations:
        representation_id = representation.get("id")
        path_value = representation.get("path")
        type_refs = representation.get("artifact_type_ids", [])
        for artifact_type_id in type_refs:
            if artifact_type_id not in known_types:
                errors.append(
                    f"representation {representation_id}: unresolved artifact type "
                    f"{artifact_type_id}"
                )
        applicability = representation.get("applicability", {})
        applicability_status = (
            applicability.get("status") if isinstance(applicability, dict) else None
        )
        if len(type_refs) > 1 and applicability_status != "combined":
            errors.append(
                f"representation {representation_id}: combined representation "
                "requires applicability.status=combined"
            )
        if len(type_refs) == 1 and applicability_status == "combined":
            errors.append(
                f"representation {representation_id}: combined status requires "
                "multiple artifact type IDs"
            )
        if applicability_status != "not_applicable":
            represented_type_ids.update(
                item for item in type_refs if isinstance(item, str)
            )
        if len(type_refs) > 1 and any(
            by_type.get(str(item), {}).get("applicability", {}).get("status")
            not in {"required", "applicable"}
            for item in type_refs
        ):
            errors.append(
                f"representation {representation_id}: combined representation "
                "may reference only required/applicable artifact types"
            )
        review = representation.get("review", {})
        if isinstance(review, dict):
            review_status = review.get("status")
            reviewed_on = review.get("last_reviewed_on")
            basis = review.get("basis")
            if review_status == "reviewed" and (
                not reviewed_on or not isinstance(basis, str) or not basis.strip()
            ):
                errors.append(
                    f"representation {representation_id}: reviewed status requires "
                    "date and basis"
                )
            if review_status == "not_reviewed" and reviewed_on is not None:
                errors.append(
                    f"representation {representation_id}: generated date cannot "
                    "serve as substantive review"
                )
        candidate, path_error = safe_relative_path(
            root,
            path_value,
            allowed_prefixes=("project-dossier", ".agent/decisions"),
            must_exist=(
                isinstance(path_value, str)
                and path_value not in DERIVED_EXCLUSIONS
            ),
        )
        if path_error:
            errors.append(f"representation {representation_id}: {path_error}")
        elif (
            candidate is not None
            and candidate.as_posix().startswith("project-dossier/")
            and candidate.as_posix() not in DERIVED_EXCLUSIONS
        ):
            nonderived_dossier_paths.add(candidate.as_posix())
        if representation.get("generated"):
            if not str(representation.get("source_direction", "")).startswith(
                "generated_"
            ):
                errors.append(
                    f"representation {representation_id}: generated representation "
                    "must declare generated source direction"
                )
        successor = representation.get("superseded_by")
        if successor is not None and successor not in known_representations:
            errors.append(
                f"representation {representation_id}: unresolved successor {successor}"
            )
        if successor == representation_id:
            errors.append(
                f"representation {representation_id}: cannot supersede itself"
            )

    for representation_id in by_representation:
        seen: set[str] = set()
        current: str | None = representation_id
        while current is not None and current in by_representation:
            if current in seen:
                errors.append(
                    f"artifact registry: supersession cycle includes {current}"
                )
                break
            seen.add(current)
            successor = by_representation[current].get("superseded_by")
            current = successor if isinstance(successor, str) else None

    uncovered_required = sorted(
        artifact_type_id
        for artifact_type_id, artifact_type in by_type.items()
        if artifact_type.get("applicability", {}).get("status")
        != "not_applicable"
        and artifact_type_id not in represented_type_ids
    )
    if uncovered_required:
        errors.append(
            "artifact registry: applicable/unassessed artifact types lack a "
            "representation: "
            + ", ".join(uncovered_required)
        )

    actual_nonderived = {
        relative(path, root)
        for path in (root / "project-dossier").rglob("*")
        if path.is_file() and relative(path, root) not in DERIVED_EXCLUSIONS
    }
    if nonderived_dossier_paths != actual_nonderived:
        missing = sorted(actual_nonderived - nonderived_dossier_paths)
        extra = sorted(nonderived_dossier_paths - actual_nonderived)
        if missing:
            errors.append(
                "artifact registry missing project-maintained dossier files: "
                + ", ".join(missing)
            )
        if extra:
            errors.append(
                "artifact registry contains absent project-maintained files: "
                + ", ".join(extra)
            )
    return registry, errors


def check_dossier_registry(root: Path) -> list[str]:
    return load_dossier_registry(root)[1]


def check_dossier_catalog(root: Path) -> list[str]:
    registry, errors = load_dossier_registry(root)
    if registry is None:
        return errors
    catalog_path = root / "project-dossier/ARTIFACT_CATALOG.json"
    authority_path = root / "project-dossier/machine-readable/path-authority.json"
    try:
        catalog = load_json(catalog_path)
        catalog_schema = load_schema(root, "artifact-catalog.schema.json")
        errors.extend(
            f"project-dossier/ARTIFACT_CATALOG.json: {item}"
            for item in validate_schema(catalog, catalog_schema)
        )
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return errors + [f"project-dossier/ARTIFACT_CATALOG.json: {error}"]
    if isinstance(catalog, dict):
        for field in ("dossier_version", "profile", "project_slug"):
            if catalog.get(field) != registry.get(field):
                errors.append(f"artifact catalog: {field} differs from source registry")
        if _sorted_by_id(catalog.get("artifact_types")) != _sorted_by_id(
            registry.get("artifact_types")
        ):
            errors.append("artifact catalog: artifact types differ from source registry")
        if _sorted_by_id(catalog.get("representations")) != _sorted_by_id(
            registry.get("representations")
        ):
            errors.append(
                "artifact catalog: representations differ from source registry"
            )

    try:
        authority = load_json(authority_path)
        authority_schema = load_schema(root, "dossier-path-authority.schema.json")
        errors.extend(
            f"project-dossier/machine-readable/path-authority.json: {item}"
            for item in validate_schema(authority, authority_schema)
        )
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return errors + [
            f"project-dossier/machine-readable/path-authority.json: {error}"
        ]

    expected_entries = sorted(
        (
            {
                "path": item["path"],
                "representation_id": item["id"],
                "artifact_type_ids": item["artifact_type_ids"],
                "information_state": item["information_state"],
                "authority": item["authority"],
                "source_direction": item["source_direction"],
                "generated": item["generated"],
            }
            for item in registry.get("representations", [])
            if isinstance(item, dict)
            and str(item.get("path", "")).startswith("project-dossier/")
        ),
        key=lambda item: item["path"],
    )
    entries = (
        authority.get("paths", [])
        if isinstance(authority, dict) and isinstance(authority.get("paths"), list)
        else []
    )
    for index, item in enumerate(entries):
        path_value = item.get("path") if isinstance(item, dict) else None
        _, path_error = safe_relative_path(
            root,
            path_value,
            allowed_prefixes=("project-dossier",),
            must_exist=True,
        )
        if path_error:
            errors.append(
                "project-dossier/machine-readable/path-authority.json: "
                f"paths[{index}] {path_error}"
            )
    if sorted(entries, key=lambda item: str(item.get("path", ""))) != expected_entries:
        errors.append(
            "path authority: entries differ from artifact registry representations"
        )

    authority_paths = {
        item.get("path")
        for item in entries
        if isinstance(item, dict) and isinstance(item.get("path"), str)
    }
    actual_paths = {
        relative(path, root)
        for path in (root / "project-dossier").rglob("*")
        if path.is_file()
    }
    if authority_paths != actual_paths:
        missing = sorted(actual_paths - authority_paths)
        extra = sorted(authority_paths - actual_paths)
        if missing:
            errors.append(
                "path authority missing dossier files: " + ", ".join(missing)
            )
        if extra:
            errors.append(
                "path authority contains absent files: " + ", ".join(extra)
            )
    generation_ids = {
        catalog.get("generation_id") if isinstance(catalog, dict) else None,
        authority.get("generation_id") if isinstance(authority, dict) else None,
    }
    manifest_path = root / "project-dossier/MANIFEST.json"
    if manifest_path.is_file():
        try:
            manifest = load_json(manifest_path)
            generation_ids.add(
                manifest.get("generation_id") if isinstance(manifest, dict) else None
            )
        except (ValueError, json.JSONDecodeError):
            pass
    if len(generation_ids) != 1 or None in generation_ids:
        errors.append("dossier derived files have mismatched generation IDs")
    return errors


def parse_semver(value: Any) -> tuple[int, int, int] | None:
    match = re.fullmatch(
        r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)",
        str(value),
    )
    if not match:
        return None
    return tuple(int(match.group(index)) for index in range(1, 4))


def version_satisfies_core(requirement: str) -> bool:
    match = re.fullmatch(
        r"\^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)",
        requirement,
    )
    current = parse_semver(KERNEL_VERSION)
    if not match or current is None:
        return False
    lower = tuple(int(match.group(index)) for index in range(1, 4))
    if lower[0] > 0:
        upper = (lower[0] + 1, 0, 0)
    elif lower[1] > 0:
        upper = (0, lower[1] + 1, 0)
    else:
        upper = (0, 0, lower[2] + 1)
    return lower <= current < upper


def confined(root: Path, declared_root: Path, candidate: Path) -> bool:
    _, declared_error = safe_relative_path(
        root,
        declared_root.as_posix(),
        allowed_prefixes=(".agent/extensions",),
        must_exist=True,
    )
    _, candidate_error = safe_relative_path(
        root,
        candidate.as_posix(),
        allowed_prefixes=(".agent/extensions",),
        must_exist=True,
    )
    if declared_error or candidate_error:
        return False
    try:
        (root / candidate).resolve(strict=True).relative_to(
            (root / declared_root).resolve(strict=True)
        )
        return True
    except (FileNotFoundError, ValueError):
        return False


def check_capabilities(
    root: Path,
    governed_records: dict[str, tuple[dict[str, Any], str]] | None = None,
) -> list[str]:
    capabilities_root = root / ".agents"
    if not capabilities_root.exists():
        try:
            project = load_json(root / ".agent/project.json")
            profile = (
                project.get("project", {}).get("profile")
                if isinstance(project, dict)
                else None
            )
        except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError):
            profile = None
        if profile == "high-assurance":
            return [".agents: capability package required by high-assurance profile"]
        return []
    if capabilities_root.is_symlink() or not capabilities_root.is_dir():
        return [".agents: capability root must be a regular directory"]
    errors: list[str] = []
    allowed_capability_entries = {"README.md", "agents", "workflows", "skills"}
    for path in sorted(capabilities_root.iterdir()):
        if path.name not in allowed_capability_entries:
            errors.append(f"{relative(path, root)}: unknown capability-root path")
        elif path.is_symlink():
            errors.append(f"{relative(path, root)}: capability-root symlink prohibited")
    try:
        schema = load_schema(root, "harness-capability-records.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agents: capability schema unavailable: {error}"]
    try:
        origin = load_json(root / ".octon-mini-origin.json")
        if not isinstance(origin, dict):
            origin = {}
    except (OSError, ValueError, json.JSONDecodeError):
        origin = {}
    if governed_records is None:
        governed_records, _ = collect_records(root)

    records: dict[str, tuple[str, dict[str, Any], str]] = {}
    by_kind: dict[str, dict[str, dict[str, Any]]] = {
        "agent": {},
        "workflow": {},
        "skill": {},
    }
    for directory_name, kind in (("agents", "agent"), ("workflows", "workflow")):
        directory = capabilities_root / directory_name
        if not directory.is_dir():
            errors.append(f".agents/{directory_name}: required governed store missing")
            continue
        for path in sorted(directory.iterdir()):
            rel = relative(path, root)
            if path.is_symlink() or path.is_dir() or path.suffix != ".json":
                errors.append(f"{rel}: unexpected governed capability path")
                continue
            try:
                value = load_json(path)
            except (OSError, ValueError, json.JSONDecodeError) as error:
                errors.append(f"{rel}: {error}")
                continue
            errors.extend(
                f"{rel}: {item}"
                for item in validate_schema(
                    value,
                    {"$ref": f"#/$defs/{kind}"},
                    root_schema=schema,
                )
            )
            if not isinstance(value, dict):
                continue
            capability_id = value.get("id")
            if capability_id != path.stem:
                errors.append(f"{rel}: filename/ID mismatch")
            if isinstance(capability_id, str):
                if capability_id in records:
                    errors.append(f"{rel}: duplicate global capability ID {capability_id}")
                else:
                    records[capability_id] = (kind, value, rel)
                    by_kind[kind][capability_id] = value

    for capability_id, (kind, value, location) in records.items():
        status = value.get("adoption_status")
        provenance = value.get("provenance", {})
        if not isinstance(provenance, dict):
            provenance = {}
        trust = provenance.get("trust_class")
        adoption_decision = value.get("adoption_decision_ref")
        if status == "generated_unadopted_baseline" and trust != (
            "generated_unadopted_capability"
        ):
            errors.append(f"{location}: unadopted capability has invalid trust class")
        if status == "generated_unadopted_baseline" and (
            value.get("owner") != "unassigned"
            or adoption_decision is not None
            or provenance.get("source") != "octon_mini"
            or provenance.get("source_version") != origin.get("octon_mini_version")
            or provenance.get("generated_on") != origin.get("generated_on")
            or provenance.get("license_review") != "not_assessed"
            or provenance.get("security_review") != "not_assessed"
            or provenance.get("source_fingerprint") is not None
            or provenance.get("local_changes") != []
        ):
            errors.append(
                f"{location}: unadopted capability provenance differs from origin"
            )
        if status == "adopted" and (
            value.get("owner") in {None, "", "unassigned"}
            or trust
            not in {
                "project_local_reviewed_capability",
                "imported_reviewed_capability",
            }
            or provenance.get("license_review") in {"not_assessed", "review_required"}
            or provenance.get("security_review") in {"not_assessed", "review_required"}
            or not isinstance(adoption_decision, str)
            or adoption_decision not in governed_records
            or governed_records.get(adoption_decision, ({}, ""))[0].get("status")
            != "accepted"
            or not str(
                governed_records.get(adoption_decision, ({}, ""))[0].get(
                    "authority_source", ""
                )
            ).startswith(("authority:", "external:"))
        ):
            errors.append(
                f"{location}: adopted capability lacks assigned owner, accepted "
                "authority decision, or completed trust reviews"
            )
        if status == "adopted" and trust == "imported_reviewed_capability" and (
            not re.fullmatch(
                r"[a-f0-9]{64}",
                str(provenance.get("source_fingerprint", "")),
            )
            or str(provenance.get("source_version", "")).casefold()
            in {
                "latest",
                "main",
                "master",
                "head",
                "unknown",
                "not_assessed",
                "unversioned",
            }
        ):
            errors.append(f"{location}: imported capability provenance is not pinned")
        included_files = provenance.get("included_files", [])
        if not isinstance(included_files, list):
            included_files = []
        if status == "generated_unadopted_baseline" and included_files != [location]:
            errors.append(f"{location}: unadopted included-file set is not exact")
        for index, included_path in enumerate(included_files):
            candidate, path_error = safe_relative_path(
                root,
                included_path,
                allowed_prefixes=(".agents",),
                must_exist=True,
            )
            if (
                path_error
                or candidate is None
                or (root / candidate).is_symlink()
                or not (root / candidate).is_file()
            ):
                errors.append(
                    f"{location}: included_files[{index}] is unsafe or absent"
                )
        deprecated = parse_semver(value.get("deprecated_at"))
        removal = parse_semver(value.get("removal_version"))
        current_kernel = parse_semver(KERNEL_VERSION)
        successor = value.get("successor")
        if status in {
            "generated_unadopted_baseline",
            "adopted",
            "disabled",
        } and any(item is not None for item in (deprecated, removal, successor)):
            errors.append(f"{location}: active capability has deprecation metadata")
        if status in {"deprecated", "superseded"}:
            if (
                deprecated is None
                or removal is None
                or removal <= deprecated
                or not isinstance(successor, str)
                or successor == capability_id
                or successor not in by_kind[kind]
            ):
                errors.append(f"{location}: invalid capability deprecation tuple")
            if (
                removal is not None
                and current_kernel is not None
                and current_kernel >= removal
            ):
                errors.append(f"{location}: capability remains after removal version")
        elif any(
            raw is not None
            for raw in (
                value.get("deprecated_at"),
                value.get("removal_version"),
                successor,
            )
        ):
            errors.append(f"{location}: deprecation metadata requires deprecated status")

        if kind == "workflow":
            states = value.get("states", [])
            state_by_id: dict[str, dict[str, Any]] = {}
            for state in states if isinstance(states, list) else []:
                if not isinstance(state, dict):
                    continue
                state_id = state.get("id")
                if isinstance(state_id, str) and state_id in state_by_id:
                    errors.append(f"{location}: duplicate workflow state ID {state_id}")
                elif isinstance(state_id, str):
                    state_by_id[state_id] = state
            terminal_ids = {
                state_id
                for state_id, state in state_by_id.items()
                if state.get("kind") == "terminal"
            }
            declared_terminals = value.get("terminal_states", [])
            if not isinstance(declared_terminals, list):
                declared_terminals = []
            if set(
                item for item in declared_terminals if isinstance(item, str)
            ) != terminal_ids:
                errors.append(f"{location}: terminal state declaration mismatch")
            for field in ("initial_state", "cancellation_state"):
                field_value = value.get(field)
                if not isinstance(field_value, str) or field_value not in state_by_id:
                    errors.append(f"{location}: unresolved workflow {field}")
            for state_id, state in state_by_id.items():
                kind_value = state.get("kind")
                agent_ref = state.get("agent_ref")
                if kind_value == "terminal":
                    if (
                        state.get("actions")
                        or agent_ref is not None
                        or state.get("gate") is not None
                        or any(
                            state.get(field) is not None
                            for field in (
                                "on_success",
                                "on_failure",
                                "on_actionable_findings",
                            )
                        )
                    ):
                        errors.append(
                            f"{location}: terminal state {state_id} has behavior"
                        )
                else:
                    if state.get("on_success") is None:
                        errors.append(
                            f"{location}: nonterminal state {state_id} lacks on_success"
                        )
                    if kind_value == "review":
                        if (
                            not isinstance(agent_ref, str)
                            or agent_ref not in by_kind["agent"]
                            or state.get("on_actionable_findings") is None
                        ):
                            errors.append(
                                f"{location}: review state {state_id} lacks a valid agent "
                                "or actionable-finding transition"
                            )
                    elif agent_ref is not None or state.get(
                        "on_actionable_findings"
                    ) is not None:
                        errors.append(
                            f"{location}: only review states may use agent/findings routing"
                        )
                for field in (
                    "on_success",
                    "on_failure",
                    "on_actionable_findings",
                ):
                    target = state.get(field)
                    if target is not None and (
                        not isinstance(target, str) or target not in state_by_id
                    ):
                        errors.append(
                            f"{location}: state {state_id} has unresolved {field}"
                        )
            initial_state = value.get("initial_state")
            cancellation_state = value.get("cancellation_state")
            reachable = (
                {initial_state}
                if isinstance(initial_state, str) and initial_state in state_by_id
                else set()
            )
            pending = list(reachable)
            while pending:
                state = state_by_id[pending.pop()]
                for field in ("on_success", "on_failure", "on_actionable_findings"):
                    target = state.get(field)
                    if (
                        isinstance(target, str)
                        and target in state_by_id
                        and target not in reachable
                    ):
                        reachable.add(target)
                        pending.append(target)
            expected_reachable = set(state_by_id) - (
                {cancellation_state}
                if isinstance(cancellation_state, str)
                else set()
            )
            if not expected_reachable.issubset(reachable):
                errors.append(f"{location}: workflow contains unreachable states")
            if not (reachable & terminal_ids):
                errors.append(
                    f"{location}: workflow initial state cannot reach a terminal"
                )
            if cancellation_state not in terminal_ids:
                errors.append(
                    f"{location}: cancellation state must be terminal"
                )

    for kind, values in by_kind.items():
        for capability_id in values:
            seen: set[str] = set()
            current_id: str | None = capability_id
            while current_id in values:
                if current_id in seen:
                    errors.append(
                        f".agents/{kind}s: successor cycle includes {current_id}"
                    )
                    break
                seen.add(current_id)
                successor = values[current_id].get("successor")
                current_id = successor if isinstance(successor, str) else None

    skills_root = capabilities_root / "skills"
    if not skills_root.is_dir():
        errors.append(".agents/skills: required governed store missing")
        return errors
    for skill_dir in sorted(skills_root.iterdir()):
        if skill_dir.is_symlink() or not skill_dir.is_dir():
            errors.append(f"{relative(skill_dir, root)}: unexpected skill package path")
            continue
        skill_path = skill_dir / "SKILL.md"
        provenance_path = skill_dir / "references/provenance.json"
        if not skill_path.is_file() or skill_path.is_symlink():
            errors.append(f"{relative(skill_dir, root)}: missing safe SKILL.md")
            continue
        try:
            text = skill_path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            errors.append(f"{relative(skill_path, root)}: cannot read frontmatter: {error}")
            continue
        metadata: dict[str, str] = {}
        if not text.startswith("---\n") or "\n---\n" not in text[4:]:
            errors.append(f"{relative(skill_path, root)}: invalid frontmatter")
        else:
            end = text.find("\n---\n", 4)
            for line in text[4:end].splitlines():
                if ":" not in line:
                    errors.append(f"{relative(skill_path, root)}: invalid frontmatter line")
                    continue
                key, raw_value = line.split(":", 1)
                if key in metadata:
                    errors.append(
                        f"{relative(skill_path, root)}: duplicate frontmatter key {key}"
                    )
                metadata[key] = raw_value.strip()
            if set(metadata) != {"name", "description"}:
                errors.append(
                    f"{relative(skill_path, root)}: frontmatter field contract mismatch"
                )
            if (
                not metadata.get("name")
                or metadata.get("name") != skill_dir.name
                or not re.fullmatch(
                    r"[a-z0-9]+(?:-[a-z0-9]+)*",
                    metadata.get("name", ""),
                )
                or not metadata.get("description")
            ):
                errors.append(
                    f"{relative(skill_path, root)}: skill name/description invalid"
                )
        if not provenance_path.is_file() or provenance_path.is_symlink():
            errors.append(f"{relative(skill_dir, root)}: missing provenance record")
            continue
        try:
            skill_record = load_json(provenance_path)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            errors.append(f"{relative(provenance_path, root)}: {error}")
            continue
        errors.extend(
            f"{relative(provenance_path, root)}: {item}"
            for item in validate_schema(
                skill_record,
                {"$ref": "#/$defs/skill_provenance"},
                root_schema=schema,
            )
        )
        if not isinstance(skill_record, dict):
            continue
        skill_id = skill_record.get("id")
        if skill_id != skill_dir.name or skill_record.get("entrypoint") != relative(
            skill_path, root
        ):
            errors.append(
                f"{relative(provenance_path, root)}: skill identity/entrypoint mismatch"
            )
        if isinstance(skill_id, str):
            if skill_id in records:
                errors.append(
                    f"{relative(provenance_path, root)}: duplicate global capability "
                    f"ID {skill_id}"
                )
            else:
                records[skill_id] = (
                    "skill",
                    skill_record,
                    relative(provenance_path, root),
                )
                by_kind["skill"][skill_id] = skill_record
        if metadata.get("name") != skill_id:
            errors.append(
                f"{relative(skill_path, root)}: frontmatter name differs from provenance"
            )

    for skill_id, skill in by_kind["skill"].items():
        location = records[skill_id][2]
        provenance = skill.get("provenance")
        if not isinstance(provenance, dict):
            provenance = {}
        status = skill.get("adoption_status")
        decision_ref = skill.get("adoption_decision_ref")
        if status == "generated_unadopted_baseline" and (
            skill.get("owner") != "unassigned"
            or decision_ref is not None
            or provenance.get("source") != "octon_mini"
            or provenance.get("source_version") != origin.get("octon_mini_version")
            or provenance.get("generated_on") != origin.get("generated_on")
            or provenance.get("license_review") != "not_assessed"
            or provenance.get("security_review") != "not_assessed"
            or provenance.get("source_fingerprint") is not None
            or provenance.get("local_changes") != []
            or provenance.get("trust_class")
            != "generated_unadopted_capability"
        ):
            errors.append(f"{location}: unadopted skill provenance differs from origin")
        if status == "adopted" and (
            skill.get("owner") in {None, "", "unassigned"}
            or provenance.get("trust_class")
            not in {
                "project_local_reviewed_capability",
                "imported_reviewed_capability",
            }
            or provenance.get("license_review") in {"not_assessed", "review_required"}
            or provenance.get("security_review") in {"not_assessed", "review_required"}
            or not isinstance(decision_ref, str)
            or decision_ref not in governed_records
            or governed_records.get(decision_ref, ({}, ""))[0].get("status")
            != "accepted"
            or not str(
                governed_records.get(decision_ref, ({}, ""))[0].get(
                    "authority_source", ""
                )
            ).startswith(("authority:", "external:"))
        ):
            errors.append(f"{location}: adopted skill lacks decision/trust review")
        if (
            status == "adopted"
            and provenance.get("trust_class") == "imported_reviewed_capability"
            and (
                not re.fullmatch(
                    r"[a-f0-9]{64}",
                    str(provenance.get("source_fingerprint", "")),
                )
                or str(provenance.get("source_version", "")).casefold()
                in {
                    "latest",
                    "main",
                    "master",
                    "head",
                    "unknown",
                    "not_assessed",
                    "unversioned",
                }
            )
        ):
            errors.append(f"{location}: imported skill provenance is not pinned")
        included_files = provenance.get("included_files", [])
        if not isinstance(included_files, list):
            included_files = []
        expected_skill_files = [
            f".agents/skills/{skill_id}/SKILL.md",
            f".agents/skills/{skill_id}/references/provenance.json",
        ]
        if (
            status == "generated_unadopted_baseline"
            and included_files != expected_skill_files
        ):
            errors.append(f"{location}: unadopted included-file set is not exact")
        current_skill_dir = skills_root / skill_id
        actual_skill_files = sorted(
            relative(path, root)
            for path in current_skill_dir.rglob("*")
            if path.is_file() and not path.is_symlink()
        )
        if sorted(
            item for item in included_files if isinstance(item, str)
        ) != actual_skill_files:
            errors.append(f"{location}: included-file inventory is incomplete")
        for index, included_path in enumerate(included_files):
            candidate, path_error = safe_relative_path(
                root,
                included_path,
                allowed_prefixes=(f".agents/skills/{skill_id}",),
                must_exist=True,
            )
            if (
                path_error
                or candidate is None
                or (root / candidate).is_symlink()
                or not (root / candidate).is_file()
            ):
                errors.append(f"{location}: included_files[{index}] is unsafe or absent")
        deprecated = parse_semver(skill.get("deprecated_at"))
        removal = parse_semver(skill.get("removal_version"))
        successor = skill.get("successor")
        current_kernel = parse_semver(KERNEL_VERSION)
        if status in {"deprecated", "superseded"}:
            if (
                deprecated is None
                or removal is None
                or removal <= deprecated
                or not isinstance(successor, str)
                or successor == skill_id
                or successor not in by_kind["skill"]
            ):
                errors.append(f"{location}: invalid capability deprecation tuple")
            if (
                removal is not None
                and current_kernel is not None
                and current_kernel >= removal
            ):
                errors.append(f"{location}: capability remains after removal version")
        elif any(
            value is not None
            for value in (
                skill.get("deprecated_at"),
                skill.get("removal_version"),
                successor,
            )
        ):
            errors.append(f"{location}: deprecation metadata requires deprecated status")
    for skill_id in by_kind["skill"]:
        seen: set[str] = set()
        current_id: str | None = skill_id
        while current_id in by_kind["skill"]:
            if current_id in seen:
                errors.append(f".agents/skills: successor cycle includes {current_id}")
                break
            seen.add(current_id)
            successor = by_kind["skill"][current_id].get("successor")
            current_id = successor if isinstance(successor, str) else None
    for agent_id, agent in by_kind["agent"].items():
        skill_refs = agent.get("skill_refs", [])
        if not isinstance(skill_refs, list):
            skill_refs = []
        for skill_id in skill_refs:
            if skill_id not in by_kind["skill"]:
                errors.append(f"{records[agent_id][2]}: unresolved skill reference {skill_id}")
            elif (
                agent.get("adoption_status") == "adopted"
                and by_kind["skill"][skill_id].get("adoption_status") != "adopted"
            ):
                errors.append(
                    f"{records[agent_id][2]}: adopted agent depends on unadopted skill"
                )
    for workflow_id, workflow in by_kind["workflow"].items():
        if workflow.get("adoption_status") != "adopted":
            continue
        states = workflow.get("states", [])
        for state in states if isinstance(states, list) else []:
            agent_ref = state.get("agent_ref") if isinstance(state, dict) else None
            if (
                isinstance(agent_ref, str)
                and agent_ref in by_kind["agent"]
                and by_kind["agent"][agent_ref].get("adoption_status") != "adopted"
            ):
                errors.append(
                    f"{records[workflow_id][2]}: adopted workflow depends on "
                    "unadopted agent"
                )
    return errors


def least_extension_environment(temporary_home: Path) -> dict[str, str]:
    allowed = ("PATH", "SYSTEMROOT", "WINDIR")
    environment = {
        key: os.environ[key]
        for key in allowed
        if key in os.environ
    }
    environment.update(
        HOME=str(temporary_home),
        USERPROFILE=str(temporary_home),
        TEMP=str(temporary_home),
        TMP=str(temporary_home),
        TMPDIR=str(temporary_home),
        PYTHONDONTWRITEBYTECODE="1",
        PYTHONIOENCODING="utf-8",
        LANG="C.UTF-8",
        LC_ALL="C.UTF-8",
    )
    return environment


def check_extensions(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]] | None = None,
) -> list[str]:
    registry_path = root / ".agent" / "extensions" / "registry.json"
    if not registry_path.exists():
        try:
            project = load_json(root / ".agent/project.json")
            profile = (
                project.get("project", {}).get("profile")
                if isinstance(project, dict)
                else None
            )
        except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError):
            profile = None
        if profile in {"standard", "high-assurance"}:
            return [
                ".agent/extensions/registry.json: required by selected profile"
            ]
        return []
    errors: list[str] = []
    try:
        registry = load_json(registry_path)
        schema = load_schema(root, "harness-extension-registry.schema.json")
        errors.extend(
            f".agent/extensions/registry.json: {item}"
            for item in validate_schema(registry, schema)
        )
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/extensions/registry.json: {error}"]
    if isinstance(registry, dict) and registry.get("core_version") != KERNEL_VERSION:
        errors.append(
            ".agent/extensions/registry.json: core_version does not match "
            "the installed kernel"
        )
    if errors or not isinstance(registry, dict):
        return errors
    seen_ids: set[str] = set()
    seen_paths: set[str] = set()
    known_extension_ids = {
        item.get("id")
        for item in registry.get("extensions", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    extensions_root = registry_path.parent
    declared_root_names = {
        Path(item.get("path", "")).name
        for item in registry.get("extensions", [])
        if isinstance(item, dict) and isinstance(item.get("path"), str)
    }
    allowed_extension_entries = {
        "README.md",
        "registry.json",
        *declared_root_names,
    }
    for path in sorted(extensions_root.iterdir()):
        if path.name not in allowed_extension_entries:
            errors.append(f"{relative(path, root)}: unregistered extension-root path")
        elif path.is_symlink():
            errors.append(f"{relative(path, root)}: extension-root symlink prohibited")
    finding_schema = schema
    if records is None:
        records, _ = collect_records(root)
    for extension in registry.get("extensions", []):
        extension_id = extension["id"]
        extension_errors: list[str] = []
        declared_root = Path(extension["path"])
        config = Path(extension["config"])
        validator = Path(extension["validator"])
        if extension_id in seen_ids:
            extension_errors.append(f"extension {extension_id}: duplicate extension ID")
        if extension["path"] in seen_paths:
            extension_errors.append(
                f"extension {extension_id}: duplicate extension path"
            )
        seen_ids.add(extension_id)
        seen_paths.add(extension["path"])
        if declared_root.name != extension_id:
            extension_errors.append(f"extension {extension_id}: path/ID mismatch")
        if not confined(root, declared_root, config):
            extension_errors.append(
                f"extension {extension_id}: config escapes extension path"
            )
        if not confined(root, declared_root, validator):
            extension_errors.append(
                f"extension {extension_id}: validator escapes extension path"
            )
        if not version_satisfies_core(extension["requires_core"]):
            extension_errors.append(
                f"extension {extension_id}: incompatible core version"
            )
        trust_decision = extension.get("trust_decision_ref")
        if extension.get("enabled") and (
            extension.get("trust_class") != "trusted_project_local_code"
            or extension.get("owner") in {None, "", "unassigned"}
            or str(extension.get("provenance", "")).startswith(
                ("replace_", "not_assessed", "generated_")
            )
            or not isinstance(trust_decision, str)
            or trust_decision not in records
            or records[trust_decision][0].get("status") != "accepted"
        ):
            extension_errors.append(
                f"extension {extension_id}: enabled extension requires assigned "
                "ownership, adopted provenance, trusted classification, and a "
                "resolved accepted trust decision"
            )
        deprecated = parse_semver(extension.get("deprecated_at"))
        removal = parse_semver(extension.get("removal_version"))
        current_core = parse_semver(KERNEL_VERSION)
        if extension.get("deprecated_at") is not None and deprecated is None:
            extension_errors.append(
                f"extension {extension_id}: deprecated_at must be strict semver"
            )
        if extension.get("removal_version") is not None and removal is None:
            extension_errors.append(
                f"extension {extension_id}: removal_version must be strict semver"
            )
        if deprecated is not None and removal is None:
            extension_errors.append(
                f"extension {extension_id}: deprecated extension lacks removal version"
            )
        if removal is not None and deprecated is None:
            extension_errors.append(
                f"extension {extension_id}: removal version requires deprecated_at"
            )
        if deprecated is not None and removal is not None and removal <= deprecated:
            extension_errors.append(
                f"extension {extension_id}: removal version must follow deprecated_at"
            )
        successor = extension.get("successor")
        if deprecated is not None and removal is not None and successor is None:
            extension_errors.append(
                f"extension {extension_id}: planned removal requires a successor"
            )
        if successor == extension_id:
            extension_errors.append(
                f"extension {extension_id}: successor cannot reference itself"
            )
        elif successor is not None and successor not in known_extension_ids:
            extension_errors.append(
                f"extension {extension_id}: unresolved successor {successor}"
            )
        if (
            removal is not None
            and current_core is not None
            and current_core >= removal
        ):
            extension_errors.append(
                f"extension {extension_id}: remains registered at or after its "
                "removal version"
            )
        errors.extend(extension_errors)
        if not extension["enabled"] or extension_errors:
            continue
        before = snapshot_files(root)
        with tempfile.TemporaryDirectory(
            prefix="harness-extension-environment-"
        ) as temporary:
            temporary_home = Path(temporary)
            try:
                result = subprocess.run(
                    [
                        sys.executable,
                        "-I",
                        "-B",
                        extension["validator"],
                        "--config",
                        extension["config"],
                    ],
                    cwd=root,
                    capture_output=True,
                    text=True,
                    check=False,
                    timeout=30,
                    env=least_extension_environment(temporary_home),
                )
            except subprocess.TimeoutExpired:
                errors.append(f"extension {extension_id}: validator timed out")
                continue
            except OSError:
                errors.append(f"extension {extension_id}: validator could not execute")
                continue
            temporary_writes = [
                path for path in temporary_home.rglob("*") if path.is_file()
            ]
            if temporary_writes:
                errors.append(
                    f"extension {extension_id}: validator wrote outside repository "
                    "to its isolated temporary environment"
                )
        after = snapshot_files(root)
        if before != after:
            changed = sorted(set(before) ^ set(after))
            changed.extend(
                path
                for path in sorted(set(before) & set(after))
                if before[path] != after[path]
            )
            errors.append(
                f"extension {extension_id}: validator changed repository files: "
                + ", ".join(changed[:10])
            )
        try:
            response = loads_json(result.stdout)
        except (ValueError, json.JSONDecodeError):
            errors.append(f"extension {extension_id}: validator returned invalid JSON")
            continue
        if (
            not isinstance(response, dict)
            or response.get("schema_version") != "harness.extension-findings.v1"
            or response.get("extension_id") != extension_id
            or not isinstance(response.get("findings"), list)
        ):
            errors.append(f"extension {extension_id}: invalid validator response")
            continue
        finding_errors: list[str] = []
        finding_keys: set[tuple[Any, Any]] = set()
        for index, finding in enumerate(response["findings"]):
            finding_errors.extend(
                f"extension {extension_id}: finding[{index}] {item}"
                for item in validate_schema(
                    finding,
                    {"$ref": "#/$defs/finding"},
                    root_schema=finding_schema,
                )
            )
            if isinstance(finding, dict):
                key = (finding.get("code"), finding.get("path"))
                if key in finding_keys:
                    finding_errors.append(
                        f"extension {extension_id}: duplicate finding identity"
                    )
                finding_keys.add(key)
        if finding_errors:
            errors.extend(finding_errors)
            continue
        if result.returncode not in {0, 1}:
            errors.append(f"extension {extension_id}: validator execution failed")
        reports_error = any(
            isinstance(item, dict) and item.get("severity") == "error"
            for item in response["findings"]
        )
        if reports_error:
            errors.append(f"extension {extension_id}: validator reported errors")
        if (result.returncode == 1) != reports_error:
            errors.append(
                f"extension {extension_id}: return code/findings severity mismatch"
            )
    return errors


def check_packages(root: Path) -> list[str]:
    path = root / ".agent/packages.json"
    try:
        registry = load_json(path)
        schema = load_schema(root, "harness-package-registry.schema.json")
        project = load_json(root / ".agent/project.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/packages.json: {error}"]
    errors = [
        f".agent/packages.json: {item}" for item in validate_schema(registry, schema)
    ]
    if not isinstance(registry, dict) or not isinstance(project, dict):
        return errors
    installed = {
        item.get("id"): item
        for item in registry.get("packages", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    if len(installed) != len(registry.get("packages", [])):
        errors.append(".agent/packages.json: package IDs must be unique")
    try:
        available_catalog = load_json(root / ".agent/available-packages/catalog.json")
    except (OSError, ValueError, json.JSONDecodeError):
        available_contracts = {}
    else:
        available_contracts = {
            item.get("id"): item
            for item in available_catalog.get("packages", [])
            if isinstance(item, dict) and isinstance(item.get("id"), str)
        } if isinstance(available_catalog, dict) else {}
    capabilities_root = root / ".agent/capabilities"
    expected_capability_paths = {
        relative
        for item in installed.values()
        if item.get("kind") == "workflow_capability"
        for relative in item.get("installed_paths", [])
        if isinstance(relative, str)
    }
    if capabilities_root.exists() or capabilities_root.is_symlink():
        if capabilities_root.is_symlink() or not capabilities_root.is_dir():
            errors.append(".agent/capabilities: capability root is unsafe")
        else:
            observed_capability_paths = {
                path.relative_to(root).as_posix()
                for path in capabilities_root.rglob("*")
                if path.is_file() or path.is_symlink()
            }
            for relative in sorted(observed_capability_paths - expected_capability_paths):
                errors.append(
                    f".agent/capabilities: unregistered capability payload path: {relative}"
                )
    for package_id, item in installed.items():
        if package_id in {"autonomous-delivery", "long-running-work"}:
            available = available_contracts.get(package_id, {})
            if item.get("version") != available.get("version") or item.get("sha256") != available.get("source_sha256"):
                errors.append(f".agent/packages.json: {package_id} differs from the exact offline source contract")
        digest = hashlib.sha256()
        for relative_path in item.get("installed_paths", []):
            candidate, path_error = safe_relative_path(root, relative_path, must_exist=True)
            if path_error or candidate is None or (root / candidate).is_symlink():
                errors.append(f".agent/packages.json: {package_id} installed path is absent or unsafe: {relative_path}")
                continue
            installed_path = root / candidate
            if not installed_path.is_file():
                errors.append(f".agent/packages.json: {package_id} installed path is not a regular file: {relative_path}")
                continue
            digest.update(relative_path.encode("utf-8"))
            digest.update(b"\0")
            digest.update(installed_path.read_bytes())
            digest.update(b"\0")
        if digest.hexdigest() != item.get("installed_paths_sha256"):
            errors.append(f".agent/packages.json: {package_id} installed content digest is stale")
        receipt_ref = item.get("validation_receipt_ref")
        active_receipt = os.environ.get("OCTON_MINI_ACTIVE_TRANSACTION_RECEIPT")
        receipt_path = root / ".agent/transactions/receipts" / f"{receipt_ref}.json"
        receipt_valid = False
        if receipt_ref == active_receipt:
            receipt_valid = True
        elif isinstance(receipt_ref, str) and receipt_path.is_file() and not receipt_path.is_symlink():
            try:
                receipt = load_json(receipt_path)
                receipt_valid = (
                    isinstance(receipt, dict)
                    and receipt.get("receipt_id") == receipt_ref
                    and receipt.get("operation") in {"maintain.package.install", "maintain.package.update", "delivery.activate"}
                    and receipt.get("status") == "applied"
                    and all(
                        result.get("exit_code") == 0
                        for result in receipt.get("validation", [])
                        if isinstance(result, dict)
                    )
                )
            except (OSError, ValueError, json.JSONDecodeError):
                receipt_valid = False
        if not receipt_valid or receipt_ref not in item.get("evidence_refs", []):
            errors.append(f".agent/packages.json: {package_id} lacks its successful transaction validation receipt")
    package_contract = project.get("packages", {})
    assessments = package_contract.get("trigger_assessments", {}) if isinstance(package_contract, dict) else {}
    for package_id, fact_id in (
        ("operations-observability", "operations_observability"),
        ("security-supply-chain", "security_supply_chain"),
        ("long-running-work", "long_running_work"),
        ("autonomous-delivery", "autonomous_delivery"),
    ):
        status = assessments.get(fact_id) if isinstance(assessments, dict) else None
        if status == "applicable" and package_id not in installed:
            errors.append(f".agent/packages.json: applicable trigger lacks installed package {package_id}")
        if status != "applicable" and package_id in installed:
            errors.append(f".agent/packages.json: {package_id} is installed without an applicable trigger")
    scm = load_json(root / ".agent/scm.json")
    git_installed = "small-team-git-portfolio" in installed
    if isinstance(scm, dict) and ((scm.get("selection") == "git") != git_installed):
        errors.append(".agent/packages.json: Git package installation differs from SCM selection")
    long_running = installed.get("long-running-work")
    if isinstance(long_running, dict):
        validator_path = root / ".agent/capabilities/long-running-work/validate.py"
        if not validator_path.is_file() or validator_path.is_symlink():
            errors.append(".agent/packages.json: long-running-work validator is absent or unsafe")
        else:
            environment = {
                key: os.environ[key]
                for key in ("PATH", "SYSTEMROOT", "WINDIR", "TEMP", "TMP", "TMPDIR")
                if key in os.environ
            }
            environment.update({
                "PYTHONIOENCODING": "utf-8",
                "PYTHONDONTWRITEBYTECODE": "1",
                "LANG": "C.UTF-8",
                "LC_ALL": "C.UTF-8",
            })
            result = subprocess.run(
                [sys.executable, "-I", "-B", str(validator_path), "--check", "--json"],
                cwd=root,
                env=environment,
                capture_output=True,
                text=True,
                check=False,
                shell=False,
            )
            try:
                report = json.loads(result.stdout) if result.stdout else {}
            except json.JSONDecodeError:
                report = {}
            if result.returncode != 0 or report.get("result") != "pass":
                errors.append(".agent/packages.json: long-running-work package state validation failed")
                for finding in report.get("findings", []) if isinstance(report, dict) else []:
                    if isinstance(finding, str) and finding:
                        errors.append(f".agent/packages.json: long-running-work: {finding}")
    else:
        state_root = root / ".agent/work-runs"
        if state_root.exists() or state_root.is_symlink():
            if state_root.is_symlink() or not state_root.is_dir():
                errors.append(".agent/work-runs: uninstalled package state root is unsafe")
            elif any(path.is_file() or path.is_symlink() for path in state_root.rglob("*")):
                errors.append(".agent/work-runs: retained state exists without the installed owning package")
    autonomous = installed.get("autonomous-delivery")
    if isinstance(autonomous, dict):
        validator_path = root / ".agent/capabilities/autonomous-delivery/validate.py"
        if not validator_path.is_file() or validator_path.is_symlink():
            errors.append(".agent/packages.json: autonomous-delivery validator is absent or unsafe")
        else:
            result = subprocess.run(
                [sys.executable, "-I", "-B", str(validator_path)],
                cwd=root,
                env={key: os.environ[key] for key in ("PATH", "SYSTEMROOT", "WINDIR", "TEMP", "TMP", "TMPDIR") if key in os.environ},
                capture_output=True,
                text=True,
                check=False,
                shell=False,
            )
            if result.returncode != 0:
                errors.append(".agent/packages.json: autonomous-delivery package validation failed")
    return errors


def check_transactions(root: Path) -> list[str]:
    """Validate durable plans/receipts and surface interrupted applies."""
    transaction_root = root / ".agent/transactions"
    if not transaction_root.exists():
        return []
    try:
        schema = load_schema(root, "harness-transaction.schema.json")
        successor_schema = load_schema(root, "harness-transaction-v3.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f".agent/transactions: {error}"]
    definitions = schema.get("$defs", {}) if isinstance(schema, dict) else {}
    errors: list[str] = []
    groups = (
        ("plans", "plan"),
        ("receipts", "receipt"),
        ("pending", "pending"),
        ("recovered", "recovery"),
    )
    for directory_name, definition_name in groups:
        directory = transaction_root / directory_name
        if not directory.exists():
            continue
        if directory.is_symlink() or not directory.is_dir():
            errors.append(f".agent/transactions/{directory_name}: expected a real directory")
            continue
        definition = definitions.get(definition_name)
        if not isinstance(definition, dict):
            errors.append(f".agent/transactions: schema lacks {definition_name} definition")
            continue
        for path in sorted(directory.glob("*.json")):
            location = relative(path, root)
            if path.is_symlink() or not path.is_file():
                errors.append(f"{location}: transaction artifact must be a regular file")
                continue
            try:
                value = load_json(path)
            except (OSError, ValueError, json.JSONDecodeError) as error:
                errors.append(f"{location}: {error}")
                continue
            definition = definitions.get(definition_name)
            active_schema = schema
            active_definitions = definitions
            if isinstance(value, dict) and value.get("schema_version") in {
                "harness.transaction-plan.v3",
                "harness.transaction-receipt.v3",
            }:
                active_schema = successor_schema
                active_definitions = successor_schema.get("$defs", {})
                definition = active_definitions.get(definition_name)
                if not isinstance(definition, dict):
                    errors.append(f"{location}: successor transaction schema lacks {definition_name} definition")
                    continue
            errors.extend(
                f"{location}: {item}"
                for item in validate_schema(
                    value,
                    definition,
                    root_schema=active_schema,
                )
            )
            if not isinstance(value, dict):
                continue
            if definition_name == "plan":
                unsigned = dict(value)
                digest = unsigned.pop("canonical_plan_digest", None)
                expected = hashlib.sha256(
                    json.dumps(
                        unsigned,
                        ensure_ascii=False,
                        allow_nan=False,
                        sort_keys=True,
                        separators=(",", ":"),
                    ).encode("utf-8")
                ).hexdigest()
                if digest != expected:
                    errors.append(f"{location}: canonical plan digest is invalid")
            if definition_name == "receipt" and value.get("status") == "rollback_in_progress":
                errors.append(
                    f"{location}: interrupted rollback requires explicit retry with this receipt"
                )
            for item in value.get("paths", []):
                if not isinstance(item, dict):
                    continue
                before = item.get("before")
                after = item.get("after")
                if isinstance(before, dict) and before.get("path") != item.get("path"):
                    errors.append(f"{location}: receipt before-state path differs from entry")
                if isinstance(after, dict):
                    errors.extend(
                        f"{location}: after {detail}"
                        for detail in validate_schema(
                            after,
                            active_definitions.get("path_state", {}),
                            root_schema=active_schema,
                        )
                    )
                    if after.get("path") != item.get("path"):
                        errors.append(f"{location}: receipt after-state path differs from entry")
            if definition_name == "pending":
                # The transaction engine keeps its write-ahead journal present
                # through read-only post-apply validation. Suppress only the
                # exact, digest-bound journal declared by that engine process;
                # ordinary `./octon check` calls still surface every pending apply.
                active_receipt = os.environ.get(
                    "OCTON_MINI_ACTIVE_TRANSACTION_RECEIPT"
                )
                active_digest = os.environ.get(
                    "OCTON_MINI_ACTIVE_TRANSACTION_PLAN_DIGEST"
                )
                active_location = (
                    f".agent/transactions/pending/{active_receipt}.json"
                    if active_receipt
                    else None
                )
                if not (
                    location == active_location
                    and value.get("receipt_id") == active_receipt
                    and value.get("plan_digest") == active_digest
                ):
                    errors.append(
                        f"{location}: pending transaction requires explicit interruption recovery"
                    )
    return errors


def check_transaction_findings(root: Path) -> list[dict[str, Any]]:
    """Split transaction findings by the owning durable artifact boundary."""
    findings: list[dict[str, Any]] = []
    for message in check_transactions(root):
        location = message.partition(":")[0]
        if location == ".agent/transactions/plans" or location.startswith(
            ".agent/transactions/plans/"
        ):
            findings.append(
                {
                    "failure_code": "OCTON-DIAG-0601",
                    "message": safe_diagnostic(message),
                    "next_argv": ["./octon", "--help"],
                }
            )
            continue
        finding: dict[str, Any] = {
            "failure_code": "OCTON-DIAG-0602",
            "message": safe_diagnostic(message),
        }
        if re.fullmatch(
            r"\.agent/transactions/pending/RCPT-[a-f0-9]{24}\.json",
            location,
        ):
            finding["next_argv"] = [
                "./octon",
                "transaction",
                "recover",
                "--pending",
                location,
            ]
        elif (
            re.fullmatch(
                r"\.agent/transactions/receipts/RCPT-[a-f0-9]{24}\.json",
                location,
            )
            and "interrupted rollback" in message
        ):
            finding["next_argv"] = [
                "./octon",
                "transaction",
                "rollback",
                "--receipt",
                location,
            ]
        findings.append(finding)
    return findings


def expected_manifest_files(root: Path) -> dict[str, str]:
    return source_inventory(root)[0]


def parse_checksums(path: Path) -> tuple[dict[str, str], list[str]]:
    values: dict[str, str] = {}
    errors: list[str] = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        match = re.fullmatch(r"([a-f0-9]{64})  ([^\n]+)", line)
        if not match:
            errors.append(f"project-dossier/CHECKSUMS.sha256:{number}: invalid line")
            continue
        digest, target = match.groups()
        _, path_error = safe_relative_path(
            path.parent.parent,
            target,
            allowed_prefixes=("project-dossier",),
            must_exist=True,
        )
        if (
            path_error
            or target == "project-dossier/CHECKSUMS.sha256"
            or (path.parent.parent / target).is_symlink()
        ):
            errors.append(
                f"project-dossier/CHECKSUMS.sha256:{number}: unsafe or absent path"
            )
            continue
        if target in values:
            errors.append(f"project-dossier/CHECKSUMS.sha256:{number}: duplicate path")
        values[target] = digest
    return values, errors


def check_integrity(root: Path, include_generated: bool = True) -> list[str]:
    errors: list[str] = []
    manifest_path = root / "project-dossier" / "MANIFEST.json"
    try:
        manifest = load_json(manifest_path)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f"project-dossier/MANIFEST.json: {error}"]
    if not isinstance(manifest, dict):
        return ["project-dossier/MANIFEST.json: expected object"]
    required_manifest_fields = {
        "schema_version",
        "generation_id",
        "generated_on",
        "octon_mini_version",
        "profile",
        "harness_kernel_version",
        "authority",
        "source_fingerprint",
        "source_scope",
        "files",
    }
    if set(manifest) != required_manifest_fields:
        errors.append("project-dossier/MANIFEST.json: invalid field contract")
    if manifest.get("schema_version") != "project-dossier.manifest.v1":
        errors.append("project-dossier/MANIFEST.json: invalid schema version")
    if not re.fullmatch(r"[a-f0-9]{32}", str(manifest.get("generation_id", ""))):
        errors.append("project-dossier/MANIFEST.json: invalid generation ID")
    try:
        generated_on = datetime.fromisoformat(
            str(manifest.get("generated_on", "")).replace("Z", "+00:00")
        )
        if generated_on.tzinfo is None:
            raise ValueError("timezone required")
    except ValueError:
        errors.append("project-dossier/MANIFEST.json: invalid generated_on")
    origin: dict[str, Any] = {}
    try:
        origin_value = load_json(root / ".octon-mini-origin.json")
        if not isinstance(origin_value, dict):
            raise ValueError("origin must be an object")
        origin = origin_value
        if (
            manifest.get("octon_mini_version") != origin.get("octon_mini_version")
            or manifest.get("profile") != origin.get("profile")
            or manifest.get("harness_kernel_version")
            != origin.get("harness_kernel_version")
        ):
            errors.append("project-dossier/MANIFEST.json: origin metadata mismatch")
        profile = origin.get("profile")
    except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError):
        profile = None
    expected_files, expected_fingerprint = source_inventory(root)
    if manifest.get("source_fingerprint") != expected_fingerprint:
        errors.append("project-dossier/MANIFEST.json: stale source fingerprint")
    try:
        project_scope = load_json(root / ".agent/project.json")
        expected_exclusions = (
            project_scope.get("paths", {}).get("fingerprint_exclusions", [])
            if isinstance(project_scope, dict)
            and isinstance(project_scope.get("paths"), dict)
            else []
        )
    except (OSError, ValueError, json.JSONDecodeError):
        expected_exclusions = []
    expected_source_scope = {
        "model": "repository_paths_excluding_declared_exclusions_and_git_metadata",
        "exclusions": expected_exclusions,
        "git_metadata": "excluded_from_source_fingerprint",
    }
    if manifest.get("source_scope") != expected_source_scope:
        errors.append("project-dossier/MANIFEST.json: source scope mismatch")
    listed: dict[str, str] = {}
    manifest_files = manifest.get("files", [])
    if not isinstance(manifest_files, list):
        errors.append("project-dossier/MANIFEST.json: files must be an array")
        manifest_files = []
    for index, item in enumerate(manifest_files):
        if not isinstance(item, dict) or set(item) != {"path", "layer", "sha256"}:
            errors.append(
                f"project-dossier/MANIFEST.json: files[{index}] invalid contract"
            )
            continue
        path_value = item.get("path")
        _, path_error = safe_relative_path(root, path_value, must_exist=True)
        if path_error:
            errors.append(
                f"project-dossier/MANIFEST.json: files[{index}] {path_error}"
            )
        if path_value in listed:
            errors.append(
                f"project-dossier/MANIFEST.json: duplicate file path {path_value}"
            )
        digest = item.get("sha256")
        if not isinstance(digest, str) or not re.fullmatch(r"[a-f0-9]{64}", digest):
            errors.append(
                f"project-dossier/MANIFEST.json: files[{index}] invalid digest"
            )
            continue
        expected_layer = (
            "agent_harness"
            if path_value == "AGENTS.md"
            or str(path_value).startswith((".agent/", ".agents/"))
            else "project_dossier"
            if str(path_value).startswith("project-dossier/")
            else "generation_provenance"
            if path_value == ".octon-mini-origin.json"
            else "project_source"
        )
        if item.get("layer") != expected_layer:
            errors.append(
                f"project-dossier/MANIFEST.json: files[{index}] layer mismatch"
            )
        if isinstance(path_value, str):
            listed[path_value] = digest
    expected = expected_files
    if listed != expected:
        errors.append("project-dossier/MANIFEST.json: file inventory or hashes are stale")

    checksum_path = root / "project-dossier" / "CHECKSUMS.sha256"
    if profile == "high-assurance" and not checksum_path.is_file():
        errors.append("project-dossier/CHECKSUMS.sha256: required by profile")
    if profile != "high-assurance" and checksum_path.exists():
        errors.append("project-dossier/CHECKSUMS.sha256: not declared by profile")
    if checksum_path.exists():
        checksums, checksum_errors = parse_checksums(checksum_path)
        errors.extend(checksum_errors)
        expected_checksums = {
            relative(path, root): hash_file(path)
            for path in sorted((root / "project-dossier").rglob("*"))
            if path.is_file() and path != checksum_path
        }
        if checksums != expected_checksums:
            errors.append("project-dossier/CHECKSUMS.sha256: stale or incomplete")

    if not include_generated:
        return errors
    generated = root / ".agent" / "generated"
    manifest_generated = generated / "manifest.json"
    report_path = generated / "validation-report.json"
    temporary = (
        sorted(
            path
            for path in generated.rglob("*")
            if path.name.endswith(".tmp") or path.name.startswith(".refresh-")
        )
        if generated.is_dir()
        else []
    )
    if temporary:
        errors.append(".agent/generated: interrupted refresh artifacts present")
    if profile == "high-assurance" and (
        not manifest_generated.is_file() or not report_path.is_file()
    ):
        errors.append(
            ".agent/generated: manifest and validation report required by profile"
        )
        return errors
    if profile != "high-assurance" and (
        manifest_generated.exists() or report_path.exists()
    ):
        errors.append(".agent/generated: integrity outputs not declared by profile")
        return errors
    if not manifest_generated.exists() and not report_path.exists():
        return errors
    if not manifest_generated.is_file() or not report_path.is_file():
        errors.append(".agent/generated: manifest and validation report must coexist")
        return errors
    try:
        generated_manifest = load_json(manifest_generated)
        report = load_json(report_path)
    except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError) as error:
        errors.append(f".agent/generated: {error}")
        return errors
    if not isinstance(generated_manifest, dict) or not isinstance(report, dict):
        errors.append(".agent/generated: manifest and report must be objects")
        return errors
    generation_ids = {
        manifest.get("generation_id"),
        generated_manifest.get("generation_id"),
        report.get("generation_id"),
    }
    if len(generation_ids) != 1 or None in generation_ids:
        errors.append("generated integrity files have mismatched generation IDs")
    for name, value in (
        (".agent/generated/manifest.json", generated_manifest),
        (".agent/generated/validation-report.json", report),
    ):
        if value.get("source_fingerprint") != expected_fingerprint:
            errors.append(f"{name}: stale source fingerprint")
        if value.get("authority") != "generated_non_authoritative_point_in_time":
            errors.append(f"{name}: invalid authority label")
        if value.get("source_scope") != expected_source_scope:
            errors.append(f"{name}: source scope mismatch")
    generated_manifest_fields = {
        "schema_version",
        "generator_version",
        "generation_id",
        "generated_at",
        "authority",
        "source_fingerprint",
        "source_scope",
        "managed_files",
        "limitations",
    }
    if (
        set(generated_manifest) != generated_manifest_fields
        or generated_manifest.get("schema_version")
        != "harness.generated-manifest.v1"
        or generated_manifest.get("generator_version")
        != origin.get("generator_version")
        or not re.fullmatch(
            r"[a-f0-9]{32}",
            str(generated_manifest.get("generation_id", "")),
        )
        or generated_manifest.get("managed_files") != sorted(expected)
        or not isinstance(generated_manifest.get("limitations"), list)
        or not generated_manifest.get("limitations")
        or not all(
            isinstance(item, str) and item
            for item in generated_manifest.get("limitations", [])
        )
    ):
        errors.append(".agent/generated/manifest.json: invalid metadata contract")
    try:
        generated_at = datetime.fromisoformat(
            str(generated_manifest.get("generated_at", "")).replace("Z", "+00:00")
        )
        if generated_at.tzinfo is None:
            raise ValueError("timezone required")
    except ValueError:
        errors.append(".agent/generated/manifest.json: invalid generated_at")
    enabled_extensions: list[str] = []
    extension_registry_path = root / ".agent/extensions/registry.json"
    if extension_registry_path.is_file():
        try:
            extension_registry = load_json(extension_registry_path)
            if isinstance(extension_registry, dict):
                enabled_extensions = [
                    str(item.get("id"))
                    for item in extension_registry.get("extensions", [])
                    if isinstance(item, dict) and item.get("enabled") is True
                ]
        except (ValueError, json.JSONDecodeError):
            pass
    checks = report.get("checks", [])
    expected_check_ids = {
        "pre_refresh_source_validation",
        "strict_json_and_duplicate_keys",
        "schemas_versions_lifecycles_and_references",
        "dependency_readiness_and_ready_frontier",
        "decision_governance_and_authority_reconciliation",
        "authority_and_nested_instruction_invariants",
        "dossier_artifact_registry",
        "extension_confinement_and_validator_protocol",
        "bounded_secret_heuristic_and_redaction",
    }
    well_shaped_checks = (
        isinstance(checks, list)
        and len(checks) == len(expected_check_ids)
        and all(
            isinstance(item, dict)
            and set(item) == {"id", "status"}
            and isinstance(item.get("id"), str)
            and isinstance(item.get("status"), str)
            for item in checks
        )
    )
    check_map = (
        {item["id"]: item["status"] for item in checks}
        if well_shaped_checks
        else {}
    )
    well_shaped_checks = (
        well_shaped_checks
        and len(check_map) == len(checks)
        and set(check_map) == expected_check_ids
    )
    non_extension_checks = expected_check_ids - {
        "extension_confinement_and_validator_protocol"
    }
    report_fields = {
        "schema_version",
        "validator_version",
        "generation_id",
        "generated_at",
        "authority",
        "source_fingerprint",
        "source_scope",
        "result",
        "checks",
        "failures",
        "skipped_checks",
        "scope",
        "environment",
        "git_scope",
        "task_and_decision_links",
        "external_effects",
        "freshness_rule",
        "limitations",
    }
    skipped_checks = report.get("skipped_checks", [])
    extension_skip = "extension validators: no adopted enabled extension"
    expected_extension_status = "pass" if enabled_extensions else "not_run"
    git_scope_value = report.get("git_scope", {})
    git_scope_values_valid = False
    if (
        isinstance(git_scope_value, dict)
        and set(git_scope_value)
        == {"available", "tracked_modified", "untracked", "ignored"}
        and isinstance(git_scope_value.get("available"), bool)
    ):
        count_values = [
            git_scope_value.get("tracked_modified"),
            git_scope_value.get("untracked"),
            git_scope_value.get("ignored"),
        ]
        git_scope_values_valid = (
            all(
                isinstance(item, int) and not isinstance(item, bool) and item >= 0
                for item in count_values
            )
            if git_scope_value["available"]
            else count_values == ["not_assessed", "not_assessed", "not_assessed"]
        )
    if (
        set(report) != report_fields
        or report.get("schema_version") != "harness.validation-report.v1"
        or report.get("validator_version") != KERNEL_VERSION
        or not re.fullmatch(r"[a-f0-9]{32}", str(report.get("generation_id", "")))
        or not well_shaped_checks
        or not isinstance(report.get("limitations"), list)
        or not report.get("limitations")
        or not all(
            isinstance(item, str) and item for item in report.get("limitations", [])
        )
        or not isinstance(report.get("environment"), dict)
        or set(report.get("environment", {})) != {"python", "platform"}
        or not all(
            isinstance(item, str) and item
            for item in report.get("environment", {}).values()
        )
        or not git_scope_values_valid
        or not isinstance(report.get("task_and_decision_links"), list)
        or not all(
            isinstance(item, str)
            for item in report.get("task_and_decision_links", [])
        )
        or report.get("failures") != []
        or not isinstance(skipped_checks, list)
        or not all(isinstance(item, str) and item for item in skipped_checks)
        or report.get("scope")
        != "pre_refresh_domain_neutral_source_validation"
        or report.get("external_effects")
        != "repository_local_derived_metadata_refresh_only"
        or report.get("freshness_rule")
        != "Invalid when any non-excluded repository source byte or path changes."
        or any(check_map.get(check_id) != "pass" for check_id in non_extension_checks)
        or check_map.get("extension_confinement_and_validator_protocol")
        != expected_extension_status
        or ((extension_skip in skipped_checks) != (not enabled_extensions))
    ):
        errors.append(
            ".agent/generated/validation-report.json: invalid metadata contract"
        )
    try:
        report_generated_at = datetime.fromisoformat(
            str(report.get("generated_at", "")).replace("Z", "+00:00")
        )
        if report_generated_at.tzinfo is None:
            raise ValueError("timezone required")
    except ValueError:
        errors.append(
            ".agent/generated/validation-report.json: invalid generated_at"
        )
    if (
        check_map.get("extension_confinement_and_validator_protocol")
        != expected_extension_status
    ):
        errors.append(
            ".agent/generated/validation-report.json: extension execution status "
            "overclaims or underreports"
        )
    if report.get("result") != "PASS":
        errors.append(".agent/generated/validation-report.json: result is not PASS")
    return errors


def git_scope(root: Path) -> dict[str, Any]:
    result = {
        "available": False,
        "tracked_modified": "not_assessed",
        "untracked": "not_assessed",
        "ignored": "not_assessed",
    }
    git_environment = {**os.environ, "GIT_OPTIONAL_LOCKS": "0"}
    try:
        probe = subprocess.run(
            ["git", "rev-parse", "--is-inside-work-tree"],
            cwd=root,
            capture_output=True,
            text=True,
            check=False,
            env=git_environment,
        )
    except OSError:
        return result
    if probe.returncode:
        return result
    result["available"] = True
    try:
        status = subprocess.run(
            ["git", "status", "--porcelain=v1", "--ignored"],
            cwd=root,
            capture_output=True,
            text=True,
            check=False,
            env=git_environment,
        )
    except OSError:
        return result
    tracked = untracked = ignored = 0
    if status.returncode == 0:
        for line in status.stdout.splitlines():
            if line.startswith("!!"):
                ignored += 1
            elif line.startswith("??"):
                untracked += 1
            else:
                tracked += 1
        result.update(
            tracked_modified=tracked,
            untracked=untracked,
            ignored=ignored,
        )
    return result


def check_decision_reuse(
    root: Path,
    records: dict[str, tuple[dict[str, Any], str]],
) -> list[str]:
    path = root / ".agent/decisions/reuse-policy.json"
    if not path.exists():
        return []
    location = ".agent/decisions/reuse-policy.json"
    try:
        value = load_json(path)
        schema = load_schema(root, "harness-decision-reuse.schema.json")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return [f"{location}: {error}"]
    errors = [
        f"{location}: {item}" for item in validate_schema(value, schema)
    ]
    if not isinstance(value, dict) or not isinstance(value.get("records"), list):
        return errors
    instruction_hash = hashlib.sha256()
    for instruction in sorted(
        item for item in root.rglob("AGENTS.md") if item.is_file() and not item.is_symlink()
    ):
        relative_path = instruction.relative_to(root).as_posix()
        instruction_hash.update(relative_path.encode("utf-8"))
        instruction_hash.update(b"\0")
        instruction_hash.update(instruction.read_bytes())
        instruction_hash.update(b"\0")
    current_instruction_digest = instruction_hash.hexdigest()
    now = datetime.now(timezone.utc)
    seen: set[str] = set()
    for index, policy in enumerate(value["records"]):
        item_location = f"{location}: records[{index}]"
        if not isinstance(policy, dict):
            continue
        policy_id = policy.get("id")
        if isinstance(policy_id, str):
            if policy_id in seen:
                errors.append(f"{item_location}: duplicate decision-reuse ID")
            seen.add(policy_id)
        if policy.get("status") != "active":
            continue
        if policy.get("governing_instruction_digest") != current_instruction_digest:
            errors.append(f"{item_location}: active reuse policy has stale governing instructions")
        expiry = policy.get("expires_at")
        valid_from = policy.get("valid_from")
        if isinstance(valid_from, str):
            try:
                if datetime.fromisoformat(valid_from.replace("Z", "+00:00")) > now:
                    errors.append(f"{item_location}: active reuse policy is not yet valid")
            except ValueError:
                pass
        if isinstance(expiry, str):
            try:
                if datetime.fromisoformat(expiry.replace("Z", "+00:00")) <= now:
                    errors.append(f"{item_location}: active reuse policy is expired")
            except ValueError:
                pass
        decision_ref = policy.get("decision_ref")
        decision_entry = records.get(decision_ref) if isinstance(decision_ref, str) else None
        if decision_entry is None:
            errors.append(f"{item_location}: accepted decision reference does not resolve")
            continue
        decision, decision_location = decision_entry
        if (
            decision.get("status") != "accepted"
            or decision.get("successor") is not None
            or decision.get("authority_source") != policy.get("authority_source")
        ):
            errors.append(f"{item_location}: decision is not current accepted authority")
        decision_path = root / decision_location
        if decision_path.is_file() and not decision_path.is_symlink():
            if hashlib.sha256(decision_path.read_bytes()).hexdigest() != policy.get("decision_sha256"):
                errors.append(f"{item_location}: decision fingerprint is stale")
    return errors


def _coded_findings(code: str, errors: list[str]) -> list[dict[str, str]]:
    return [
        {"failure_code": code, "message": safe_diagnostic(item)}
        for item in errors
    ]


def _unique_findings(
    findings: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    seen: set[str] = set()
    result: list[dict[str, Any]] = []
    for item in findings:
        message = item["message"]
        if message in seen:
            continue
        seen.add(message)
        result.append(item)
    return result


def check_source_findings(
    root: Path = ROOT,
    *,
    scan_repository_files: bool = True,
) -> list[dict[str, str]]:
    """Return source-owned stable categories before derived refresh."""
    findings: list[dict[str, str]] = []
    findings.extend(_coded_findings("OCTON-DIAG-0001", check_runtime()))
    if scan_repository_files:
        findings.extend(
            _coded_findings(
                "OCTON-DIAG-0201",
                check_files_and_json(root, include_derived=False),
            )
        )
    findings.extend(_coded_findings("OCTON-DIAG-0201", check_kernel(root)))
    findings.extend(
        _coded_findings("OCTON-DIAG-0202", check_project_check_evidence(root))
    )
    findings.extend(_coded_findings("OCTON-DIAG-0101", check_focus(root)))
    records, record_errors = collect_records(root)
    findings.extend(_coded_findings("OCTON-DIAG-0201", record_errors))
    findings.extend(_coded_findings("OCTON-DIAG-0201", check_origin(root, records)))
    findings.extend(
        _coded_findings("OCTON-DIAG-0401", check_collaboration_profile(root, records))
    )
    findings.extend(_coded_findings("OCTON-DIAG-0401", check_git_workflows(root, records)))
    findings.extend(
        _coded_findings("OCTON-DIAG-0201", check_references_and_lifecycle(root, records))
    )
    findings.extend(
        _coded_findings("OCTON-DIAG-0203", check_decision_governance(root, records))
    )
    findings.extend(_coded_findings("OCTON-DIAG-0203", check_decision_reuse(root, records)))
    findings.extend(_coded_findings("OCTON-DIAG-0201", check_maturity_assessments(records)))
    findings.extend(_coded_findings("OCTON-DIAG-0201", check_plan_and_traceability(records)))
    findings.extend(
        _coded_findings("OCTON-DIAG-0201", check_governance_semantics(root, records))
    )
    findings.extend(_coded_findings("OCTON-DIAG-0301", check_dossier_registry(root)))
    findings.extend(_coded_findings("OCTON-DIAG-0501", check_capabilities(root, records)))
    findings.extend(_coded_findings("OCTON-DIAG-0501", check_extensions(root, records)))
    findings.extend(_coded_findings("OCTON-DIAG-0501", check_packages(root)))
    findings.extend(check_transaction_findings(root))
    return _unique_findings(findings)


def check_sources(
    root: Path = ROOT,
    *,
    scan_repository_files: bool = True,
) -> list[str]:
    """Validate authoritative/project-maintained inputs before derived refresh."""
    return [
        item["message"]
        for item in check_source_findings(
            root,
            scan_repository_files=scan_repository_files,
        )
    ]


def check_findings(
    root: Path = ROOT,
    include_generated: bool = True,
) -> list[dict[str, str]]:
    # The complete file scan subsumes the source-only scan. Keeping the source
    # contract checks while enumerating repository payload once is material at
    # 10k+ files and does not narrow validation coverage.
    findings = check_source_findings(root, scan_repository_files=False)
    findings.extend(
        _coded_findings(
            "OCTON-DIAG-0101",
            check_files_and_json(root, include_derived=True),
        )
    )
    records, record_errors = collect_records(root)
    findings.extend(_coded_findings("OCTON-DIAG-0201", record_errors))
    findings.extend(_coded_findings("OCTON-DIAG-0101", check_current_state(root, records)))
    findings.extend(_coded_findings("OCTON-DIAG-0101", check_dossier_catalog(root)))
    if include_generated:
        findings.extend(
            _coded_findings(
                "OCTON-DIAG-0101",
                check_integrity(root, include_generated=True),
            )
        )
    return _unique_findings(findings)


def check(root: Path = ROOT, include_generated: bool = True) -> list[str]:
    return [
        item["message"]
        for item in check_findings(root, include_generated=include_generated)
    ]


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Read-only structural validation of the project foundation."
    )
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--check-sources", action="store_true")
    mode.add_argument("--ready-frontier", action="store_true")
    mode.add_argument("--assess-collaboration", action="store_true")
    args = parser.parse_args()
    if args.check_sources:
        errors = check_sources()
        for error in errors:
            print(f"[FAIL] {safe_diagnostic(error)}", file=sys.stderr)
        if errors:
            return 1
        print("[PASS] authoritative and project-maintained sources are structurally valid")
        print("[INFO] derived freshness and target-project readiness were not assessed")
        return 0
    if args.assess_collaboration:
        try:
            project = load_json(ROOT / ".agent/project.json")
            kernel_schema = load_schema(ROOT, "harness-kernel.schema.json")
        except (OSError, ValueError, json.JSONDecodeError) as error:
            print(f"[FAIL] .agent/project.json: {safe_diagnostic(error)}", file=sys.stderr)
            return 1
        schema_errors = validate_schema(
            project,
            {"$ref": "#/$defs/project"},
            root_schema=kernel_schema,
        )
        profile = project.get("collaboration_profile") if isinstance(project, dict) else None
        if isinstance(profile, dict) and profile.get("schema_version") == "harness.collaboration-profile.v2":
            try:
                collaboration_schema = load_schema(ROOT, "harness-collaboration-profile.schema.json")
                schema_errors.extend(validate_schema(profile, collaboration_schema))
            except (OSError, ValueError, json.JSONDecodeError) as error:
                schema_errors.append(str(error))
        if schema_errors or not isinstance(profile, dict):
            for error in schema_errors:
                print(f"[FAIL] .agent/project.json: {safe_diagnostic(error)}", file=sys.stderr)
            if not isinstance(profile, dict):
                print(
                    "[FAIL] .agent/project.json: collaboration_profile must be an object",
                    file=sys.stderr,
                )
            return 1
        report, report_errors = derive_collaboration_assessment(profile)
        for error in report_errors:
            print(f"[FAIL] {safe_diagnostic(error)}", file=sys.stderr)
        print(json.dumps(report, indent=2, sort_keys=True))
        return 1 if report_errors else 0
    if args.ready_frontier:
        errors = check_sources()
        for error in errors:
            print(f"[FAIL] {safe_diagnostic(error)}", file=sys.stderr)
        if errors:
            return 1
        records, record_errors = collect_records(ROOT)
        if record_errors:
            for error in record_errors:
                print(f"[FAIL] {safe_diagnostic(error)}", file=sys.stderr)
            return 1
        print(json.dumps(ready_frontier(records), indent=2, sort_keys=True))
        return 0
    errors = check()
    for error in errors:
        print(f"[FAIL] {safe_diagnostic(error)}", file=sys.stderr)
    if errors:
        return 1
    print("[PASS] harness and dossier structural contracts")
    print(
        "[INFO] structural/adoption conformance does not establish "
        "target-project readiness"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
