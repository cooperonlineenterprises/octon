class FinishError(ValueError):
    """The completion contract, reviewed plan, or observation is invalid."""

    failure_code = "OCTON-WORK-4001"
    repair_class = "manual_reconciliation_required"

    def __init__(self, value: str | dict[str, Any]):
        report = value if isinstance(value, dict) else transaction.CONTINUATION.finding(
            failure_code=self.failure_code,
            blocked_operation="work.finish",
            phase="plan",
            root_cause=str(value),
            authority_source="work_completion_plan_and_project_owned_governance",
            repair_class=self.repair_class,
            next_action=transaction.CONTINUATION.action(
                "Inspect current coded diagnostics before creating a successor completion plan.",
                ["./octon", "doctor", "--json"],
                read_only=True,
            ),
            safe_read_only_actions=[
                transaction.CONTINUATION.action(
                    "Inspect current structural state.",
                    ["./octon", "check", "--json"],
                    read_only=True,
                )
            ],
            successor_plan=True,
            successor_reason="A successor completion plan can be created only after its owning input or authority source is current.",
        )
        self.report = report
        super().__init__(str(report.get("root_cause", "work completion blocked")))


class FinishBlocked(FinishError):
    """A safe, resumable workflow reached a material stop condition."""

    failure_code = "OCTON-WORK-4002"
    repair_class = "project_action_required"


def named_operation(operation: str):
    """Attach the failing completion step without changing its error type."""
    def decorate(function):
        @wraps(function)
        def wrapped(*args, **kwargs):
            try:
                return function(*args, **kwargs)
            except FinishError as error:
                if not hasattr(error, "operation"):
                    error.operation = operation
                report = error.report
                report["blocked_operation"] = f"work.finish.{operation}"
                report["phase"] = "apply"
                report["authority_source"] = (
                    "current_runtime_authorization_and_work_completion_receipt"
                )
                report["mutation"] = {
                    "occurred": True,
                    "repository_paths": [],
                    "external_effects": [operation],
                    "statement": (
                        "A repository-mutating or externally observed completion step was attempted; its exact outcome must be recovered from the receipt and current state."
                    ),
                }
                receipt = next(
                    (
                        item
                        for item in args
                        if isinstance(item, dict)
                        and re.fullmatch(r"WCR-[a-f0-9]{24}", str(item.get("receipt_id")))
                    ),
                    None,
                )
                if receipt is not None:
                    receipt_id = str(receipt["receipt_id"])
                    report["preserved"] = [
                        transaction.CONTINUATION.proof_state(
                            "receipt",
                            receipt_id,
                            "The append-only completion receipt preserves observed progress for deterministic resume.",
                            ["re_observe_every_run", "source_fingerprint_bound"],
                        )
                    ]
                    report["next_action"] = transaction.CONTINUATION.action(
                        "Resume from the exact completion receipt after current authorization is revalidated.",
                        [
                            "./octon",
                            "work",
                            "finish",
                            "resume",
                            "--receipt-id",
                            receipt_id,
                        ],
                        read_only=False,
                        requires_confirmation=True,
                    )
                raise
        return wrapped
    return decorate


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")


def digest(value: object) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise FinishError(f"cannot load {path}: {error}") from error


def run(
    root: Path,
    argv: list[str],
    *,
    stdin: str | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[bytes]:
    environment = {**os.environ, "GIT_OPTIONAL_LOCKS": "0", "PYTHONDONTWRITEBYTECODE": "1"}
    try:
        result = subprocess.run(
            argv,
            cwd=root,
            input=stdin.encode("utf-8") if stdin is not None else None,
            capture_output=True,
            check=False,
            shell=False,
            env=environment,
        )
    except OSError as error:
        raise FinishBlocked(f"command could not start: {argv[0]}: {error}") from error
    if check and result.returncode:
        detail = result.stderr.decode("utf-8", errors="replace").strip()
        raise FinishBlocked(f"command failed ({result.returncode}): {' '.join(argv)}: {detail[:1000]}")
    return result


def text(result: subprocess.CompletedProcess[bytes]) -> str:
    return result.stdout.decode("utf-8", errors="strict").strip()


def git(root: Path, *arguments: str, check: bool = True) -> str:
    return text(run(root, ["git", *arguments], check=check))


def revision(root: Path, value: str) -> str:
    result = git(root, "rev-parse", "--verify", value)
    if REVISION.fullmatch(result) is None:
        raise FinishError(f"Git returned a malformed revision for {value}")
    return result


def safe_path(value: str) -> str:
    if not isinstance(value, str):
        raise FinishError("completion paths must be strings")
    candidate = PurePosixPath(value)
    if (
        not value
        or "\\" in value
        or "\x00" in value
        or candidate.is_absolute()
        or candidate.as_posix() != value
        or any(part in {"", ".", ".."} for part in candidate.parts)
        or value == ".git"
        or value.startswith(".git/")
    ):
        raise FinishError(f"unsafe completion path: {value!r}")
    return value


def string_inventory(value: Any, label: str, *, allow_empty: bool = True) -> list[str]:
    if (
        not isinstance(value, list)
        or any(not isinstance(item, str) or not item.strip() for item in value)
        or len(value) != len(set(value))
        or (not allow_empty and not value)
    ):
        qualifier = "nonempty, " if not allow_empty else ""
        raise FinishError(f"{label} must be a {qualifier}unique string array")
    return sorted(value)


def parse_record(path: Path) -> dict[str, Any]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
        end = lines.index("---", 1)
        value = json.loads("\n".join(lines[1:end]))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        raise FinishError(f"cannot parse canonical record {path}: {error}") from error
    if not lines or lines[0] != "---" or not isinstance(value, dict):
        raise FinishError(f"canonical record is malformed: {path}")
    return value


def task_candidates(root: Path) -> list[tuple[Path, dict[str, Any]]]:
    values: list[tuple[Path, dict[str, Any]]] = []
    for path in sorted((root / ".agent/tasks").glob("TASK-*.md")):
        record = parse_record(path)
        if (
            TASK_ID.fullmatch(str(record.get("id")))
            and record.get("status") == "completed"
            and isinstance(record.get("work_completion"), dict)
        ):
            values.append((path, record))
    return values


def closure_transaction(
    root: Path,
    task_path: Path,
    dirty: list[str],
) -> tuple[dict[str, Any] | None, list[str]]:
    """Bind exact current work.close evidence without hiding unrelated dirt."""
    relative_task = task_path.relative_to(root).as_posix()
    candidates: list[tuple[datetime, Path, dict[str, Any]]] = []
    receipt_root = root / ".agent/transactions/receipts"
    if not receipt_root.is_dir() or receipt_root.is_symlink():
        return None, []
    for path in sorted(receipt_root.glob("RCPT-*.json")):
        if path.is_symlink() or not path.is_file():
            continue
        value = load_json(path)
        receipt_schema = value.get("schema_version") if isinstance(value, dict) else None
        expected_receipt_fields = (
            TRANSACTION_RECEIPT_V3_FIELDS
            if receipt_schema == "harness.transaction-receipt.v3"
            else TRANSACTION_RECEIPT_V2_FIELDS
        )
        if (
            not isinstance(value, dict)
            or set(value) != expected_receipt_fields
            or receipt_schema not in {
                "harness.transaction-receipt.v2",
                "harness.transaction-receipt.v3",
            }
            or value.get("artifact_kind") != "transaction_receipt"
            or value.get("permission_grant") is not False
            or value.get("operation") != "work.close"
            or value.get("status") != "applied"
            or re.fullmatch(r"RCPT-[a-f0-9]{24}", str(value.get("receipt_id"))) is None
            or path.stem != value.get("receipt_id")
            or re.fullmatch(r"[a-f0-9]{64}", str(value.get("plan_digest"))) is None
            or not isinstance(value.get("created_directories"), list)
            or not isinstance(value.get("validation"), list)
            or value.get("rollback")
            != {
                "available": True,
                "refuse_if_post_apply_changed": True,
                "command": [
                    "python",
                    "-B",
                    ".agent/scripts/octon.py",
                    "transaction",
                    "rollback",
                    "--receipt",
                    f".agent/transactions/receipts/{value.get('receipt_id')}.json",
                ],
            }
        ):
            continue
        paths = value.get("paths")
        if (
            not isinstance(paths, list)
            or not paths
            or any(
                not isinstance(item, dict)
                or set(item) != {"path", "before", "after", "before_content_base64"}
                or not isinstance(item.get("path"), str)
                or not isinstance(item.get("before"), dict)
                or not isinstance(item.get("after"), dict)
                or item["before"].get("path") != item["path"]
                or item["after"].get("path") != item["path"]
                for item in paths
            )
            or len({item["path"] for item in paths}) != len(paths)
        ):
            continue
        task_entries = [
            item
            for item in paths
            if isinstance(item, dict) and item.get("path") == relative_task
        ]
        if len(task_entries) != 1:
            continue
        try:
            applied_at = parse_timestamp(
                value.get("applied_at"), "closure receipt application time"
            )
        except FinishBlocked:
            continue
        if transaction.path_state(root, relative_task) != task_entries[0].get("after"):
            continue
        candidates.append((applied_at, path, value))
    if not candidates:
        return None, []
    candidates.sort(key=lambda item: item[0], reverse=True)
    if len(candidates) > 1 and candidates[0][0] == candidates[1][0]:
        raise FinishBlocked("current task has ambiguous work.close receipt evidence")
    _applied_at, receipt_path, receipt = candidates[0]
    included: list[str] = []
    for item in receipt["paths"]:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            raise FinishBlocked("closure receipt path evidence is malformed")
        relative = safe_path(item["path"])
        if transaction.path_state(root, relative) != item.get("after"):
            raise FinishBlocked(
                f"closure transaction postimage changed after apply: {relative}"
            )
        if relative in dirty:
            included.append(relative)
    receipt_relative = receipt_path.relative_to(root).as_posix()
    if receipt_relative not in dirty:
        raise FinishBlocked("current closure receipt is absent from the dirty inventory")
    included.append(receipt_relative)
    included = sorted(set(included))
    return {
        "receipt_ref": receipt["receipt_id"],
        "path": receipt_relative,
        "applied_at": receipt["applied_at"],
        "included_dirty_paths": included,
    }, included


def dirty_state(root: Path) -> tuple[list[str], list[str]]:
    result = run(
        root,
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
    )
    dirty: list[str] = []
    staged: list[str] = []
    entries = result.stdout.split(b"\0")
    for raw in entries:
        if not raw:
            continue
        if len(raw) < 4 or raw[2:3] != b" ":
            raise FinishError("Git status returned an unrecognized entry")
        xy = raw[:2].decode("ascii", errors="strict")
        if any(character in xy for character in "URC"):
            raise FinishBlocked("conflicted, renamed, or copied paths require explicit resolution before planning")
        path = safe_path(raw[3:].decode("utf-8", errors="strict"))
        if xy[0] not in {" ", "?"}:
            staged.append(path)
        if xy == "??" or xy[1] != " ":
            dirty.append(path)
    return sorted(set(dirty)), sorted(set(staged))


def blob_state(root: Path, path: str, *, worktree: bool) -> tuple[str, str | None]:
    target = root / path
    if worktree:
        if target.is_symlink() or (target.exists() and not target.is_file()):
            raise FinishBlocked(f"completion path is not a regular file: {path}")
        if not target.exists():
            return "absent", None
        return "file", hashlib.sha256(target.read_bytes()).hexdigest()
    result = run(root, ["git", "show", f"HEAD:{path}"], check=False)
    if result.returncode:
        return "absent", None
    return "file", hashlib.sha256(result.stdout).hexdigest()


def filtered_worktree_blob_state(
    root: Path, path: str
) -> tuple[str, str | None]:
    target = root / path
    if not target.exists():
        return "absent", None
    result = run(
        root,
        ["git", "hash-object", f"--path={path}", "--", path],
    )
    object_id = text(result)
    if REVISION.fullmatch(object_id) is None:
        raise FinishBlocked(f"Git returned a malformed filtered blob identity: {path}")
    return "file", object_id


def path_precondition(root: Path, path: str) -> dict[str, Any]:
    worktree_state, worktree_hash = blob_state(root, path, worktree=True)
    index_state, index_hash = blob_state(root, path, worktree=False)
    git_blob_state, git_blob_oid = filtered_worktree_blob_state(root, path)
    if git_blob_state != worktree_state:
        raise FinishBlocked(f"Git-filtered state differs from the worktree: {path}")
    return {
        "path": path,
        "worktree_state": worktree_state,
        "worktree_sha256": worktree_hash,
        "git_blob_state": git_blob_state,
        "git_blob_oid": git_blob_oid,
        "index_state": index_state,
        "index_sha256": index_hash,
    }


def source_fingerprint(root: Path, paths: list[Path]) -> str:
    value = hashlib.sha256()
    for path in sorted(paths):
        relative = path.relative_to(root).as_posix()
        value.update(relative.encode("utf-8"))
        value.update(b"\0")
        value.update(path.read_bytes())
        value.update(b"\0")
    instruction = transaction.instruction_fingerprint(root)
    value.update(canonical_bytes(instruction))
    return value.hexdigest()


def stored_plan_digest(plan: dict[str, Any]) -> str:
    unsigned = dict(plan)
    supplied = unsigned.pop("canonical_plan_digest", None)
    calculated = digest(unsigned)
    if supplied != calculated:
        raise FinishError("work-completion plan digest is internally inconsistent")
    return calculated


def remote_tracking_revision(root: Path, remote: str, branch: str) -> str | None:
    result = run(
        root,
        ["git", "rev-parse", "--verify", f"refs/remotes/{remote}/{branch}"],
        check=False,
    )
    if result.returncode:
        return None
    value = text(result)
    if REVISION.fullmatch(value) is None:
        raise FinishBlocked("remote-tracking state contains a malformed revision")
    return value


def accepted_decision(root: Path, decision_ref: str) -> Path:
    candidates = sorted((root / ".agent/decisions").glob(f"{decision_ref}*.md"))
    if len(candidates) != 1:
        raise FinishBlocked(f"adopted workflow authority is missing or ambiguous: {decision_ref}")
    record = parse_record(candidates[0])
    if record.get("id") != decision_ref or record.get("status") != "accepted":
        raise FinishBlocked(f"workflow authority is not currently accepted: {decision_ref}")
    return candidates[0]


def worktree_branch_owners(root: Path) -> dict[str, str]:
    output = git(root, "worktree", "list", "--porcelain")
    owners: dict[str, str] = {}
    location: str | None = None
    for line in output.splitlines():
        if line.startswith("worktree "):
            location = line.removeprefix("worktree ")
        elif line.startswith("branch refs/heads/") and location:
            owners[line.removeprefix("branch refs/heads/")] = location
    return owners


def git_hook_observation(root: Path, policy: Any) -> dict[str, Any]:
    if policy != "require_none":
        raise FinishBlocked("work completion requires an explicit no-active-Git-hooks policy")
    monitor_result = run(
        root, ["git", "config", "--get", "core.fsmonitor"], check=False
    )
    if monitor_result.returncode not in {0, 1}:
        raise FinishBlocked("core.fsmonitor state could not be observed safely")
    monitor = text(monitor_result).strip().casefold() if monitor_result.returncode == 0 else ""
    if monitor not in {"", "false", "0", "no", "off"}:
        raise FinishBlocked(
            "active core.fsmonitor is unsupported because planning must not invoke hidden hooks or daemons"
        )
    configured_result = run(
        root,
        ["git", "config", "--path", "--get", "core.hooksPath"],
        check=False,
    )
    if configured_result.returncode not in {0, 1}:
        raise FinishBlocked("core.hooksPath state could not be observed safely")
    configured = text(configured_result) if configured_result.returncode == 0 else ""
    configured_hash = (
        hashlib.sha256(configured.encode("utf-8")).hexdigest()
        if configured
        else None
    )
    if configured:
        candidate = Path(configured)
        hook_root = candidate if candidate.is_absolute() else root / candidate
    else:
        hook_root = transaction.git_common_directory(root) / "hooks"
    if hook_root.is_symlink():
        state = "unsafe_symlink"
        active = ["<symlinked-hook-directory>"]
    elif not hook_root.exists():
        state = "absent"
        active = []
    elif not hook_root.is_dir():
        state = "non_directory"
        active = []
    else:
        state = "directory"
        active = sorted(
            item.name
            for item in hook_root.iterdir()
            if not item.name.endswith(".sample")
        )
    return {
        "policy": "require_none",
        "configured_path_sha256": configured_hash,
        "hook_directory_state": state,
        "active_hook_names": active,
        "fsmonitor": "disabled_or_absent",
    }


def build_plan(root: Path, task_id: str | None = None) -> dict[str, Any]:
    project_path = root / ".agent/project.json"
    workflow_path = root / ".agent/workflows/small-team-git.json"
    tools_path = root / ".agent/tools.json"
    project = load_json(project_path)
    if not isinstance(project, dict):
        raise FinishError("project contract must be an object")
    config = project.get("work_completion")
    if not isinstance(config, dict) or config.get("status") != "enabled":
        raise FinishBlocked("work completion is disabled; explicit project adoption is required")
    if config.get("permission_grant") is not False:
        raise FinishError("work-completion configuration cannot grant permission")
    hook_observation = git_hook_observation(root, config.get("git_hooks"))
    completion_hook = config.get("completion_hook", {})
    if completion_hook.get("mode") not in {"disabled", "plan_only_on_completion_event"}:
        raise FinishError("completion hook may only be disabled or plan-only")
    if completion_hook.get("command_hook_ref") != "work_completion_plan":
        raise FinishError("completion hook must reference work_completion_plan")
    if completion_hook.get("external_or_destructive_actions") is not False:
        raise FinishError("completion hook cannot authorize apply")
    plan_command = project.get("commands", {}).get("work_completion_plan", {})
    if (
        not isinstance(plan_command, dict)
        or plan_command.get("status") != "configured"
        or plan_command.get("argv")
        != ["python", "-B", ".agent/scripts/octon.py", "work", "finish", "plan"]
        or plan_command.get("side_effects")
        != {
            "classification": "read_only",
            "repository_write_paths": [],
            "external_effects": [],
        }
    ):
        raise FinishBlocked(
            "work_completion_plan must be explicitly configured as the exact read-only completion hook"
        )
    if not workflow_path.is_file():
        raise FinishBlocked("the adopted small-team Git workflow package is absent")
    workflow_catalog = load_json(workflow_path)
    selection = project.get("collaboration_profile", {}).get("workflow_selection", {})
    workflow = selection.get("base_workflow")
    if selection.get("status") != "adopted" or workflow not in WORKFLOWS:
        raise FinishBlocked("an accepted small-team base workflow has not been adopted")
    decision_ref = selection.get("adoption_decision_ref")
    if not isinstance(decision_ref, str):
        raise FinishBlocked("the adopted workflow lacks an authority reference")
    decision_path = accepted_decision(root, decision_ref)
    workflow_policy = workflow_catalog.get("workflows", {}).get(workflow)
    if not isinstance(workflow_policy, dict):
        raise FinishError("adopted workflow is absent from the installed portfolio")
    integration_method = selection.get("integration_method")
    if integration_method not in workflow_policy.get("integration_methods", []):
        raise FinishBlocked("adopted integration method is unsupported by the selected workflow")

    dirty, staged = dirty_state(root)
    if staged:
        raise FinishBlocked("planning refuses a pre-staged index: " + ", ".join(staged))
    candidates = task_candidates(root)
    if task_id is not None:
        candidates = [item for item in candidates if item[1].get("id") == task_id]
    else:
        matching_candidates: list[tuple[Path, dict[str, Any]]] = []
        for candidate_path, candidate_task in candidates:
            declared = sorted(
                safe_path(item)
                for item in string_inventory(
                    candidate_task["work_completion"].get("eligible_staging_paths"),
                    "task completion paths",
                    allow_empty=False,
                )
            )
            _closure, closure_paths = closure_transaction(
                root, candidate_path, dirty
            )
            if sorted(set(declared) | set(closure_paths)) == dirty:
                matching_candidates.append((candidate_path, candidate_task))
        candidates = matching_candidates
    if len(candidates) != 1:
        raise FinishBlocked("exactly one completed task must own the current dirty-path inventory")
    task_path, task = candidates[0]
    contract = task["work_completion"]
    declared_eligible = sorted(
        safe_path(item)
        for item in string_inventory(
            contract.get("eligible_staging_paths"),
            "task completion paths",
            allow_empty=False,
        )
    )
    closure, closure_paths = closure_transaction(root, task_path, dirty)
    eligible = sorted(set(declared_eligible) | set(closure_paths))
    blocking: list[str] = []
    if hook_observation["active_hook_names"]:
        blocking.append(
            "active or unsafe Git hooks are outside the adopted deterministic completion contract: "
            + ", ".join(hook_observation["active_hook_names"])
        )
    if eligible != dirty:
        blocking.append("dirty paths differ from the exact task-owned staging inventory")
    message = contract.get("commit_message")
    if not isinstance(message, str) or not message.strip():
        blocking.append("the proposed commit message is absent")

    repository = config.get("repository", {})
    identity = repository.get("identity")
    remote = repository.get("remote")
    default_branch = repository.get("default_branch")
    if not all(isinstance(value, str) and value for value in (identity, remote, default_branch)):
        raise FinishBlocked("repository identity, remote, and default branch must be explicitly configured")
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", remote) is None:
        raise FinishBlocked("configured remote name is unsafe or malformed")
    if run(root, ["git", "check-ref-format", "--branch", default_branch], check=False).returncode:
        raise FinishBlocked("configured default branch name is invalid")
    current_branch = git(root, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    if not current_branch:
        raise FinishBlocked("detached or unborn HEAD cannot be completed")
    if run(root, ["git", "check-ref-format", "--branch", current_branch], check=False).returncode:
        raise FinishBlocked("current task branch name is invalid")
    if workflow == "solo_direct" and current_branch != default_branch:
        blocking.append("solo_direct completion must run on the configured default branch")
    if workflow != "solo_direct" and current_branch == default_branch:
        blocking.append("branch-based completion requires a non-default task branch")
    remote_url = git(root, "remote", "get-url", remote, check=False)
    if not remote_url:
        raise FinishBlocked("configured remote is unavailable")
    head = revision(root, "HEAD")
    tracking_ref = f"refs/remotes/{remote}/{default_branch}"
    remote_default = revision(root, tracking_ref)
    remote_task = (
        None
        if workflow == "solo_direct"
        else remote_tracking_revision(root, remote, current_branch)
    )
    base = git(root, "merge-base", "HEAD", tracking_ref)
    if REVISION.fullmatch(base) is None:
        raise FinishBlocked("shared base revision cannot be established")
    if base != remote_default:
        blocking.append(
            "local work is not based on the exact observed remote default revision"
        )
    if workflow == "solo_direct" and head != remote_default:
        blocking.append(
            "solo_direct local default contains pre-existing unpublished commits"
        )

    provider = config.get("provider", {})
    adapter = provider.get("adapter")
    hosted_repository = provider.get("hosted_repository")
    if adapter not in {"none", "github_cli"}:
        raise FinishBlocked("provider handling must be explicitly assessed before completion")
    solo_hybrid_pr = config.get("solo_hybrid_pull_request") == "enabled"
    pr_required = workflow in {"pair_pr", "tiny_pr"} or (
        workflow == "solo_hybrid" and solo_hybrid_pr
    )
    if pr_required and (adapter != "github_cli" or not isinstance(hosted_repository, str) or not hosted_repository):
        blocking.append("the required pull-request path lacks an assessed hosted provider adapter")
    check_config = config.get("required_hosted_checks", {})
    if check_config.get("status") != "configured":
        blocking.append("required hosted checks have not been explicitly assessed")
    required_checks = string_inventory(
        check_config.get("names"), "required hosted checks"
    )
    if required_checks and (
        adapter != "github_cli"
        or not isinstance(hosted_repository, str)
        or not hosted_repository
    ):
        blocking.append("named hosted checks lack an assessed provider repository")
    if adapter == "none" and hosted_repository is not None:
        blocking.append("provider adapter none requires hosted_repository=null")
    validation_hooks = config.get("validation_hooks")
    try:
        validation_hooks = string_inventory(
            validation_hooks,
            "work-completion validation hooks",
            allow_empty=False,
        )
    except FinishError as error:
        blocking.append(str(error))
        validation_hooks = []
    commands = project.get("commands", {})
    for hook in validation_hooks or []:
        command = commands.get(hook, {})
        if command.get("status") != "configured" or command.get("side_effects", {}).get("classification") != "read_only":
            blocking.append(f"validation hook is not configured read-only: {hook}")

    cleanup = config.get("cleanup", {})
    remote_cleanup = workflow != "solo_direct" and cleanup.get("remote_task_branch") == "required"
    local_cleanup = workflow != "solo_direct" and cleanup.get("local_task_branch") == "required"
    if workflow != "solo_direct" and not (remote_cleanup and local_cleanup):
        blocking.append(
            "branch-based completion must reconcile both remote and local task-branch cleanup"
        )
    if workflow != "solo_direct" and "concurrent_work" in selection.get("modifiers", []):
        concurrent = contract.get("concurrent_work", {})
        shared_base = concurrent.get("shared_base_revision")
        scope = [
            safe_path(item)
            for item in string_inventory(
                concurrent.get("declared_write_scope"),
                "concurrent-work declared write scope",
                allow_empty=False,
            )
        ]
        owner = concurrent.get("worktree_owner")
        owners = worktree_branch_owners(root)
        if shared_base != base:
            blocking.append("recorded concurrent-work shared base differs from the observed base")
        if not scope or not set(eligible).issubset(scope):
            blocking.append("task paths exceed the declared concurrent-work write scope")
        if concurrent.get("handback_state") != "complete":
            blocking.append("concurrent-work handback is incomplete")
        if concurrent.get("partial_result_state") != "resolved":
            blocking.append("concurrent-work partial results are unresolved")
        if owner != task.get("owner") or owners.get(current_branch) != str(root.resolve()):
            blocking.append("task branch/worktree ownership is missing or contradictory")
        concurrent_plan = {
            "enabled": True,
            "shared_base_revision": shared_base,
            "declared_write_scope": scope,
            "worktree": str(root.resolve()),
            "handback_state": "complete" if concurrent.get("handback_state") == "complete" else "unknown",
            "partial_result_state": "resolved" if concurrent.get("partial_result_state") == "resolved" else "unknown",
            "coordination_evidence_refs": string_inventory(
                concurrent.get("coordination_evidence_refs"),
                "concurrent-work coordination evidence",
            ),
        }
    else:
        concurrent_plan = {
            "enabled": False,
            "shared_base_revision": None,
            "declared_write_scope": [],
            "worktree": str(root.resolve()),
            "handback_state": "not_applicable",
            "partial_result_state": "not_applicable",
            "coordination_evidence_refs": [],
        }

    if workflow in {"pair_pr", "tiny_pr"}:
        review_requirement = "one_peer"
        maximum_approvals = 1
    elif workflow == "solo_hybrid":
        review_requirement = "self_review_with_limitations"
        maximum_approvals = 0
    else:
        review_requirement = "none"
        maximum_approvals = 0
    eligible_reviewers = string_inventory(
        config.get("eligible_peer_reviewers"), "eligible peer reviewers"
    )
    if workflow in {"pair_pr", "tiny_pr"} and not eligible_reviewers:
        blocking.append("eligible peer reviewer identities have not been explicitly configured")
    if workflow not in {"pair_pr", "tiny_pr"} and eligible_reviewers:
        blocking.append("peer reviewer identities are inapplicable to the adopted workflow")
    self_review_refs = string_inventory(
        contract.get("self_review_refs"), "self-review evidence references"
    )
    if workflow == "solo_hybrid" and not self_review_refs:
        blocking.append("solo_hybrid completion requires explicit self-review evidence")
    pr_title = contract.get("pull_request_title") or task.get("title")
    pr_body = contract.get("pull_request_body") or (
        f"Completes {task['id']}.\n\nValidation and readiness claims remain limited to the attached receipt."
    )
    operations = ["fetch_remote"]
    if workflow == "solo_direct":
        operations.append("push_branch")
        if required_checks:
            operations.append("observe_change_checks")
    elif pr_required:
        operations += ["push_branch", "locate_pull_request", "open_pull_request"]
        if required_checks:
            operations.append("observe_change_checks")
        if review_requirement == "one_peer":
            operations.append("observe_pull_request_reviews")
        operations.append("merge_pull_request")
        if remote_cleanup:
            operations.append("delete_remote_branch")
    else:
        operations.append("push_branch")
        if required_checks:
            operations.append("observe_change_checks")
        if remote_cleanup:
            operations.append("delete_remote_branch")
    operations = list(dict.fromkeys(operations))

    source_paths = [project_path, workflow_path, tools_path, task_path, decision_path]
    if closure is not None:
        source_paths.append(root / closure["path"])
    plan: dict[str, Any] = {
        "schema_version": PLAN_SCHEMA,
        "artifact_kind": "work_completion_plan",
        "permission_grant": False,
        "read_only": True,
        "task_ref": task["id"],
        "task_status": task["status"],
        "workflow": workflow,
        "adopted_workflow_authority_ref": decision_ref,
        "assurance_profile": project.get("project", {}).get("profile"),
        "assurance_control_refs": string_inventory(
            config.get("assurance_control_refs"), "assurance control references"
        ),
        "repository": {
            "root": ".",
            "identity": identity,
            "remote": remote,
            "observed_remote_url_sha256": hashlib.sha256(remote_url.encode("utf-8")).hexdigest(),
            "provider_adapter": adapter,
            "hosted_repository": hosted_repository,
        },
        "branches": {"default": default_branch, "task": current_branch, "current": current_branch},
        "expected_revisions": {
            "base": base,
            "head_before_commit": head,
            "remote_default": remote_default,
            "remote_task": remote_task,
        },
        "eligible_staging_paths": eligible,
        "path_preconditions": [path_precondition(root, path) for path in eligible],
        "closure_transaction": closure,
        "git_hook_observation": hook_observation,
        "proposed_commit": {
            "message": message,
            "allow_empty": False,
            "amend": False,
            "history_rewrite": False,
        },
        "validation_commands": [
            {
                "purpose": f"execute configured read-only project hook {hook}",
                "argv": ["python", "-B", ".agent/scripts/run_project_checks.py", "--observe-only", "--hook", hook],
                "may_write_repository": False,
                "possible_external_effects": [],
            }
            for hook in validation_hooks or []
        ],
        "pull_request": {
            "requirement": "required" if pr_required else "not_required",
            "title": pr_title if pr_required else None,
            "body": pr_body if pr_required else None,
            "draft_allowed": False,
        },
        "review": {
            "requirement": review_requirement,
            "maximum_peer_approvals": maximum_approvals,
            "eligible_peer_reviewers": eligible_reviewers,
            "self_review_refs": self_review_refs,
            "limitations": [
                "Automated or self-review evidence is not independent human approval."
            ] if review_requirement == "self_review_with_limitations" else [],
        },
        "required_hosted_checks": required_checks,
        "integration_method": integration_method,
        "cleanup": {
            "remote_task_branch": remote_cleanup,
            "local_task_branch": local_cleanup,
        },
        "concurrent_work": concurrent_plan,
        "external_operations": operations,
        "authorization_contract": {
            "required": bool(operations),
            "attestation_schema": AUTH_SCHEMA,
            "exact_plan_binding": True,
            "revalidate_before_each_effect": True,
        },
        "stop_conditions": [
            "any relevant authority or source fingerprint changes",
            "local or remote revisions differ from the reviewed preconditions",
            "dirty, staged, conflicted, draft, stale, unmergeable, or unknown material state",
            "required checks or eligible peer approval are absent, stale, or failed",
            "integration, synchronization, branch ownership, or cleanup proof is incomplete",
        ],
        "blocking_reasons": sorted(set(blocking)),
        "relevant_input_fingerprint": source_fingerprint(root, source_paths),
        "limitations": [
            "Planning used local remote-tracking observations and performed no fetch or hosted query.",
            "The plan grants no permission and makes no release, production, or efficacy claim.",
            "External operations are not atomically reversible; apply is monotonic and resumable.",
        ],
    }
    plan["canonical_plan_digest"] = digest(plan)
    stored_plan_digest(plan)
    return plan


def run_completion_plan_event(root: Path) -> dict[str, Any] | None:
    """Dispatch only the explicitly adopted read-only completion event hook."""
    project = load_json(root / ".agent/project.json")
    if not isinstance(project, dict):
        raise FinishError("project contract must be an object")
    config = project.get("work_completion")
    if not isinstance(config, dict) or config.get("status") != "enabled":
        return None
    hook = config.get("completion_hook")
    if not isinstance(hook, dict) or hook.get("mode") == "disabled":
        return None
    if (
        hook.get("mode") != "plan_only_on_completion_event"
        or hook.get("command_hook_ref") != "work_completion_plan"
        or hook.get("external_or_destructive_actions") is not False
    ):
        raise FinishBlocked("completion event hook is not an exact plan-only contract")
    command = project.get("commands", {}).get("work_completion_plan")
    exact_argv = ["python", "-B", ".agent/scripts/octon.py", "work", "finish", "plan"]
    if (
        not isinstance(command, dict)
        or command.get("status") != "configured"
        or command.get("argv") != exact_argv
        or command.get("side_effects")
        != {
            "classification": "read_only",
            "repository_write_paths": [],
            "external_effects": [],
        }
    ):
        raise FinishBlocked("completion event command hook is not the exact read-only plan command")
    result = run(root, exact_argv)
    try:
        plan = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise FinishBlocked("completion event returned malformed plan output") from error
    if (
        not isinstance(plan, dict)
        or plan.get("artifact_kind") != "work_completion_plan"
        or plan.get("read_only") is not True
        or plan.get("permission_grant") is not False
    ):
        raise FinishBlocked("completion event did not return a non-authorizing read-only plan")
    stored_plan_digest(plan)
    return plan


def parse_timestamp(value: Any, label: str) -> datetime:
    if not isinstance(value, str):
        raise FinishBlocked(f"{label} is malformed")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise FinishBlocked(f"{label} is malformed") from error
    if parsed.tzinfo is None:
        raise FinishBlocked(f"{label} requires a timezone")
    return parsed


def record_source_candidate_validation(root: Path, receipt: dict[str, Any], evidence_path: Path) -> dict[str, Any]:
    receipt = validate_receipt(receipt)
    plan = receipt["plan"]
    if plan.get("schema_version") != SOURCE_PLAN_SCHEMA:
        raise FinishBlocked("candidate-matrix source evidence is inapplicable to generated-project completion")
    completed = set(receipt["completed_operations"])
    prerequisites = {"create_commit", "push_task_branch", "locate_or_open_pull_request", "observe_hosted_checks", "record_self_review"}
    if not prerequisites <= completed or "merge_pull_request" in completed:
        raise FinishBlocked("candidate-matrix evidence requires hosted checks and self-review before integration")
    path = external_evidence_path(root, str(evidence_path))
    value = load_json(path)
    required = {
        "schema_version", "artifact_kind", "permission_grant", "receipt_id",
        "plan_digest", "candidate_revision", "pull_request_number",
        "pull_request_head", "required_check", "full_matrix", "observed_at",
        "evidence_refs", "limitations", "evidence_digest",
    }
    if not isinstance(value, dict) or set(value) != required or value.get("schema_version") != "harness.source-candidate-matrix-validation.v1" or value.get("artifact_kind") != "source_candidate_hosted_validation_evidence" or value.get("permission_grant") is not False:
        raise FinishBlocked("source candidate-matrix evidence is absent or malformed")
    unsigned = dict(value)
    supplied = unsigned.pop("evidence_digest", None)
    if supplied != digest(unsigned):
        raise FinishBlocked("source candidate-matrix evidence digest is invalid")
    candidate = receipt["revisions"]["commit"]
    pull_request = receipt.get("pull_request") or {}
    if value.get("receipt_id") != receipt["receipt_id"] or value.get("plan_digest") != receipt["plan_digest"] or value.get("candidate_revision") != candidate or value.get("pull_request_head") != candidate or value.get("pull_request_number") != pull_request.get("number") or pull_request.get("headRefOid") != candidate:
        raise FinishBlocked("source candidate-matrix evidence covers another receipt, pull request, or revision")
    required_check = value.get("required_check")
    if not isinstance(required_check, dict) or set(required_check) != {"status", "run_ref"} or required_check.get("status") != "pass" or not isinstance(required_check.get("run_ref"), str) or not required_check["run_ref"]:
        raise FinishBlocked("source candidate-matrix evidence lacks the passing required check")
    matrix = value.get("full_matrix")
    expected_jobs = plan.get("candidate_validation", {}).get("expected_matrix_jobs")
    if not isinstance(matrix, dict) or set(matrix) != {"status", "run_ref", "expected_jobs", "successful_jobs"} or matrix.get("status") != "pass" or not isinstance(matrix.get("run_ref"), str) or not matrix["run_ref"] or matrix.get("expected_jobs") != expected_jobs or matrix.get("successful_jobs") != expected_jobs:
        raise FinishBlocked("source candidate full-matrix accounting is incomplete")
    observed = parse_timestamp(value.get("observed_at"), "candidate-matrix evidence observation time")
    if observed > datetime.now(timezone.utc):
        raise FinishBlocked("source candidate-matrix evidence is future-dated")
    string_inventory(value.get("evidence_refs"), "source candidate-matrix evidence references", allow_empty=False)
    string_inventory(value.get("limitations"), "source candidate-matrix evidence limitations")
    task_branch = plan["branches"]["task"]
    if revision(root, f"refs/heads/{task_branch}") != candidate:
        raise FinishBlocked("local source candidate changed after hosted validation")
    if "record_candidate_matrix_validation" not in receipt["completed_operations"]:
        record(
            root,
            receipt,
            "review_satisfied",
            "record_candidate_matrix_validation",
            "performed",
            {
                "path": str(path),
                "file_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
                "evidence_digest": supplied,
                "candidate_revision": candidate,
                "pull_request_number": pull_request["number"],
                "expected_matrix_jobs": expected_jobs,
            },
            completed=True,
        )
    return receipt


def record_source_post_merge_validation(root: Path, receipt: dict[str, Any], evidence_path: Path) -> dict[str, Any]:
    receipt = validate_receipt(receipt)
    plan = receipt["plan"]
    if plan.get("schema_version") != SOURCE_PLAN_SCHEMA:
        raise FinishBlocked("post-merge source evidence is inapplicable to generated-project completion")
    if "merge_pull_request" not in receipt["completed_operations"] or "synchronize_local_default_branch" not in receipt["completed_operations"]:
        raise FinishBlocked("post-merge evidence requires proven integration and local default synchronization")
    path = external_evidence_path(root, str(evidence_path))
    value = load_json(path)
    required = {
        "schema_version", "artifact_kind", "permission_grant", "receipt_id",
        "plan_digest", "integrated_revision", "tested_main_revision",
        "automatic_main_check", "full_matrix", "observed_at", "evidence_refs",
        "limitations", "evidence_digest",
    }
    if not isinstance(value, dict) or set(value) != required or value.get("schema_version") != "harness.source-post-merge-validation.v1" or value.get("artifact_kind") != "source_integrated_main_validation_evidence" or value.get("permission_grant") is not False:
        raise FinishBlocked("source post-merge evidence is absent or malformed")
    unsigned = dict(value)
    supplied = unsigned.pop("evidence_digest", None)
    if supplied != digest(unsigned):
        raise FinishBlocked("source post-merge evidence digest is invalid")
    integrated = receipt["revisions"]["integrated"]
    synchronized = receipt["revisions"]["synchronized_default"]
    if value.get("receipt_id") != receipt["receipt_id"] or value.get("plan_digest") != receipt["plan_digest"] or value.get("integrated_revision") != integrated or value.get("tested_main_revision") != synchronized or integrated != synchronized:
        raise FinishBlocked("source post-merge evidence covers another receipt or integrated revision")
    for label in ("automatic_main_check", "full_matrix"):
        result = value.get(label)
        if not isinstance(result, dict) or result.get("status") != "pass" or not isinstance(result.get("run_ref"), str) or not result["run_ref"]:
            raise FinishBlocked(f"source post-merge evidence lacks a passing {label}")
    matrix = value["full_matrix"]
    if matrix.get("successful_jobs") != matrix.get("expected_jobs") or not isinstance(matrix.get("expected_jobs"), int) or matrix["expected_jobs"] < 1:
        raise FinishBlocked("source post-merge full-matrix accounting is incomplete")
    observed = parse_timestamp(value.get("observed_at"), "post-merge evidence observation time")
    if observed > datetime.now(timezone.utc):
        raise FinishBlocked("source post-merge evidence is future-dated")
    string_inventory(value.get("evidence_refs"), "source post-merge evidence references", allow_empty=False)
    string_inventory(value.get("limitations"), "source post-merge evidence limitations")
    if git(root, "symbolic-ref", "--short", "HEAD") != plan["branches"]["default"] or revision(root, "HEAD") != synchronized:
        raise FinishBlocked("local default branch changed after integrated-main validation")
    if "record_post_merge_validation" not in receipt["completed_operations"]:
        record(
            root,
            receipt,
            "default_branch_synchronized",
            "record_post_merge_validation",
            "performed",
            {
                "path": str(path),
                "file_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
                "evidence_digest": supplied,
                "integrated_revision": integrated,
            },
            completed=True,
        )
    return receipt


def validate_authorization_record(
    value: Any,
    plan: dict[str, Any],
    *,
    require_current: bool,
) -> dict[str, Any]:
    if (
        not isinstance(value, dict)
        or set(value) != AUTHORIZATION_FIELDS
        or value.get("schema_version") != AUTH_SCHEMA
    ):
        raise FinishBlocked("current task-scoped authorization attestation is absent or malformed")
    supplied = dict(value)
    fingerprint = supplied.pop("evidence_fingerprint", None)
    if fingerprint != digest(supplied):
        raise FinishBlocked("authorization evidence fingerprint is invalid")
    expected = {
        "plan_digest": plan["canonical_plan_digest"],
        "task_ref": plan["task_ref"],
        "repository_identity": plan["repository"]["identity"],
        "remote": plan["repository"]["remote"],
        "default_branch": plan["branches"]["default"],
        "task_branch": plan["branches"]["task"],
        "operations": plan["external_operations"],
    }
    for key, expected_value in expected.items():
        if value.get(key) != expected_value:
            raise FinishBlocked(f"authorization does not cover the exact plan field: {key}")
    if value.get("artifact_kind") != "external_authorization_attestation" or value.get("permission_grant") is not False:
        raise FinishBlocked("authorization attestation envelope is invalid")
    observed_at = parse_timestamp(value.get("observed_at"), "authorization observation time")
    valid_from = parse_timestamp(value.get("valid_from"), "authorization valid_from")
    valid_until = parse_timestamp(value.get("valid_until"), "authorization valid_until")
    if valid_from > valid_until or not valid_from <= observed_at <= valid_until:
        raise FinishBlocked("authorization validity interval is contradictory")
    if require_current and not valid_from <= datetime.now(timezone.utc) <= valid_until:
        raise FinishBlocked("authorization is not currently valid")
    if not isinstance(value.get("authority_source"), str) or not value["authority_source"].startswith(("authority:", "external:")):
        raise FinishBlocked("authorization lacks an accepted external authority source")
    for field in ("principal_or_role", "observed_by"):
        if not isinstance(value.get(field), str) or not value[field].strip():
            raise FinishBlocked(f"authorization lacks {field}")
    string_inventory(value.get("operations"), "authorized operation inventory", allow_empty=False)
    string_inventory(value.get("constraints"), "authorization constraints")
    return value


def load_authorization(path: Path, plan: dict[str, Any]) -> dict[str, Any]:
    return validate_authorization_record(load_json(path), plan, require_current=True)


def new_receipt(plan: dict[str, Any], authority_record: dict[str, Any]) -> dict[str, Any]:
    stored_plan_digest(plan)
    timestamp = now()
    receipt_id = "WCR-" + secrets.token_hex(12)
    return {
        "schema_version": RECEIPT_SCHEMA,
        "artifact_kind": "work_completion_receipt",
        "permission_grant": False,
        "receipt_id": receipt_id,
        "plan_digest": plan["canonical_plan_digest"],
        "plan": plan,
        "state": "planned",
        "started_at": timestamp,
        "updated_at": timestamp,
        "progress": [],
        "completed_operations": [],
        "authorization_evidence": authority_record,
        "authorization_history": [authority_record],
        "revisions": {"commit": None, "integrated": None, "synchronized_default": None},
        "pull_request": None,
        "blocking": None,
        "rollback": "external_effects_are_not_atomically_reversible_resume_or_fix_forward",
        "resume": ["python", "-B", ".agent/scripts/octon.py", "work", "finish", "resume", "--receipt-id", receipt_id],
        "readiness_claim": False,
        "limitations": [
            "This Git-common-directory receipt is local, nonportable progress evidence until explicitly exported.",
            "Completion does not establish release, production, product-efficacy, or commercial readiness.",
        ],
    }


def validate_receipt(receipt: Any) -> dict[str, Any]:
    if not isinstance(receipt, dict):
        raise FinishError("work-completion receipt must be an object")
    if (
        receipt.get("schema_version") != RECEIPT_SCHEMA
        or receipt.get("artifact_kind") != "work_completion_receipt"
        or receipt.get("permission_grant") is not False
        or receipt.get("readiness_claim") is not False
        or receipt.get("state") not in RECEIPT_STATES
    ):
        raise FinishError("work-completion receipt envelope is malformed")
    receipt_id = receipt.get("receipt_id")
    if not isinstance(receipt_id, str) or re.fullmatch(r"WCR-[a-f0-9]{24}", receipt_id) is None:
        raise FinishError("work-completion receipt identity is malformed")
    plan = receipt.get("plan")
    if not isinstance(plan, dict):
        raise FinishError("work-completion receipt lacks its reviewed plan")
    calculated = stored_plan_digest(plan)
    if receipt.get("plan_digest") != calculated:
        raise FinishError("work-completion receipt plan binding is invalid")
    validate_authorization_record(
        receipt.get("authorization_evidence"), plan, require_current=False
    )
    authority_history = receipt.get("authorization_history")
    if (
        not isinstance(authority_history, list)
        or not authority_history
        or authority_history[-1] != receipt.get("authorization_evidence")
    ):
        raise FinishError("work-completion authorization history is malformed")
    for authority_record in authority_history:
        validate_authorization_record(authority_record, plan, require_current=False)
    completed = receipt.get("completed_operations")
    if (
        not isinstance(completed, list)
        or any(not isinstance(item, str) or not item for item in completed)
        or len(completed) != len(set(completed))
        or not set(completed) <= COMPLETABLE_OPERATIONS
    ):
        raise FinishError("work-completion completed-operation inventory is malformed")
    progress = receipt.get("progress")
    if not isinstance(progress, list):
        raise FinishError("work-completion progress must be an array")
    for index, event in enumerate(progress, start=1):
        if (
            not isinstance(event, dict)
            or event.get("sequence") != index
            or event.get("state") not in RECEIPT_STATES
            or not isinstance(event.get("operation"), str)
            or event.get("result") not in {"performed", "already_satisfied", "blocked", "failed"}
        ):
            raise FinishError("work-completion progress sequence is malformed")
    revisions = receipt.get("revisions")
    if not isinstance(revisions, dict) or set(revisions) != {
        "commit", "integrated", "synchronized_default"
    }:
        raise FinishError("work-completion revision evidence is malformed")
    for field, value in revisions.items():
        if value is not None and (not isinstance(value, str) or REVISION.fullmatch(value) is None):
            raise FinishError(f"work-completion {field} revision is malformed")
    if "delete_remote_task_branch" in completed and not revisions.get("integrated"):
        raise FinishError("remote branch cleanup lacks integration evidence")
    if "delete_local_task_branch" in completed and (
        not revisions.get("integrated") or not revisions.get("synchronized_default")
    ):
        raise FinishError("local branch cleanup lacks integration and synchronization evidence")
    if receipt.get("state") == "completed" and (
        "complete" not in completed
        or not revisions.get("integrated")
        or not revisions.get("synchronized_default")
    ):
        raise FinishError("completed receipt lacks terminal integration evidence")
    downstream = set(completed) - {"create_commit"}
    if downstream and "create_commit" not in completed:
        raise FinishError("work-completion progress skipped the exact local commit")
    workflow = plan.get("workflow")
    if "merge_pull_request" in completed:
        prerequisites = {
            "locate_or_open_pull_request",
            "observe_hosted_checks",
        }
        if plan.get("review", {}).get("requirement") == "one_peer":
            prerequisites.add("observe_peer_review")
        if plan.get("review", {}).get("requirement") == "self_review_with_limitations":
            prerequisites.add("record_self_review")
        if plan.get("schema_version") == SOURCE_PLAN_SCHEMA:
            prerequisites.add("record_candidate_matrix_validation")
        if not prerequisites <= set(completed):
            raise FinishError("pull-request integration skipped required check or review evidence")
    if "delete_remote_task_branch" in completed and not (
        {"merge_pull_request", "integrate_local_branch"} & set(completed)
    ):
        raise FinishError("remote task branch cleanup preceded integration")
    if plan.get("schema_version") == SOURCE_PLAN_SCHEMA and (
        {"delete_remote_task_branch", "delete_local_task_branch", "complete"} & set(completed)
    ) and "record_post_merge_validation" not in completed:
        raise FinishError("source completion cleanup preceded integrated-main validation evidence")
    if "delete_local_task_branch" in completed and "synchronize_local_default_branch" not in completed:
        raise FinishError("local task branch cleanup preceded default synchronization")
    if "complete" in completed:
        required = {"create_commit", "observe_hosted_checks"}
        if workflow == "solo_direct":
            required |= {"push_default_branch", "recognize_direct_integration"}
        elif plan.get("pull_request", {}).get("requirement") == "required":
            required |= {
                "push_task_branch",
                "locate_or_open_pull_request",
                "merge_pull_request",
                "synchronize_local_default_branch",
            }
        else:
            required |= {
                "record_self_review",
                "integrate_local_branch",
                "push_default_branch",
                "synchronize_local_default_branch",
            }
        if plan.get("cleanup", {}).get("remote_task_branch"):
            required.add("delete_remote_task_branch")
        if plan.get("cleanup", {}).get("local_task_branch"):
            required.add("delete_local_task_branch")
        if plan.get("schema_version") == SOURCE_PLAN_SCHEMA:
            required.add("record_candidate_matrix_validation")
            required.add("record_post_merge_validation")
        if not required <= set(completed):
            raise FinishError("completed receipt skipped required workflow progress")
    return receipt


def record(
    root: Path,
    receipt: dict[str, Any],
    state: str,
    operation: str,
    result: str,
    evidence: dict[str, Any],
    *,
    completed: bool = False,
) -> None:
    receipt["state"] = state
    receipt["updated_at"] = now()
    receipt["blocking"] = None
    receipt["progress"].append(
        {
            "sequence": len(receipt["progress"]) + 1,
            "state": state,
            "operation": operation,
            "observed_at": receipt["updated_at"],
            "result": result,
            "evidence": evidence,
            "limitations": [],
        }
    )
    if completed and operation not in receipt["completed_operations"]:
        receipt["completed_operations"].append(operation)
    validate_receipt(receipt)
    transaction.write_work_completion_receipt(root, receipt, create=False)


def block(root: Path, receipt: dict[str, Any], operation: str, error: Exception) -> None:
    receipt["blocking"] = {"operation": operation, "reason": str(error), "observed_at": now()}
    receipt["state"] = "blocked"
    receipt["updated_at"] = receipt["blocking"]["observed_at"]
    receipt["progress"].append(
        {
            "sequence": len(receipt["progress"]) + 1,
            "state": "blocked",
            "operation": operation,
            "observed_at": receipt["updated_at"],
            "result": "blocked",
            "evidence": {"reason": str(error)},
            "limitations": ["No later operation was attempted."],
        }
    )
    validate_receipt(receipt)
    transaction.write_work_completion_receipt(root, receipt, create=False)


def authority_still_current(root: Path, receipt: dict[str, Any], operation: str) -> None:
    authority_record = validate_authorization_record(
        receipt.get("authorization_evidence"), receipt["plan"], require_current=True
    )
    if operation not in authority_record.get("operations", []):
        raise FinishBlocked(f"authorization does not cover operation: {operation}")
    source = authority_record.get("authority_source", "")
    if isinstance(source, str) and source.startswith("external:standing-authorization:"):
        constraints = authority_record.get("constraints", [])
        values = {
            item.partition(":")[0]: item.partition(":")[2]
            for item in constraints
            if isinstance(item, str) and ":" in item
        }
        required = {
            "standing_contract_digest",
            "confirmation_fingerprint",
            "authorization_record_ref",
            "confirmation_artifact_ref",
            "usage_artifact_ref",
            "usage_digest",
        }
        compute_key = (
            "compute_enforcement_artifact_ref"
            if "compute_enforcement_artifact_ref" in values
            else "cost_enforcement_artifact_ref"
        )
        required.add(compute_key)
        if not required <= set(values):
            raise FinishBlocked("standing authorization lacks current revalidation bindings")
        root = root.resolve()
        source_mode = receipt.get("plan", {}).get("schema_version") == SOURCE_PLAN_SCHEMA
        core_path = (
            root / "skills/octon-mini-project-bootstrap/assets/templates/core/.agent/scripts/octon_autonomous_delivery.py.tmpl"
            if source_mode
            else root / ".agent/scripts/octon_autonomous_delivery.py"
        )
        if not core_path.is_file() or core_path.is_symlink():
            raise FinishBlocked("standing-authorization evaluator is absent or unsafe")
        if source_mode:
            core = types.ModuleType("octon_work_completion_source_standing_authority")
            core.__file__ = str(core_path)
            exec(compile(core_path.read_text(encoding="utf-8"), str(core_path), "exec"), core.__dict__)
        else:
            spec = importlib.util.spec_from_file_location("octon_work_completion_standing_authority", core_path)
            if spec is None or spec.loader is None:
                raise FinishBlocked("standing-authorization evaluator cannot be loaded")
            core = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(core)
        try:
            confirmation = core.load_json(core.external_path(root, values["confirmation_artifact_ref"], require_file=True))
            record = core.validate_record(core.load_json(core.external_path(root, values["authorization_record_ref"], require_file=True)), confirmation)
            contract = record["contract"]
            core.active_controls(root, contract)
            compute = core.validate_compute_evidence(core.load_json(core.external_path(root, values[compute_key], require_file=True)), contract)
            usage = core.validate_usage(core.load_json(core.external_path(root, values["usage_artifact_ref"], require_file=True)), record, compute)
        except Exception as error:
            raise FinishBlocked(f"standing authorization is not current: {error}") from error
        expected_record = source.removeprefix("external:standing-authorization:")
        if record.get("accepted_record_digest") != expected_record:
            raise FinishBlocked("standing authorization source digest changed")
        if contract.get("canonical_contract_digest") != values["standing_contract_digest"] or confirmation.get("confirmation_fingerprint") != values["confirmation_fingerprint"]:
            raise FinishBlocked("standing authorization contract or confirmation changed")
        if usage.get("usage_digest") != values["usage_digest"]:
            raise FinishBlocked("standing authorization usage changed; create a current exact-plan attestation")
        resource_control = contract.get("compute_control", contract.get("costs", {}))
        if resource_control.get("direct_external_spending_usd") != 0:
            raise FinishBlocked("standing authorization would permit direct external spending")


def ensure_remote_identity(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    result = run(
        root,
        ["git", "remote", "get-url", plan["repository"]["remote"]],
        check=False,
    )
    observed = text(result) if result.returncode == 0 else ""
    if (
        not observed
        or hashlib.sha256(observed.encode("utf-8")).hexdigest()
        != plan["repository"]["observed_remote_url_sha256"]
    ):
        raise FinishBlocked("configured remote identity changed after planning")


def external(root: Path, receipt: dict[str, Any], operation: str, argv: list[str]) -> subprocess.CompletedProcess[bytes]:
    try:
        ensure_remote_identity(root, receipt)
        authority_still_current(root, receipt, operation)
        result = run(root, argv)
        INTERRUPTION_HOOK(operation)
        return result
    except FinishError as error:
        if not hasattr(error, "operation"):
            error.operation = operation
        raise


def external_evidence_path(root: Path, raw: Any) -> Path:
    if not isinstance(raw, str):
        raise FinishBlocked("external evidence path is malformed")
    path = Path(raw).expanduser()
    if not path.is_absolute():
        raise FinishBlocked("external evidence path must be absolute")
    path = path.resolve(strict=False)
    try:
        path.relative_to(root.resolve())
    except ValueError:
        pass
    else:
        raise FinishBlocked("external evidence path must remain outside the repository")
    current = Path(path.anchor)
    for part in path.parts[1:-1]:
        current = current / part
        if current.is_symlink():
            raise FinishBlocked("external evidence path has a symlink ancestor")
    if not path.is_file() or path.is_symlink():
        raise FinishBlocked("external evidence file is absent or unsafe")
    return path


def source_repository_fingerprint(root: Path, plan: dict[str, Any]) -> str:
    inputs = string_inventory(plan.get("source_inputs"), "source work-completion inputs", allow_empty=False)
    binding = plan.get("external_task_binding")
    if not isinstance(binding, dict) or set(binding) != {"path", "file_sha256", "task_reference_digest"}:
        raise FinishBlocked("source work-completion task binding is malformed")
    task_path = external_evidence_path(root, binding["path"])
    if parse_timestamp(plan.get("external_task_valid_until"), "external task valid_until") < datetime.now(timezone.utc):
        raise FinishBlocked("external Codex task reference is expired")
    task_bytes = task_path.read_bytes()
    if hashlib.sha256(task_bytes).hexdigest() != binding["file_sha256"]:
        raise FinishBlocked("external Codex task-reference bytes changed after planning")
    revisions = plan.get("expected_revisions", {})
    candidate = revisions.get("candidate_head")
    base = revisions.get("base")
    task_branch = plan.get("branches", {}).get("task")
    if not isinstance(candidate, str) or not isinstance(base, str) or not isinstance(task_branch, str):
        raise FinishBlocked("source candidate revision binding is malformed")
    branch_value = git(root, "rev-parse", "--verify", f"refs/heads/{task_branch}", check=False)
    if branch_value != candidate:
        raise FinishBlocked("source task branch changed or disappeared after planning")
    commits = [item for item in git(root, "rev-list", "--reverse", f"{base}..{candidate}").splitlines() if item]
    changed = sorted(item for item in git(root, "diff", "--name-only", "--diff-filter=ACDMRTUXB", base, candidate).splitlines() if item)
    if commits != plan.get("candidate_commits") or changed != plan.get("eligible_staging_paths"):
        raise FinishBlocked("source candidate commit range or changed-path inventory changed")
    value = hashlib.sha256()
    for relative in sorted(inputs):
        path = root / safe_path(relative)
        if not path.is_file() or path.is_symlink():
            raise FinishBlocked(f"source work-completion input disappeared or became unsafe: {relative}")
        value.update(relative.encode("utf-8")); value.update(b"\0")
        value.update(path.read_bytes()); value.update(b"\0")
    value.update(b"external_task_reference\0"); value.update(task_bytes); value.update(b"\0")
    value.update(canonical_bytes(transaction.instruction_fingerprint(root)))
    return value.hexdigest()


def current_source_fingerprint(root: Path, plan: dict[str, Any]) -> str:
    if plan.get("schema_version") == SOURCE_PLAN_SCHEMA:
        return source_repository_fingerprint(root, plan)
    task = next((path for path in (root / ".agent/tasks").glob(f"{plan['task_ref']}*.md")), None)
    decision = next((path for path in (root / ".agent/decisions").glob(f"{plan['adopted_workflow_authority_ref']}*.md")), None)
    if task is None or decision is None:
        raise FinishBlocked("a governing source record disappeared after planning")
    paths = [
        root / ".agent/project.json",
        root / ".agent/workflows/small-team-git.json",
        root / ".agent/tools.json",
        task,
        decision,
    ]
    closure = plan.get("closure_transaction")
    if isinstance(closure, dict):
        receipt_path = root / safe_path(closure.get("path"))
        if not receipt_path.is_file() or receipt_path.is_symlink():
            raise FinishBlocked("bound work.close receipt disappeared or became unsafe")
        paths.append(receipt_path)
    return source_fingerprint(root, paths)


def ensure_plan_sources(root: Path, plan: dict[str, Any]) -> None:
    if current_source_fingerprint(root, plan) != plan["relevant_input_fingerprint"]:
        raise FinishBlocked("relevant authority, task, workflow, tool, or instruction inputs changed")


def revision_blob_state(root: Path, revision_value: str, path: str) -> tuple[str, str | None]:
    result = run(root, ["git", "rev-parse", f"{revision_value}:{path}"], check=False)
    if result.returncode:
        return "absent", None
    object_id = text(result)
    if REVISION.fullmatch(object_id) is None:
        raise FinishBlocked(f"commit contains a malformed blob identity: {path}")
    return "file", object_id


def commit_matches_plan(root: Path, commit: str, plan: dict[str, Any]) -> bool:
    expected_parent = plan["expected_revisions"]["head_before_commit"]
    parent = git(root, "rev-parse", f"{commit}^", check=False)
    message = git(root, "show", "-s", "--format=%B", commit).rstrip("\n")
    changed = sorted(
        item
        for item in git(
            root, "diff", "--name-only", "--diff-filter=ACDMRTUXB", expected_parent, commit
        ).splitlines()
        if item
    )
    if (
        parent != expected_parent
        or message != plan["proposed_commit"]["message"]
        or changed != plan["eligible_staging_paths"]
    ):
        return False
    expected_paths = {
        item["path"]: (item["git_blob_state"], item["git_blob_oid"])
        for item in plan["path_preconditions"]
    }
    return all(
        revision_blob_state(root, commit, path) == expected_paths[path]
        for path in plan["eligible_staging_paths"]
    )


@named_operation("create_commit")
def validate_and_commit(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    operation = "create_commit"
    expected = plan["expected_revisions"]["head_before_commit"]
    current = revision(root, "HEAD")
    if current != expected:
        if commit_matches_plan(root, current, plan):
            receipt["revisions"]["commit"] = current
            record(root, receipt, "locally_committed", operation, "already_satisfied", {"commit": current}, completed=True)
            return
        raise FinishBlocked("local HEAD changed after planning and is not the exact planned commit")
    dirty, staged = dirty_state(root)
    if staged:
        raise FinishBlocked("the index changed after planning; re-plan from an unstaged worktree")
    if dirty != plan["eligible_staging_paths"]:
        raise FinishBlocked("dirty paths changed after planning")
    for expected_path in plan["path_preconditions"]:
        if path_precondition(root, expected_path["path"]) != expected_path:
            raise FinishBlocked(f"path content changed after planning: {expected_path['path']}")
    for command in plan["validation_commands"]:
        result = run(root, command["argv"])
        try:
            report = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise FinishBlocked("read-only project validation returned malformed evidence") from error
        if report.get("overall_outcome") != "pass":
            raise FinishBlocked("read-only project validation did not pass")
    for expected_path in plan["path_preconditions"]:
        if path_precondition(root, expected_path["path"]) != expected_path:
            raise FinishBlocked(
                f"validation changed a reviewed completion path: {expected_path['path']}"
            )
    run(root, ["git", "add", "--", *plan["eligible_staging_paths"]])
    staged_names = sorted(
        item for item in git(root, "diff", "--cached", "--name-only", "--diff-filter=ACDMRTUXB").splitlines() if item
    )
    if staged_names != plan["eligible_staging_paths"]:
        raise FinishBlocked("staged inventory differs from the reviewed plan")
    if run(root, ["git", "diff", "--cached", "--quiet"], check=False).returncode == 0:
        raise FinishBlocked("planned commit is empty")
    run(root, ["git", "commit", "-m", plan["proposed_commit"]["message"]])
    commit = revision(root, "HEAD")
    if not commit_matches_plan(root, commit, plan):
        raise FinishBlocked("created commit differs from the reviewed content and message")
    INTERRUPTION_HOOK(operation)
    receipt["revisions"]["commit"] = commit
    record(root, receipt, "locally_committed", operation, "performed", {"commit": commit}, completed=True)


def remote_head(root: Path, receipt: dict[str, Any], branch: str) -> str | None:
    plan = receipt["plan"]
    result = external(
        root,
        receipt,
        "fetch_remote",
        ["git", "ls-remote", "--heads", plan["repository"]["remote"], f"refs/heads/{branch}"],
    )
    output = text(result)
    if not output:
        return None
    value = output.split()[0]
    if REVISION.fullmatch(value) is None:
        raise FinishBlocked("remote returned a malformed branch revision")
    return value


def fetch_default(root: Path, receipt: dict[str, Any], *, expected: str | None) -> str:
    plan = receipt["plan"]
    remote = plan["repository"]["remote"]
    branch = plan["branches"]["default"]
    external(
        root,
        receipt,
        "fetch_remote",
        ["git", "fetch", "--no-tags", remote, f"refs/heads/{branch}:refs/remotes/{remote}/{branch}"],
    )
    value = revision(root, f"refs/remotes/{remote}/{branch}")
    if expected is not None and value != expected:
        raise FinishBlocked("remote default revision changed after planning")
    return value


def push_exact(
    root: Path,
    receipt: dict[str, Any],
    branch: str,
    commit: str,
    operation: str,
    *,
    expected_before: str | None = None,
) -> None:
    existing = remote_head(root, receipt, branch)
    if existing == commit:
        record(root, receipt, "branch_published", operation, "already_satisfied", {"branch": branch, "revision": commit}, completed=True)
        return
    if existing is not None and existing != expected_before:
        raise FinishBlocked(f"remote branch {branch} has an unexpected revision")
    plan = receipt["plan"]
    external(
        root,
        receipt,
        "push_branch",
        ["git", "push", "--no-follow-tags", plan["repository"]["remote"], f"{commit}:refs/heads/{branch}"],
    )
    if remote_head(root, receipt, branch) != commit:
        raise FinishBlocked("published branch could not be re-observed at the exact revision")
    record(root, receipt, "branch_published", operation, "performed", {"branch": branch, "revision": commit}, completed=True)


def gh_json(root: Path, receipt: dict[str, Any], operation: str, argv: list[str]) -> Any:
    result = external(root, receipt, operation, ["gh", *argv])
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise FinishBlocked("hosted provider adapter returned malformed JSON") from error


def locate_pr(root: Path, receipt: dict[str, Any]) -> dict[str, Any] | None:
    plan = receipt["plan"]
    values = gh_json(
        root,
        receipt,
        "locate_pull_request",
        [
            "pr", "list", "--repo", plan["repository"]["hosted_repository"],
            "--head", plan["branches"]["task"], "--base", plan["branches"]["default"],
            "--state", "all", "--json",
            "number,state,isDraft,headRefName,baseRefName,headRefOid,mergeStateStatus,reviewDecision,url,mergedAt,mergeCommit",
        ],
    )
    if not isinstance(values, list) or len(values) > 1:
        raise FinishBlocked("pull-request identity is ambiguous")
    return values[0] if values else None


@named_operation("locate_or_open_pull_request")
def ensure_pr(root: Path, receipt: dict[str, Any]) -> dict[str, Any]:
    plan = receipt["plan"]
    pr = locate_pr(root, receipt)
    result = "already_satisfied"
    if pr is None:
        external(
            root,
            receipt,
            "open_pull_request",
            [
                "gh", "pr", "create", "--repo", plan["repository"]["hosted_repository"],
                "--base", plan["branches"]["default"], "--head", plan["branches"]["task"],
                "--title", plan["pull_request"]["title"], "--body", plan["pull_request"]["body"],
            ],
        )
        pr = locate_pr(root, receipt)
        result = "performed"
    if not isinstance(pr, dict):
        raise FinishBlocked("pull request was not observable after creation")
    if not isinstance(pr.get("number"), int) or pr["number"] < 1:
        raise FinishBlocked("pull request identity is malformed")
    if (
        pr.get("headRefName") != plan["branches"]["task"]
        or pr.get("baseRefName") != plan["branches"]["default"]
        or pr.get("headRefOid") != receipt["revisions"]["commit"]
    ):
        raise FinishBlocked("pull request base, head, or revision differs from the reviewed plan")
    if pr.get("isDraft"):
        raise FinishBlocked("draft pull requests cannot be integrated")
    if pr.get("state") not in {"OPEN", "MERGED"}:
        raise FinishBlocked("pull request is closed without integration")
    receipt["pull_request"] = pr
    record(root, receipt, "pull_request_open", "locate_or_open_pull_request", result, {"number": pr.get("number"), "url": pr.get("url")}, completed=True)
    return pr


@named_operation("observe_hosted_checks")
def observe_checks(root: Path, receipt: dict[str, Any], revision_value: str) -> None:
    plan = receipt["plan"]
    required = plan["required_hosted_checks"]
    if not required:
        record(root, receipt, "checks_passed", "observe_hosted_checks", "already_satisfied", {"required": [], "revision": revision_value}, completed=True)
        return
    repository = plan["repository"]["hosted_repository"]
    if plan["repository"]["provider_adapter"] != "github_cli" or not repository:
        raise FinishBlocked("required hosted checks cannot be observed without the adopted adapter")
    checks = gh_json(
        root,
        receipt,
        "observe_change_checks",
        ["api", f"repos/{repository}/commits/{revision_value}/check-runs?per_page=100"],
    )
    statuses = gh_json(
        root,
        receipt,
        "observe_change_checks",
        ["api", f"repos/{repository}/commits/{revision_value}/status"],
    )
    observed: dict[str, str | None] = {}
    for item in checks.get("check_runs", []) if isinstance(checks, dict) else []:
        observed[item.get("name")] = item.get("conclusion") or item.get("status")
    for item in statuses.get("statuses", []) if isinstance(statuses, dict) else []:
        observed[item.get("context")] = item.get("state")
    missing = [name for name in required if name not in observed]
    failed = [name for name in required if observed.get(name) not in {"success"}]
    if missing:
        record(root, receipt, "checks_pending", "observe_hosted_checks", "blocked", {"missing": missing, "revision": revision_value})
        raise FinishBlocked("required hosted checks are missing for the exact head revision")
    if failed:
        record(root, receipt, "checks_failed", "observe_hosted_checks", "failed", {"failed": {name: observed.get(name) for name in failed}, "revision": revision_value})
        raise FinishBlocked("required hosted checks are pending or failed")
    record(root, receipt, "checks_passed", "observe_hosted_checks", "already_satisfied", {"checks": {name: observed[name] for name in required}, "revision": revision_value}, completed=True)


@named_operation("observe_peer_review")
def observe_peer_review(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    pr = receipt.get("pull_request") or {}
    if not isinstance(pr.get("number"), int) or pr["number"] < 1:
        raise FinishBlocked("pull request identity is unavailable for review")
    view = gh_json(
        root,
        receipt,
        "observe_pull_request_reviews",
        ["pr", "view", str(pr.get("number")), "--repo", plan["repository"]["hosted_repository"], "--json", "author,reviews,headRefOid"],
    )
    if view.get("headRefOid") != receipt["revisions"]["commit"]:
        raise FinishBlocked("review evidence belongs to another head revision")
    author = (view.get("author") or {}).get("login")
    eligible = set(plan["review"]["eligible_peer_reviewers"])
    approvals = sorted(
        {
            (item.get("author") or {}).get("login")
            for item in view.get("reviews", [])
            if item.get("state") == "APPROVED"
            and (item.get("author") or {}).get("login") != author
            and (item.get("author") or {}).get("login") in eligible
        }
        - {None}
    )
    if not approvals:
        record(root, receipt, "review_pending", "observe_peer_review", "blocked", {"author": author, "configured_eligible_reviewers": sorted(eligible), "eligible_approvals": []})
        raise FinishBlocked("required approval by another eligible developer is unavailable")
    record(root, receipt, "review_satisfied", "observe_peer_review", "already_satisfied", {"author": author, "eligible_approval": approvals[0], "approval_count_used": 1}, completed=True)


@named_operation("record_self_review")
def record_self_review(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    commit = receipt["revisions"]["commit"]
    if plan.get("schema_version") == SOURCE_PLAN_SCHEMA:
        base = plan["expected_revisions"]["base"]
        summary = git(root, "diff", "--stat", "--no-renames", base, commit)
        patch = run(root, ["git", "diff", "--no-ext-diff", "--no-renames", base, commit]).stdout
    else:
        summary = git(root, "show", "--stat", "--oneline", "--no-renames", commit)
        patch = run(root, ["git", "show", "--format=", "--no-ext-diff", "--no-renames", commit]).stdout
    record(
        root,
        receipt,
        "review_satisfied",
        "record_self_review",
        "performed",
        {
            "commit": commit,
            "summary_sha256": hashlib.sha256(summary.encode("utf-8")).hexdigest(),
            "patch_sha256": hashlib.sha256(patch).hexdigest(),
            "review_refs": plan["review"]["self_review_refs"],
            "independent_human_approval": False,
        },
        completed=True,
    )


def require_open_mergeable_pr(pr: dict[str, Any], receipt: dict[str, Any]) -> None:
    if pr.get("state") != "OPEN" or pr.get("isDraft"):
        raise FinishBlocked("pull request is not open and ready")
    if pr.get("headRefOid") != receipt["revisions"]["commit"]:
        raise FinishBlocked("pull request head changed before integration")
    if pr.get("mergeStateStatus") not in {"CLEAN", "HAS_HOOKS", "UNSTABLE"}:
        raise FinishBlocked("pull request is conflicted, stale, blocked, unmergeable, or unknown")
    if not isinstance(pr.get("number"), int) or pr["number"] < 1:
        raise FinishBlocked("pull request identity is malformed")


@named_operation("merge_pull_request")
def merge_pr(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    pr = locate_pr(root, receipt)
    if not pr:
        raise FinishBlocked("pull request disappeared before integration")
    if pr.get("state") == "MERGED":
        result = "already_satisfied"
    else:
        require_open_mergeable_pr(pr, receipt)
        observe_checks(root, receipt, receipt["revisions"]["commit"])
        if plan["review"]["requirement"] == "one_peer":
            observe_peer_review(root, receipt)
        pr = locate_pr(root, receipt)
        if not pr:
            raise FinishBlocked("pull request disappeared immediately before integration")
        if pr.get("state") == "MERGED":
            result = "already_satisfied"
        else:
            require_open_mergeable_pr(pr, receipt)
            method = plan["integration_method"]
            if method not in PROVIDER_INTEGRATION_METHODS:
                raise FinishBlocked("unsupported pull-request integration method")
            external(
                root,
                receipt,
                "merge_pull_request",
                [
                    "gh",
                    "api",
                    "--method",
                    "PUT",
                    f"repos/{plan['repository']['hosted_repository']}/pulls/{pr['number']}/merge",
                    "-f",
                    f"merge_method={PROVIDER_INTEGRATION_METHODS[method]}",
                    "-f",
                    f"sha={receipt['revisions']['commit']}",
                ],
            )
            pr = locate_pr(root, receipt)
            result = "performed"
    if not pr or pr.get("state") != "MERGED" or not pr.get("mergedAt"):
        raise FinishBlocked("provider did not prove pull-request integration")
    merge_commit = (pr.get("mergeCommit") or {}).get("oid")
    if not isinstance(merge_commit, str) or REVISION.fullmatch(merge_commit) is None:
        raise FinishBlocked("provider omitted the integrated revision")
    receipt["pull_request"] = pr
    receipt["revisions"]["integrated"] = merge_commit
    record(root, receipt, "integrated", "merge_pull_request", result, {"number": pr["number"], "integrated_revision": merge_commit}, completed=True)


@named_operation("integrate_local_branch")
def integrate_local(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    task = plan["branches"]["task"]
    default = plan["branches"]["default"]
    remote_default = fetch_default(root, receipt, expected=plan["expected_revisions"]["remote_default"])
    method = plan["integration_method"]
    current_branch = git(root, "symbolic-ref", "--short", "HEAD")
    if current_branch == default:
        default_head = revision(root, "HEAD")
        task_head = revision(root, f"refs/heads/{task}")
        parent_line = git(root, "rev-list", "--parents", "-n", "1", default_head).split()
        recovered = False
        if method == "merge_commit":
            recovered = (
                len(parent_line) == 3
                and parent_line[1] == remote_default
                and parent_line[2] == task_head
            )
        elif method == "squash_merge":
            recovered = (
                len(parent_line) == 2
                and parent_line[1] == remote_default
                and git(root, "rev-parse", f"{default_head}^{{tree}}")
                == git(root, "rev-parse", f"{task_head}^{{tree}}")
                and git(root, "show", "-s", "--format=%B", default_head).rstrip("\n")
                == plan["proposed_commit"]["message"]
            )
        elif method == "rebase_then_fast_forward":
            recovered = default_head == task_head and run(
                root,
                ["git", "merge-base", "--is-ancestor", remote_default, task_head],
                check=False,
            ).returncode == 0
            if recovered:
                receipt["revisions"]["commit"] = task_head
        if not recovered:
            raise FinishBlocked(
                "local default branch changed and does not prove the exact interrupted integration"
            )
        receipt["revisions"]["integrated"] = default_head
        record(
            root,
            receipt,
            "integrated",
            "integrate_local_branch",
            "already_satisfied",
            {"integrated_revision": default_head},
            completed=True,
        )
        return
    if current_branch != task:
        raise FinishBlocked("local integration must start on the exact task branch")
    if dirty_state(root) != ([], []):
        raise FinishBlocked("local integration requires a clean worktree and index")
    if method == "rebase_then_fast_forward":
        run(root, ["git", "rebase", remote_default])
        receipt["revisions"]["commit"] = revision(root, "HEAD")
    run(root, ["git", "switch", default])
    local_default = revision(root, "HEAD")
    if local_default != remote_default:
        raise FinishBlocked("local default branch changed or is not synchronized with the reviewed remote base")
    if method == "merge_commit":
        run(root, ["git", "merge", "--no-ff", task, "-m", f"Merge {task}"])
    elif method == "squash_merge":
        run(root, ["git", "merge", "--squash", task])
        run(root, ["git", "commit", "-m", plan["proposed_commit"]["message"]])
    elif method == "rebase_then_fast_forward":
        run(root, ["git", "merge", "--ff-only", task])
    else:
        raise FinishBlocked("unsupported local integration method")
    integrated = revision(root, "HEAD")
    INTERRUPTION_HOOK("integrate_local_branch")
    receipt["revisions"]["integrated"] = integrated
    record(root, receipt, "integrated", "integrate_local_branch", "performed", {"integrated_revision": integrated}, completed=True)


@named_operation("delete_remote_task_branch")
def delete_remote(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    branch = plan["branches"]["task"]
    observed = remote_head(root, receipt, branch)
    if observed is None:
        record(root, receipt, "remote_branch_cleaned", "delete_remote_task_branch", "already_satisfied", {"branch": branch, "absent": True}, completed=True)
        return
    if observed != receipt["revisions"]["commit"] or not receipt["revisions"]["integrated"]:
        raise FinishBlocked("remote task branch deletion lacks exact integration proof")
    external(
        root,
        receipt,
        "delete_remote_branch",
        ["git", "push", plan["repository"]["remote"], f":refs/heads/{branch}"],
    )
    if remote_head(root, receipt, branch) is not None:
        raise FinishBlocked("remote task branch remains after deletion")
    record(root, receipt, "remote_branch_cleaned", "delete_remote_task_branch", "performed", {"branch": branch, "absent": True}, completed=True)


@named_operation("synchronize_local_default_branch")
def sync_default(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    default = plan["branches"]["default"]
    current = git(root, "symbolic-ref", "--short", "HEAD")
    if current != default and dirty_state(root) != ([], []):
        raise FinishBlocked("default-branch synchronization requires a clean worktree")
    # Revalidate and fetch while the reviewed source candidate is still
    # checked out. A predecessor default branch may not contain the evaluator
    # introduced by that candidate, so switching first would make exact
    # standing-authority revalidation impossible immediately after merge.
    remote_value = fetch_default(root, receipt, expected=None)
    if current != default:
        run(root, ["git", "switch", default])
    integrated = receipt["revisions"].get("integrated")
    if not integrated or run(
        root,
        ["git", "merge-base", "--is-ancestor", integrated, remote_value],
        check=False,
    ).returncode:
        raise FinishBlocked("remote default branch does not contain the proven integration")
    local_value = revision(root, "HEAD")
    ancestor = run(root, ["git", "merge-base", "--is-ancestor", local_value, remote_value], check=False)
    if ancestor.returncode:
        raise FinishBlocked("local default branch cannot be synchronized by fast-forward")
    if local_value != remote_value:
        run(root, ["git", "merge", "--ff-only", remote_value])
    synchronized = revision(root, "HEAD")
    if synchronized != remote_value:
        raise FinishBlocked("local default branch did not reach the exact remote revision")
    receipt["revisions"]["synchronized_default"] = synchronized
    record(root, receipt, "default_branch_synchronized", "synchronize_local_default_branch", "performed" if local_value != remote_value else "already_satisfied", {"revision": synchronized}, completed=True)


@named_operation("delete_local_task_branch")
def delete_local(root: Path, receipt: dict[str, Any]) -> None:
    plan = receipt["plan"]
    task = plan["branches"]["task"]
    default = plan["branches"]["default"]
    if task == default or git(root, "symbolic-ref", "--short", "HEAD") == task:
        raise FinishBlocked("current or default branch cannot be deleted")
    task_result = run(root, ["git", "rev-parse", "--verify", f"refs/heads/{task}"], check=False)
    if task_result.returncode:
        record(root, receipt, "local_branch_cleaned", "delete_local_task_branch", "already_satisfied", {"branch": task, "absent": True}, completed=True)
        return
    task_revision = text(task_result)
    if task_revision != receipt["revisions"]["commit"]:
        raise FinishBlocked("local task branch revision differs from the integrated receipt")
    if task in worktree_branch_owners(root):
        raise FinishBlocked("local task branch is still owned by a worktree")
    if not receipt["revisions"]["integrated"] or receipt["revisions"]["synchronized_default"] != revision(root, f"refs/heads/{default}"):
        raise FinishBlocked("local branch cleanup lacks integration and synchronization proof")
    ancestry = run(root, ["git", "merge-base", "--is-ancestor", task_revision, f"refs/heads/{default}"], check=False)
    if ancestry.returncode == 0:
        run(root, ["git", "branch", "-d", task])
    elif receipt.get("pull_request", {}).get("state") == "MERGED" or plan["integration_method"] == "squash_merge":
        run(root, ["git", "update-ref", "-d", f"refs/heads/{task}", task_revision])
    else:
        raise FinishBlocked("local task branch is not proven integrated")
    INTERRUPTION_HOOK("delete_local_task_branch")
    record(root, receipt, "local_branch_cleaned", "delete_local_task_branch", "performed", {"branch": task, "absent": True}, completed=True)


def execute(root: Path, receipt: dict[str, Any]) -> dict[str, Any]:
    plan = receipt["plan"]
    ensure_plan_sources(root, plan)
    current_hooks = git_hook_observation(root, plan["git_hook_observation"]["policy"])
    if current_hooks != plan["git_hook_observation"] or current_hooks["active_hook_names"]:
        raise FinishBlocked("Git hook or fsmonitor state changed after planning")
    if plan["blocking_reasons"]:
        raise FinishBlocked("; ".join(plan["blocking_reasons"]))
    if "create_commit" not in receipt["completed_operations"]:
        validate_and_commit(root, receipt)
    if dirty_state(root) != ([], []):
        raise FinishBlocked("worktree or index changed after the exact planned commit")
    workflow = plan["workflow"]
    commit = receipt["revisions"]["commit"]
    if not commit:
        raise FinishBlocked("local commit evidence is unavailable")

    if workflow == "solo_direct":
        if "push_default_branch" not in receipt["completed_operations"]:
            observed_default = remote_head(root, receipt, plan["branches"]["default"])
            if observed_default != commit:
                if observed_default != plan["expected_revisions"]["remote_default"]:
                    raise FinishBlocked("remote default revision changed after planning")
                fetch_default(root, receipt, expected=plan["expected_revisions"]["remote_default"])
            push_exact(
                root,
                receipt,
                plan["branches"]["default"],
                commit,
                "push_default_branch",
                expected_before=plan["expected_revisions"]["remote_default"],
            )
            receipt["revisions"]["integrated"] = commit
            receipt["revisions"]["synchronized_default"] = commit
        if (
            receipt["revisions"].get("integrated") != commit
            or receipt["revisions"].get("synchronized_default") != commit
        ):
            receipt["revisions"]["integrated"] = commit
            receipt["revisions"]["synchronized_default"] = commit
        if "recognize_direct_integration" not in receipt["completed_operations"]:
            record(
                root,
                receipt,
                "integrated",
                "recognize_direct_integration",
                "already_satisfied",
                {"integrated_revision": commit, "synchronized_default": commit},
                completed=True,
            )
        if "observe_hosted_checks" not in receipt["completed_operations"]:
            observe_checks(root, receipt, commit)
    elif plan["pull_request"]["requirement"] == "required":
        if "push_task_branch" not in receipt["completed_operations"]:
            fetch_default(root, receipt, expected=plan["expected_revisions"]["remote_default"])
            push_exact(
                root,
                receipt,
                plan["branches"]["task"],
                commit,
                "push_task_branch",
                expected_before=plan["expected_revisions"]["remote_task"],
            )
        if "locate_or_open_pull_request" not in receipt["completed_operations"]:
            ensure_pr(root, receipt)
        if "observe_hosted_checks" not in receipt["completed_operations"]:
            observe_checks(root, receipt, commit)
        if plan["review"]["requirement"] == "self_review_with_limitations" and "record_self_review" not in receipt["completed_operations"]:
            record_self_review(root, receipt)
        if plan["review"]["requirement"] == "one_peer" and "observe_peer_review" not in receipt["completed_operations"]:
            observe_peer_review(root, receipt)
        if plan.get("schema_version") == SOURCE_PLAN_SCHEMA:
            candidate_gate = plan.get("candidate_validation", {})
            if candidate_gate.get("required") is not True or candidate_gate.get("integration_before_pass") is not False or "record_candidate_matrix_validation" not in receipt["completed_operations"]:
                raise FinishBlocked("source completion requires current candidate full-matrix evidence before integration")
        if "merge_pull_request" not in receipt["completed_operations"]:
            merge_pr(root, receipt)
        if plan.get("schema_version") != SOURCE_PLAN_SCHEMA and plan["cleanup"]["remote_task_branch"] and "delete_remote_task_branch" not in receipt["completed_operations"]:
            delete_remote(root, receipt)
        if "synchronize_local_default_branch" not in receipt["completed_operations"]:
            sync_default(root, receipt)
    else:
        if "record_self_review" not in receipt["completed_operations"]:
            record_self_review(root, receipt)
        if "integrate_local_branch" not in receipt["completed_operations"]:
            integrate_local(root, receipt)
        integrated = receipt["revisions"]["integrated"]
        if "push_default_branch" not in receipt["completed_operations"]:
            existing = remote_head(root, receipt, plan["branches"]["default"])
            if existing != plan["expected_revisions"]["remote_default"] and existing != integrated:
                raise FinishBlocked("remote default changed before local integration publication")
            if existing == integrated:
                record(root, receipt, "branch_published", "push_default_branch", "already_satisfied", {"branch": plan["branches"]["default"], "revision": integrated}, completed=True)
            else:
                external(root, receipt, "push_branch", ["git", "push", "--no-follow-tags", plan["repository"]["remote"], f"{integrated}:refs/heads/{plan['branches']['default']}"])
                record(root, receipt, "branch_published", "push_default_branch", "performed", {"branch": plan["branches"]["default"], "revision": integrated}, completed=True)
        if "observe_hosted_checks" not in receipt["completed_operations"]:
            observe_checks(root, receipt, integrated)
        if plan["cleanup"]["remote_task_branch"] and "delete_remote_task_branch" not in receipt["completed_operations"]:
            delete_remote(root, receipt)
        if "synchronize_local_default_branch" not in receipt["completed_operations"]:
            sync_default(root, receipt)

    if plan.get("schema_version") == SOURCE_PLAN_SCHEMA:
        gate = plan.get("post_merge_validation", {})
        if gate.get("required") is not True or "record_post_merge_validation" not in receipt["completed_operations"]:
            raise FinishBlocked("source completion requires current integrated-main validation evidence before branch cleanup")
        if plan["cleanup"]["remote_task_branch"] and "delete_remote_task_branch" not in receipt["completed_operations"]:
            delete_remote(root, receipt)
    if workflow != "solo_direct" and plan["cleanup"]["local_task_branch"] and "delete_local_task_branch" not in receipt["completed_operations"]:
        delete_local(root, receipt)
    record(root, receipt, "completed", "complete", "already_satisfied", {"integrated_revision": receipt["revisions"]["integrated"], "synchronized_default": receipt["revisions"]["synchronized_default"]}, completed=True)
    return receipt


def find_plan_by_digest(root: Path, accepted_digest: str, task_id: str | None) -> dict[str, Any]:
    if not re.fullmatch(r"[a-f0-9]{64}", accepted_digest):
        raise FinishError("accepted plan digest is malformed")
    plans: list[dict[str, Any]] = []
    if task_id:
        plans.append(build_plan(root, task_id))
    else:
        for _path, task in task_candidates(root):
            try:
                plans.append(build_plan(root, task["id"]))
            except FinishError:
                continue
    matching = [plan for plan in plans if plan["canonical_plan_digest"] == accepted_digest]
    if len(matching) != 1:
        raise FinishBlocked("accepted digest is stale or does not identify one current plan")
    return matching[0]


def apply(root: Path, accepted_digest: str, authorization_path: Path, task_id: str | None = None) -> dict[str, Any]:
    plan = find_plan_by_digest(root, accepted_digest, task_id)
    authority_record = load_authorization(authorization_path, plan)
    receipt = new_receipt(plan, authority_record)
    validate_receipt(receipt)
    transaction.write_work_completion_receipt(root, receipt, create=True)
    record(root, receipt, "planned", "accept_plan", "performed", {"plan_digest": accepted_digest})
    try:
        return execute(root, receipt)
    except FinishError as error:
        operation = getattr(error, "operation", "execute")
        block(root, receipt, operation, error)
        raise


def select_receipt(root: Path, receipt_id: str | None) -> dict[str, Any]:
    if receipt_id:
        return transaction.load_work_completion_receipt(root, receipt_id)
    values = [
        transaction.load_work_completion_receipt(root, path.stem)
        for path in transaction.list_work_completion_receipts(root)
    ]
    active = [value for value in values if value.get("state") != "completed"]
    if len(active) != 1:
        raise FinishBlocked("resume requires --receipt-id unless exactly one incomplete receipt exists")
    return active[0]


def resume(root: Path, receipt_id: str | None = None, authorization_path: Path | None = None) -> dict[str, Any]:
    receipt = validate_receipt(select_receipt(root, receipt_id))
    if authorization_path is not None:
        replacement = load_authorization(authorization_path, receipt["plan"])
        if replacement != receipt["authorization_evidence"]:
            receipt["authorization_history"].append(replacement)
        receipt["authorization_evidence"] = replacement
        validate_receipt(receipt)
        transaction.write_work_completion_receipt(root, receipt, create=False)
    if receipt.get("state") == "completed":
        return receipt
    try:
        return execute(root, receipt)
    except FinishError as error:
        block(root, receipt, getattr(error, "operation", "resume"), error)
        raise
